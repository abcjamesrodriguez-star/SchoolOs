---
import type { PricingPlan } from '../data/pricing';

interface FAQItem { question: string; answer: string; }
interface Props {
  plans: PricingPlan[];
  faq: FAQItem[];
  faqEyebrow?: string;
  faqHeading?: string;
}
const {
  plans,
  faq,
  faqEyebrow = 'Common questions',
  faqHeading = 'Before you request a demo',
} = Astro.props;
---
<section class="tight" id="demo">
  <div class="wrap">
    <!-- Price grid -->
    <div class="price-grid">
      {plans.map((plan) => (
        <div class={`price-card${plan.featured ? ' featured' : ''}`}>
          <h3>{plan.name}</h3>
          <p class="price-note">{plan.note}</p>
          <ul>
            {plan.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a class={`btn btn-${plan.cta.variant}`} href={plan.cta.href}>
            {plan.cta.label}
          </a>
        </div>
      ))}
    </div>

    <!-- FAQ -->
    <div class="price-faq">
      <div class="section-head" style="margin-bottom: 24px;">
        <span class="eyebrow">{faqEyebrow}</span>
        <h2 style="font-size: 28px;">{faqHeading}</h2>
      </div>
      {faq.map((item) => (
        <div class="price-faq-item">
          <h4>{item.question}</h4>
          <p>{item.answer}</p>
        </div>
      ))}
    </div>
  </div>
</section>
