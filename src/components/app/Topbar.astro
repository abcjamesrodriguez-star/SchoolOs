---
import type { Lang } from '../../i18n';
import { useTranslations, switchLang } from '../../i18n';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  breadcrumbs: BreadcrumbItem[];
  role?: 'super_admin' | 'school_admin' | 'teacher' | 'student';
  schoolName?: string;
  lang?: Lang;
  activeRoute?: string;
}

const {
  title,
  breadcrumbs,
  role = 'super_admin',
  schoolName = 'Institución',
  lang = 'es',
  activeRoute = '/app/super-admin',
} = Astro.props;

const t = useTranslations(lang).app.topbar;
const isSchoolAdmin = role === 'school_admin';
const isTeacher = role === 'teacher';
const isStudent = role === 'student';

const altLang: Lang = lang === 'en' ? 'es' : 'en';
const currentPath = `/${lang}${activeRoute.startsWith('/') ? activeRoute : '/' + activeRoute}`;
const altPath = switchLang(currentPath, altLang);

/* Datos del usuario según rol */
const userData = isStudent
  ? { initials: 'US', name: 'Usuario', fullName: 'Usuario', email: 'pendiente@schoolos.app', avatarBg: '#C3532C', roleLabel: lang === 'es' ? 'Estudiante' : 'Student', userId: '-' }
  : isSchoolAdmin
  ? { initials: 'US', name: 'Usuario', fullName: 'Usuario', email: 'pendiente@schoolos.app', avatarBg: 'var(--rust)', roleLabel: lang === 'es' ? 'Rectoría' : 'School Admin', userId: '-' }
  : isTeacher
  ? { initials: 'US', name: 'Usuario', fullName: 'Usuario', email: 'pendiente@schoolos.app', avatarBg: 'var(--ink)', roleLabel: lang === 'es' ? 'Docente' : 'Teacher', userId: '-' }
  : { initials: 'US', name: 'Usuario', fullName: 'Usuario', email: 'pendiente@schoolos.app', avatarBg: 'var(--ink)', roleLabel: lang === 'es' ? 'Super Admin' : 'Super Administrator', userId: '-' };
---

<header class="app-topbar">
  <div>
    <div class="breadcrumb">
      {breadcrumbs.map((b, i) => (
        <span>
          {b.href ? <a href={b.href}>{b.label}</a> : b.label}
          {i < breadcrumbs.length - 1 && ' / '}
        </span>
      ))}
    </div>
    <h1>{title}</h1>
  </div>

  <div class="topbar-right">
    <!-- Live Ecosystem Indicator -->
    {isSchoolAdmin ? (
      <div style="display:inline-flex; align-items:center; gap:6px; font-family:var(--mono); font-size:11px; padding:4px 10px; border:1px solid var(--ink); background:var(--paper); color:var(--ink);">
        <span style="width:6px; height:6px; border-radius:50%; background:#4ADE80;"></span>
        <span style="font-weight:700;" data-tenant-name>{schoolName.toUpperCase()}</span>
        <span style="color:var(--ink-soft); font-size:10px;">{lang === 'es' ? 'TENANT ACTIVO' : 'ACTIVE TENANT'}</span>
      </div>
    ) : (
      <div style="display:inline-flex; align-items:center; gap:6px; font-family:var(--mono); font-size:11px; padding:4px 10px; border:1px solid var(--ink); background:var(--paper); color:var(--ink);">
        <span style="width:6px; height:6px; border-radius:50%; background:#4ADE80;"></span>
        <span style="font-weight:700;">SchoolOS</span>
        <span style="color:var(--ink-soft); font-size:10px;">{lang === 'es' ? 'SISTEMA ACTIVO' : 'SYSTEM ACTIVE'}</span>
      </div>
    )}

    <!-- Search with shortcut badge -->
    <div style="position:relative; display:flex; align-items:center;">
      <svg style="position:absolute; left:10px; color:var(--ink-soft); pointer-events:none;" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input class="search-input" style="padding-left:30px; padding-right:38px; border:1px solid var(--ink);" type="text" placeholder={isSchoolAdmin ? (lang === 'es' ? 'Buscar cursos, alumnos, profes...' : 'Search courses, students, teachers...') : t.searchPlaceholder} />
      <span style="position:absolute; right:8px; font-family:var(--mono); font-size:9.5px; border:1px solid var(--line-strong); padding:1px 4px; border-radius:2px; color:var(--ink-soft); background:var(--paper);">⌘K</span>
    </div>

    <!-- Dual Language Switcher pill -->
    <a
      class="topbar-lang-switcher"
      href={altPath}
      data-target-lang={altLang}
      style="display:inline-flex; align-items:center; gap:4px; font-family:var(--mono); font-size:11px; padding:4px 10px; border:1px solid var(--ink); background:var(--paper); color:var(--ink); text-decoration:none; font-weight:600;"
      title={lang === 'es' ? 'Switch to English' : 'Cambiar a Español'}
    >
      <span style={lang === 'en' ? 'color:var(--orange-vibrant); font-weight:800;' : 'color:var(--ink-soft);'}>EN</span>
      <span style="opacity:0.3;">/</span>
      <span style={lang === 'es' ? 'color:var(--orange-vibrant); font-weight:800;' : 'color:var(--ink-soft);'}>ES</span>
    </a>

    <!-- User chip → abre modal de perfil -->
    <button
      id="profileChipBtn"
      class="user-chip profile-chip-btn"
      style={`border:1px solid var(--ink); padding:3px 10px 3px 4px; background:var(--paper); cursor:pointer;`}
      title={lang === 'es' ? 'Ver mi perfil' : 'View my profile'}
    >
      <div class="avatar" style={`width:24px; height:24px; font-size:10.5px; background:${userData.avatarBg}; color:#FFFFFF; border-radius:0;`}>{userData.initials}</div>
      <span style="font-weight:700; font-size:12px;">{userData.name}</span>
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-left:2px; opacity:0.5;"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </button>

    <button id="logoutBtn" class="logout-btn" style="border:1px solid var(--ink); font-weight:700;" title="Cerrar sesión">{t.logout}</button>
  </div>
</header>

<!-- ═══════════════════════════════════════════════════════════════
     MODAL DE PERFIL DE USUARIO
     ═══════════════════════════════════════════════════════════════ -->
<div id="profileModal" class="profile-modal-overlay" aria-hidden="true">
  <div class="profile-modal-panel" role="dialog" aria-label={lang === 'es' ? 'Perfil de usuario' : 'User profile'}>

    <!-- Header del modal -->
    <div class="profile-modal-header">
      <span class="profile-modal-label">{lang === 'es' ? 'PERFIL DE USUARIO' : 'USER PROFILE'}</span>
      <button id="profileModalClose" class="profile-modal-close" title={lang === 'es' ? 'Cerrar' : 'Close'}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <!-- Hero: Avatar + Nombre + Rol -->
    <div class="profile-hero">
      <div class="profile-avatar-xl" style={`background:${userData.avatarBg};`}>{userData.initials}</div>
      <div class="profile-hero-info">
        <div class="profile-name">{userData.fullName}</div>
        <div class="profile-role-badge">{userData.roleLabel}</div>
        <div class="profile-school-tag">
          <span style="width:6px; height:6px; border-radius:50%; background:#4ADE80; display:inline-block;"></span>
          <span data-tenant-name>{schoolName}</span> · {lang === 'es' ? 'Cuenta verificada' : 'Verified account'}
        </div>
      </div>
    </div>

    <!-- Separador -->
    <div class="profile-divider"></div>

    <!-- Datos personales -->
    <div class="profile-section-title">{lang === 'es' ? 'INFORMACIÓN PERSONAL' : 'PERSONAL INFO'}</div>
    <div class="profile-info-grid">
      <div class="profile-info-row">
        <span class="profile-info-label">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          {lang === 'es' ? 'Nombre completo' : 'Full name'}
        </span>
        <span class="profile-info-value">{userData.fullName}</span>
      </div>
      <div class="profile-info-row">
        <span class="profile-info-label">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          {lang === 'es' ? 'Correo institucional' : 'Institutional email'}
        </span>
        <span class="profile-info-value" style="color:var(--rust);">{userData.email}</span>
      </div>
      <div class="profile-info-row">
        <span class="profile-info-label">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          {lang === 'es' ? 'Estado de cuenta' : 'Account status'}
        </span>
        <span class="profile-info-value" data-profile-status>Activa</span>
      </div>
      <div class="profile-info-row">
        <span class="profile-info-label">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          ID de usuario
        </span>
        <span class="profile-info-value" data-profile-user-id style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft);">{userData.userId}</span>
      </div>
    </div>

    <!-- Separador -->
    <div class="profile-divider"></div>

    <!-- Estadísticas según rol -->
    <div class="profile-section-title">
      {isTeacher
        ? (lang === 'es' ? 'RESUMEN DOCENTE · PERIODO ACTUAL' : 'TEACHER SUMMARY · CURRENT PERIOD')
        : isSchoolAdmin
        ? (lang === 'es' ? 'RESUMEN DIRECTIVO · INSTITUCIÓN' : 'ADMIN SUMMARY · INSTITUTION')
        : (lang === 'es' ? 'ESTADO DEL SISTEMA' : 'SYSTEM STATUS')}
    </div>
    <div class="profile-stats-row">
      {isTeacher ? (
        <>
          <div class="profile-stat-card">
            <div class="profile-stat-num">--</div>
            <div class="profile-stat-lbl">{lang === 'es' ? 'Cursos' : 'Courses'}</div>
          </div>
          <div class="profile-stat-card">
            <div class="profile-stat-num">--</div>
            <div class="profile-stat-lbl">{lang === 'es' ? 'Estudiantes' : 'Students'}</div>
          </div>
          <div class="profile-stat-card">
            <div class="profile-stat-num" style="color:var(--rust);">--</div>
            <div class="profile-stat-lbl">{lang === 'es' ? 'Por calificar' : 'To grade'}</div>
          </div>
          <div class="profile-stat-card">
            <div class="profile-stat-num">--</div>
            <div class="profile-stat-lbl">{lang === 'es' ? 'Semana' : 'Week'}</div>
          </div>
        </>
      ) : isSchoolAdmin ? (
        <>
          <div class="profile-stat-card">
            <div class="profile-stat-num">--</div>
            <div class="profile-stat-lbl">{lang === 'es' ? 'Docentes' : 'Teachers'}</div>
          </div>
          <div class="profile-stat-card">
            <div class="profile-stat-num">--</div>
            <div class="profile-stat-lbl">{lang === 'es' ? 'Alumnos' : 'Students'}</div>
          </div>
          <div class="profile-stat-card">
            <div class="profile-stat-num">--</div>
            <div class="profile-stat-lbl">{lang === 'es' ? 'Cursos' : 'Courses'}</div>
          </div>
          <div class="profile-stat-card">
            <div class="profile-stat-num" style="color:var(--olive);">--</div>
            <div class="profile-stat-lbl">Uptime</div>
          </div>
        </>
      ) : (
        <>
          <div class="profile-stat-card">
            <div class="profile-stat-num">--</div>
            <div class="profile-stat-lbl">{lang === 'es' ? 'Escuelas' : 'Schools'}</div>
          </div>
          <div class="profile-stat-card">
            <div class="profile-stat-num">--</div>
            <div class="profile-stat-lbl">{lang === 'es' ? 'Latencia' : 'Latency'}</div>
          </div>
          <div class="profile-stat-card">
            <div class="profile-stat-num" style="color:var(--olive);">--</div>
            <div class="profile-stat-lbl">SLA</div>
          </div>
          <div class="profile-stat-card">
            <div class="profile-stat-num">--</div>
            <div class="profile-stat-lbl">{lang === 'es' ? 'Alertas' : 'Alerts'}</div>
          </div>
        </>
      )}
    </div>

    <!-- Materias asignadas (solo teacher) -->
    {isTeacher && (
      <>
        <div class="profile-divider"></div>
        <div class="profile-section-title">{lang === 'es' ? 'MATERIAS ASIGNADAS' : 'ASSIGNED SUBJECTS'}</div>
        <div class="profile-subjects">
          <span class="profile-subject-tag">{lang === 'es' ? 'Sin materias cargadas' : 'No subjects loaded'}</span>
        </div>
      </>
    )}

    <!-- Separador final -->
    <div class="profile-divider"></div>

    <!-- Acciones -->
    <div class="profile-actions">
      <button class="profile-action-btn profile-action-primary" id="editProfileBtn">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
        {lang === 'es' ? 'Editar perfil' : 'Edit profile'}
      </button>
      <button class="profile-action-btn profile-action-secondary" id="changePasswordBtn">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        {lang === 'es' ? 'Cambiar contraseña' : 'Change password'}
      </button>
      <button id="profileLogoutBtn" class="profile-action-btn profile-action-danger">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        {lang === 'es' ? 'Cerrar sesión' : 'Log out'}
      </button>
    </div>

  </div>
</div>

<script>
  import { authService } from '../../services/authService';

  /* ── Sincronizar datos del usuario autenticado en la barra superior ── */
  (function() {
    try {
      const userRaw = localStorage.getItem('schoolos-user');
      if (userRaw) {
        const user = JSON.parse(userRaw);
        if (user && user.name) {
          // Iniciales (fallback si no hay avatar)
          const names = user.name.trim().split(' ');
          const initials = names.length > 1 ? (names[0][0] + names[names.length - 1][0]).toUpperCase() : names[0].slice(0, 2).toUpperCase();

          // Chip superior — respeta diseño actual, solo inserta <img> si hay avatarUrl
          const chipAvatar = document.querySelector('#profileChipBtn .avatar');
          const chipName = document.querySelector('#profileChipBtn span');
          if (chipAvatar) {
            if (user.avatarUrl) {
              chipAvatar.innerHTML = `<img src="${user.avatarUrl}" alt="${user.name}" loading="eager" onerror="this.style.display='none'; this.parentElement.textContent='${initials}'" />`;
            } else {
              chipAvatar.textContent = initials;
            }
          }
          if (chipName) chipName.textContent = user.name;

          // Modal de perfil — mismo patrón, sin tocar layout
          const modalAvatar = document.querySelector('.profile-avatar-xl');
          const modalName = document.querySelector('.profile-name');
          const modalRole = document.querySelector('.profile-role-badge');
          const modalStatus = document.querySelector('[data-profile-status]');
          const modalUserId = document.querySelector('[data-profile-user-id]');
          if (modalAvatar) {
            if (user.avatarUrl) {
              modalAvatar.innerHTML = `<img src="${user.avatarUrl}" alt="${user.name}" loading="eager" onerror="this.style.display='none'; this.parentElement.textContent='${initials}'" />`;
            } else {
              modalAvatar.textContent = initials;
            }
          }
          if (modalName) modalName.textContent = user.name;
          if (modalRole) {
            const labels = {
              super_admin: 'Super Admin',
              school_admin: 'Rectoría',
              teacher: 'Docente',
              student: 'Estudiante'
            };
            modalRole.textContent = labels[user.role] || user.role;
          }
          if (modalStatus) modalStatus.textContent = user.status || 'active';
          if (modalUserId) modalUserId.textContent = user.id || '-';

          // Actualizar rows de información
          const infoValues = document.querySelectorAll('.profile-info-value');
          if (infoValues.length >= 2) {
            infoValues[0].textContent = user.name;
            infoValues[1].textContent = user.email;
          }
        }
      }
    } catch (_) {}
  })();

  /* ── Lang switcher ── */
  document.querySelectorAll('.topbar-lang-switcher').forEach((el) => {
    el.addEventListener('click', () => {
      const target = el.getAttribute('data-target-lang');
      if (target) {
        try { localStorage.setItem('schoolos-lang', target); } catch (_) {}
      }
    });
  });

  /* ── Logout con authService (Supabase Auth) ── */
  async function handleLogout() {
    try {
      await authService.signOut();
    } catch (_) {
      localStorage.removeItem('schoolos-auth');
      localStorage.removeItem('schoolos-user');
    }
    window.location.href = '/login';
  }

  document.getElementById('logoutBtn')?.addEventListener('click', handleLogout);
  document.getElementById('profileLogoutBtn')?.addEventListener('click', handleLogout);

  /* ── Modal de perfil ── */
  (function() {
    const modal = document.getElementById('profileModal');
    const chipBtn = document.getElementById('profileChipBtn');
    const closeBtn = document.getElementById('profileModalClose');
    const editBtn = document.getElementById('editProfileBtn');
    const pwBtn = document.getElementById('changePasswordBtn');

    function openModal() {
      if (!modal) return;
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    chipBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      modal?.classList.contains('open') ? closeModal() : openModal();
    });

    closeBtn?.addEventListener('click', closeModal);
    editBtn?.addEventListener('click', closeModal);
    pwBtn?.addEventListener('click', closeModal);

    /* Cerrar al hacer clic en el backdrop */
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    /* Cerrar con Escape */
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('open')) closeModal();
    });
  })();
</script>

<style>
  /* ── Profile chip button ── */
  .profile-chip-btn {
    font-family: var(--mono);
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .profile-chip-btn:hover {
    background: var(--cream) !important;
    border-color: var(--rust) !important;
  }

  /* ── Modal overlay ── */
  .profile-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(18, 17, 14, 0.52);
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 70px 24px 24px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    backdrop-filter: blur(2px);
  }
  .profile-modal-overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  /* ── Modal panel ── */
  .profile-modal-panel {
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 6px;
    width: 420px;
    max-width: calc(100vw - 48px);
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    box-shadow: 8px 8px 0 rgba(18, 17, 14, 0.18);
    transform: translateY(-14px);
    transition: transform 0.22s ease;
  }
  .profile-modal-overlay.open .profile-modal-panel {
    transform: translateY(0);
  }

  /* ── Header ── */
  .profile-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    background: var(--ink);
    border-radius: 4px 4px 0 0;
    position: sticky;
    top: 0;
    z-index: 2;
  }
  .profile-modal-label {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    font-weight: 700;
    color: var(--orange-vibrant);
    text-transform: uppercase;
  }
  .profile-modal-close {
    background: none;
    border: none;
    color: #8B876F;
    cursor: pointer;
    padding: 2px;
    display: flex;
    align-items: center;
    border-radius: 2px;
    transition: color 0.15s ease;
  }
  .profile-modal-close:hover { color: #FFFFFF; }

  /* ── Hero ── */
  .profile-hero {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 22px 18px;
  }
  :global(.profile-avatar-xl) {
    width: 64px;
    height: 64px;
    min-width: 64px;
    min-height: 64px;
    max-width: 64px;
    max-height: 64px;
    flex-shrink: 0;
    border: 2px solid var(--ink);
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background: var(--paper);
    /* fallback para iniciales */
    font-family: var(--sans);
    font-weight: 800;
    font-size: 22px;
    color: #FFFFFF;
    letter-spacing: -0.02em;
    line-height: 64px;
    text-align: center;
  }
  :global(.profile-avatar-xl img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    background: var(--paper);
  }
  :global(#profileChipBtn .avatar) {
    overflow: hidden;
    background: var(--paper);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  :global(#profileChipBtn .avatar img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
