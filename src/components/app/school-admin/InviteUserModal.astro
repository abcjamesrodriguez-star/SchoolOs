---
// ============================================================
// SchoolOS — Modal de Invitación / Registro de Usuarios
// ============================================================
import type { Lang } from '../../../i18n';

interface Props {
  id?: string;
  defaultRole?: 'teacher' | 'student';
  lang?: Lang;
}

const { id = 'inviteModal', defaultRole = 'teacher', lang = 'es' } = Astro.props;
---

<div id={id} class="custom-modal-backdrop" style="display:none; position:fixed; inset:0; background:rgba(18, 17, 14, 0.6); z-index:9999; align-items:center; justify-content:center; padding:20px;">
  <div class="panel" style="width:100%; max-width:520px; background:var(--paper); box-shadow:8px 8px 0 rgba(18, 17, 14, 0.3);">
    <div class="panel-header" style="display:flex; justify-content:space-between; align-items:center;">
      <h2 style="font-family:var(--mono); font-size:12px; letter-spacing:0.08em; text-transform:uppercase;">
        {lang === 'es' ? '＋ Invitar a la Comunidad Escolar' : '＋ Invite to School Community'}
      </h2>
      <button type="button" class="close-modal-btn" style="background:none; border:none; font-family:var(--mono); font-size:16px; cursor:pointer; font-weight:700; color:var(--ink);">✕</button>
    </div>

    <div class="panel-body padded">
      <div id={`${id}Feedback`} style="display:none; padding:10px 14px; margin-bottom:14px; font-family:var(--mono); font-size:12px; font-weight:700;"></div>

      <form id={`${id}Form`} data-modal-id={id}>
        <div class="form-grid">
          <div class="form-field full">
            <label>{lang === 'es' ? 'Rol en la Institución' : 'School Role'}</label>
            <select id={`${id}Role`} style="border:1.5px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--mono); font-size:12px; width:100%;">
              <option value="teacher" selected={defaultRole === 'teacher'}>{lang === 'es' ? 'Docente / Profesor' : 'Teacher / Faculty'}</option>
              <option value="student" selected={defaultRole === 'student'}>{lang === 'es' ? 'Estudiante / Alumno' : 'Student'}</option>
            </select>
          </div>

          <div class="form-field full">
            <label>{lang === 'es' ? 'Nombre Completo' : 'Full Name'}</label>
            <input id={`${id}Name`} type="text" placeholder={lang === 'es' ? 'Ej. Andrés Camargo' : 'E.g. Andres Camargo'} required style="border:1.5px solid var(--ink); background:var(--cream); padding:8px 10px; width:100%;" />
          </div>

          <div class="form-field full">
            <label>{lang === 'es' ? 'Correo Electrónico Institucional' : 'Institutional Email'}</label>
            <input id={`${id}Email`} type="email" placeholder="usuario@colegionorte.edu.co" required style="border:1.5px solid var(--ink); background:var(--cream); padding:8px 10px; width:100%; font-family:var(--mono);" />
            <span class="hint" style="font-size:11px; color:var(--ink-soft); margin-top:4px; display:block;">
              {lang === 'es' ? 'Se enviará un enlace seguro de activación con credenciales oficiales.' : 'A secure activation link with credentials will be sent.'}
            </span>
          </div>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px; border-top:1px solid var(--line); padding-top:16px;">
          <button type="button" class="btn btn-secondary close-modal-btn">{lang === 'es' ? 'Cancelar' : 'Cancel'}</button>
          <button type="submit" id={`${id}SubmitBtn`} class="btn btn-primary">{lang === 'es' ? 'Enviar Invitación →' : 'Send Invitation →'}</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script is:inline define:vars={{ id, lang }}>
  (function() {
    var modal = document.getElementById(id);
    if (!modal) return;

    modal.querySelectorAll('.close-modal-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        modal.style.display = 'none';
      });
    });

    modal.addEventListener('click', function(e) {
      if (e.target === modal) {
        modal.style.display = 'none';
      }
    });

    var form = document.getElementById(id + 'Form');
    if (form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        var submitBtn = document.getElementById(id + 'SubmitBtn');
        var feedback = document.getElementById(id + 'Feedback');
        var roleEl = document.getElementById(id + 'Role');
        var nameEl = document.getElementById(id + 'Name');
        var emailEl = document.getElementById(id + 'Email');

        var role = roleEl ? roleEl.value : 'teacher';
        var name = nameEl ? nameEl.value.trim() : '';
        var email = emailEl ? emailEl.value.trim() : '';

        if (!name || !email) return;

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = lang === 'es' ? 'Enviando invitación…' : 'Sending invite…';
        }
        if (feedback) {
          feedback.style.display = 'none';
          feedback.textContent = '';
        }

        try {
          var endpoint = role === 'teacher' ? '/api/school-admin/teachers' : '/api/admin/create-student';
          var payload = role === 'teacher'
            ? { action: 'create', name: name, email: email }
            : { name: name, email: email, send_invite: true };

          var res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          var data = await res.json().catch(function() { return {}; });

          if (!res.ok || data.ok === false) {
            throw new Error(data.error || 'Error al procesar la invitación');
          }

          if (feedback) {
            feedback.style.cssText = 'display:block; background:#E6F4EA; border:1px solid #1E4620; color:#1E4620;';
            feedback.textContent = lang === 'es'
              ? '✓ Invitación enviada con éxito a ' + email
              : '✓ Invitation sent successfully to ' + email;
          }

          setTimeout(function() {
            modal.style.display = 'none';
            form.reset();
            if (feedback) feedback.style.display = 'none';
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = lang === 'es' ? 'Enviar Invitación →' : 'Send Invitation →';
            }
          }, 1500);

        } catch (err) {
          console.error('[InviteUserModal] Error:', err);
          if (feedback) {
            feedback.style.cssText = 'display:block; background:#FEE2E2; border:1px solid var(--danger); color:var(--danger);';
            feedback.textContent = err.message || 'Error al enviar invitación';
          }
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = lang === 'es' ? 'Reintentar →' : 'Retry →';
          }
        }
      });
    }
  })();
</script>
