---
// ============================================================
// SchoolOS — Modal de Convocatoria & Atención a Padres
// Enfoque: Diálogo Pedagógico, Acompañamiento y Acuerdos Formativos (Sin Emojis)
// ============================================================
import type { Lang } from '../../../i18n';

interface Props {
  id?: string;
  lang?: Lang;
}

const { id = 'studentCitationModal', lang = 'es' } = Astro.props;
---

<div
  id={id}
  class="custom-modal-backdrop student-citation-modal"
  style="display:none; position:fixed; inset:0; background:rgba(18, 17, 14, 0.65); z-index:9999; align-items:center; justify-content:center; padding:20px; backdrop-filter:blur(2px);"
  role="dialog"
  aria-modal="true"
>
  <div class="panel" style="width:100%; max-width:560px; background:var(--paper); border:1.5px solid var(--ink); box-shadow:6px 6px 0 rgba(18, 17, 14, 0.25); border-radius:3px;">
    
    <!-- HEADER AMABLE Y PEDAGÓGICO -->
    <div class="panel-header" style="display:flex; justify-content:space-between; align-items:center; padding:16px 20px; background:var(--cream); border-bottom:1.5px solid var(--line);">
      <div>
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:2px;">
          <span class="plan-tag" style="background:var(--ink); color:#FFFFFF; border-color:var(--ink); font-size:9.5px; font-weight:800; padding:2px 6px;">
            {lang === 'es' ? 'COMUNIDAD EDUCATIVA' : 'FAMILY PARTNERSHIP'}
          </span>
          <h2 style="font-family:var(--serif); font-size:17px; margin:0; font-weight:700; color:var(--ink);">
            {lang === 'es' ? 'Atención a Padres & Diálogo Formativo' : 'Parent Meeting & Academic Follow-up'}
          </h2>
        </div>
        <div style="font-size:11.5px; color:var(--ink-soft);">
          {lang === 'es' ? 'Agendar espacio de diálogo, seguimiento y acuerdos con el acudiente' : 'Schedule a constructive meeting and follow-up with the student guardian'}
        </div>
      </div>

      <button
        type="button"
        class="close-modal-btn"
        onclick={`document.getElementById('${id}').style.display='none';`}
        style="background:none; border:none; font-family:var(--sans); font-size:18px; font-weight:700; cursor:pointer; color:var(--ink-soft); padding:4px 8px; border-radius:2px;"
        aria-label="Cerrar"
      >
        ✕
      </button>
    </div>

    <!-- BODY -->
    <div class="panel-body padded" style="background:#FFFDF9; padding:20px;">
      
      <!-- TARJETA DEL ESTUDIANTE & ACUDIENTE -->
      <div style="background:var(--paper); border:1px solid var(--line); border-left:3.5px solid var(--olive-dark); padding:12px 14px; margin-bottom:16px; border-radius:2px;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
          <div style="display:flex; align-items:center; gap:10px;">
            <div id="citationStudentAvatar" style="width:32px; height:32px; background:var(--ink); color:#FFF; font-family:var(--mono); font-size:12px; font-weight:700; display:flex; align-items:center; justify-content:center; border-radius:2px;">
              ST
            </div>
            <div>
              <strong id="citationStudentTargetName" style="font-size:14px; color:var(--ink);">Mateo Gómez</strong>
              <div id="citationStudentTargetSub" style="font-size:11.5px; color:var(--ink-soft); margin-top:1px;">
                10° Grado A (10-1) · Acudiente: Rosa Gómez (+57 310 445 8921)
              </div>
            </div>
          </div>
          <span id="citationStudentBadge" class="badge badge-active" style="font-size:9.5px; padding:2px 6px;">
            {lang === 'es' ? 'Seguimiento Formativo' : 'Academic Follow-up'}
          </span>
        </div>
      </div>

      <form id={`${id}Form`} onsubmit={`event.preventDefault(); alert(document.documentElement.lang === 'en' ? 'Invitation sent cordially to the guardian via WhatsApp and email. Meeting logged in academic follow-up calendar.' : 'Invitación enviada cordialmente al acudiente vía WhatsApp y correo institucional. El espacio quedó agendado en el calendario escolar.'); document.getElementById('${id}').style.display='none';`}>
        
        <div style="display:flex; flex-direction:column; gap:13px;">
          
          <!-- Motivo del espacio -->
          <div>
            <label style="font-size:11.5px; font-weight:700; display:block; margin-bottom:4px; color:var(--ink);">
              {lang === 'es' ? 'Propósito de la Reunión *' : 'Meeting Purpose *'}
            </label>
            <select style="border:1px solid var(--ink); background:var(--cream); padding:7px 10px; font-size:12.5px; width:100%; border-radius:2px;">
              <option value="pedagogico">{lang === 'es' ? 'Revisión de avances pedagógicos y plan de acompañamiento' : 'Academic progress review & support plan'}</option>
              <option value="nivelacion">{lang === 'es' ? 'Seguimiento a plan de nivelación y refuerzo (Periodo 1)' : 'Term 1 recovery plan & tutoring follow-up'}</option>
              <option value="asistencia">{lang === 'es' ? 'Revisión cordial de inasistencias y justificaciones' : 'Absence review & justification support'}</option>
              <option value="convivencia">{lang === 'es' ? 'Diálogo formativo y acuerdos de convivencia escolar' : 'Constructive conduct agreement & dialogue'}</option>
              <option value="general">{lang === 'es' ? 'Espacio general de atención a padres solicitado' : 'General parent meeting request'}</option>
            </select>
          </div>

          <!-- Fecha y Hora Manual -->
          <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
            <div>
              <label style="font-size:11.5px; font-weight:700; display:block; margin-bottom:4px; color:var(--ink);">
                {lang === 'es' ? 'Fecha de la Reunión *' : 'Meeting Date *'}
              </label>
              <input
                type="date"
                required
                value="2026-08-21"
                style="border:1px solid var(--ink); background:var(--cream); padding:7px 10px; font-family:var(--sans); font-size:12px; width:100%; border-radius:2px;"
              />
            </div>

            <div>
              <label style="font-size:11.5px; font-weight:700; display:block; margin-bottom:4px; color:var(--ink);">
                {lang === 'es' ? 'Hora de Inicio *' : 'Start Time *'}
              </label>
              <input
                type="time"
                required
                value="08:00"
                style="border:1px solid var(--ink); background:var(--cream); padding:7px 10px; font-family:var(--mono); font-size:12px; width:100%; border-radius:2px;"
              />
            </div>
          </div>

          <!-- Lugar / Modalidad Dropdown & Manual (Sin Emojis) -->
          <div>
            <label style="font-size:11.5px; font-weight:700; display:block; margin-bottom:4px; color:var(--ink);">
              {lang === 'es' ? 'Lugar o Modalidad del Encuentro *' : 'Meeting Location or Format *'}
            </label>
            <select
              id={`${id}LocationSelect`}
              style="border:1px solid var(--ink); background:var(--cream); padding:7px 10px; font-size:12.5px; width:100%; border-radius:2px; cursor:pointer;"
              onchange={`
                var wrapper = document.getElementById('${id}CustomLocationWrapper');
                if (this.value === 'custom') {
                  if (wrapper) {
                    wrapper.style.display = 'block';
                    var inp = wrapper.querySelector('input');
                    if (inp) { inp.required = true; inp.focus(); }
                  }
                } else {
                  if (wrapper) {
                    wrapper.style.display = 'none';
                    var inp = wrapper.querySelector('input');
                    if (inp) inp.required = false;
                  }
                }
              `}
            >
              <option value="Despacho de Rectoría">{lang === 'es' ? 'Despacho de Rectoría' : 'Principal Office'}</option>
              <option value="Coordinación Académica">{lang === 'es' ? 'Coordinación Académica' : 'Academic Office'}</option>
              <option value="Orientación Escolar & Psicología">{lang === 'es' ? 'Orientación Escolar & Psicología' : 'Counseling & Psychology'}</option>
              <option value="Sala de Convivencia Escolar">{lang === 'es' ? 'Sala de Convivencia Escolar' : 'School Conduct Office'}</option>
              <option value="Sala de Profesores">{lang === 'es' ? 'Sala de Profesores' : 'Faculty Lounge'}</option>
              <option value="Salón de Clases">{lang === 'es' ? 'Salón de Clases del Estudiante' : 'Student Classroom'}</option>
              <option value="Virtual — Google Meet / Zoom">{lang === 'es' ? 'Virtual — Enlace Google Meet / Zoom' : 'Virtual — Google Meet / Zoom'}</option>
              <option value="Llamada Telefónica">{lang === 'es' ? 'Llamada Telefónica con Acudiente' : 'Direct Phone Call'}</option>
              <option value="custom">{lang === 'es' ? 'Otro lugar (Escribir manualmente...)' : 'Other location (Type manually...)'}</option>
            </select>

            <!-- Campo que se despliega si se elige "Otro lugar" -->
            <div id={`${id}CustomLocationWrapper`} style="display:none; margin-top:6px;">
              <input
                type="text"
                placeholder={lang === 'es' ? 'Escribe el lugar o enlace específico (ej: Biblioteca, Salón 302, Sala de Audiovisuales...)' : 'Type location (e.g. Library, Room 302...)'}
                style="border:1px solid var(--ink); background:#FFFDF9; padding:7px 10px; font-size:12px; width:100%; border-radius:2px;"
              />
            </div>
          </div>

          <!-- Mensaje cordial -->
          <div>
            <label style="font-size:11.5px; font-weight:700; display:block; margin-bottom:4px; color:var(--ink);">
              {lang === 'es' ? 'Mensaje o puntos a tratar con la familia' : 'Message or notes for the guardian'}
            </label>
            <textarea rows="3" placeholder={lang === 'es' ? 'Ej: Estimado acudiente, le invitamos a este espacio para conversar sobre los avances en el área de Matemáticas y acordar estrategias conjuntas de apoyo en casa.' : 'E.g. Dear guardian, we invite you to review your student’s progress and coordinate support strategies...'} style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--sans); font-size:12px; width:100%; resize:vertical; border-radius:2px;"></textarea>
          </div>

          <!-- Canales de comunicación amables (Sin Emojis) -->
          <div style="background:var(--paper); border:1px solid var(--line); padding:10px 12px; font-size:11.5px; color:var(--ink); border-radius:2px;">
            <div style="font-weight:700; font-size:11px; margin-bottom:2px; color:var(--ink);">
              {lang === 'es' ? 'Canal de notificación:' : 'Notification channel:'}
            </div>
            <div style="color:var(--ink-soft); font-size:11px; line-height:1.35;">
              {lang === 'es' 
                ? 'Se enviará una invitación formal personalizada vía WhatsApp y correo institucional con opción de confirmación para el acudiente.'
                : 'A personalized invitation will be sent via WhatsApp and school email with confirmation options.'}
            </div>
          </div>

        </div>

        <!-- BOTONES DE ACCIÓN -->
        <div style="display:flex; justify-content:flex-end; align-items:center; gap:10px; border-top:1px solid var(--line); padding-top:14px; margin-top:16px;">
          <button
            type="button"
            class="btn btn-secondary btn-sm"
            onclick={`document.getElementById('${id}').style.display='none';`}
            style="font-size:12px;"
          >
            {lang === 'es' ? 'Cancelar' : 'Cancel'}
          </button>
          <button
            type="submit"
            class="btn btn-primary btn-sm"
            style="font-size:12px; font-weight:700;"
          >
            {lang === 'es' ? 'Agendar & Enviar Invitación' : 'Schedule & Send Invite'}
          </button>
        </div>

      </form>
    </div>

  </div>
</div>
