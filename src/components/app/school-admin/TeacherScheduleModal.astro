---
// ============================================================
// SchoolOS — Pop-up Modal de Horario Semanal & Salones del Docente
// Sincronización en Tiempo Real con Reloj Local:
// 1. Radar en Vivo: Dónde está ubicado en este minuto exacto
// 2. Tarjetas de Salones Asignados & Carga por Materia
// 3. Matriz Semanal con Highlight del Bloque Activo y Día de Hoy
// 4. Cartel Institucional de Jornada Finalizada o en Curso
// Cero emojis, diseño brutalista editorial institucional
// ============================================================
interface Props {
  id?: string;
}

const { id = 'teacherScheduleModal' } = Astro.props;
---

<div
  id={id}
  class="custom-modal-backdrop"
  style="display:none; position:fixed; inset:0; background:rgba(18, 17, 14, 0.75); z-index:9999; align-items:center; justify-content:center; padding:20px; overflow-y:auto;"
  role="dialog"
  aria-modal="true"
>
  <div class="panel" style="width:96%; max-width:1240px; background:var(--paper); border:2px solid var(--ink); box-shadow:10px 10px 0 var(--ink); max-height:92vh; display:flex; flex-direction:column; overflow:hidden;">
    
    <!-- HEADER: IDENTIDAD DEL DOCENTE & HORA ACTUAL -->
    <div class="panel-header" style="display:flex; justify-content:space-between; align-items:center; padding:14px 22px; background:var(--cream); border-bottom:2px solid var(--ink); flex-shrink:0;">
      <div id={`${id}TeacherSummary`} style="display:flex; align-items:center; gap:14px;">
        <!-- Se llena dinámicamente -->
      </div>

      <div style="display:flex; align-items:center; gap:10px;">
        <div id={`${id}LiveClockBadge`} style="font-family:var(--mono); font-size:11.5px; font-weight:900; background:var(--ink); color:#FFFFFF; padding:4px 8px; border:1px solid var(--ink); display:flex; align-items:center; gap:6px;">
          <span style="display:inline-block; width:7px; height:7px; background:#4ade80; border-radius:50%;"></span>
          <span id={`${id}LiveClockTime`}>--:--</span>
        </div>
        <span id={`${id}TopHoursBadge`} class="plan-tag" style="background:#FFFFFF; border-color:var(--ink); font-size:11px; font-weight:900;">
          CARGA: 0h / SEM
        </span>
        <button
          type="button"
          onclick={`document.getElementById('${id}').style.display='none';`}
          style="background:var(--paper); border:1.5px solid var(--ink); font-family:var(--mono); font-size:12.5px; font-weight:900; padding:6px 12px; cursor:pointer; color:var(--ink); box-shadow:2px 2px 0 var(--ink);"
        >
          ✕ CERRAR
        </button>
      </div>
    </div>

    <!-- BODY WITH SCROLL -->
    <div class="panel-body padded" style="background:#FFFDF9; padding:20px 24px; overflow-y:auto; flex:1; display:flex; flex-direction:column; gap:20px;">
      
      <!-- ============================================================ -->
      <!-- RADAR EN VIVO: ESTADO Y UBICACIÓN ACTUAL DEL DOCENTE -->
      <!-- ============================================================ -->
      <div id={`${id}LiveRadarBanner`} style="border:2px solid var(--ink); box-shadow:3px 3px 0 var(--ink); padding:14px 18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; background:#FFFFFF;">
        <!-- Llenado dinámico según la hora local -->
      </div>

      <!-- ============================================================ -->
      <!-- BLOQUE 1: CARDS DE SALONES & ASIGNATURAS A CARGO (RESUMEN) -->
      <!-- ============================================================ -->
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
          <div style="font-family:var(--mono); font-size:11px; font-weight:900; text-transform:uppercase; color:var(--rust); letter-spacing:0.06em; display:flex; align-items:center; gap:6px;">
            <span>01 ·</span> Salones & Asignaturas a Cargo (Resumen de Carga)
          </div>
          <div id={`${id}SalonsCountLabel`} style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">
            0 salones asignados
          </div>
        </div>

        <div id={`${id}ClassroomsSummaryGrid`} style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:12px;">
          <!-- Se llena dinámicamente con las cards de salones -->
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- BLOQUE 2: MATRIZ SEMANAL DISTRIBUIDA (LUNES A VIERNES) -->
      <!-- ============================================================ -->
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
          <div style="font-family:var(--mono); font-size:11px; font-weight:900; text-transform:uppercase; color:var(--rust); letter-spacing:0.06em; display:flex; align-items:center; gap:6px;">
            <span>02 ·</span> Horario Semanal Distribuido (Lunes a Viernes)
          </div>
          <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft);">
            Las celdas con borde terracota indican el bloque activo en tiempo real
          </div>
        </div>

        <div style="border:2px solid var(--ink); background:#FFFFFF; overflow-x:auto; box-shadow:4px 4px 0 var(--ink);">
          <table class="data-table" style="margin:0; width:100%; min-width:880px; border-collapse:collapse;">
            <thead>
              <tr style="background:var(--cream); border-bottom:2px solid var(--ink);">
                <th style="width:14%; border-right:2px solid var(--ink); text-align:center; font-family:var(--mono); font-size:11px; font-weight:900; padding:12px 8px;">
                  BLOQUE / HORA
                </th>
                <th id={`${id}Th-0`} style="width:17.2%; border-right:1.5px solid var(--ink); text-align:center; font-family:var(--mono); font-size:12px; font-weight:900; padding:12px 8px;">
                  LUNES
                </th>
                <th id={`${id}Th-1`} style="width:17.2%; border-right:1.5px solid var(--ink); text-align:center; font-family:var(--mono); font-size:12px; font-weight:900; padding:12px 8px;">
                  MARTES
                </th>
                <th id={`${id}Th-2`} style="width:17.2%; border-right:1.5px solid var(--ink); text-align:center; font-family:var(--mono); font-size:12px; font-weight:900; padding:12px 8px;">
                  MIÉRCOLES
                </th>
                <th id={`${id}Th-3`} style="width:17.2%; border-right:1.5px solid var(--ink); text-align:center; font-family:var(--mono); font-size:12px; font-weight:900; padding:12px 8px;">
                  JUEVES
                </th>
                <th id={`${id}Th-4`} style="width:17.2%; text-align:center; font-family:var(--mono); font-size:12px; font-weight:900; padding:12px 8px;">
                  VIERNES
                </th>
              </tr>
            </thead>
            <tbody id={`${id}Tbody`}>
              <!-- Renderizado dinámicamente -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- CARTEL INFORMATIVO AL PIE (COMUNICACIÓN INSTITUCIONAL) -->
      <!-- ============================================================ -->
      <div id={`${id}FooterStatusNotice`} style="border:1.5px dashed var(--ink); background:#FAF8F5; padding:12px 18px; font-size:12px; color:var(--ink-soft); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
        <!-- Llenado dinámicamente -->
      </div>

    </div>

    <!-- FOOTER CON RESUMEN -->
    <div style="display:flex; justify-content:space-between; align-items:center; padding:14px 22px; border-top:2px solid var(--ink); background:var(--paper); flex-shrink:0;">
      <div id={`${id}TotalHoursLabel`} style="font-family:var(--mono); font-size:12px; font-weight:900; color:var(--ink);">
        Carga total: 0 horas lectivas / semana
      </div>

      <button type="button" class="btn btn-secondary btn-sm" onclick={`document.getElementById('${id}').style.display='none';`} style="font-weight:800; font-size:11px;">
        Cerrar Horario
      </button>
    </div>

  </div>
</div>


<script>
  import { scheduleService } from '../../../services/scheduleService';

  function getModalId(): string {
    const modal = document.querySelector('[data-teacher-schedule-modal]') as HTMLElement || document.getElementById('TeacherScheduleModal');
    return modal ? modal.id : 'TeacherScheduleModal';
  }

  const daysMap = ['DOMINGO', 'LUNES', 'MARTES', 'MIÉRCOLES', 'JUEVES', 'VIERNES', 'SÁBADO'];
  const weekdayIndexMap: Record<string, number> = { 'LUNES': 0, 'MARTES': 1, 'MIÉRCOLES': 2, 'JUEVES': 3, 'VIERNES': 4 };

  function timeToMinutes(timeStr: string) {
    if (!timeStr) return 0;
    const parts = timeStr.trim().split(':');
    return (parseInt(parts[0], 10) || 0) * 60 + (parseInt(parts[1], 10) || 0);
  }

  function formatTime(d: Date) {
    const hh = String(d.getHours()).padStart(2, '0');
    const mm = String(d.getMinutes()).padStart(2, '0');
    return `${hh}:${mm}`;
  }

  function escapeHtmlText(str: any) {
    return String(str || '').replace(/[&<>"']/g, function(char) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char] as string;
    });
  }

  function escapeHtmlAttr(str: any) {
    return String(str || '').replace(/"/g, '&quot;');
  }

  (window as any).openTeacherScheduleModal = async function(teacher: any, schoolId?: string) {
    if (!teacher) return;
    const modalId = getModalId();
    const modal = document.getElementById(modalId);
    if (!modal) return;

    const summary = document.getElementById(modalId + 'TeacherSummary');
    const liveClockTime = document.getElementById(modalId + 'LiveClockTime');
    const radarBanner = document.getElementById(modalId + 'LiveRadarBanner');
    const classroomsGrid = document.getElementById(modalId + 'ClassroomsSummaryGrid');
    const salonsCountLabel = document.getElementById(modalId + 'SalonsCountLabel');
    const tbody = document.getElementById(modalId + 'Tbody');
    const hoursLabel = document.getElementById(modalId + 'TotalHoursLabel');
    const topHoursBadge = document.getElementById(modalId + 'TopHoursBadge');

    function getActiveTenantSchoolId(): string {
      try {
        const user = JSON.parse(localStorage.getItem('schoolos-user') || '{}');
        if (user.schoolId) return user.schoolId;
      } catch (_) {}
      return (window as any).SchoolOSApp?.currentSchoolId || (window as any)._currentTenantSchoolId || localStorage.getItem('schoolos_tenant_id') || localStorage.getItem('schoolos_tenant_slug') || '';
    }

    const sId = schoolId || getActiveTenantSchoolId();
    const isDirector = (teacher.jobTitle || '').startsWith('Director de Grupo');

    const now = new Date();
    const currentDayName = daysMap[now.getDay()];
    const currentWeekdayIdx = weekdayIndexMap[currentDayName] !== undefined ? weekdayIndexMap[currentDayName] : -1;
    const currentMinutes = now.getHours() * 60 + now.getMinutes();

    if (liveClockTime) {
      liveClockTime.textContent = `${currentDayName.substring(0, 3)} ${formatTime(now)}`;
    }

    if (summary) {
      summary.innerHTML = `
        <div style="width:46px; height:46px; border:2px solid var(--ink); background:#FFFFFF; display:flex; align-items:center; justify-content:center; flex-shrink:0; overflow:hidden; box-shadow:2px 2px 0 var(--ink);">
          <img src="${escapeHtmlAttr(teacher.avatarUrl || '/avatars/women/fila-2-columna-1.png')}" alt="" style="width:100%; height:100%; object-fit:contain;" />
        </div>
        <div>
          <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
            <h2 style="font-family:var(--serif); font-size:19px; margin:0; font-weight:800; color:var(--ink);">
              ${escapeHtmlText(teacher.name)}
            </h2>
            <span class="plan-tag" style="background:var(--ink); color:#FFFFFF; font-size:10px; font-weight:900;">
              CÓDIGO: ${escapeHtmlText(teacher.documentId || 'DOC')}
            </span>
            ${isDirector ? `<span class="plan-tag" style="background:var(--rust); color:#FFFFFF; border-color:var(--rust); font-size:10px; font-weight:900;">${escapeHtmlText(teacher.jobTitle.toUpperCase())}</span>` : ''}
          </div>
          <div style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft); margin-top:2px;">
            Especialidad: <strong>${escapeHtmlText(teacher.specialty || 'Docente')}</strong> · Correo: <strong>${escapeHtmlText(teacher.email)}</strong>
          </div>
        </div>
      `;
    }

    if (classroomsGrid) {
      classroomsGrid.innerHTML = '<div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">Cargando salones a cargo...</div>';
    }
    if (tbody) {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:35px; font-family:var(--mono); font-size:12px; color:var(--ink-soft);">Cargando horario semanal...</td></tr>';
    }

    modal.style.display = 'flex';

    try {
      const res = await scheduleService.getTeacherSchedule(teacher.id, sId);
      const dbSlots = res.slots || [];
      const dbCourses = res.courses || [];
      const dbClasses = res.classes || [];

      const slots = (dbSlots && dbSlots.length > 0) ? dbSlots.map((s: any) => ({
        id: s.slot_id || s.id,
        name: s.name,
        startTime: s.start_time,
        endTime: s.end_time,
        isBreak: s.is_break === true
      })) : [];

      const coursesMap = new Map((dbCourses || []).map((c: any) => [c.id, c]));
      const teacherClasses = (dbClasses || []).filter((cls: any) => cls.teacher_id === teacher.id);

      const assignments: any[] = [];
      const roomsMap: Record<string, number> = {};

      teacherClasses.forEach((asg: any) => {
        const cInfo: any = coursesMap.get(asg.course_id) || {};
        assignments.push({
          id: asg.id,
          classroom: asg.classroom,
          day: (asg.day_of_week || '').toUpperCase(),
          slotId: asg.slot_id,
          subjectName: cInfo.name || 'Materia General',
          subjectCode: cInfo.code || 'MAT',
          roomLocation: asg.room_location || ('Salón ' + asg.classroom)
        });

        if (asg.classroom) {
          roomsMap[asg.classroom] = (roomsMap[asg.classroom] || 0) + 1;
        }
      });

      const totalHours = assignments.length;
      if (hoursLabel) hoursLabel.textContent = `${totalHours} horas semanales`;
      if (topHoursBadge) topHoursBadge.textContent = `${totalHours} Horas Asignadas`;

      const distinctRooms = Object.keys(roomsMap);
      if (salonsCountLabel) {
        salonsCountLabel.textContent = `${distinctRooms.length} salones diferentes`;
      }

      if (classroomsGrid) {
        if (distinctRooms.length === 0) {
          classroomsGrid.innerHTML = '<div style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft); grid-column:span 4;">No tiene salones asignados en este ciclo académico.</div>';
        } else {
          classroomsGrid.innerHTML = distinctRooms.map((room) => `
            <div style="background:#FFFFFF; border:1.5px solid var(--ink); padding:8px 12px; display:flex; justify-content:space-between; align-items:center;">
              <div>
                <div style="font-family:var(--mono); font-size:12px; font-weight:900; color:var(--ink);">SALÓN ${escapeHtmlText(room)}</div>
                <div style="font-size:10.5px; color:var(--ink-soft);">${roomsMap[room]} hora(s) / semana</div>
              </div>
              <span class="badge badge-active" style="font-size:9.5px; padding:2px 6px;">Vigente</span>
            </div>
          `).join('');
        }
      }

      let activeNowAssignment: any = null;
      let activeNowSlot: any = null;

      if (currentWeekdayIdx >= 0) {
        slots.forEach((s: any) => {
          const sMin = timeToMinutes(s.startTime);
          const eMin = timeToMinutes(s.endTime);
          if (currentMinutes >= sMin && currentMinutes < eMin) {
            activeNowSlot = s;
            activeNowAssignment = assignments.find((a: any) => a.day === currentDayName && a.slotId === s.id);
          }
        });
      }

      if (radarBanner) {
        if (currentWeekdayIdx < 0) {
          radarBanner.innerHTML = `
            <div style="display:flex; align-items:center; gap:10px;">
              <span style="font-size:18px;">💤</span>
              <div>
                <div style="font-weight:800; font-size:12.5px; color:var(--ink);">Fin de Semana — Fuera de Jornada Académica</div>
                <div style="font-size:11px; color:var(--ink-soft);">El sistema de radar en tiempo real se reactiva el lunes a primera hora.</div>
              </div>
            </div>
          `;
        } else if (!activeNowSlot) {
          radarBanner.innerHTML = `
            <div style="display:flex; align-items:center; gap:10px;">
              <span style="font-size:18px;">☕</span>
              <div>
                <div style="font-weight:800; font-size:12.5px; color:var(--ink);">Fuera de Bloques de Clase</div>
                <div style="font-size:11px; color:var(--ink-soft);">El docente no está en ningún bloque programado en este momento exacto.</div>
              </div>
            </div>
          `;
        } else if (activeNowSlot.isBreak) {
          radarBanner.innerHTML = `
            <div style="display:flex; align-items:center; gap:10px;">
              <span style="font-size:18px;">🥐</span>
              <div>
                <div style="font-weight:800; font-size:12.5px; color:var(--rust);">Hora de Descanso / Receso Institucional</div>
                <div style="font-size:11px; color:var(--ink-soft);">Período de receso (${activeNowSlot.startTime} - ${activeNowSlot.endTime}).</div>
              </div>
            </div>
          `;
        } else if (activeNowAssignment) {
          radarBanner.innerHTML = `
            <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; justify-content:space-between; width:100%;">
              <div style="display:flex; align-items:center; gap:10px;">
                <span class="live-radar-dot"></span>
                <div>
                  <div style="font-weight:900; font-size:13px; color:var(--rust);">
                    EN CLASE AHORA: ${escapeHtmlText(activeNowAssignment.subjectName)}
                  </div>
                  <div style="font-family:var(--mono); font-size:11px; color:var(--ink); margin-top:2px;">
                    Ubicación actual: <strong>SALÓN ${escapeHtmlText(activeNowAssignment.classroom)}</strong> (${escapeHtmlText(activeNowAssignment.roomLocation)})
                  </div>
                </div>
              </div>
              <span class="plan-tag" style="background:var(--rust); color:#FFFFFF; font-size:10px; font-weight:900;">
                BLOQUE ${escapeHtmlText(activeNowSlot.name)} (${activeNowSlot.startTime} - ${activeNowSlot.endTime})
              </span>
            </div>
          `;
        } else {
          radarBanner.innerHTML = `
            <div style="display:flex; align-items:center; gap:10px;">
              <span style="font-size:18px;">📖</span>
              <div>
                <div style="font-weight:800; font-size:12.5px; color:var(--ink);">Hora Libre / Planificación Pedagógica</div>
                <div style="font-size:11px; color:var(--ink-soft);">El docente no tiene clase asignada en el bloque actual (${activeNowSlot.name}). Disponible para atención.</div>
              </div>
            </div>
          `;
        }
      }

      const days = ['LUNES', 'MARTES', 'MIÉRCOLES', 'JUEVES', 'VIERNES'];
      for (let d = 0; d < 5; d++) {
        const th = document.getElementById(`${modalId}Th-${d}`);
        if (th) {
          if (d === currentWeekdayIdx) {
            th.style.background = 'var(--ink)';
            th.style.color = '#FFFFFF';
            th.innerHTML = `${days[d]} <span style="background:var(--rust); color:#FFFFFF; font-size:9px; padding:1px 5px; font-weight:900; margin-left:4px;">HOY</span>`;
          } else {
            th.style.background = 'var(--cream)';
            th.style.color = 'var(--ink)';
            th.textContent = days[d];
          }
        }
      }

      tbody.innerHTML = slots.map(function(slot: any) {
        const isBreak = slot.isBreak === true;
        const sMin = timeToMinutes(slot.startTime);
        const eMin = timeToMinutes(slot.endTime);
        const isCurrentTimeSlot = currentMinutes >= sMin && currentMinutes < eMin;

        if (isBreak) {
          return `
            <tr style="background:#FAF5ED; border-top:2px solid var(--ink); border-bottom:2px solid var(--ink);">
              <td style="text-align:center; padding:10px 8px; border-right:2px solid var(--ink); font-family:var(--mono); font-size:11px; font-weight:900; color:var(--rust);">
                ${slot.startTime} - ${slot.endTime}
              </td>
              <td colspan="5" style="text-align:center; padding:10px; font-family:var(--mono); font-size:11.5px; font-weight:900; letter-spacing:0.08em; text-transform:uppercase; color:var(--rust);">
                — ${escapeHtmlText(slot.name)} (${slot.startTime} - ${slot.endTime}) —
              </td>
            </tr>
          `;
        }

        const dayCells = days.map(function(dayName, dIdx) {
          const found = assignments.find(function(a: any) {
            return a.day === dayName && a.slotId === slot.id;
          });

          const isCellLiveNow = (dIdx === currentWeekdayIdx && isCurrentTimeSlot);

          if (found) {
            return `
              <td style="border-right:1.5px solid var(--ink); border-bottom:1.5px solid var(--ink); padding:6px; vertical-align:top; background:${isCellLiveNow ? '#FFF8E8' : '#FFFFFF'};">
                <div style="background:#FFFFFF; border:${isCellLiveNow ? '2.5px solid var(--rust)' : '1.5px solid var(--ink)'}; box-shadow:${isCellLiveNow ? '4px 4px 0 var(--rust)' : '2.5px 2.5px 0 var(--ink)'}; padding:8px 10px; display:flex; flex-direction:column; gap:4px;">
                  ${isCellLiveNow ? `<div style="background:var(--rust); color:#FFFFFF; font-family:var(--mono); font-size:9px; font-weight:900; padding:2px 6px; text-transform:uppercase; display:inline-block; margin-bottom:2px;">● EN CURSO AHORA</div>` : ''}
                  <div style="display:flex; justify-content:space-between; align-items:center; gap:4px;">
                    <span style="font-family:var(--mono); font-size:11.5px; font-weight:900; background:var(--cream); color:var(--rust); border:1px solid var(--ink); padding:2px 7px;">
                      SALÓN ${escapeHtmlText(found.classroom)}
                    </span>
                    <span style="font-family:var(--mono); font-size:9.5px; font-weight:900; background:var(--ink); color:#FFFFFF; padding:2px 6px;">
                      ${escapeHtmlText(found.subjectCode)}
                    </span>
                  </div>
                  <div style="font-weight:800; font-size:13px; color:var(--ink); line-height:1.2; margin-top:2px;">
                    ${escapeHtmlText(found.subjectName)}
                  </div>
                  <div style="border-top:1px dashed var(--line); padding-top:4px; margin-top:2px; font-family:var(--mono); font-size:10px; color:var(--ink-soft); display:flex; justify-content:space-between; align-items:center;">
                    <span>${escapeHtmlText(found.roomLocation || `Aula ${found.classroom}`)}</span>
                    <span style="font-weight:800; color:var(--ink);">${dayName.substring(0, 3)}</span>
                  </div>
                </div>
              </td>
            `;
          }

          return `
            <td style="border-right:1.5px solid var(--ink); border-bottom:1.5px solid var(--ink); padding:6px; vertical-align:middle; text-align:center; background:${isCellLiveNow ? '#FFF8F0' : '#FAF8F5'};">
              <span style="font-family:var(--mono); font-size:10px; color:#A09B90; font-style:italic;">
                ${isCellLiveNow ? '— Libre Ahora —' : '— Libre —'}
              </span>
            </td>
          `;
        }).join('');

        return `
          <tr style="border-bottom:1.5px solid var(--ink);">
            <td style="text-align:center; padding:10px 8px; border-right:2px solid var(--ink); background:${isCurrentTimeSlot ? 'var(--paper)' : 'var(--cream)'}; vertical-align:middle;">
              <div style="font-family:var(--mono); font-size:11.5px; font-weight:900; color:var(--ink);">
                ${escapeHtmlText(slot.name)}
              </div>
              <div style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink-soft); margin-top:2px;">
                ${slot.startTime} - ${slot.endTime}
              </div>
              ${isCurrentTimeSlot ? `<span style="background:var(--rust); color:#FFFFFF; font-family:var(--mono); font-size:8.5px; font-weight:900; padding:1px 4px; border-radius:2px; display:inline-block; margin-top:4px;">BLOQUE ACTUAL</span>` : ''}
            </td>
            ${dayCells}
          </tr>
        `;
      }).join('');

    } catch (err) {
      console.error('Error cargando horario del docente:', err);
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:30px; color:var(--rust);">Error al consultar el horario del docente.</td></tr>';
    }
  };
</script>