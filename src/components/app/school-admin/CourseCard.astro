---
// ============================================================
// SchoolOS — Tarjeta de Curso para Directorio Escolar
// ============================================================
import type { Lang } from '../../../i18n';
import type { Course } from '../../../types/academic';

interface Props {
  course: Course;
  lang?: Lang;
}

const { course, lang = 'es' } = Astro.props;
const occupancyPercent = Math.round((course.studentCount / course.maxCapacity) * 100);
---

<div style="background:var(--paper); border:1px solid var(--ink); display:flex; flex-direction:column; justify-content:space-between; box-shadow: 4px 4px 0 rgba(18, 17, 14, 0.08); transition:transform 0.15s ease, box-shadow 0.15s ease;">
  <!-- HEADER -->
  <div style="padding:18px 20px; border-bottom:1px solid var(--line);">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
      <span class="plan-tag" style="font-size:10px; font-weight:700;">{course.level}</span>
      <span class="badge badge-active" style="font-size:9.5px;">{course.status.toUpperCase()}</span>
    </div>

    <h3 style="font-family:var(--serif); font-size:18px; font-weight:700; color:var(--ink); margin:0 0 6px 0; line-height:1.25;">
      <a href={`/${lang}/app/school-admin/courses/${course.id}`} style="color:inherit; text-decoration:none;">
        {course.name}
      </a>
    </h3>
    <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">
      {course.subject} · {course.schedule}
    </div>
  </div>

  <!-- BODY: TEACHER & STATS -->
  <div style="padding:14px 20px; background:var(--cream); flex:1; display:flex; flex-direction:column; gap:12px;">
    <!-- Teacher Assigned -->
    <div style="display:flex; align-items:center; gap:8px;">
      <div style="width:22px; height:22px; background:var(--ink); color:#FFFFFF; font-family:var(--mono); font-size:10px; font-weight:700; display:flex; align-items:center; justify-content:center;">
        {course.teacherNames[0]?.split(' ').map((n: string) => n[0]).join('').slice(0, 2) || 'DC'}
      </div>
      <div style="font-size:12px; font-weight:600; color:var(--ink);">
        {course.teacherNames.join(', ')}
      </div>
    </div>

    <!-- Student Occupancy -->
    <div>
      <div style="display:flex; justify-content:space-between; font-family:var(--mono); font-size:11px; margin-bottom:4px;">
        <span style="color:var(--ink-soft);">{lang === 'es' ? 'Matrícula' : 'Enrolled'}</span>
        <span style="font-weight:700; color:var(--ink);">{course.studentCount} / {course.maxCapacity} {lang === 'es' ? 'alumnos' : 'students'}</span>
      </div>
      <div style="width:100%; height:5px; background:var(--line-strong); overflow:hidden;">
        <div style={`width:${occupancyPercent}%; height:100%; background:var(--rust);`}></div>
      </div>
    </div>

    <!-- Metrics Row -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; padding-top:4px; border-top:1px dashed var(--line); font-family:var(--mono); font-size:10.5px;">
      <div>
        <span style="color:var(--ink-soft);">{lang === 'es' ? 'Guías:' : 'Guides:'} </span>
        <strong style="color:var(--ink);">{course.guidesCount}</strong>
      </div>
      <div style="text-align:right;">
        <span style="color:var(--ink-soft);">{lang === 'es' ? 'Promedio:' : 'Avg:'} </span>
        <strong style="color:var(--rust);">{course.averageGrade} / 10</strong>
      </div>
    </div>
  </div>

  <!-- FOOTER ACTION -->
  <div style="padding:10px 20px; background:var(--paper); border-top:1px solid var(--line); display:flex; justify-content:space-between; align-items:center;">
    <span style="font-family:var(--mono); font-size:10px; color:var(--ink-soft);">{course.period}</span>
    <a href={`/${lang}/app/school-admin/courses/${course.id}`} class="btn btn-secondary btn-sm" style="font-size:11px; padding:4px 10px;">
      {lang === 'es' ? 'Ver Ficha →' : 'View Course →'}
    </a>
  </div>
</div>
