---
// ============================================================
// SchoolOS — Wizard Directivo de Registro de Docente
// Distribución Proporcional / Sin Emojis / Estilo Editorial
// ============================================================
import type { Lang } from '../../../i18n';
import type { SubjectDepartment } from '../../../types/academic';

interface Props {
  id?: string;
  lang?: Lang;
  departments?: SubjectDepartment[];
}

const { id = 'teacherRegisterModal', lang = 'es', departments = [] } = Astro.props;

const isEs = lang === 'es';

// Avatares provistos en public/avatars/
