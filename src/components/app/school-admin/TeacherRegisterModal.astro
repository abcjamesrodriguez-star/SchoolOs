---
// ============================================================
// SchoolOS — Modal de Vinculación y Edición Docente (MVP)
// Con Selección de Avatar por Género, Director de Grupo y Cero Emojis
// ============================================================
import type { Lang } from '../../../i18n';
import AvatarPickerModal from './AvatarPickerModal.astro';

interface Props {
  id?: string;
  lang?: Lang;
  schoolId?: string;
}

const { id = 'teacherRegisterModal', lang = 'es', schoolId } = Astro.props;
---

<div
  id={id}
  class="custom-modal-backdrop teacher-register-modal"
  style="display:none; position:fixed; inset:0; background:rgba(18, 17, 14, 0.75); z-index:9999; align-items:center; justify-content:center; padding:20px; overflow-y:auto;"
  role="dialog"
  aria-modal="true"
>
  <div class="panel" style="width:100%; max-width:700px; background:var(--paper); border:2px solid var(--ink); box-shadow:8px 8px 0 rgba(18, 17, 14, 0.35); max-height:90vh; display:flex; flex-direction:column; overflow:hidden;">
    
    <!-- HEADER -->
    <div class="panel-header" style="display:flex; justify-content:space-between; align-items:center; padding:14px 20px; background:var(--cream); border-bottom:2px solid var(--ink); flex-shrink:0;">
      <div style="display:flex; align-items:center; gap:8px;">
        <span class="plan-tag" style="background:var(--ink); color:#FFFFFF; border-color:var(--ink); font-size:10px; font-weight:900;">
          PLANTA DOCENTE
        </span>
        <h2 id={`${id}ModalTitle`} style="font-family:var(--serif); font-size:16.5px; margin:0; font-weight:700; color:var(--ink);">
          Vinculación Oficial de Docente
        </h2>
      </div>

      <button type="button" class="close-modal-btn" onclick={`document.getElementById('${id}').style.display='none';`} style="background:none; border:none; font-family:var(--mono); font-size:18px; font-weight:700; cursor:pointer; color:var(--ink);">✕</button>
    </div>

    <!-- FEEDBACK ALERT -->
    <div id={`${id}Feedback`} style="display:none; padding:12px 20px; font-family:var(--mono); font-size:12px; font-weight:700;"></div>

    <!-- BODY WITH SCROLL -->
    <div class="panel-body padded" style="background:#FFFDF9; padding:20px; overflow-y:auto; flex:1;">
      
      <form id={`${id}Form`}>
        <input type="hidden" id={`${id}TeacherId`} value="" />
        <input type="hidden" id={`${id}SchoolId`} value={schoolId || ''} />
        <input type="hidden" id={`${id}AvatarUrl`} value="/avatars/men/fila-2-columna-1.png" />
        
        <!-- SECCIÓN 1: IDENTIDAD DOCENTE & AVATAR -->
        <div style="background:var(--cream); border:1.5px solid var(--ink); padding:16px; margin-bottom:16px; box-shadow:2px 2px 0 var(--ink);">
          <div style="font-family:var(--mono); font-size:10.5px; font-weight:800; text-transform:uppercase; color:var(--rust); margin-bottom:12px; display:flex; align-items:center; gap:6px;">
            <span>01 ·</span> Identificación Personal & Avatar Institucional
          </div>

          <div style="display:grid; grid-template-columns: 100px 1fr; gap:16px; align-items:start;">
            <!-- Avatar Box -->
            <div style="display:flex; flex-direction:column; align-items:center; gap:6px;">
              <div
                id={`${id}AvatarPreview`}
                style="width:84px; height:84px; border:2px solid var(--ink); background:#FFFFFF; display:flex; align-items:center; justify-content:center; overflow:hidden; box-shadow:2px 2px 0 var(--ink);"
              >
                <img id={`${id}AvatarImg`} src="/avatars/men/fila-2-columna-1.png" alt="Avatar Docente" style="width:100%; height:100%; object-fit:contain;" />
              </div>
              <button
                type="button"
                id={`${id}BtnChangeAvatar`}
                class="btn btn-secondary btn-sm"
                onclick={`window.openAvatarPicker && window.openAvatarPicker('${id}AvatarPickerModal', document.getElementById('${id}Gender')?.value || 'Hombre', '${id}AvatarUrl', '${id}AvatarImg');`}
                style="font-size:9.5px; font-weight:800; padding:4px 6px; width:100%; text-align:center;"
              >
                Elegir Avatar
              </button>
            </div>

            <!-- Datos Principales -->
            <div style="display:grid; grid-template-columns: 1.4fr 1fr; gap:12px;">
              <div style="grid-column: span 2;">
                <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; display:block; margin-bottom:4px; text-transform:uppercase;">
                  Nombre Completo del Docente *
                </label>
                <input type="text" id={`${id}Name`} required placeholder="Ej: Lic. Andrés Felipe Cárdenas" style="width:100%; border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-size:13px;" />
              </div>

              <div>
                <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:4px;">
                  <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; text-transform:uppercase;">
                    Código Docente *
                  </label>
                  <button
                    type="button"
                    onclick={`
                      var codeInput = document.getElementById('${id}TeacherCode');
                      if (codeInput) {
                        var rand = Math.floor(100 + Math.random() * 900);
                        codeInput.value = 'DOC-2026-' + rand;
                      }
                    `}
                    style="background:none; border:none; color:var(--rust); font-family:var(--mono); font-size:10px; font-weight:800; cursor:pointer; text-decoration:underline;"
                  >
                    Generar ⟳
                  </button>
                </div>
                <div style="display:flex; gap:4px;">
                  <input
                    type="text"
                    id={`${id}TeacherCode`}
                    required
                    placeholder="DOC-2026-015"
                    style="width:100%; border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-size:12.5px; font-family:var(--mono); font-weight:700;"
                  />
                </div>
                <div style="font-size:10px; color:var(--ink-soft); margin-top:2px;">
                  Generado automáticamente (configurable).
                </div>
              </div>

              <div>
                <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; display:block; margin-bottom:4px; text-transform:uppercase;">
                  Género *
                </label>
                <select
                  id={`${id}Gender`}
                  onchange={`
                    var g = this.value;
                    var defaultImg = g === 'Mujer' ? '/avatars/women/fila-2-columna-1.png' : '/avatars/men/fila-2-columna-1.png';
                    document.getElementById('${id}AvatarUrl').value = defaultImg;
                    document.getElementById('${id}AvatarImg').src = defaultImg;
                  `}
                  style="width:100%; border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-size:12.5px; font-family:var(--mono); font-weight:700;"
                >
                  <option value="Hombre" selected>Masculino</option>
                  <option value="Mujer">Femenino</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <!-- SECCIÓN 2: ESPECIALIDAD, DIRECCIÓN DE GRUPO & JORNADA -->
        <div style="background:var(--cream); border:1.5px solid var(--ink); padding:16px; margin-bottom:16px; box-shadow:2px 2px 0 var(--ink);">
          <div style="font-family:var(--mono); font-size:10.5px; font-weight:800; text-transform:uppercase; color:var(--rust); margin-bottom:12px; display:flex; align-items:center; gap:6px;">
            <span>02 ·</span> Especialidad Académica, Cargo & Dirección de Grupo
          </div>

          <div style="display:grid; grid-template-columns: 1.2fr 1fr; gap:12px; margin-bottom:12px;">
            <div>
              <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; display:block; margin-bottom:4px; text-transform:uppercase;">
                Área / Departamento Curricular *
              </label>
              <select id={`${id}Specialty`} style="width:100%; border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-size:12px; font-family:var(--mono); font-weight:700;">
                <option value="Ciencias Naturales y Educación Ambiental" selected>Ciencias Naturales y Educación Ambiental</option>
                <option value="Matemáticas y Geometría">Matemáticas y Geometría</option>
                <option value="Lengua Castellana y Literatura">Lengua Castellana y Literatura</option>
                <option value="Idioma Extranjero (Inglés)">Idioma Extranjero (Inglés)</option>
                <option value="Ciencias Sociales, Historia y Geografía">Ciencias Sociales, Historia y Geografía</option>
                <option value="Educación Artística y Cultura">Educación Artística y Cultura</option>
                <option value="Educación Física, Recreación y Deportes">Educación Física, Recreación y Deportes</option>
                <option value="Tecnología e Informática">Tecnología e Informática</option>
                <option value="Filosofía y Ética">Filosofía y Ética</option>
                <option value="Educación Religiosa">Educación Religiosa</option>
              </select>
            </div>

            <div>
              <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; display:block; margin-bottom:4px; text-transform:uppercase;">
                Director de Grupo / Titular
              </label>
              <select id={`${id}HomeroomGroup`} style="width:100%; border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-size:12px; font-family:var(--mono); font-weight:700;">
                <option value="none" selected>Ninguno (Docente de Área)</option>
                <!-- Salones cargados dinámicamente -->
              </select>
            </div>
          </div>

          <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
            <div>
              <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; display:block; margin-bottom:4px; text-transform:uppercase;">
                Jornada Laboral *
              </label>
              <select id={`${id}Shift`} style="width:100%; border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-size:12px; font-family:var(--mono);">
                <option value="Mañana" selected>Mañana</option>
                <option value="Tarde">Tarde</option>
                <option value="Única">Jornada Completa / Única</option>
                <option value="Nocturna">Nocturna</option>
              </select>
            </div>

            <div>
              <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; display:block; margin-bottom:4px; text-transform:uppercase;">
                Teléfono / WhatsApp Docente
              </label>
              <input type="tel" id={`${id}Phone`} placeholder="+57 300 123 4567" style="width:100%; border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-size:12.5px; font-family:var(--mono);" />
            </div>
          </div>
        </div>

        <!-- SECCIÓN 3: CORREO DE ACCESO & ACTIVACIÓN JWT -->
        <div style="background:var(--cream); border:1.5px solid var(--ink); padding:16px; margin-bottom:20px; box-shadow:2px 2px 0 var(--ink);">
          <div style="font-family:var(--mono); font-size:10.5px; font-weight:800; text-transform:uppercase; color:var(--rust); margin-bottom:10px; display:flex; align-items:center; gap:6px;">
            <span>03 ·</span> Cuenta Institucional & Invitación Segura (JWT)
          </div>

          <div>
            <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; display:block; margin-bottom:4px; text-transform:uppercase;">
              Correo Electrónico Institucional de Acceso *
            </label>
            <input type="email" id={`${id}Email`} required placeholder="profesor@colegio.edu.co" style="width:100%; border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-size:12.5px; font-family:var(--mono);" />
          </div>

          <div style="font-size:11.5px; color:var(--ink-soft); line-height:1.45; margin-top:8px;">
            Al vincular al docente se despachará automáticamente un <strong>correo con token JWT de 48 horas</strong> para que el profesor confirme su código docente y cree su contraseña personal.
          </div>
        </div>

        <!-- FOOTER ACTIONS -->
        <div style="display:flex; justify-content:space-between; align-items:center; border-top:1.5px solid var(--line); padding-top:16px;">
          <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">
            Las materias y horarios se asignan posteriormente en la Malla Curricular.
          </div>

          <div style="display:flex; gap:10px;">
            <button type="button" class="btn btn-secondary" onclick={`document.getElementById('${id}').style.display='none';`}>
              Cancelar
            </button>
            <button type="submit" id={`${id}SubmitBtn`} class="btn btn-primary" style="font-weight:800;">
              Vincular y Enviar Invitación
            </button>
          </div>
        </div>

      </form>
    </div>

  </div>
</div>

<AvatarPickerModal id={`${id}AvatarPickerModal`} />


<script>
  import { teacherService } from '../../../services/teacherService';
  import { courseManagementService } from '../../../services/courseManagementService';

  function getActiveTenantSchoolId(): string {
    try {
      const user = JSON.parse(localStorage.getItem('schoolos-user') || '{}');
      if (user.schoolId) return user.schoolId;
    } catch (_) {}
    return (window as any).SchoolOSApp?.currentSchoolId || (window as any)._currentTenantSchoolId || localStorage.getItem('schoolos_tenant_id') || localStorage.getItem('schoolos_tenant_slug') || '';
  }

  function getModalId(): string {
    const modal = document.querySelector('[data-teacher-register-modal]') as HTMLElement || document.getElementById('TeacherRegisterModal');
    return modal ? modal.id : 'TeacherRegisterModal';
  }

  async function loadHomeroomOptions(currentSchoolId?: string, selectedVal?: string) {
    try {
      const sId = currentSchoolId || getActiveTenantSchoolId();
      if (!sId) return;

      const res = await courseManagementService.getGradeCapacities(sId);
      const gradeCapacities = res.data || [];

      const modalId = getModalId();
      const select = document.getElementById(modalId + 'HomeroomGroup') as HTMLSelectElement;
      if (!select) return;

      let html = '<option value="none">Ninguno (Docente de Área)</option>';
      if (Array.isArray(gradeCapacities)) {
        gradeCapacities.forEach(function(g: any) {
          if (g.is_offered !== false && (g.sections_count || g.sectionsCount) > 0) {
            const count = g.sections_count || g.sectionsCount || 1;
            const gradeName = g.grade_level || g.gradeLevel || '';
            for (let i = 1; i <= count; i++) {
              const room = gradeName + '-' + i;
              html += '<option value="' + room + '">Director Salón ' + room + '</option>';
            }
          }
        });
      }
      select.innerHTML = html;
      if (selectedVal) {
        select.value = selectedVal;
      }
    } catch (err) {
      console.warn('Error cargando salones para director de grupo:', err);
    }
  }

  (window as any).openTeacherRegisterModal = function(customSchoolId?: string) {
    const modalId = getModalId();
    const modal = document.getElementById(modalId);
    if (!modal) return;

    const titleEl = document.getElementById(modalId + 'ModalTitle');
    const submitBtn = document.getElementById(modalId + 'SubmitBtn') as HTMLButtonElement;
    const teacherIdInput = document.getElementById(modalId + 'TeacherId') as HTMLInputElement;
    const codeInput = document.getElementById(modalId + 'TeacherCode') as HTMLInputElement;
    const nameInput = document.getElementById(modalId + 'Name') as HTMLInputElement;
    const emailInput = document.getElementById(modalId + 'Email') as HTMLInputElement;
    const phoneInput = document.getElementById(modalId + 'Phone') as HTMLInputElement;
    const schoolInput = document.getElementById(modalId + 'SchoolId') as HTMLInputElement;

    if (titleEl) titleEl.textContent = 'Vinculación Oficial de Docente';
    if (submitBtn) submitBtn.textContent = 'Vincular y Enviar Invitación';
    if (teacherIdInput) teacherIdInput.value = '';
    if (nameInput) nameInput.value = '';
    if (emailInput) emailInput.value = '';
    if (phoneInput) phoneInput.value = '';
    if (codeInput) {
      const rand = Math.floor(100 + Math.random() * 900);
      codeInput.value = 'DOC-2026-' + rand;
    }
    const sId = customSchoolId || getActiveTenantSchoolId();
    if (schoolInput) {
      schoolInput.value = sId;
    }

    loadHomeroomOptions(sId, 'none');
    modal.style.display = 'flex';
  };

  (window as any).openTeacherModal = function(teacherData: any) {
    const modalId = getModalId();
    const modal = document.getElementById(modalId);
    if (!modal) return;

    const titleEl = document.getElementById(modalId + 'ModalTitle');
    const submitBtn = document.getElementById(modalId + 'SubmitBtn') as HTMLButtonElement;
    const teacherIdInput = document.getElementById(modalId + 'TeacherId') as HTMLInputElement;
    const codeInput = document.getElementById(modalId + 'TeacherCode') as HTMLInputElement;
    const nameInput = document.getElementById(modalId + 'Name') as HTMLInputElement;
    const emailInput = document.getElementById(modalId + 'Email') as HTMLInputElement;
    const phoneInput = document.getElementById(modalId + 'Phone') as HTMLInputElement;
    const specialtySelect = document.getElementById(modalId + 'Specialty') as HTMLSelectElement;
    const avatarUrlInput = document.getElementById(modalId + 'AvatarUrl') as HTMLInputElement;
    const avatarImg = document.getElementById(modalId + 'AvatarImg') as HTMLImageElement;
    const schoolInput = document.getElementById(modalId + 'SchoolId') as HTMLInputElement;

    const sId = getActiveTenantSchoolId();
    if (schoolInput) schoolInput.value = sId;

    if (teacherData) {
      if (titleEl) titleEl.textContent = 'Editar Expediente Docente — ' + (teacherData.name || '');
      if (submitBtn) submitBtn.textContent = 'Guardar Cambios del Docente';
      if (teacherIdInput) teacherIdInput.value = teacherData.id || '';
      if (nameInput) nameInput.value = teacherData.name || '';
      if (emailInput) emailInput.value = teacherData.email || '';
      if (phoneInput) phoneInput.value = teacherData.phone || '';
      if (codeInput) codeInput.value = teacherData.documentId || teacherData.teacherCode || '';
      if (specialtySelect && teacherData.specialty) specialtySelect.value = teacherData.specialty;
      if (avatarUrlInput && teacherData.avatarUrl) avatarUrlInput.value = teacherData.avatarUrl;
      if (avatarImg && teacherData.avatarUrl) avatarImg.src = teacherData.avatarUrl;

      let homeroomVal = 'none';
      if (teacherData.jobTitle && teacherData.jobTitle.includes('Director de Grupo')) {
        homeroomVal = teacherData.jobTitle.replace('Director de Grupo', '').trim();
      }
      loadHomeroomOptions(sId, homeroomVal);
    }

    modal.style.display = 'flex';
  };

  document.addEventListener('DOMContentLoaded', () => {
    const modalId = getModalId();
    const form = document.getElementById(modalId + 'Form');
    const modal = document.getElementById(modalId);
    if (!form || !modal) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById(modalId + 'SubmitBtn') as HTMLButtonElement;
      const feedback = document.getElementById(modalId + 'Feedback');

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Guardando datos…';
      }
      if (feedback) {
        feedback.style.display = 'none';
        feedback.textContent = '';
      }

      try {
        const teacherId = (document.getElementById(modalId + 'TeacherId') as HTMLInputElement)?.value;
        const schoolId = (document.getElementById(modalId + 'SchoolId') as HTMLInputElement)?.value || getActiveTenantSchoolId();
        const name = (document.getElementById(modalId + 'Name') as HTMLInputElement)?.value.trim();
        const teacherCode = (document.getElementById(modalId + 'TeacherCode') as HTMLInputElement)?.value.trim();
        const email = (document.getElementById(modalId + 'Email') as HTMLInputElement)?.value.trim().toLowerCase();
        const avatarUrl = (document.getElementById(modalId + 'AvatarUrl') as HTMLInputElement)?.value;
        const specialty = (document.getElementById(modalId + 'Specialty') as HTMLSelectElement)?.value;
        const homeroomGroup = (document.getElementById(modalId + 'HomeroomGroup') as HTMLSelectElement)?.value;
        const phone = (document.getElementById(modalId + 'Phone') as HTMLInputElement)?.value.trim() || undefined;
        const jobTitle = (homeroomGroup && homeroomGroup !== 'none') ? ('Director de Grupo ' + homeroomGroup) : ('Docente de ' + specialty);

        if (!name || !email) throw new Error('Nombre y correo son obligatorios.');

        if (!teacherId) {
          if (submitBtn) submitBtn.textContent = 'Enviando invitación oficial…';
          await teacherService.createTeacher({
            email, name, schoolId, teacherCode, avatarUrl, specialty, jobTitle, phone
          });
        } else {
          if (submitBtn) submitBtn.textContent = 'Actualizando docente…';
          await teacherService.updateTeacher({
            teacherId, name, teacherCode, avatarUrl, specialty, jobTitle, phone
          });
        }

        if (feedback) {
          feedback.style.cssText = 'display:block; background:#E6F4EA; border-bottom:2px solid var(--sage-dark); color:var(--sage-dark); padding:12px 20px; font-family:var(--mono); font-size:12px; font-weight:700;';
          feedback.textContent = teacherId ? 'Docente actualizado correctamente.' : 'Docente vinculado e invitación despachada con éxito.';
        }

        if (submitBtn) {
          submitBtn.textContent = teacherId ? 'Cambios Guardados' : 'Docente Vinculado';
        }

        window.dispatchEvent(new CustomEvent('teacher:created', { detail: { ok: true, email } }));

        setTimeout(() => {
          modal.style.display = 'none';
          (form as HTMLFormElement).reset();
          if (feedback) feedback.style.display = 'none';
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Vincular y Enviar Invitación';
          }
          window.location.reload();
        }, 1000);

      } catch (err: any) {
        console.error('Error guardando docente:', err);
        if (feedback) {
          feedback.style.cssText = 'display:block; background:#FEE2E2; border-bottom:2px solid var(--danger); color:var(--danger); padding:12px 20px; font-family:var(--mono); font-size:12px; font-weight:700;';
          feedback.textContent = err?.message || 'Error al procesar docente';
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Reintentar Guardado';
        }
      }
    });
  });
</script>