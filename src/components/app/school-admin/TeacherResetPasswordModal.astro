---
// ============================================================
// SchoolOS — Modal de Restablecimiento Directo de Contraseña
// Para Directivos / Rectores en Gestión de Docentes
// Cero pérdida de datos: Actualiza Supabase Auth directamente
// ============================================================
interface Props {
  id?: string;
}

const { id = 'teacherResetPasswordModal' } = Astro.props;
---

<div
  id={id}
  data-modal-id={id}
  data-teacher-reset-password-modal
  class="custom-modal-backdrop"
  style="display:none; position:fixed; inset:0; background:rgba(18, 17, 14, 0.75); z-index:9999; align-items:center; justify-content:center; padding:20px; overflow-y:auto;"
  role="dialog"
  aria-modal="true"
  aria-labelledby={`${id}Title`}
>
  <div class="panel" style="width:100%; max-width:560px; background:var(--paper); border:2px solid var(--ink); box-shadow:8px 8px 0 var(--ink); max-height:90vh; display:flex; flex-direction:column; overflow:hidden;">
    
    <!-- HEADER -->
    <div class="panel-header" style="display:flex; justify-content:space-between; align-items:center; padding:14px 20px; background:var(--cream); border-bottom:2px solid var(--ink); flex-shrink:0;">
      <div style="display:flex; align-items:center; gap:8px;">
        <span class="plan-tag" style="background:var(--rust); color:#FFFFFF; border-color:var(--rust); font-size:10px; font-weight:900;">
          SEGURIDAD DE ACCESO
        </span>
        <h2 id={`${id}Title`} style="font-family:var(--serif); font-size:16.5px; margin:0; font-weight:700; color:var(--ink);">
          Restablecer Contraseña de Docente
        </h2>
      </div>
      <button
        type="button"
        onclick={`document.getElementById('${id}').style.display='none';`}
        style="background:none; border:none; font-family:var(--mono); font-size:18px; font-weight:700; cursor:pointer; color:var(--ink);"
        aria-label="Cerrar modal"
      >✕</button>
    </div>

    <!-- FEEDBACK ALERT -->
    <div id={`${id}Feedback`} style="display:none; padding:12px 20px; font-family:var(--sans); font-size:12px; font-weight:600; border-bottom:1.5px solid var(--ink);"></div>

    <!-- FORM -->
    <form id={`${id}Form`} style="display:flex; flex-direction:column; flex:1; overflow-y:auto; margin:0;">
      <div class="panel-body padded" style="background:#FFFDF9; padding:20px; overflow-y:auto; flex:1; display:flex; flex-direction:column; gap:16px;">
        
        <!-- FICHA RESUMEN DEL DOCENTE -->
        <div id={`${id}TeacherSummary`} style="background:#FFFFFF; border:1.5px solid var(--ink); padding:12px 16px; box-shadow:3px 3px 0 var(--ink); display:flex; align-items:center; gap:14px;">
          <!-- Se llena dinámicamente -->
        </div>

        <input type="hidden" id={`${id}TeacherId`} value="" />

        <!-- AVISO DE CERO PÉRDIDA DE DATOS -->
        <div style="background:var(--cream); border:1.5px solid var(--ink); padding:10px 14px; font-size:12px; color:var(--ink); line-height:1.45;">
          🛡️ <strong>Sin pérdida de datos:</strong> La clave se actualiza en tiempo real en Supabase Auth. Los cursos, evaluaciones, clases y calificaciones creadas por el docente se conservan al 100%.
        </div>

        <!-- CAMPO: NUEVA CONTRASEÑA -->
        <div class="form-field" style="margin-bottom:0;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
            <label style="font-family:var(--mono); font-size:11px; font-weight:800; text-transform:uppercase; color:var(--ink); margin:0;">
              Nueva Contraseña para el Docente *
            </label>
            <span style="font-family:var(--mono); font-size:10px; color:var(--ink-soft);">Mínimo 6 caracteres</span>
          </div>

          <div style="display:flex; gap:8px; align-items:stretch;">
            <input
              id={`${id}NewPassword`}
              type="text"
              required
              minlength="6"
              placeholder="Escribe o genera una clave..."
              style="flex:1; border:1.5px solid var(--ink); background:#FFFFFF; padding:8px 12px; font-family:var(--mono); font-size:13px; font-weight:700; color:var(--ink);"
            />
            <button
              type="button"
              id={`${id}BtnGenerate`}
              class="btn btn-secondary"
              style="font-size:11px; padding:0 12px; font-weight:800; white-space:nowrap; border:1.5px solid var(--ink); background:var(--cream); box-shadow:2px 2px 0 var(--ink); cursor:pointer;"
              title="Generar clave aleatoria segura"
            >
              🎲 Generar
            </button>
            <button
              type="button"
              id={`${id}BtnCopy`}
              class="btn btn-secondary"
              style="font-size:11px; padding:0 12px; font-weight:800; white-space:nowrap; border:1.5px solid var(--ink); background:var(--cream); box-shadow:2px 2px 0 var(--ink); cursor:pointer;"
              title="Copiar contraseña al portapapeles"
            >
              📋 Copiar
            </button>
          </div>
        </div>

        <!-- OPCIONES ADICIONALES -->
        <div>
          <label style="display:flex; align-items:flex-start; gap:8px; font-family:var(--sans); font-size:12px; color:var(--ink); cursor:pointer; font-weight:600;">
            <input id={`${id}RequireChange`} type="checkbox" style="accent-color:var(--rust); margin-top:2px;" />
            <span>Exigir al docente cambiar esta clave en su próximo inicio de sesión.</span>
          </label>
        </div>

        <!-- MOTIVO / OBSERVACIÓN -->
        <div class="form-field" style="margin-bottom:0;">
          <label style="font-family:var(--mono); font-size:10px; font-weight:700; text-transform:uppercase; color:var(--ink-soft); display:block; margin-bottom:4px;">
            Motivo / Justificación (Opcional)
          </label>
          <input
            id={`${id}Reason`}
            type="text"
            placeholder="Ej: Docente perdió su contraseña y solicitó recuperación a rectoría."
            style="width:100%; border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--sans); font-size:12px;"
          />
        </div>

      </div>

      <!-- FOOTER ACTIONS -->
      <div class="panel-footer" style="display:flex; justify-content:flex-end; gap:10px; padding:14px 20px; background:var(--cream); border-top:2px solid var(--ink); flex-shrink:0;">
        <button
          type="button"
          class="btn btn-secondary"
          onclick={`document.getElementById('${id}').style.display='none';`}
        >
          Cancelar
        </button>
        <button
          id={`${id}SubmitBtn`}
          type="submit"
          class="btn btn-primary"
          style="background:var(--rust); border-color:var(--ink); color:#FFFFFF; font-weight:800; box-shadow:3px 3px 0 var(--ink);"
        >
          🔑 Guardar y Aplicar Clave Ahora
        </button>
      </div>
    </form>
  </div>
</div>

<script define:vars={{ modalId: id }}>
(function() {
  function generateSecurePassword() {
    const words = ['Profe', 'Educa', 'Clase', 'Saber', 'Colegio'];
    const prefix = words[Math.floor(Math.random() * words.length)];
    const chars = '23456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz';
    let rand = '';
    for (let i = 0; i < 4; i++) {
      rand += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return `${prefix}!2026#${rand}`;
  }

  window._openTeacherResetPasswordModal = function(teacherIdxOrObj) {
    let teacher = null;
    if (typeof teacherIdxOrObj === 'object' && teacherIdxOrObj !== null) {
      teacher = teacherIdxOrObj;
    } else if (window.cachedTeachers && window.cachedTeachers[teacherIdxOrObj]) {
      teacher = window.cachedTeachers[teacherIdxOrObj];
    }

    if (!teacher) {
      alert('No se encontró el registro del docente.');
      return;
    }

    const modal = document.getElementById(modalId);
    if (!modal) return;

    document.getElementById(`${modalId}TeacherId`).value = teacher.id;
    document.getElementById(`${modalId}NewPassword`).value = generateSecurePassword();
    document.getElementById(`${modalId}RequireChange`).checked = false;
    document.getElementById(`${modalId}Reason`).value = 'Restablecimiento directo de contraseña por Rectoría.';

    const summary = document.getElementById(`${modalId}TeacherSummary`);
    if (summary) {
      summary.innerHTML = `
        <div style="width:40px; height:40px; border:1.5px solid var(--ink); background:#FFFFFF; display:flex; align-items:center; justify-content:center; overflow:hidden; flex-shrink:0;">
          <img src="${teacher.avatarUrl || '/avatars/women/fila-2-columna-1.png'}" alt="" style="width:100%; height:100%; object-fit:contain;" />
        </div>
        <div>
          <div style="font-weight:800; font-size:14px; color:var(--ink);">${teacher.name || 'Docente'}</div>
          <div style="font-family:var(--mono); font-size:11.5px; color:var(--rust); font-weight:700;">${teacher.email}</div>
          <div style="font-size:11px; color:var(--ink-soft); margin-top:2px;">
            ${teacher.specialty || 'Docente de Área'} · Documento: ${teacher.documentId || 'N/A'}
          </div>
        </div>
      `;
    }

    const feedback = document.getElementById(`${modalId}Feedback`);
    if (feedback) {
      feedback.style.display = 'none';
      feedback.textContent = '';
    }

    const submitBtn = document.getElementById(`${modalId}SubmitBtn`);
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = '🔑 Guardar y Aplicar Clave Ahora';
    }

    modal.style.display = 'flex';
  };

  document.addEventListener('DOMContentLoaded', () => {
    const btnGen = document.getElementById(`${modalId}BtnGenerate`);
    if (btnGen) {
      btnGen.addEventListener('click', () => {
        const inp = document.getElementById(`${modalId}NewPassword`);
        if (inp) inp.value = generateSecurePassword();
      });
    }

    const btnCopy = document.getElementById(`${modalId}BtnCopy`);
    if (btnCopy) {
      btnCopy.addEventListener('click', async () => {
        const inp = document.getElementById(`${modalId}NewPassword`);
        if (!inp || !inp.value) return;
        try {
          await navigator.clipboard.writeText(inp.value);
          const orig = btnCopy.textContent;
          btnCopy.textContent = '✓ Copiada';
          setTimeout(() => { btnCopy.textContent = orig; }, 1800);
        } catch (_) {
          inp.select();
          document.execCommand('copy');
        }
      });
    }

    const form = document.getElementById(`${modalId}Form`);
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const submitBtn = document.getElementById(`${modalId}SubmitBtn`);
        const feedback = document.getElementById(`${modalId}Feedback`);
        const teacherId = document.getElementById(`${modalId}TeacherId`)?.value;
        const newPassword = document.getElementById(`${modalId}NewPassword`)?.value?.trim();
        const requireChangeOnNextLogin = document.getElementById(`${modalId}RequireChange`)?.checked ?? true;
        const reason = document.getElementById(`${modalId}Reason`)?.value?.trim() || 'Restablecimiento directo de contraseña por Rectoría.';

        if (!teacherId || !newPassword || newPassword.length < 6) {
          if (feedback) {
            feedback.style.display = 'block';
            feedback.style.background = '#FEE2E2';
            feedback.style.color = 'var(--danger)';
            feedback.textContent = 'La contraseña debe tener mínimo 6 caracteres.';
          }
          return;
        }

        try {
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Actualizando en Supabase Auth…';
          }
          if (feedback) feedback.style.display = 'none';

          const res = await window.fetchAuth('/api/admin/reset-password', {
            method: 'POST',
            body: JSON.stringify({
              userId: teacherId,
              newPassword,
              requireChangeOnNextLogin,
              reason,
            }),
          });
          const data = await res.json();
          if (!data.ok) throw new Error(data.error || 'Error al actualizar la contraseña');

          try {
            await navigator.clipboard.writeText(newPassword);
          } catch (_) {}

          if (feedback) {
            feedback.style.display = 'block';
            feedback.style.background = '#E6F4EA';
            feedback.style.color = '#137333';
            feedback.innerHTML = `
              <div style="font-weight:800; font-size:13px; margin-bottom:4px;">
                ✓ ¡Contraseña Actualizada con Éxito en Supabase Auth!
              </div>
              <div style="font-size:11.5px; color:var(--ink); margin-bottom:6px;">
                Se actualizó el acceso del docente sin alterar ninguna de sus clases ni cursos.
              </div>
              <div style="background:#FFFFFF; border:1px solid var(--ink); padding:6px 10px; font-family:var(--mono); font-size:12.5px; font-weight:800; color:var(--rust); display:flex; justify-content:space-between; align-items:center;">
                <span>Clave: ${newPassword}</span>
                <span style="font-size:10px; color:#137333; font-weight:700;">✓ Copiada al portapapeles</span>
              </div>
            `;
          }

          if (submitBtn) submitBtn.textContent = '✓ Contraseña Guardada';

          setTimeout(() => {
            const modal = document.getElementById(modalId);
            if (modal) modal.style.display = 'none';
          }, 2400);

        } catch (err) {
          console.error('Error restableciendo contraseña:', err);
          if (feedback) {
            feedback.style.display = 'block';
            feedback.style.background = '#FEE2E2';
            feedback.style.color = 'var(--danger)';
            feedback.textContent = 'No fue posible actualizar la contraseña: ' + (err.message || 'Error del servidor');
          }
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = '🔑 Guardar y Aplicar Clave Ahora';
          }
        }
      });
    }
  });
})();
</script>
