---
import type { Lang } from '../../i18n';
import { useTranslations } from '../../i18n';

interface Props {
  activeSection: string;
  role?: 'super_admin' | 'school_admin' | 'teacher' | 'student';
  schoolName?: string;
  lang?: Lang;
}

const { activeSection, role = 'super_admin', schoolName = 'Colegio Norte', lang = 'es' } = Astro.props;
const t = useTranslations(lang).app.sidebar;

const isSchoolAdmin = role === 'school_admin';
const isTeacher = role === 'teacher';
---

<aside class="app-sidebar">
  <div class="brand">
    <a href={isTeacher ? `/${lang}/app/teacher` : isSchoolAdmin ? `/${lang}/app/school-admin` : `/${lang}/app/super-admin`}>
      School<span>OS</span>
    </a>
    <div class="brand-sub">{isTeacher ? schoolName.toUpperCase() : isSchoolAdmin ? schoolName.toUpperCase() : 'GOVERNANCE & AUDIT'}</div>
    <span class="role-tag">{isTeacher ? (lang === 'es' ? 'Docente' : 'Teacher') : isSchoolAdmin ? (lang === 'es' ? 'School Admin' : 'School Admin') : t.brandRole}</span>
  </div>

  <nav class="app-nav">
    {isTeacher ? (
      /* ── NAVEGACIÓN TEACHER (DOCENTE) ──────────────────────── */
      <>
        <div class="group-label">{lang === 'es' ? 'Mi Jornada' : 'My Day'}</div>

        <a href={`/${lang}/app/teacher`} class={activeSection === 'today' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </span>
          <span>{lang === 'es' ? '⚡ Aula Hoy (Acción Rápida)' : '⚡ Today in Class'}</span>
        </a>

        <a href={`/${lang}/app/teacher/dashboard`} class={activeSection === 'dashboard' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          </span>
          <span>{lang === 'es' ? 'Dashboard & Métricas' : 'Dashboard & Analytics'}</span>
        </a>

        <div class="group-label">{lang === 'es' ? 'Contenido & Evaluaciones' : 'Content & Evaluations'}</div>

        <a href={`/${lang}/app/teacher/courses`} class={activeSection === 'courses' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          </span>
          <span>{lang === 'es' ? 'Mis Cursos' : 'My Courses'}</span>
        </a>

        <a href={`/${lang}/app/teacher/grades`} class={activeSection === 'grades' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          </span>
          <span>{lang === 'es' ? 'Calificaciones & Notas' : 'Grades & Grading'}</span>
        </a>

        <div class="group-label">{lang === 'es' ? 'Comunidad' : 'Community'}</div>

        <a href={`/${lang}/app/teacher/students`} class={activeSection === 'students' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </span>
          <span>{lang === 'es' ? 'Mis Estudiantes' : 'My Students'}</span>
        </a>
      </>
    ) : isSchoolAdmin ? (
      /* ── NAVEGACIÓN SCHOOL ADMIN (RECTORÍA) ───────────────── */
      <>
        <div class="group-label">{lang === 'es' ? 'Gestión Académica' : 'Academic Management'}</div>

        <a href={`/${lang}/app/school-admin`} class={activeSection === 'dashboard' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          </span>
          <span>{lang === 'es' ? 'Dashboard' : 'Dashboard'}</span>
        </a>

        <a href={`/${lang}/app/school-admin/courses`} class={activeSection === 'courses' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          </span>
          <span>{lang === 'es' ? 'Cursos y Materias' : 'Courses & Classes'}</span>
        </a>

        <div class="group-label">{lang === 'es' ? 'Comunidad Escolar' : 'School Community'}</div>

        <a href={`/${lang}/app/school-admin/teachers`} class={activeSection === 'teachers' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg>
          </span>
          <span>{lang === 'es' ? 'Docentes' : 'Teachers'}</span>
        </a>

        <a href={`/${lang}/app/school-admin/students`} class={activeSection === 'students' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </span>
          <span>{lang === 'es' ? 'Estudiantes' : 'Students'}</span>
        </a>

        <div class="group-label">{lang === 'es' ? 'Comunicación' : 'Communication'}</div>

        <a href={`/${lang}/app/school-admin/news`} class={activeSection === 'news' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          </span>
          <span>{lang === 'es' ? 'Noticias & Avisos' : 'News & Announcements'}</span>
        </a>

        <div class="group-label">{lang === 'es' ? 'Institución' : 'Institution'}</div>

        <a href={`/${lang}/app/school-admin/settings`} class={activeSection === 'settings' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          </span>
          <span>{lang === 'es' ? 'Configuración' : 'Settings'}</span>
        </a>
      </>
    ) : (
      /* ── NAVEGACIÓN SUPER ADMIN (SISTEMA) ─────────────────── */
      <>
        <div class="group-label">{t.systemGroup}</div>

        <a href={`/${lang}/app/super-admin`} class={activeSection === 'dashboard' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          </span>
          <span>{t.dashboard}</span>
        </a>

        <a href={`/${lang}/app/super-admin/schools`} class={activeSection === 'schools' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M3 21h18M3 7v14M21 7v14M6 11h4M6 15h4M14 11h4M14 15h4M12 3L2 7h20L12 3z"/></svg>
          </span>
          <span>{t.schools}</span>
        </a>

        <a href={`/${lang}/app/super-admin/users`} class={activeSection === 'users' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </span>
          <span>{t.users}</span>
        </a>

        <a href={`/${lang}/app/super-admin/plans`} class={activeSection === 'plans' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
          </span>
          <span>{t.plans}</span>
        </a>

        <div class="group-label">{t.complianceGroup}</div>

        <a href={`/${lang}/app/super-admin/judicial-access`} class={activeSection === 'judicial-access' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </span>
          <span>{t.judicialAccess}</span>
        </a>

        <a href={`/${lang}/app/super-admin/audit-log`} class={activeSection === 'audit-log' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          </span>
          <span>{t.auditLog}</span>
        </a>

        <div class="group-label">{t.configGroup}</div>

        <a href={`/${lang}/app/super-admin/settings`} class={activeSection === 'settings' ? 'active' : ''}>
          <span class="nav-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          </span>
          <span>{t.settings}</span>
        </a>
      </>
    )}
  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-status">
      <span class="status-dot-pulse"></span>
      <span>{isSchoolAdmin ? (lang === 'es' ? 'TENANT ACTIVO · 2026' : 'ACTIVE TENANT · 2026') : 'SISTEMA EN LÍNEA · 24ms'}</span>
    </div>
    <div class="sidebar-links">
      <span>{t.version}</span>
      <a href={`/${lang}/`} style="color:var(--orange-vibrant); font-size:10.5px; font-weight:700; text-transform:uppercase;" title={lang === 'es' ? 'Ver Sitio Web' : 'View Main Website'}>
        {t.webLink}
      </a>
    </div>
  </div>
</aside>
