---
// ============================================================
// SchoolOS — Pantalla de Inicio de Sesión (Mock Auth + Dual i18n)
// ============================================================
import '../styles/tokens.css';
import { en } from '../i18n/en';
import { es } from '../i18n/es';

const i18nData = {
  en: en.loginPage,
  es: es.loginPage,
};
---

<!doctype html>
<html lang="es" id="htmlRoot">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title id="metaTitle">Iniciar Sesión — SchoolOS</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,450;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <style>
      body {
        background: var(--cream);
        color: var(--ink);
        font-family: var(--sans);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }

      .login-container {
        width: 100%;
        max-width: 440px;
        position: relative;
      }

      .login-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
      }

      .lang-switcher {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-family: var(--mono, monospace);
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-soft);
        background: var(--paper);
        padding: 0.35rem 0.75rem;
        border: 1px solid var(--line-strong);
        border-radius: 999px;
        cursor: pointer;
      }

      .lang-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--ink-soft);
        font-weight: 500;
        padding: 2px 4px;
        transition: color 0.15s ease;
      }

      .lang-btn.active {
        color: var(--rust);
        font-weight: 700;
      }

      .ls-divider {
        opacity: 0.3;
      }

      .brand-header {
        text-align: center;
        margin-bottom: 24px;
      }

      .brand-logo {
        font-family: var(--serif);
        font-size: 32px;
        font-weight: 700;
        color: var(--ink);
        text-decoration: none;
        display: inline-block;
      }

      .brand-logo span {
        color: var(--rust);
      }

      .brand-subtitle {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-soft);
        margin-top: 4px;
      }

      .login-card {
        background: var(--paper);
        border: 1px solid var(--ink);
        box-shadow: 0 4px 20px rgba(22, 20, 15, 0.08);
        padding: 36px 32px;
        border-radius: 2px;
      }

      .login-card h2 {
        font-family: var(--serif);
        font-size: 22px;
        font-weight: 600;
        margin-bottom: 8px;
      }

      .login-card p.intro {
        font-size: 13.5px;
        color: var(--ink-soft);
        margin-bottom: 22px;
        line-height: 1.45;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 18px;
      }

      .form-group label {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }

      .form-group input {
        border: 1px solid var(--line-strong);
        background: var(--cream);
        padding: 12px 14px;
        font-size: 14.5px;
        border-radius: 2px;
        transition: border-color 0.15s ease, background 0.15s ease;
      }

      .form-group input:focus {
        outline: none;
        border-color: var(--ink);
        background: #fff;
      }

      .demo-pill {
        background: #EDEAE0;
        border: 1px solid var(--line-strong);
        padding: 11px 14px;
        font-size: 12px;
        font-family: var(--mono);
        color: var(--ink);
        border-radius: 2px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        transition: background 0.15s ease, border-color 0.15s ease;
      }

      .demo-pill:hover {
        background: var(--cream);
        border-color: var(--ink);
      }

      .demo-pill code {
        font-weight: 600;
        color: var(--rust);
      }

      .error-alert {
        display: none;
        background: #F0D2CB;
        border: 1px solid #A23324;
        color: #5c2015;
        font-size: 12.5px;
        padding: 10px 14px;
        margin-bottom: 18px;
        border-radius: 2px;
      }

      .btn-submit {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 14px;
        font-size: 13px;
        font-family: var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        background: var(--ink);
        color: var(--cream);
        border: 1px solid var(--ink);
        cursor: pointer;
        transition: background 0.15s ease, transform 0.15s ease;
        margin-top: 8px;
        border-radius: 2px;
      }

      .btn-submit:hover {
        background: var(--rust);
        border-color: var(--rust);
      }

      .footer-links {
        text-align: center;
        margin-top: 24px;
        font-size: 12px;
        font-family: var(--mono);
        color: var(--ink-soft);
      }

      .footer-links a {
        color: var(--ink);
        text-decoration: underline;
      }

      .footer-links a:hover {
        color: var(--rust);
      }
    </style>
  </head>
  <body>
    <div class="login-container">
      <div class="login-top-bar">
        <a href="/es/" id="backHomeTop" style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft); text-transform:uppercase;">
          ← SchoolOS
        </a>

        <!-- Dual Language Switcher -->
        <div class="lang-switcher">
          <button type="button" class="lang-btn" id="btnLangEn">EN</button>
          <span class="ls-divider">|</span>
          <button type="button" class="lang-btn active" id="btnLangEs">ES</button>
        </div>
      </div>

      <div class="brand-header">
        <a href="/es/" class="brand-logo">School<span>OS</span></a>
        <div class="brand-subtitle" id="brandSubtitle">Acceso a la Plataforma Interna</div>
      </div>

      <div class="login-card">
        <h2 id="cardTitle">Iniciar Sesión</h2>
        <p class="intro" id="cardIntro">Accede al panel administrativo y de gestión escolar.</p>

        <!-- Demo credentials helper -->
        <div class="demo-pill" id="autoFillBtn" title="Clic para autocompletar credenciales">
          <span id="demoPillText">Demo: <code>admin</code> / <code>123</code></span>
          <span id="autoFillLabel" style="font-size:10.5px; text-transform:uppercase; color:var(--rust);">Autollenar ↙</span>
        </div>

        <div class="error-alert" id="errorMsg">
          Credenciales incorrectas. Usa <strong>admin</strong> y contraseña <strong>123</strong>.
        </div>

        <form id="loginForm">
          <div class="form-group">
            <label for="username" id="labelUser">Usuario o Email</label>
            <input type="text" id="username" name="username" placeholder="admin" required autofocus />
          </div>

          <div class="form-group">
            <label for="password" id="labelPass">Contraseña</label>
            <input type="password" id="password" name="password" placeholder="••••" required />
          </div>

          <button type="submit" class="btn-submit" id="btnSubmit">Entrar al Sistema →</button>
        </form>
      </div>

      <div class="footer-links">
        <a href="/es/" id="linkBackHome">← Volver al sitio principal</a>
      </div>
    </div>

    <!-- Translations store and language controller script -->
    <script is:inline define:vars={{ i18nData }}>
      let currentLang = 'es';

      // Detect language preference
      try {
        const savedLang = localStorage.getItem('schoolos-lang');
        if (savedLang === 'en' || savedLang === 'es') {
          currentLang = savedLang;
        } else {
          const browser = (navigator.language || 'es').toLowerCase();
          currentLang = browser.startsWith('es') ? 'es' : 'en';
        }
      } catch (_) {}

      function applyTranslations(lang) {
        currentLang = lang;
        try {
          localStorage.setItem('schoolos-lang', lang);
        } catch (_) {}

        const t = i18nData[lang] || i18nData.es;

        document.getElementById('htmlRoot').setAttribute('lang', lang);
        document.getElementById('metaTitle').textContent = t.metaTitle;
        document.getElementById('brandSubtitle').textContent = t.brandSubtitle;
        document.getElementById('cardTitle').textContent = t.title;
        document.getElementById('cardIntro').textContent = t.intro;
        document.getElementById('autoFillLabel').textContent = t.autoFill;
        document.getElementById('labelUser').textContent = t.userLabel;
        document.getElementById('labelPass').textContent = t.passLabel;
        document.getElementById('btnSubmit').textContent = t.submitBtn;
        document.getElementById('linkBackHome').textContent = t.backHome;
        document.getElementById('linkBackHome').setAttribute('href', '/' + lang + '/');
        document.getElementById('backHomeTop').setAttribute('href', '/' + lang + '/');
        document.getElementById('errorMsg').innerHTML = t.errorMsg;

        // Toggle active button style
        document.getElementById('btnLangEn').classList.toggle('active', lang === 'en');
        document.getElementById('btnLangEs').classList.toggle('active', lang === 'es');
      }

      // Initial apply
      applyTranslations(currentLang);

      // Language Switcher clicks
      document.getElementById('btnLangEn')?.addEventListener('click', () => applyTranslations('en'));
      document.getElementById('btnLangEs')?.addEventListener('click', () => applyTranslations('es'));

      // Autofill button
      const userInput = document.getElementById('username');
      const passInput = document.getElementById('password');
      const errorMsg = document.getElementById('errorMsg');

      document.getElementById('autoFillBtn')?.addEventListener('click', () => {
        userInput.value = 'admin';
        passInput.value = '123';
        userInput.focus();
      });

      // Submit
      document.getElementById('loginForm')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const username = userInput.value.trim();
        const password = passInput.value.trim();

        if ((username === 'admin' || username === 'admin@schoolos.com') && password === '123') {
          try {
            localStorage.setItem('schoolos-auth', 'true');
            localStorage.setItem(
              'schoolos-user',
              JSON.stringify({
                name: 'Maria P.',
                email: 'maria.p@schoolos.com',
                role: 'super_admin',
                lang: currentLang,
              })
            );
          } catch (_) {}

          const params = new URLSearchParams(window.location.search);
          const redirectTo = params.get('redirect') || ('/' + currentLang + '/app/super-admin');
          window.location.href = redirectTo;
        } else {
          errorMsg.style.display = 'block';
          passInput.value = '';
          passInput.focus();
        }
      });
    </script>
  </body>
</html>
