---
// ============================================================
// SchoolOS — Pantalla de Inicio de Sesión (Mock Auth Multi-Rol)
// ============================================================
import '../styles/tokens.css';
import { en } from '../i18n/en';
import { es } from '../i18n/es';

const i18nData = {
  en: en.loginPage,
  es: es.loginPage,
};
---

<!doctype html>
<html lang="es" id="htmlRoot">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title id="metaTitle">Iniciar Sesión — SchoolOS</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,450;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <style>
      body {
        background: var(--cream);
        color: var(--ink);
        font-family: var(--sans);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }

      .login-container {
        width: 100%;
        max-width: 480px;
        position: relative;
      }

      .login-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
      }

      .lang-switcher {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-family: var(--mono, monospace);
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-soft);
        background: var(--paper);
        padding: 0.35rem 0.75rem;
        border: 1px solid var(--line-strong);
        border-radius: 999px;
        cursor: pointer;
      }

      .lang-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--ink-soft);
        font-weight: 500;
        padding: 2px 4px;
        transition: color 0.15s ease;
      }

      .lang-btn.active {
        color: var(--rust);
        font-weight: 700;
      }

      .ls-divider {
        opacity: 0.3;
      }

      .brand-header {
        text-align: center;
        margin-bottom: 24px;
      }

      .brand-logo {
        font-family: var(--serif);
        font-size: 32px;
        font-weight: 700;
        color: var(--ink);
        text-decoration: none;
        display: inline-block;
      }

      .brand-logo span {
        color: var(--rust);
      }

      .brand-subtitle {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-soft);
        margin-top: 4px;
      }

      .login-card {
        background: var(--paper);
        border: 1px solid var(--ink);
        box-shadow: 0 4px 20px rgba(22, 20, 15, 0.08);
        padding: 32px 28px;
        border-radius: 2px;
      }

      .login-card h2 {
        font-family: var(--serif);
        font-size: 22px;
        font-weight: 600;
        margin-bottom: 6px;
      }

      .login-card p.intro {
        font-size: 13px;
        color: var(--ink-soft);
        margin-bottom: 18px;
        line-height: 1.45;
      }

      .roles-selector-title {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-soft);
        margin-bottom: 8px;
        display: block;
      }

      .role-pills-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-bottom: 20px;
      }

      .role-pill {
        background: #EDEAE0;
        border: 1px solid var(--line-strong);
        padding: 8px 10px;
        font-size: 11.5px;
        font-family: var(--mono);
        color: var(--ink);
        border-radius: 2px;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        gap: 2px;
        transition: all 0.15s ease;
        text-align: left;
      }

      .role-pill:hover, .role-pill.active {
        background: var(--paper);
        border-color: var(--ink);
        box-shadow: 2px 2px 0 rgba(18, 17, 14, 0.15);
      }

      .role-pill strong {
        font-size: 12px;
        color: var(--rust);
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 16px;
      }

      .form-group label {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }

      .form-group input {
        border: 1px solid var(--line-strong);
        background: var(--cream);
        padding: 11px 13px;
        font-size: 14px;
        border-radius: 2px;
        transition: border-color 0.15s ease, background 0.15s ease;
      }

      .form-group input:focus {
        outline: none;
        border-color: var(--ink);
        background: #fff;
      }

      .error-alert {
        display: none;
        background: #F0D2CB;
        border: 1px solid #A23324;
        color: #5c2015;
        font-size: 12px;
        padding: 10px 12px;
        margin-bottom: 16px;
        border-radius: 2px;
      }

      .btn-submit {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 13px;
        font-size: 12.5px;
        font-family: var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        background: var(--ink);
        color: var(--cream);
        border: 1px solid var(--ink);
        cursor: pointer;
        transition: background 0.15s ease, transform 0.15s ease;
        margin-top: 6px;
        border-radius: 2px;
        font-weight: 700;
      }

      .btn-submit:hover {
        background: var(--rust);
        border-color: var(--rust);
      }

      .footer-links {
        text-align: center;
        margin-top: 22px;
        font-size: 12px;
        font-family: var(--mono);
        color: var(--ink-soft);
      }

      .footer-links a {
        color: var(--ink);
        text-decoration: underline;
      }

      .footer-links a:hover {
        color: var(--rust);
      }
    </style>
  </head>
  <body>
    <div class="login-container">
      <div class="login-top-bar">
        <a href="/es/" id="backHomeTop" style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft); text-transform:uppercase;">
          ← SchoolOS
        </a>

        <!-- Dual Language Switcher -->
        <div class="lang-switcher">
          <button type="button" class="lang-btn" id="btnLangEn">EN</button>
          <span class="ls-divider">|</span>
          <button type="button" class="lang-btn active" id="btnLangEs">ES</button>
        </div>
      </div>

      <div class="brand-header">
        <a href="/es/" class="brand-logo">School<span>OS</span></a>
        <div class="brand-subtitle" id="brandSubtitle">Acceso a la Plataforma Educativa</div>
      </div>

      <div class="login-card">
        <h2 id="cardTitle">Iniciar Sesión</h2>
        <p class="intro" id="cardIntro">Selecciona tu perfil de acceso rápido o ingresa credenciales:</p>

        <!-- Fast Role Selection Pills -->
        <span class="roles-selector-title">⚡ Perfiles Demo de Acceso Rápido:</span>
        <div class="role-pills-grid">
          <!-- RECTOR -->
          <div class="role-pill active" id="pillRector" title="Iniciar como Rectora del Colegio Norte">
            <strong>Rectoría / Admin</strong>
            <span style="color:var(--ink-soft); font-size:10px;">rector / 123</span>
          </div>

          <!-- SUPER ADMIN -->
          <div class="role-pill" id="pillSuperAdmin" title="Iniciar como Super Administrador Global">
            <strong>Super Admin</strong>
            <span style="color:var(--ink-soft); font-size:10px;">admin / 123</span>
          </div>

          <!-- DOCENTE -->
          <div class="role-pill" id="pillTeacher" title="Docente de Biología">
            <strong>Docente (Profesor)</strong>
            <span style="color:var(--ink-soft); font-size:10px;">profesor / 123</span>
          </div>

          <!-- ESTUDIANTE -->
          <div class="role-pill" id="pillStudent" title="Estudiante de 10°">
            <strong>Estudiante</strong>
            <span style="color:var(--ink-soft); font-size:10px;">estudiante / 123</span>
          </div>
        </div>

        <div class="error-alert" id="errorMsg">
          Credenciales no reconocidas. Usa <strong>rector</strong>, <strong>admin</strong>, <strong>profesor</strong> o <strong>estudiante</strong> con contraseña <strong>123</strong>.
        </div>

        <form id="loginForm">
          <div class="form-group">
            <label for="username" id="labelUser">Usuario o Correo Institucional</label>
            <input type="text" id="username" name="username" value="rector" required autofocus />
          </div>

          <div class="form-group">
            <label for="password" id="labelPass">Contraseña de Acceso</label>
            <input type="password" id="password" name="password" value="123" required />
          </div>

          <button type="submit" class="btn-submit" id="btnSubmit">Entrar al Sistema →</button>
        </form>
      </div>

      <div class="footer-links">
        <a href="/es/" id="linkBackHome">← Volver al sitio principal</a>
      </div>
    </div>

    <!-- Translations store and language controller script -->
    <script is:inline define:vars={{ i18nData }}>
      window.i18nData = i18nData;
    </script>

    <!-- Script de autenticación empaquetado por Vite -->
    <script>
      import { authService } from '../services/authService';

      // Translations setup
      const i18nData = (window as any).i18nData;
      let currentLang = 'es';

      try {
        const savedLang = localStorage.getItem('schoolos-lang');
        if (savedLang === 'en' || savedLang === 'es') {
          currentLang = savedLang;
        } else {
          const browser = (navigator.language || 'es').toLowerCase();
          currentLang = browser.startsWith('es') ? 'es' : 'en';
        }
      } catch (_) {}

      function applyTranslations(lang: string) {
        currentLang = lang;
        try {
          localStorage.setItem('schoolos-lang', lang);
        } catch (_) {}

        const t = (i18nData && i18nData[lang]) || (i18nData && i18nData.es);
        if (!t) return;

        document.getElementById('htmlRoot')?.setAttribute('lang', lang);
        const metaTitle = document.getElementById('metaTitle');
        if (metaTitle) metaTitle.textContent = t.metaTitle;
        const cardTitle = document.getElementById('cardTitle');
        if (cardTitle) cardTitle.textContent = t.title;
        const cardIntro = document.getElementById('cardIntro');
        if (cardIntro) cardIntro.textContent = t.intro;
        const labelUser = document.getElementById('labelUser');
        if (labelUser) labelUser.textContent = t.userLabel;
        const labelPass = document.getElementById('labelPass');
        if (labelPass) labelPass.textContent = t.passLabel;
        const btnSubmit = document.getElementById('btnSubmit');
        if (btnSubmit) btnSubmit.textContent = t.submitBtn;
        const linkBackHome = document.getElementById('linkBackHome');
        if (linkBackHome) {
          linkBackHome.textContent = t.backHome;
          linkBackHome.setAttribute('href', '/' + lang + '/');
        }
        document.getElementById('backHomeTop')?.setAttribute('href', '/' + lang + '/');

        document.getElementById('btnLangEn')?.classList.toggle('active', lang === 'en');
        document.getElementById('btnLangEs')?.classList.toggle('active', lang === 'es');
      }

      applyTranslations(currentLang);

      document.getElementById('btnLangEn')?.addEventListener('click', () => applyTranslations('en'));
      document.getElementById('btnLangEs')?.addEventListener('click', () => applyTranslations('es'));

      const userInput = document.getElementById('username') as HTMLInputElement;
      const passInput = document.getElementById('password') as HTMLInputElement;
      const errorMsg = document.getElementById('errorMsg') as HTMLElement;
      const btnSubmit = document.getElementById('btnSubmit') as HTMLButtonElement;

      function setActivePill(pillId: string, user: string, pass: string) {
        document.querySelectorAll('.role-pill').forEach(p => p.classList.remove('active'));
        document.getElementById(pillId)?.classList.add('active');
        if (userInput) userInput.value = user;
        if (passInput) passInput.value = pass;
      }

      document.getElementById('pillRector')?.addEventListener('click', () => setActivePill('pillRector', 'rector', '123'));
      document.getElementById('pillSuperAdmin')?.addEventListener('click', () => setActivePill('pillSuperAdmin', 'kumikasato45@gmail.com', 'SuperAdmin2026!*'));
      document.getElementById('pillTeacher')?.addEventListener('click', () => setActivePill('pillTeacher', 'profesor', '123'));
      document.getElementById('pillStudent')?.addEventListener('click', () => setActivePill('pillStudent', 'estudiante', '123'));

      // Submit con Supabase Auth Real
      document.getElementById('loginForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const inputVal = userInput ? userInput.value.trim() : '';
        const password = passInput ? passInput.value.trim() : '';

        if (errorMsg) errorMsg.style.display = 'none';
        if (btnSubmit) {
          btnSubmit.disabled = true;
          btnSubmit.textContent = 'Verificando con Supabase...';
        }

        try {
          // 1. Caso Real: Si es un email o el atajo de admin, login con Supabase Auth
          if (inputVal.includes('@') || inputVal === 'admin') {
            const emailToUse = inputVal === 'admin' ? 'kumikasato45@gmail.com' : inputVal;
            const user = await authService.signIn(emailToUse, password);

            let targetUrl = '/' + currentLang + '/app/super-admin';
            if (user.role === 'school_admin') targetUrl = '/' + currentLang + '/app/school-admin';
            if (user.role === 'teacher') targetUrl = '/' + currentLang + '/app/teacher';
            if (user.role === 'student') targetUrl = '/' + currentLang + '/app/student';

            localStorage.setItem('schoolos-auth', 'true');
            localStorage.setItem('schoolos-user', JSON.stringify(user));

            const params = new URLSearchParams(window.location.search);
            const redirectTo = params.get('redirect') || targetUrl;
            window.location.href = redirectTo;
            return;
          }

          // 2. Fallback Demo Mock para otros roles ('rector', 'profesor', 'estudiante')
          if (password === '123') {
            let role = 'school_admin';
            let targetUrl = '/' + currentLang + '/app/school-admin';
            let userData = {
              name: 'Diana Restrepo',
              email: 'diana.restrepo@colegionorte.edu.co',
              role: 'school_admin',
              schoolId: '20e98b23-c8d8-4ed3-92ff-376d85106988',
              schoolName: 'Cafelitos Baseball Academy',
            };

            if (inputVal === 'superadmin') {
              role = 'super_admin';
              targetUrl = '/' + currentLang + '/app/super-admin';
              userData = {
                name: 'Kumika Sato',
                email: 'kumikasato45@gmail.com',
                role: 'super_admin',
                schoolId: null,
                schoolName: 'SchoolOS Global',
              };
            } else if (inputVal === 'profesor' || inputVal === 'teacher') {
              role = 'teacher';
              targetUrl = '/' + currentLang + '/app/teacher';
              userData = {
                name: 'Prof. Diana Restrepo',
                email: 'diana.restrepo@colegio-norte.edu.co',
                role: 'teacher',
                schoolId: '20e98b23-c8d8-4ed3-92ff-376d85106988',
                schoolName: 'Cafelitos Baseball Academy',
              };
            } else if (inputVal === 'estudiante' || inputVal === 'student') {
              role = 'student';
              targetUrl = '/' + currentLang + '/app/student';
              userData = {
                name: 'Mateo Gómez',
                email: 'mateo.g@colegio-norte.edu.co',
                role: 'student',
                schoolId: '20e98b23-c8d8-4ed3-92ff-376d85106988',
                schoolName: 'Cafelitos Baseball Academy',
              };
            }

            localStorage.setItem('schoolos-auth', 'true');
            localStorage.setItem('schoolos-user', JSON.stringify(userData));

            const params = new URLSearchParams(window.location.search);
            const redirectTo = params.get('redirect') || targetUrl;
            window.location.href = redirectTo;
            return;
          }

          throw new Error('Credenciales inválidas. Verifica tu correo y contraseña.');
        } catch (err: any) {
          if (errorMsg) {
            errorMsg.textContent = err?.message || 'Error al iniciar sesión en Supabase.';
            errorMsg.style.display = 'block';
          }
          if (passInput) {
            passInput.value = '';
            passInput.focus();
          }
        } finally {
          if (btnSubmit) {
            btnSubmit.disabled = false;
            const t = (i18nData && i18nData[currentLang]) || (i18nData && i18nData.es);
            btnSubmit.textContent = t?.submitBtn || 'Entrar al Sistema →';
          }
        }
      });
    </script>
  </body>
</html>
