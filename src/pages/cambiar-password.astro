---
import '../styles/tokens.css';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cambiar contraseña — SchoolOS</title>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Inter:wght@400;500;700&family=IBM+Plex+Mono:wght@400&display=swap" rel="stylesheet" />
  <style>
    body{background:var(--cream);color:var(--ink);font-family:var(--sans);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}
    .card{max-width:460px;width:100%;background:var(--paper);border:2px solid var(--ink);padding:28px;box-shadow:8px 8px 0 rgba(18,17,14,.12)}
    h1{font-family:var(--serif);font-size:22px;font-weight:700;margin-bottom:8px}
    p{font-size:13px;color:var(--ink-soft);margin-bottom:18px;line-height:1.5}
    .field{display:flex;flex-direction:column;gap:6px;margin-bottom:14px}
    .field label{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft)}
    .field input{border:1px solid var(--line-strong);background:var(--cream);padding:11px 13px;font-size:14px}
    .field input:focus{outline:none;border-color:var(--ink);background:#fff}
    .btn{width:100%;padding:13px;background:var(--ink);color:var(--cream);border:1px solid var(--ink);font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;font-weight:700;cursor:pointer}
    .btn:hover{background:var(--rust);border-color:var(--rust)}
    .alert{display:none;padding:10px 12px;border:1px solid var(--danger);background:var(--danger-dim);color:#5c2015;font-size:12px;margin-bottom:14px}
    .alert.ok{border-color:#2E4A1E;background:#DDE2C9;color:#2E4A1E;display:block}
  </style>
</head>
<body>
  <div class="card">
    <h1>Crea tu contraseña definitiva</h1>
    <p>Por seguridad debes cambiar la temporal que te enviamos. Usa al menos 8 caracteres.</p>
    <div id="alert" class="alert"></div>
    <form id="form">
      <div class="field"><label>Nueva contraseña</label><input id="p1" type="password" required minlength="8" /></div>
      <div class="field"><label>Confirmar contraseña</label><input id="p2" type="password" required minlength="8" /></div>
      <button class="btn" type="submit">Guardar y entrar →</button>
    </form>
  </div>
  <script>
    import { apiClient } from '../lib/apiClient';
    const form = document.getElementById('form');
    const alertEl = document.getElementById('alert');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const p1 = (document.getElementById('p1') as HTMLInputElement).value;
      const p2 = (document.getElementById('p2') as HTMLInputElement).value;
      if (p1 !== p2) { alertEl.textContent = 'Las contraseñas no coinciden.'; alertEl.style.display = 'block'; return; }
      if (p1.length < 8) { alertEl.textContent = 'Mínimo 8 caracteres.'; alertEl.style.display = 'block'; return; }
      const btn = form.querySelector('button') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Guardando...';
      try {
        // El servidor se encarga de todo: actualizar contraseña + limpiar flag en public.users
        const result = await apiClient.post<any>('/api/auth/change-password', {
          newPassword: p1,
        });

        if (!result.ok) throw new Error(result.error || 'Error al guardar la contraseña.');

        // Limpiar caché local
        localStorage.removeItem('schoolos_profile_cache');
        const raw = localStorage.getItem('schoolos-user');
        if (raw) {
          try { const u = JSON.parse(raw); u.passwordResetRequired = false; localStorage.setItem('schoolos-user', JSON.stringify(u)); } catch {}
        }

        alertEl.textContent = 'Contraseña actualizada. Redirigiendo...';
        alertEl.className = 'alert ok';
        alertEl.style.display = 'block';

        setTimeout(() => {
          const u = JSON.parse(localStorage.getItem('schoolos-user') || '{}');
          if (u.role === 'school_admin') location.href = '/es/app/school-admin';
          else if (u.role === 'teacher') location.href = '/es/app/teacher';
          else if (u.role === 'student') location.href = '/es/app/student';
          else location.href = '/login';
        }, 1200);
      } catch (err: any) {
        alertEl.textContent = err.message || 'Error al guardar.';
        alertEl.style.display = 'block';
        btn.disabled = false; btn.textContent = 'Guardar y entrar →';
      }
    });
  </script>
</body>
</html>
