---
import '../styles/tokens.css';
import AvatarPickerModal from '../components/app/school-admin/AvatarPickerModal.astro';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Activación de Cuenta Institucional — SchoolOS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    body {
      background: var(--cream);
      color: var(--ink);
      font-family: var(--sans);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      margin: 0;
    }
    .card {
      max-width: 500px;
      width: 100%;
      background: var(--paper);
      border: 2px solid var(--ink);
      box-shadow: 8px 8px 0 rgba(18, 17, 14, 0.16);
      overflow: hidden;
    }
    .card-header {
      padding: 20px 24px;
      background: var(--cream);
      border-bottom: 2px solid var(--ink);
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .school-logo-box {
      width: 44px;
      height: 44px;
      border: 1.5px solid var(--ink);
      background: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
      box-shadow: 2px 2px 0 var(--ink);
    }
    .card-body {
      padding: 28px 24px;
    }
    h1 {
      font-family: var(--serif);
      font-size: 22px;
      font-weight: 700;
      margin: 0 0 6px;
      color: var(--ink);
    }
    p {
      font-size: 13px;
      color: var(--ink-soft);
      line-height: 1.5;
      margin: 0 0 20px;
    }
    .avatar-section {
      display: flex;
      align-items: center;
      gap: 16px;
      background: var(--cream);
      border: 1.5px solid var(--ink);
      padding: 16px;
      margin-bottom: 22px;
      box-shadow: 3px 3px 0 var(--ink);
    }
    .avatar-preview-circle {
      width: 76px;
      height: 76px;
      border: 2px solid var(--ink);
      background: #FFFFFF;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      box-shadow: 2px 2px 0 var(--ink);
      flex-shrink: 0;
    }
    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 16px;
    }
    .field label {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--ink);
    }
    .field input {
      border: 1.5px solid var(--ink);
      background: var(--paper);
      padding: 11px 13px;
      font-size: 14px;
      width: 100%;
      box-sizing: border-box;
      outline: none;
    }
    .field input:focus {
      border-color: var(--orange-vibrant);
      background: #FFFFFF;
    }
    .btn {
      width: 100%;
      padding: 13px;
      background: var(--ink);
      color: var(--cream);
      border: 1.5px solid var(--ink);
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 3px 3px 0 var(--ink);
      transition: all 0.15s ease;
    }
    .btn:hover {
      background: var(--orange-vibrant);
      border-color: var(--orange-vibrant);
      transform: translate(-1px, -1px);
      box-shadow: 4px 4px 0 var(--ink);
    }
    .btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }
    .alert {
      display: none;
      padding: 12px 14px;
      border: 2px solid var(--rust);
      background: #FFF0EE;
      color: var(--rust);
      font-size: 12.5px;
      font-weight: 700;
      line-height: 1.45;
      margin-bottom: 14px;
      box-shadow: 2px 2px 0 var(--ink);
    }
    .alert.ok {
      border-color: #2E7D32;
      background: #E8F5E9;
      color: #2E7D32;
      display: block;
    }
    .input-with-icon {
      position: relative;
      display: flex;
      align-items: center;
      width: 100%;
    }
    .input-with-icon input {
      padding-right: 44px !important;
    }
    .btn-toggle-pass {
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      font-size: 16px;
      padding: 4px 6px;
      line-height: 1;
      color: var(--ink-soft);
      border-radius: 4px;
    }
    .btn-toggle-pass:hover {
      color: var(--ink);
      background: rgba(0, 0, 0, 0.05);
    }
    .match-indicator {
      font-size: 11.5px;
      font-family: var(--mono);
      font-weight: 700;
      margin-top: 4px;
      display: none;
    }
    .match-indicator.ok {
      color: #2E7D32;
      display: block;
    }
    .match-indicator.err {
      color: var(--rust);
      display: block;
    }
  </style>
</head>
<body>
  <div class="card">
    <!-- CABECERA INSTITUCIONAL -->
    <div class="card-header">
      <div class="school-logo-box" id="headerLogoBox">
        <span style="font-family:var(--mono); font-weight:800; font-size:14px; color:var(--orange-vibrant);">OS</span>
      </div>
      <div>
        <div style="font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--orange-vibrant); letter-spacing:0.08em;">
          BIENVENIDO A SCHOOLOS
        </div>
        <div id="headerSchoolName" style="font-family:var(--sans); font-size:13.5px; font-weight:700; color:var(--ink);">
          Plataforma Institucional
        </div>
      </div>
    </div>

    <!-- CUERPO PRINCIPAL -->
    <div class="card-body">
      <!-- VISTA CARGANDO / VERIFICANDO ACCESO -->
      <div id="checkingAuthView" style="text-align:center; padding:36px 16px;">
        <div style="font-size:28px; margin-bottom:12px;">🔒</div>
        <div style="font-family:var(--mono); font-size:12px; font-weight:700; color:var(--ink); letter-spacing:0.06em; text-transform:uppercase; margin-bottom:6px;">
          Verificando Autorización
        </div>
        <div style="font-size:12px; color:var(--ink-soft);">
          Comprobando sesión institucional y enlace de seguridad...
        </div>
      </div>

      <!-- VISTA NORMAL: SELECCIÓN DE AVATAR & CONTRASEÑA -->
      <div id="normalView" style="display:none;">
        <h1>Configura tu Perfil Institucional</h1>
        <p>Elige tu avatar de identificación y asigna tu contraseña definitiva para comenzar a operar.</p>

        <form id="activationForm">
          <!-- SECCIÓN AVATAR OFICIAL -->
          <div class="avatar-section">
            <div class="avatar-preview-circle" id="previewSelectedAvatarBox" onclick="window.openAvatarPicker && window.openAvatarPicker('userActivationAvatarPicker', 'men', 'inputSelectedAvatar', 'previewSelectedAvatarImg');" style="cursor:pointer;" title="Haz clic para cambiar avatar">
              <img id="previewSelectedAvatarImg" src="/avatars/men/fila-1-columna-1.png" alt="Avatar Seleccionado" style="width:100%; height:100%; object-fit:contain;" />
            </div>
            <div style="flex:1;">
              <div style="font-family:var(--mono); font-size:10.5px; font-weight:700; text-transform:uppercase; color:var(--ink); margin-bottom:4px;">
                Avatar Institucional
              </div>
              <div style="font-size:12px; color:var(--ink-soft); margin-bottom:8px;">
                Selecciona uno de los 32 avatares oficiales (16 masculinos / 16 femeninos).
              </div>
              <button
                type="button"
                id="btnOpenAvatarPicker"
                class="btn"
                onclick="window.openAvatarPicker && window.openAvatarPicker('userActivationAvatarPicker', 'men', 'inputSelectedAvatar', 'previewSelectedAvatarImg');"
                style="padding:6px 12px; font-size:10.5px; background:var(--paper); color:var(--ink); border:1.5px solid var(--ink); width:auto; display:inline-block;"
              >
                👤 Elegir mi Avatar →
              </button>
            </div>
            <input type="hidden" id="inputSelectedAvatar" value="/avatars/men/fila-1-columna-1.png" />
          </div>

          <!-- CAMPOS DE CONTRASEÑA -->
          <div class="field">
            <label for="pass1">Nueva Contraseña Definitiva *</label>
            <div class="input-with-icon">
              <input id="pass1" type="password" required minlength="8" placeholder="Mínimo 8 caracteres" />
              <button type="button" class="btn-toggle-pass" data-target="pass1" title="Mostrar/ocultar contraseña">👁️</button>
            </div>
          </div>

          <div class="field">
            <label for="pass2">Confirmar Contraseña *</label>
            <div class="input-with-icon">
              <input id="pass2" type="password" required minlength="8" placeholder="Repite exactamente la contraseña" />
              <button type="button" class="btn-toggle-pass" data-target="pass2" title="Mostrar/ocultar contraseña">👁️</button>
            </div>
            <div id="matchIndicator" class="match-indicator"></div>
          </div>

          <div id="alertBox" class="alert"></div>

          <button id="btnSubmitActivation" class="btn" type="submit" style="margin-top:6px;">
            ACTIVAR CUENTA Y ENTRAR →
          </button>
        </form>
      </div>

      <!-- VISTA ERROR: ENLACE EXPIRADO O CADUCADO -->
      <div id="expiredView" style="display:none;">
        <div style="text-align:center; margin-bottom:16px;">
          <div style="font-size:36px; line-height:1; margin-bottom:8px;" id="expiredIcon">🔒</div>
          <h1 style="font-size:20px; margin-bottom:6px;" id="expiredTitle">Acceso Requerido</h1>
          <p style="font-size:13px; color:var(--ink-soft); line-height:1.5; margin:0;" id="expiredDesc">
            Para cambiar o configurar tu contraseña debes haber iniciado sesión previamente o ingresar mediante el enlace oficial enviado a tu correo institucional.
          </p>
        </div>

        <div style="background:var(--cream); border:1.5px solid var(--ink); padding:12px 14px; margin-bottom:18px; font-size:12.5px; line-height:1.5; box-shadow:2px 2px 0 var(--ink);">
          • Si ya cuentas con tus credenciales o contraseña temporal, puedes <a href="/login" style="font-weight:700; color:var(--ink); text-decoration:underline;">iniciar sesión aquí</a>.<br/><br/>
          • Si necesitas un nuevo enlace de activación o restablecimiento, puedes solicitarlo directo a tu correo a continuación:
        </div>

        <div id="recoveryAlert" class="alert"></div>

        <form id="recoveryForm" style="display:flex; flex-direction:column; gap:12px; margin-bottom:16px;">
          <div class="field" style="margin:0;">
            <label for="recoveryEmail">Tu Correo Institucional</label>
            <input type="email" id="recoveryEmail" required placeholder="tu-correo@institucion.edu" />
          </div>
          <button id="recoveryBtn" type="submit" class="btn">
            Enviar Enlace a mi Correo →
          </button>
        </form>

        <div style="text-align:center; margin-top:14px; border-top:1px dashed var(--line); padding-top:12px;">
          <a href="/login" style="font-family:var(--mono); font-size:11px; font-weight:700; color:var(--ink); text-decoration:none;">
            ← VOLVER AL INICIO DE SESIÓN
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL SELECTOR DE AVATARES OFICIALES -->
  <AvatarPickerModal id="userActivationAvatarPicker" />

  <script>
    import { apiClient } from '../lib/apiClient';
    import { supabase } from '../lib/supabase';

    const normalView = document.getElementById('normalView');
    const expiredView = document.getElementById('expiredView');
    const activationForm = document.getElementById('activationForm');
    const alertBox = document.getElementById('alertBox');
    const btnSubmitActivation = document.getElementById('btnSubmitActivation') as HTMLButtonElement;

    const recoveryForm = document.getElementById('recoveryForm');
    const recoveryEmail = document.getElementById('recoveryEmail') as HTMLInputElement;
    const recoveryBtn = document.getElementById('recoveryBtn') as HTMLButtonElement;
    const recoveryAlert = document.getElementById('recoveryAlert');

    const headerSchoolName = document.getElementById('headerSchoolName');
    const headerLogoBox = document.getElementById('headerLogoBox');

    const pass1Input = document.getElementById('pass1') as HTMLInputElement;
    const pass2Input = document.getElementById('pass2') as HTMLInputElement;
    const matchIndicator = document.getElementById('matchIndicator');

    // Botones de mostrar/ocultar contraseña (ojo 👁️)
    document.querySelectorAll('.btn-toggle-pass').forEach((btn) => {
      btn.addEventListener('click', (ev) => {
        ev.preventDefault();
        const targetId = (btn as HTMLElement).dataset.target;
        if (!targetId) return;
        const input = document.getElementById(targetId) as HTMLInputElement;
        if (!input) return;
        if (input.type === 'password') {
          input.type = 'text';
          btn.textContent = '🔒';
          btn.setAttribute('title', 'Ocultar contraseña');
        } else {
          input.type = 'password';
          btn.textContent = '👁️';
          btn.setAttribute('title', 'Mostrar contraseña');
        }
      });
    });

    // Validación visual en tiempo real de coincidencia
    function checkLivePasswordMatch() {
      const p1 = pass1Input?.value || '';
      const p2 = pass2Input?.value || '';

      if (!matchIndicator) return;
      if (!p2) {
        matchIndicator.style.display = 'none';
        matchIndicator.textContent = '';
        return;
      }

      if (p1 === p2) {
        matchIndicator.textContent = '✓ Las contraseñas coinciden';
        matchIndicator.className = 'match-indicator ok';
        matchIndicator.style.display = 'block';
      } else {
        matchIndicator.textContent = '✗ Las contraseñas no coinciden';
        matchIndicator.className = 'match-indicator err';
        matchIndicator.style.display = 'block';
      }
    }

    pass1Input?.addEventListener('input', () => {
      checkLivePasswordMatch();
      if (alertBox && alertBox.textContent?.includes('coinciden')) {
        alertBox.style.display = 'none';
      }
    });

    pass2Input?.addEventListener('input', () => {
      checkLivePasswordMatch();
      if (alertBox && alertBox.textContent?.includes('coinciden')) {
        alertBox.style.display = 'none';
      }
    });

    // Escuchar selección de avatar
    window.addEventListener('avatar:selected', (e: any) => {
      const url = e.detail?.avatarUrl;
      const input = document.getElementById('inputSelectedAvatar') as HTMLInputElement;
      const preview = document.getElementById('previewSelectedAvatarImg') as HTMLImageElement;
      if (input && url) input.value = url;
      if (preview && url) preview.src = url;
    });

    async function syncUserProfile(session: any) {
      if (!session) return;
      try {
        const meRes = await apiClient.get<any>('/api/auth/me');
        if (!meRes || !meRes.ok) return;

        const profile = meRes.profile;
        const school = meRes.school;

        // 1. Mostrar nombre y logo del colegio
        if (school) {
          if (headerSchoolName && school.name) headerSchoolName.textContent = school.name;
          if (headerLogoBox && school.logo_url) {
            headerLogoBox.innerHTML = `<img src="${school.logo_url}" alt="Logo" style="width:100%; height:100%; object-fit:contain;" />`;
          }
        }

        // 2. PRECARGAR EL AVATAR EXISTENTE (el que se subió al crear la cuenta o registrarse)
        const existingAvatar = profile?.avatarUrl || profile?.avatar_url || session.user?.user_metadata?.avatar_url;
        if (existingAvatar) {
          const inputAvatar = document.getElementById('inputSelectedAvatar') as HTMLInputElement;
          const previewImg = document.getElementById('previewSelectedAvatarImg') as HTMLImageElement;
          if (inputAvatar) inputAvatar.value = existingAvatar;
          if (previewImg) previewImg.src = existingAvatar;

          // Sincronizar también miniatura del modal
          const modalThumb = document.getElementById('userActivationAvatarPicker-selected-preview-thumb') as HTMLImageElement;
          if (modalThumb) modalThumb.src = existingAvatar;
        }
      } catch (err) {
        console.warn('[cambiar-password] Error sincronizando perfil:', err);
      }
    }

    const checkingAuthView = document.getElementById('checkingAuthView');
    const expiredIcon = document.getElementById('expiredIcon');
    const expiredTitle = document.getElementById('expiredTitle');
    const expiredDesc = document.getElementById('expiredDesc');

    function showUnauthorized(isExpired = false) {
      if (checkingAuthView) checkingAuthView.style.display = 'none';
      if (normalView) normalView.style.display = 'none';
      if (expiredView) expiredView.style.display = 'block';

      if (isExpired) {
        if (expiredIcon) expiredIcon.textContent = '⚠️';
        if (expiredTitle) expiredTitle.textContent = 'Enlace Expirado o Ya Utilizado';
        if (expiredDesc) expiredDesc.textContent = 'Este enlace de invitación ya fue utilizado o ha caducado por motivos de seguridad.';
      } else {
        if (expiredIcon) expiredIcon.textContent = '🔒';
        if (expiredTitle) expiredTitle.textContent = 'Acceso Requerido';
        if (expiredDesc) expiredDesc.textContent = 'No se detectó una sesión activa ni un enlace de activación válido. Para configurar una nueva contraseña debes haber iniciado sesión o ingresar mediante el enlace oficial enviado a tu correo institucional.';
      }
    }

    function showForm(session: any) {
      if (checkingAuthView) checkingAuthView.style.display = 'none';
      if (expiredView) expiredView.style.display = 'none';
      if (normalView) normalView.style.display = 'block';
      if (btnSubmitActivation) btnSubmitActivation.disabled = false;
      if (window.location.hash.includes('error')) {
        history.replaceState(null, '', window.location.pathname);
      }
      syncUserProfile(session);
    }

    async function init() {
      // 1. Revisar si la URL traía error explícito de enlace expirado
      if (window.location.hash) {
        const hashParams = new URLSearchParams(window.location.hash.substring(1));
        if (hashParams.has('error') || hashParams.has('error_description')) {
          showUnauthorized(true);
          return;
        }
      }

      // 2. Revisar si el usuario ya tiene sesión activa (ej. redirección desde /login)
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (session) {
          showForm(session);
          return;
        }
      } catch (_) {}

      // 3. Revisar si viene un token de recuperación/invitación en el hash o search params
      const hasAuthToken = window.location.hash.includes('access_token') ||
                           window.location.hash.includes('type=recovery') ||
                           window.location.hash.includes('type=invite') ||
                           new URLSearchParams(window.location.search).has('token') ||
                           new URLSearchParams(window.location.search).has('code');

      if (!hasAuthToken) {
        // FILTRO ESTRICTO: Acceso directo sin sesión y sin token -> BLOQUEAR acceso
        showUnauthorized(false);
      } else {
        // Hay token en proceso; esperar a que el cliente Supabase lo resuelva
        setTimeout(async () => {
          const { data: { session: retrySession } } = await supabase.auth.getSession();
          if (retrySession) {
            showForm(retrySession);
          } else {
            showUnauthorized(true);
          }
        }, 2000);
      }
    }

    init();

    // Detección reactiva de sesión de Supabase
    supabase.auth.onAuthStateChange(async (event, session) => {
      if (session && (event === 'SIGNED_IN' || event === 'PASSWORD_RECOVERY' || event === 'USER_UPDATED' || event === 'INITIAL_SESSION')) {
        showForm(session);
      }
    });

    // Envío del formulario de activación (Avatar + Contraseña)
    activationForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const p1 = (document.getElementById('pass1') as HTMLInputElement)?.value?.trim() || '';
      const p2 = (document.getElementById('pass2') as HTMLInputElement)?.value?.trim() || '';
      const avatarInput = document.getElementById('inputSelectedAvatar') as HTMLInputElement;
      const avatarUrl = avatarInput?.value?.trim() || null;

      if (!p1 || p1.length < 8) {
        if (alertBox) {
          alertBox.textContent = '⚠️ La contraseña debe tener al menos 8 caracteres.';
          alertBox.className = 'alert';
          alertBox.style.display = 'block';
          alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
        (document.getElementById('pass1') as HTMLInputElement)?.focus();
        return;
      }

      if (p1 !== p2) {
        if (alertBox) {
          alertBox.textContent = '⚠️ Las contraseñas no coinciden. Asegúrate de escribir exactamente la misma contraseña en ambos campos.';
          alertBox.className = 'alert';
          alertBox.style.display = 'block';
          alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
        (document.getElementById('pass2') as HTMLInputElement)?.focus();
        return;
      }

      if (alertBox) {
        alertBox.style.display = 'none';
      }

      if (btnSubmitActivation) {
        btnSubmitActivation.disabled = true;
        btnSubmitActivation.textContent = 'Guardando perfil y entrando…';
      }

      try {
        const result = await apiClient.post<any>('/api/auth/change-password', {
          newPassword: p1,
          avatarUrl: avatarUrl,
        });

        if (!result.ok) throw new Error(result.error || 'No se pudo activar la cuenta.');

        // Renovar sesión activa con la nueva contraseña para refrescar el token revocado por Supabase Auth
        try {
          const { data: { session: curSess } } = await supabase.auth.getSession();
          const email = curSess?.user?.email;
          if (email) {
            await supabase.auth.signInWithPassword({ email, password: p1 });
          }
        } catch (_) {}

        // Actualizar caché de sesión local
        localStorage.removeItem('schoolos_profile_cache');
        const raw = localStorage.getItem('schoolos-user');
        if (raw) {
          try {
            const u = JSON.parse(raw);
            u.passwordResetRequired = false;
            u.avatar_url = avatarUrl;
            localStorage.setItem('schoolos-user', JSON.stringify(u));
          } catch (_) {}
        }

        if (alertBox) {
          alertBox.textContent = '✓ ¡Perfil configurado y cuenta activada! Ingresando a la plataforma...';
          alertBox.className = 'alert ok';
          alertBox.style.display = 'block';
        }

        setTimeout(async () => {
          try {
            const meRes = await apiClient.get<any>('/api/auth/me');
            const role = meRes?.profile?.role || meRes?.user?.role;
            if (role === 'school_admin') location.href = '/es/app/school-admin';
            else if (role === 'teacher') location.href = '/es/app/teacher';
            else if (role === 'student') location.href = '/es/app/student';
            else if (role === 'super_admin') location.href = '/es/app/super-admin';
            else location.href = '/login';
          } catch {
            location.href = '/login';
          }
        }, 1200);
      } catch (err: any) {
        if (alertBox) {
          alertBox.textContent = err.message || 'Error al activar tu cuenta. Intenta nuevamente.';
          alertBox.style.display = 'block';
        }
        if (btnSubmitActivation) {
          btnSubmitActivation.disabled = false;
          btnSubmitActivation.textContent = 'ACTIVAR CUENTA Y ENTRAR →';
        }
      }
    });

    // Envío del formulario de nuevo enlace
    recoveryForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = recoveryEmail?.value.trim();
      if (!email) return;

      if (recoveryBtn) { recoveryBtn.disabled = true; recoveryBtn.textContent = 'Enviando enlace…'; }
      if (recoveryAlert) recoveryAlert.style.display = 'none';

      try {
        const { error } = await supabase.auth.resetPasswordForEmail(email, {
          redirectTo: `${window.location.origin}/cambiar-password`,
        });

        if (error) throw error;

        if (recoveryAlert) {
          recoveryAlert.textContent = `✓ Te hemos enviado un enlace nuevo a ${email}. Revisa tu bandeja de entrada o spam.`;
          recoveryAlert.className = 'alert ok';
          recoveryAlert.style.display = 'block';
        }
      } catch (err: any) {
        if (recoveryAlert) {
          recoveryAlert.textContent = err?.message || 'No se pudo despachar el enlace. Verifica que el correo sea correcto.';
          recoveryAlert.className = 'alert';
          recoveryAlert.style.display = 'block';
        }
        if (recoveryBtn) { recoveryBtn.disabled = false; recoveryBtn.textContent = 'Enviar Nuevo Enlace a mi Correo →'; }
      }
    });
  </script>
</body>
</html>
