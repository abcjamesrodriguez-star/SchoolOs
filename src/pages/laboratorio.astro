---
// ============================================================
// SchoolOS — Laboratorio de Química (Simulador WebGL)
// Layout Cockpit Proporcional: 3 Columnas con Altura 100% Sincronizada
// Diseño Editorial Brutalista Oficial (Vibrant Brutalism)
// ============================================================
import '../styles/tokens.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Laboratorio de Química — SchoolOS</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,800&family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --cream: #F4EFE6;
        --paper: #FDFCF9;
        --ink: #12110E;
        --ink-soft: #4A473E;
        --orange-vibrant: #F25C2B;
        --green-vibrant: #15803D;
        --green-bg: #DCFCE7;
        --line: #E8E3D9;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--cream);
        color: var(--ink);
        font-family: var(--sans);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background-image:
          linear-gradient(rgba(18, 17, 14, 0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(18, 17, 14, 0.035) 1px, transparent 1px);
        background-size: 24px 24px;
      }

      /* ── BARRA SUPERIOR EDITORIAL BRUTALISTA ────────────────────────── */
      .lab-nav {
        background: var(--paper);
        border-bottom: 2px solid var(--ink);
        padding: 12px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 50;
        box-shadow: 0 4px 0 rgba(18, 17, 14, 0.06);
      }

      .nav-left {
        display: flex;
        align-items: center;
        gap: 20px;
      }

      .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--ink);
        background: var(--cream);
        border: 2px solid var(--ink);
        box-shadow: 2.5px 2.5px 0 var(--ink);
        padding: 7px 13px;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.12s ease;
      }

      .btn-back:hover {
        background: var(--orange-vibrant);
        color: #FFFFFF;
        transform: translate(-1px, -1px);
        box-shadow: 3.5px 3.5px 0 var(--ink);
      }

      .btn-back:active {
        transform: translate(2px, 2px);
        box-shadow: 1px 1px 0 var(--ink);
      }

      .lab-title-box h1 {
        font-family: var(--serif);
        font-size: 22px;
        font-weight: 800;
        color: var(--ink);
        letter-spacing: -0.02em;
        margin: 0;
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .lab-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--green-vibrant);
        background: var(--green-bg);
        border: 1.5px solid var(--ink);
        box-shadow: 2px 2px 0 var(--ink);
        padding: 6px 12px;
      }

      .pulse-dot {
        width: 7px;
        height: 7px;
        background: var(--green-vibrant);
        border-radius: 50%;
        animation: pulse 1.6s infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
      }

      .btn-action {
        background: var(--paper);
        border: 2px solid var(--ink);
        box-shadow: 2.5px 2.5px 0 var(--ink);
        color: var(--ink);
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        padding: 7px 13px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.12s ease;
      }

      .btn-action:hover {
        background: var(--cream);
        transform: translate(-1px, -1px);
        box-shadow: 3.5px 3.5px 0 var(--ink);
      }

      .btn-action:active {
        transform: translate(2px, 2px);
        box-shadow: 1px 1px 0 var(--ink);
      }

      .btn-fullscreen {
        background: var(--ink);
        color: #FFFFFF;
      }

      .btn-fullscreen:hover {
        background: var(--orange-vibrant);
        color: #FFFFFF;
      }

      /* ── CONTENEDOR COCKPIT 3 COLUMNAS PROPORCIONAL & EXPANDIDO ───── */
      .lab-cockpit {
        width: calc(100% - 32px);
        max-width: 1920px;
        margin: 14px auto 24px;
        padding: 0 8px;
        display: grid;
        grid-template-columns: 320px 1fr 320px;
        gap: 16px;
        align-items: stretch; /* TODAS LAS COLUMNAS MIDEN EXACTAMENTE LO MISMO */
        justify-content: center;
      }

      @media (max-width: 1600px) {
        .lab-cockpit {
          grid-template-columns: 300px 1fr 300px;
          gap: 14px;
          width: calc(100% - 24px);
        }
      }

      @media (max-width: 1360px) {
        .lab-cockpit {
          grid-template-columns: 280px 1fr 280px;
          gap: 12px;
          width: calc(100% - 16px);
        }
      }

      @media (max-width: 1180px) {
        .lab-cockpit {
          grid-template-columns: 1fr;
          max-width: 1000px;
          width: calc(100% - 24px);
          gap: 18px;
        }
        .lab-nav {
          flex-direction: column;
          align-items: flex-start;
          gap: 12px;
          padding: 14px 18px;
        }
        .nav-actions {
          width: 100%;
          justify-content: space-between;
        }
      }

      /* ── PANELES LATERALES FULL HEIGHT (ALTURA PERFECTA) ─────────────── */
      .side-panel {
        background: var(--paper);
        border: 2.5px solid var(--ink);
        box-shadow: 5px 5px 0 var(--ink);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 16px 18px;
        box-sizing: border-box;
      }

      .panel-top-header {
        display: flex;
        flex-direction: column;
        gap: 6px;
        border-bottom: 2px solid var(--ink);
        padding-bottom: 12px;
        margin-bottom: 12px;
      }

      .panel-tag {
        align-self: flex-start;
        font-family: var(--mono);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 2.5px 7px;
        border: 1.5px solid var(--ink);
        box-shadow: 1.5px 1.5px 0 var(--ink);
      }
      .tag-orange { background: #FFE8DF; color: #C23A0B; }
      .tag-green { background: #E4F5E6; color: #15803D; }
      .tag-yellow { background: #FEF3C7; color: #B45309; }

      .panel-top-header h3 {
        font-family: var(--serif);
        font-size: 16.5px;
        font-weight: 700;
        color: var(--ink);
        margin: 0;
        line-height: 1.25;
      }

      /* ── TABLA DE CONTROLES COMPACTA Y ELEGANTE ──────────────────────── */
      .controls-list {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex: 1;
        gap: 4px;
      }

      .control-item {
        border-bottom: 1px solid var(--line);
        padding: 7px 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .control-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }

      .control-row-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
      }

      .action-title {
        font-size: 12px;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -0.01em;
      }

      .key-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 800;
        background: var(--cream);
        color: var(--ink);
        border: 1.5px solid var(--ink);
        box-shadow: 1.5px 1.5px 0 var(--ink);
        padding: 1.5px 6px;
        line-height: 1.2;
        white-space: nowrap;
        flex-shrink: 0;
      }

      .key-pill.pill-accent {
        background: #FFECE5;
        color: #C23A0B;
        border-color: #12110E;
      }

      .action-hint {
        font-size: 11px;
        color: var(--ink-soft);
        line-height: 1.35;
      }

      /* ── PANEL DERECHO: OBJETIVOS + EVALUACIÓN INTEGRADA ─────────────── */
      .right-content {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        gap: 14px;
      }

      .mission-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 10px;
        font-size: 11.5px;
        color: var(--ink-soft);
      }

      .mission-list li {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        line-height: 1.4;
      }

      .mission-badge {
        font-family: var(--mono);
        font-size: 9.5px;
        font-weight: 800;
        color: var(--ink);
        background: var(--cream);
        border: 1.5px solid var(--ink);
        box-shadow: 1.5px 1.5px 0 var(--ink);
        padding: 1px 5px;
        flex-shrink: 0;
      }

      .academic-box {
        background: var(--cream);
        border: 1.5px solid var(--ink);
        box-shadow: 2.5px 2.5px 0 var(--ink);
        padding: 12px;
        margin-top: auto;
      }

      .academic-title {
        font-family: var(--mono);
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 5px;
      }

      .academic-text {
        font-size: 11px;
        line-height: 1.4;
        color: var(--ink-soft);
      }

      .raw-mode-link {
        font-family: var(--mono);
        font-size: 10.5px;
        font-weight: 800;
        color: var(--orange-vibrant);
        text-decoration: underline;
        margin-top: 8px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }
      .raw-mode-link:hover {
        color: var(--ink);
      }

      /* ── MARCO CENTRAL DEL VISOR 3D (EQUAL HEIGHT WORKSTATION) ────────── */
      .viewport-frame {
        background: #181714;
        border: 2.5px solid var(--ink);
        box-shadow: 6px 6px 0 var(--ink);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
      }

      .viewport-header {
        background: var(--cream);
        border-bottom: 2.5px solid var(--ink);
        padding: 8px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-family: var(--mono);
        font-size: 10.5px;
        font-weight: 800;
        color: var(--ink);
        letter-spacing: 0.05em;
        flex-shrink: 0;
      }

      .window-dots {
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .dot {
        width: 9px;
        height: 9px;
        border: 1.5px solid var(--ink);
        border-radius: 0;
      }
      .dot.red { background: #FF5C5C; }
      .dot.yellow { background: #FFBD2E; }
      .dot.green { background: #27C93F; }

      .viewport-wrapper {
        position: relative;
        width: 100%;
        height: 660px;
        min-height: 620px;
        background: #12110E;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        flex: 1;
      }

      .viewport-iframe {
        width: 100%;
        height: 100%;
        border: none;
        display: block;
        background: #12110E;
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    <!-- BARRA SUPERIOR EDITORIAL -->
    <header class="lab-nav">
      <div class="nav-left">
        <a href="/es/app/student" class="btn-back" id="btnBackPortal">
          ← Volver al Portal
        </a>
        <div class="lab-title-box">
          <h1>Laboratorio de Química</h1>
        </div>
      </div>

      <div class="nav-actions">
        <div class="lab-status-badge">
          <div class="pulse-dot"></div>
          <span>Simulación 3D Activa</span>
        </div>

        <button type="button" class="btn-action" id="btnReloadLab" title="Reiniciar Simulación">
          🔄 Reiniciar
        </button>
      </div>
    </header>

    <!-- COCKPIT 3 COLUMNAS PROPORCIONAL: EXACTAMENTE LA MISMA ALTURA -->
    <main class="lab-cockpit">
      
      <!-- ── PANEL IZQUIERDO: CONTROLES DE DECANTACIÓN ──────────────── -->
      <aside class="side-panel">
        <div class="panel-top-header">
          <span class="panel-tag tag-orange">PRÁCTICA · DECANTACIÓN</span>
          <h3>🎮 Controles de Simulación</h3>
        </div>

        <div class="controls-list">
          <!-- Control 1 -->
          <div class="control-item">
            <div class="control-row-top">
              <span class="action-title">Tomar / Arrastrar</span>
              <span class="key-pill">Clic Izq sostenido</span>
            </div>
            <div class="action-hint">Mueve el vaso o matraz libremente sobre la mesa.</div>
          </div>

          <!-- Control 2 -->
          <div class="control-item">
            <div class="control-row-top">
              <span class="action-title">Soltar objeto</span>
              <span class="key-pill">Soltar Clic</span>
            </div>
            <div class="action-hint">Deja el objeto; bajo el embudo se auto-alinea.</div>
          </div>

          <!-- Control 3 -->
          <div class="control-item">
            <div class="control-row-top">
              <span class="action-title">Rotar recipiente</span>
              <span class="key-pill">Tecla R</span>
            </div>
            <div class="action-hint">Gira el objeto 90° en sentido horario.</div>
          </div>

          <!-- Control 4 -->
          <div class="control-item">
            <div class="control-row-top">
              <span class="action-title">Rotar al revés</span>
              <span class="key-pill">Tecla T</span>
            </div>
            <div class="action-hint">Gira el objeto 90° en sentido anti-horario.</div>
          </div>

          <!-- Control 5 -->
          <div class="control-item">
            <div class="control-row-top">
              <span class="action-title">Llave de Paso</span>
              <span class="key-pill">Clic en Llave</span>
            </div>
            <div class="action-hint">Abre la válvula del embudo para drenar; otro clic la cierra.</div>
          </div>

          <!-- Control 6 -->
          <div class="control-item">
            <div class="control-row-top">
              <span class="action-title">Drenado Agua</span>
              <span class="key-pill pill-accent">Tecla Q</span>
            </div>
            <div class="action-hint">Drena la fase densa (Agua) hacia el vaso receptor.</div>
          </div>

          <!-- Control 7 -->
          <div class="control-item">
            <div class="control-row-top">
              <span class="action-title">Drenado Aceite</span>
              <span class="key-pill pill-accent">Tecla E</span>
            </div>
            <div class="action-hint">Fuerza la salida de la fase superior (Aceite).</div>
          </div>
        </div>
      </aside>

      <!-- ── PANEL CENTRAL: ESTACIÓN DEL SIMULADOR 3D ────────────────── -->
      <section class="viewport-frame" id="labViewportContainer">
        <div class="viewport-header">
          <div style="display:flex; align-items:center; gap:10px;">
            <div class="window-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <span>ESTACIÓN DE SIMULACIÓN CIENTÍFICA</span>
          </div>
          <div>
            <span>ALTA RESOLUCIÓN // 60 FPS</span>
          </div>
        </div>

        <div class="viewport-wrapper">
          <iframe
            id="unityIframe"
            class="viewport-iframe"
            src="/game/index.html"
            allow="fullscreen; autoplay; gamepad; xr-spatial-tracking"
            tabindex="0"
          ></iframe>
        </div>
      </section>

      <!-- ── PANEL DERECHO: PROTOCOLO & BITÁCORA ACADÉMICA ──────────── -->
      <aside class="side-panel">
        <div class="right-content">
          <div>
            <div class="panel-top-header">
              <span class="panel-tag tag-green">PROTOCOLO DIDÁCTICO</span>
              <h3>📋 Práctica: Decantación</h3>
            </div>

            <ul class="mission-list">
              <li>
                <span class="mission-badge">01</span>
                <span><strong>Separación:</strong> Comprobar la inmiscibilidad entre agua y aceite.</span>
              </li>
              <li>
                <span class="mission-badge">02</span>
                <span><strong>Alineación:</strong> Posicionar el vaso receptor debajo del embudo.</span>
              </li>
              <li>
                <span class="mission-badge">03</span>
                <span><strong>Drenado Acuoso:</strong> Abrir llave o pulsar [Q] hasta la interfaz.</span>
              </li>
              <li>
                <span class="mission-badge">04</span>
                <span><strong>Fase Oleosa:</strong> Cambiar recipiente y extraer aceite con [E].</span>
              </li>
            </ul>
          </div>

          <!-- Bloque de Evaluación Integrado al final -->
          <div class="academic-box">
            <div class="academic-title">
              <span>⚡ EVALUACIÓN EN TIEMPO REAL</span>
            </div>
            <p class="academic-text">
              Tus experimentos en el simulador se evalúan y asientan en tu boletín estudiantil de SchoolOS.
            </p>
            <a href="/game/index.html" target="_blank" class="raw-mode-link">
              Abrir simulación en pestaña nueva ↗
            </a>
          </div>
        </div>
      </aside>

    </main>

    <script>
      // 1. Reiniciar simulador
      const btnReloadLab = document.getElementById('btnReloadLab');
      const unityIframe = document.getElementById('unityIframe') as HTMLIFrameElement;

      btnReloadLab?.addEventListener('click', () => {
        if (unityIframe) {
          const currentSrc = unityIframe.src;
          unityIframe.src = 'about:blank';
          setTimeout(() => {
            unityIframe.src = currentSrc;
          }, 150);
        }
      });

      // 3. Adaptar enlace de retorno según rol o sesión activa
      try {
        const rawUser = localStorage.getItem('schoolos-user');
        if (rawUser) {
          const user = JSON.parse(rawUser);
          const backBtn = document.getElementById('btnBackPortal');
          if (backBtn && user.role) {
            if (user.role === 'teacher') backBtn.setAttribute('href', '/es/app/teacher');
            else if (user.role === 'school_admin') backBtn.setAttribute('href', '/es/app/school-admin');
            else if (user.role === 'student') backBtn.setAttribute('href', '/es/app/student');
          }
        }
      } catch (_) {}
    </script>
  </body>
</html>
