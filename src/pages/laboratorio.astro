---
// ============================================================
// SchoolOS — Laboratorio de Química (Simulador WebGL)
// Diseño Editorial Brutalista Oficial (Vibrant Brutalism)
// ============================================================
import '../styles/tokens.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Laboratorio de Química — SchoolOS</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,800&family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --cream: #F4EFE6;
        --paper: #FDFCF9;
        --ink: #12110E;
        --ink-soft: #4A473E;
        --orange-vibrant: #F25C2B;
        --green-vibrant: #15803D;
        --green-bg: #DCFCE7;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--cream);
        color: var(--ink);
        font-family: var(--sans);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background-image:
          linear-gradient(rgba(18, 17, 14, 0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(18, 17, 14, 0.035) 1px, transparent 1px);
        background-size: 24px 24px;
      }

      /* ── BARRA SUPERIOR EDITORIAL BRUTALISTA ────────────────────────── */
      .lab-nav {
        background: var(--paper);
        border-bottom: 2px solid var(--ink);
        padding: 14px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 50;
        box-shadow: 0 4px 0 rgba(18, 17, 14, 0.06);
      }

      .nav-left {
        display: flex;
        align-items: center;
        gap: 20px;
      }

      .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--ink);
        background: var(--cream);
        border: 2px solid var(--ink);
        box-shadow: 2.5px 2.5px 0 var(--ink);
        padding: 8px 14px;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.12s ease;
      }

      .btn-back:hover {
        background: var(--orange-vibrant);
        color: #FFFFFF;
        transform: translate(-1px, -1px);
        box-shadow: 3.5px 3.5px 0 var(--ink);
      }

      .btn-back:active {
        transform: translate(2px, 2px);
        box-shadow: 1px 1px 0 var(--ink);
      }

      .lab-title-box h1 {
        font-family: var(--serif);
        font-size: 22px;
        font-weight: 800;
        color: var(--ink);
        letter-spacing: -0.02em;
        margin: 0;
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .lab-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--green-vibrant);
        background: var(--green-bg);
        border: 1.5px solid var(--ink);
        box-shadow: 2px 2px 0 var(--ink);
        padding: 6px 12px;
      }

      .pulse-dot {
        width: 7px;
        height: 7px;
        background: var(--green-vibrant);
        border-radius: 50%;
        animation: pulse 1.6s infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
      }

      .btn-action {
        background: var(--paper);
        border: 2px solid var(--ink);
        box-shadow: 2.5px 2.5px 0 var(--ink);
        color: var(--ink);
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        padding: 8px 14px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.12s ease;
      }

      .btn-action:hover {
        background: var(--cream);
        transform: translate(-1px, -1px);
        box-shadow: 3.5px 3.5px 0 var(--ink);
      }

      .btn-action:active {
        transform: translate(2px, 2px);
        box-shadow: 1px 1px 0 var(--ink);
      }

      .btn-fullscreen {
        background: var(--ink);
        color: #FFFFFF;
      }

      .btn-fullscreen:hover {
        background: var(--orange-vibrant);
        color: #FFFFFF;
      }

      /* ── CONTENEDOR PRINCIPAL ───────────────────────────────────────── */
      .main-container {
        max-width: 1240px;
        width: 100%;
        margin: 28px auto;
        padding: 0 20px 48px;
        display: flex;
        flex-direction: column;
        gap: 26px;
      }

      /* ── MARCO DE LA ESTACIÓN DE SIMULACIÓN (ESTILO BRUTALISTA) ─────── */
      .viewport-frame {
        background: #181714;
        border: 2.5px solid var(--ink);
        box-shadow: 6px 6px 0 var(--ink);
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }

      .viewport-header {
        background: var(--cream);
        border-bottom: 2.5px solid var(--ink);
        padding: 9px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 800;
        color: var(--ink);
        letter-spacing: 0.05em;
      }

      .window-dots {
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .dot {
        width: 10px;
        height: 10px;
        border: 1.5px solid var(--ink);
        border-radius: 0;
      }
      .dot.red { background: #FF5C5C; }
      .dot.yellow { background: #FFBD2E; }
      .dot.green { background: #27C93F; }

      .viewport-wrapper {
        position: relative;
        width: 100%;
        height: 660px;
        background: #12110E;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }


      @media (max-width: 1024px) {
        .viewport-wrapper {
          height: 520px;
        }
      }

      @media (max-width: 768px) {
        .viewport-wrapper {
          height: 420px;
        }
        .lab-nav {
          flex-direction: column;
          align-items: flex-start;
          gap: 12px;
          padding: 14px 18px;
        }
        .nav-actions {
          width: 100%;
          justify-content: space-between;
        }
      }

      .viewport-iframe {
        width: 100%;
        height: 100%;
        border: none;
        display: block;
        background: #12110E;
        overflow: hidden;
      }


      /* ── GRID DE INFORMACIÓN (TARJETAS BRUTALISTAS) ─────────────────── */
      .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 22px;
      }

      .info-card {
        background: var(--paper);
        border: 2px solid var(--ink);
        box-shadow: 4px 4px 0 var(--ink);
        padding: 22px;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .card-tag {
        align-self: flex-start;
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 3px 8px;
        border: 1.5px solid var(--ink);
        box-shadow: 1.5px 1.5px 0 var(--ink);
      }
      .tag-orange { background: #FFE8DF; color: #C23A0B; }
      .tag-green { background: #E4F5E6; color: #15803D; }
      .tag-yellow { background: #FEF3C7; color: #B45309; }

      .info-card h3 {
        font-family: var(--serif);
        font-size: 18px;
        font-weight: 700;
        color: var(--ink);
        margin: 0;
      }

      /* Tabla de controles */
      .controls-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12.5px;
      }

      .controls-table tr {
        border-bottom: 1px solid var(--line, #E5E0D5);
      }

      .controls-table tr:last-child {
        border-bottom: none;
      }

      .controls-table td {
        padding: 9px 4px;
        color: var(--ink-soft);
      }

      .key-pill {
        display: inline-block;
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 800;
        background: var(--cream);
        color: var(--ink);
        border: 1.5px solid var(--ink);
        box-shadow: 1.5px 1.5px 0 var(--ink);
        padding: 2px 7px;
        margin-right: 4px;
        line-height: 1.2;
      }

      /* Lista de objetivos */
      .mission-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 12px;
        font-size: 12.5px;
        color: var(--ink-soft);
      }

      .mission-list li {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        line-height: 1.45;
      }

      .mission-number {
        font-family: var(--mono);
        font-size: 10.5px;
        font-weight: 800;
        color: var(--ink);
        background: var(--cream);
        border: 1.5px solid var(--ink);
        box-shadow: 1.5px 1.5px 0 var(--ink);
        padding: 1px 5px;
        flex-shrink: 0;
      }

      /* Caja de sincronización */
      .sync-box {
        background: var(--cream);
        border: 1.5px solid var(--ink);
        box-shadow: 2.5px 2.5px 0 var(--ink);
        padding: 14px;
        font-size: 12px;
        line-height: 1.5;
        color: var(--ink-soft);
      }

      .sync-box strong {
        color: var(--ink);
        font-size: 12.5px;
      }

      .open-raw-link {
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 800;
        color: var(--orange-vibrant);
        text-decoration: underline;
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }
      .open-raw-link:hover {
        color: var(--ink);
      }
    </style>
  </head>
  <body>
    <!-- BARRA SUPERIOR EDITORIAL -->
    <header class="lab-nav">
      <div class="nav-left">
        <a href="/es/app/student" class="btn-back" id="btnBackPortal">
          ← Volver al Portal
        </a>
        <div class="lab-title-box">
          <h1>Laboratorio de Química</h1>
        </div>
      </div>

      <div class="nav-actions">
        <div class="lab-status-badge">
          <div class="pulse-dot"></div>
          <span>Simulación 3D Activa</span>
        </div>

        <button type="button" class="btn-action" id="btnReloadLab" title="Reiniciar Simulación">
          🔄 Reiniciar
        </button>

        <button type="button" class="btn-action btn-fullscreen" id="btnFullscreen" title="Pantalla Completa">
          ⛶ Pantalla Completa
        </button>
      </div>
    </header>

    <!-- CUERPO PRINCIPAL -->
    <main class="main-container">
      <!-- MARCO WORKSTATION DEL VISOR 3D (UNITY) -->
      <section class="viewport-frame" id="labViewportContainer">
        <div class="viewport-header">
          <div style="display:flex; align-items:center; gap:10px;">
            <div class="window-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <span>ESTACIÓN DE SIMULACIÓN CIENTÍFICA</span>
          </div>
          <div>
            <span>ALTA RESOLUCIÓN // 60 FPS</span>
          </div>
        </div>

        <div class="viewport-wrapper">
          <iframe
            id="unityIframe"
            class="viewport-iframe"
            src="/game/index.html"
            allow="fullscreen; autoplay; gamepad; xr-spatial-tracking"
            tabindex="0"
          ></iframe>
        </div>
      </section>

      <!-- PANELES EDITORIALES DE APOYO -->
      <section class="info-grid">
        <!-- Tarjeta 1: Controles -->
        <article class="info-card">
          <span class="card-tag tag-orange">MANDOS Y NAVEGACIÓN</span>
          <h3>🎮 Guía de Controles</h3>
          <table class="controls-table">
            <tbody>
              <tr>
                <td style="width:125px;">
                  <span class="key-pill">W</span><span class="key-pill">A</span><span class="key-pill">S</span><span class="key-pill">D</span>
                </td>
                <td>Desplazarse por el laboratorio escolar</td>
              </tr>
              <tr>
                <td><span class="key-pill">Mouse</span></td>
                <td>Mirar alrededor e inspeccionar el instrumental</td>
              </tr>
              <tr>
                <td><span class="key-pill">Clic Izq</span> / <span class="key-pill">E</span></td>
                <td>Tomar reactivos, manipular matraces y pipetas</td>
              </tr>
              <tr>
                <td><span class="key-pill">Espacio</span></td>
                <td>Saltar obstáculos o acción especial</td>
              </tr>
              <tr>
                <td><span class="key-pill">Esc</span></td>
                <td>Liberar cursor del ratón de la ventana 3D</td>
              </tr>
            </tbody>
          </table>
        </article>

        <!-- Tarjeta 2: Objetivos de la Práctica -->
        <article class="info-card">
          <span class="card-tag tag-green">OBJETIVOS DE APRENDIZAJE</span>
          <h3>📋 Objetivos de la Práctica</h3>
          <ul class="mission-list">
            <li>
              <span class="mission-number">01</span>
              <span>Reconocer el instrumental de laboratorio y preparar los reactivos para el ensayo químico.</span>
            </li>
            <li>
              <span class="mission-number">02</span>
              <span>Comprobar las fases de la reacción respetando los protocolos institucionales de bioseguridad.</span>
            </li>
            <li>
              <span class="mission-number">03</span>
              <span>Finalizar los experimentos para consolidar la nota académica en el sistema.</span>
            </li>
          </ul>
        </article>

        <!-- Tarjeta 3: Sincronización Institucional -->
        <article class="info-card">
          <span class="card-tag tag-yellow">EVALUACIÓN Y PROGRESO</span>
          <h3>⚡ Calificación y Avance</h3>
          <div class="sync-box">
            <strong>Sincronización en Tiempo Real:</strong>
            <p style="margin-top:6px;">
              Cada experimento y prueba que concluyas en esta simulación se sincroniza de forma segura con tu cuenta de estudiante.
            </p>
          </div>
          <a href="/game/index.html" target="_blank" class="open-raw-link">
            Abrir simulador en pantalla pura →
          </a>
        </article>
      </section>
    </main>

    <script>
      // 1. Pantalla completa nativa
      const btnFullscreen = document.getElementById('btnFullscreen');
      const viewportContainer = document.getElementById('labViewportContainer');

      btnFullscreen?.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          viewportContainer?.requestFullscreen?.().catch((err) => {
            console.warn('Error solicitando pantalla completa:', err);
          });
        } else {
          document.exitFullscreen?.();
        }
      });

      // 2. Reiniciar simulador
      const btnReloadLab = document.getElementById('btnReloadLab');
      const unityIframe = document.getElementById('unityIframe') as HTMLIFrameElement;

      btnReloadLab?.addEventListener('click', () => {
        if (unityIframe) {
          const currentSrc = unityIframe.src;
          unityIframe.src = 'about:blank';
          setTimeout(() => {
            unityIframe.src = currentSrc;
          }, 150);
        }
      });

      // 3. Adaptar enlace de retorno según rol o sesión activa
      try {
        const rawUser = localStorage.getItem('schoolos-user');
        if (rawUser) {
          const user = JSON.parse(rawUser);
          const backBtn = document.getElementById('btnBackPortal');
          if (backBtn && user.role) {
            if (user.role === 'teacher') backBtn.setAttribute('href', '/es/app/teacher');
            else if (user.role === 'school_admin') backBtn.setAttribute('href', '/es/app/school-admin');
            else if (user.role === 'student') backBtn.setAttribute('href', '/es/app/student');
          }
        }
      } catch (_) {}
    </script>
  </body>
</html>
