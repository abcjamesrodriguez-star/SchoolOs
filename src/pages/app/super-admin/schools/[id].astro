---
// ============================================================
// SchoolOS — Vista de Detalle de Escuela (Español)
// ============================================================
import AppLayout from '../../../../layouts/AppLayout.astro';
import { mockSchools, mockSchoolAdmins, mockJudicialGrants } from '../../../../data/app/mock-data';

export function getStaticPaths() {
  return mockSchools.map((school) => ({
    params: { id: school.id },
    props: { school },
  }));
}

const { school } = Astro.props;
const admins = mockSchoolAdmins[school.id] || [];
const grants = mockJudicialGrants.filter((g) => g.schoolId === school.id);
const hasActiveOrPendingGrant = grants.some((g) => g.status === 'active' || g.status === 'pending_verification');

function getAuditBadge(auditStatus: string) {
  if (auditStatus === 'under_investigation') {
    return { class: 'badge-investigation', label: 'Bajo investigación' };
  }
  if (auditStatus === 'flagged') {
    return { class: 'badge-flagged', label: 'Marcado' };
  }
  return { class: 'badge-none', label: 'Ninguno' };
}

function getStatusLabel(status: string) {
  switch (status) {
    case 'active': return 'Activa';
    case 'trial': return 'En Prueba';
    case 'suspended': return 'Suspendida';
    case 'cancelled': return 'Cancelada';
    default: return status;
  }
}

function getGrantStatusLabel(status: string) {
  switch (status) {
    case 'active': return 'Activo';
    case 'pending_verification': return 'Pendiente de Verificación';
    case 'expired': return 'Expirado';
    case 'revoked': return 'Revocado';
    default: return status;
  }
}

const audit = getAuditBadge(school.auditStatus);
---

<AppLayout
  title={school.name}
  pageTitle="Detalle de la Institución"
  activeSection="schools"
  breadcrumbs={[
    { label: 'Escuelas', href: '/app/super-admin/schools' },
    { label: school.name },
  ]}
>
  <!-- Enlace de regreso -->
  <a class="back-link" href="/app/super-admin/schools">← Volver a Escuelas</a>

  <!-- Header de Detalle -->
  <div class="detail-header">
    <div>
      <div class="title-row">
        <h1>{school.name}</h1>
        <span class={`badge badge-${school.status}`}>
          {getStatusLabel(school.status)}
        </span>
        <span class="plan-tag">{school.planName}</span>
        <span class={`badge ${audit.class}`}>{audit.label}</span>
      </div>
      <div class="sub">
        {school.domain} · {school.location} · Registrado el {school.createdAt}
      </div>
    </div>
    <div class="detail-actions">
      <button class="btn btn-secondary">Cambiar Plan</button>
      <button class="btn btn-secondary">Editar Datos</button>
      <button class="btn btn-danger">Suspender</button>
    </div>
  </div>

  <!-- Grid de Estadísticas -->
  <div class="stat-grid">
    <div class="stat-card">
      <div class="stat-label">Estudiantes</div>
      <div class="stat-num">{school.studentCount}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Docentes</div>
      <div class="stat-num">{school.teacherCount}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Clases Activas</div>
      <div class="stat-num">{school.activeClassesCount}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Estado de Auditoría</div>
      <div class={`stat-num ${school.auditStatus !== 'none' ? 'accent' : ''}`} style="font-size:20px; margin-top:12px;">
        {audit.label}
      </div>
    </div>
  </div>

  <!-- Panel: Administradores de la Escuela -->
  <div class="panel">
    <div class="panel-header">
      <h2>Administradores de la escuela</h2>
      <a class="panel-link" href="#">+ Invitar administrador</a>
    </div>
    <div class="panel-body">
      {admins.length > 0 ? (
        <table class="data-table">
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Correo Electrónico</th>
              <th>Estado</th>
              <th>Último Ingreso</th>
            </tr>
          </thead>
          <tbody>
            {admins.map((adm) => (
              <tr>
                <td class="cell-name">{adm.name}</td>
                <td class="cell-muted">{adm.email}</td>
                <td>
                  <span class={`badge badge-${adm.status}`}>
                    {adm.status === 'active' ? 'Activo' : adm.status}
                  </span>
                </td>
                <td class="cell-muted">{adm.lastLoginAt || 'Nunca'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <div class="empty-state">No hay administradores registrados para esta escuela aún.</div>
      )}
    </div>
  </div>

  <!-- Sección Colapsable: Acceso Judicial con Orden -->
  <details class="collapsible" open={school.auditStatus !== 'none'}>
    <summary>
      <div class="summary-meta">
        <span>Acceso Judicial con Orden</span>
        <span class={`badge ${audit.class}`}>{audit.label}</span>
      </div>
      <span class="chevron">▾</span>
    </summary>
    <div class="panel-body padded">
      <div class="notice restricted">
        <span class="notice-icon">⚠</span>
        <div>
          <strong>Restringido por diseño de seguridad.</strong> Los registros individuales de estudiantes,
          comunicaciones y actividad académica de esta escuela no son visibles aquí a menos que una Orden de Acceso Judicial
          esté <strong>activa</strong> y la información solicitada se encuentre dentro del alcance autorizado.
          Cada consulta bajo una orden activa queda registrada individualmente en el historial de auditoría.
        </div>
      </div>

      {grants.length > 0 ? (
        <table class="data-table" style="margin-bottom: 20px;">
          <thead>
            <tr>
              <th>Nº Expediente / Caso</th>
              <th>Autoridad Judicial</th>
              <th>Alcance Autorizado</th>
              <th>Estado</th>
              <th>Radicado por</th>
              <th>Verificado por</th>
              <th>Vigencia</th>
            </tr>
          </thead>
          <tbody>
            {grants.map((g) => (
              <tr>
                <td class="cell-name">{g.caseReference}</td>
                <td class="cell-muted">{g.issuingAuthority}</td>
                <td class="cell-muted">{g.scope}</td>
                <td>
                  <span class={`badge badge-${g.status}`}>
                    {getGrantStatusLabel(g.status)}
                  </span>
                </td>
                <td class="cell-muted">{g.requestedBy}</td>
                <td class="cell-muted">{g.verifiedBy || '—'}</td>
                <td class="cell-muted">{g.expiresAt}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <div class="empty-state" style="padding: 20px 0;">
          No hay órdenes de acceso judicial registradas para esta escuela.
        </div>
      )}

      <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
        <button
          class="btn btn-secondary"
          disabled={hasActiveOrPendingGrant}
          title={hasActiveOrPendingGrant ? 'Ya existe una orden activa o pendiente para esta escuela' : ''}
        >
          + Solicitar Acceso Judicial
        </button>
        {hasActiveOrPendingGrant && (
          <span class="hint" style="font-size:12px; color:var(--ink-soft);">
            Deshabilitado — ya existe una orden activa para esta escuela.
          </span>
        )}
      </div>
    </div>
  </details>
</AppLayout>
