---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import StudentRegisterModal from '../../../../../components/app/school-admin/StudentRegisterModal.astro';
import StudentCitationModal from '../../../../../components/app/school-admin/StudentCitationModal.astro';

const lang = 'es';
---

<AppLayout
  title="Directorio de Estudiantes"
  pageTitle="Expedientes de Estudiantes"
  activeSection="students"
  role="school_admin"
  schoolName="Institución"
  lang={lang}
  activeRoute="/app/school-admin/students"
  breadcrumbs={[{ label: 'Institución', href: `/${lang}/app/school-admin` }, { label: 'Estudiantes' }]}
>
  <div class="stat-grid" style="margin-bottom:18px;">
    <div class="stat-card">
      <div class="stat-label">MATRÍCULA ACTIVA TOTAL</div>
      <div class="stat-num" id="student-stat-total">0</div>
      <div class="stat-sub" id="student-stat-total-sub">Sin información cargada</div>
    </div>
    <div class="stat-card" style="border-left:4px solid var(--rust);">
      <div class="stat-label">ALERTAS TEMPRANAS</div>
      <div class="stat-num" id="student-stat-risk" style="color:var(--rust);">0</div>
      <div class="stat-sub" id="student-stat-risk-sub" style="font-weight:700; color:var(--rust);">Módulo de notas pendiente</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">ASISTENCIA PROMEDIO</div>
      <div class="stat-num" style="color:var(--olive-dark);">--</div>
      <div class="stat-sub">Sin asistencia registrada</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">CONVIVENCIA</div>
      <div class="stat-num">--</div>
      <div class="stat-sub">Sin información cargada</div>
    </div>
  </div>

  <div class="panel" style="margin-bottom:18px; border-left:4px solid var(--ink); background:var(--paper);">
    <div class="panel-body" style="padding:12px 18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
      <div style="font-size:13px; color:var(--ink);">
        <strong style="font-family:var(--mono); font-size:11px; text-transform:uppercase; margin-right:8px;">[Tenant en vivo]</strong>
        <span id="student-live-banner-text">La matrícula se cargará desde Supabase para esta institución.</span>
      </div>
      <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('studentRegisterModal').style.display='flex';" style="font-size:11px; font-weight:700;">＋ Matricular Alumno</button>
    </div>
  </div>

  <div class="panel" style="margin-bottom:20px; background:var(--cream); padding:12px 16px;">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
      <div style="position:relative; flex:1; min-width:280px;">
        <input id="studentSearchInput" type="text" placeholder="Buscar por estudiante, documento, correo o teléfono..." style="width:100%; padding:7px 12px; border:1px solid var(--ink); background:var(--paper); font-family:var(--sans); font-size:12.5px; border-radius:2px;" />
      </div>
      <select id="filterGrade" style="border:1px solid var(--ink); background:var(--paper); padding:7px 12px; font-family:var(--mono); font-size:11.5px; border-radius:2px;">
        <option value="all">Todos los Grados</option>
      </select>
      <select id="filterAcademicStatus" style="border:1px solid var(--ink); background:var(--paper); padding:7px 12px; font-family:var(--mono); font-size:11.5px; border-radius:2px;">
        <option value="all">Estado: Todos</option>
      </select>
    </div>
  </div>

  <div class="panel" style="margin-bottom:30px;">
    <div class="panel-header" style="background:var(--paper); display:flex; justify-content:space-between; align-items:center; padding:12px 20px; border-bottom:1.5px solid var(--ink);">
      <div style="display:flex; align-items:center; gap:10px;">
        <span class="plan-tag" style="background:var(--ink); color:#FFFFFF; border-color:var(--ink); font-weight:800; font-size:10.5px; padding:2px 7px;">EXPEDIENTES</span>
        <h2 style="font-family:var(--serif); font-size:16.5px; margin:0; font-weight:700; color:var(--ink);">Directorio General de Matrícula</h2>
      </div>
      <div style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft);">Mostrando <strong id="studentCountVisible">0</strong> de <strong id="studentCountTotal">0</strong> registros</div>
    </div>
    <div class="panel-body">
      <table class="data-table" id="studentsTable">
        <thead>
          <tr>
            <th>Estudiante & Documento</th>
            <th>Grado / Sección</th>
            <th>Acudiente & Contacto</th>
            <th>Promedio</th>
            <th>Asistencia</th>
            <th>Estado</th>
            <th style="text-align:right;">Acciones</th>
          </tr>
        </thead>
        <tbody id="studentsTableBody">
          <tr>
            <td colspan="7" style="padding:34px; text-align:center;">
              <div style="font-family:var(--serif); font-size:21px; font-weight:700; color:var(--ink); margin-bottom:6px;">Sin estudiantes vinculados</div>
              <div style="font-size:13px; color:var(--ink-soft); margin-bottom:16px;">Cuando existan estudiantes reales en Supabase, aparecerán aquí.</div>
              <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('studentRegisterModal').style.display='flex';">＋ Matricular Alumno</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <StudentRegisterModal id="studentRegisterModal" lang={lang} />
  <StudentCitationModal id="studentCitationModal" lang={lang} />
</AppLayout>

<script>
  import { schoolAdminTenantService } from '../../../../../services/schoolAdminTenantService';

  function escapeHtml(value) {
    return String(value || '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;',
    }[char]));
  }

  function renderLiveStudents(students, stats) {
    const tbody = document.getElementById('studentsTableBody');
    if (!tbody) return;

    const max = stats?.maxStudentsPlan || 0;
    const total = students.length;
    const usage = max ? Math.round((total / max) * 100) : 0;

    document.getElementById('student-stat-total').innerHTML = `${total} <span style="font-size:16px; font-weight:400; color:var(--ink-soft);">/ ${max || 0}</span>`;
    document.getElementById('student-stat-total-sub').textContent = total ? `${usage}% cupos ocupados según usuarios del tenant` : 'Sin estudiantes vinculados';
    document.getElementById('student-stat-risk').textContent = '0';
    document.getElementById('student-stat-risk-sub').textContent = 'Alertas académicas se conectarán al módulo de notas';
    document.getElementById('student-live-banner-text').innerHTML = `Rectoría está leyendo matrícula viva desde <strong>public.users</strong> filtrada por <strong>school_id</strong>.`;
    document.getElementById('studentCountVisible').textContent = String(total);
    document.getElementById('studentCountTotal').textContent = String(total);

    if (!total) return;

    tbody.innerHTML = students.map((student) => {
      const initials = schoolAdminTenantService.initials(student.name);
      const search = `${student.name} ${student.email} ${student.documentId || ''} ${student.phone || ''}`.toLowerCase();
      return `
        <tr class="student-table-row" data-search-text="${escapeHtml(search)}">
          <td class="cell-name"><div style="display:flex; align-items:center; gap:12px;"><div style="width:34px; height:34px; background:var(--ink); color:#FFFFFF; font-family:var(--mono); font-size:12.5px; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0; border-radius:2px;">${escapeHtml(initials)}</div><div><div style="font-weight:700; font-size:14px;">${escapeHtml(student.name)}</div><div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-top:1px;">${escapeHtml(student.documentType || 'Doc.')} ${escapeHtml(student.documentId || 'Sin documento')} · ${escapeHtml(student.email)}</div></div></div></td>
          <td><span class="plan-tag" style="background:var(--cream); font-weight:800; font-size:11px; padding:3px 8px; border:1.5px solid var(--ink);">Por asignar</span></td>
          <td class="cell-muted"><div style="font-size:12.5px; color:var(--ink); font-weight:700;">Acudiente por registrar</div><div style="font-size:11px; font-family:var(--mono); color:var(--rust); margin-top:2px; font-weight:700;">Tel: ${escapeHtml(student.phone || 'Pendiente')}</div></td>
          <td><span style="font-family:var(--mono); font-weight:800;">--</span><div style="font-family:var(--mono); font-size:10px; color:var(--ink-soft); margin-top:2px;">Sin notas</div></td>
          <td><span style="font-family:var(--mono); font-weight:800;">--</span><div style="font-family:var(--mono); font-size:10px; color:var(--ink-soft);">Sin asistencia</div></td>
          <td><span class="badge badge-${student.status === 'active' ? 'active' : 'suspended'}">${escapeHtml(student.status || 'active')}</span></td>
          <td class="cell-actions"><button type="button" class="btn btn-secondary btn-sm" style="font-size:11px;">Ficha</button></td>
        </tr>
      `;
    }).join('');
  }

  function wireLiveStudentFilters() {
    const searchInput = document.getElementById('studentSearchInput');
    const countVisible = document.getElementById('studentCountVisible');
    searchInput?.addEventListener('input', () => {
      const query = searchInput.value.trim().toLowerCase();
      let count = 0;
      document.querySelectorAll('.student-table-row').forEach((row) => {
        const text = row.getAttribute('data-search-text') || '';
        const show = !query || text.includes(query);
        row.style.display = show ? '' : 'none';
        if (show) count++;
      });
      if (countVisible) countVisible.textContent = String(count);
    });
  }

  async function hydrateStudents() {
    try {
      const context = await schoolAdminTenantService.getTenantContext();
      if (!context) return;
      const [students, stats] = await Promise.all([
        schoolAdminTenantService.getTenantUsers('student'),
        schoolAdminTenantService.getTenantStats(),
      ]);
      renderLiveStudents(students, stats);
      wireLiveStudentFilters();
    } catch (error) {
      console.warn('No se pudo hidratar estudiantes del tenant:', error);
    }
  }

  const studentsLoad = hydrateStudents();
  (window as any).SchoolOSApp?.registerPageLoad(studentsLoad);
</script>
