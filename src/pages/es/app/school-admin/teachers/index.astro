---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import TeacherRegisterModal from '../../../../../components/app/school-admin/TeacherRegisterModal.astro';
import TeacherScheduleModal from '../../../../../components/app/school-admin/TeacherScheduleModal.astro';
import TeacherSubstituteModal from '../../../../../components/app/school-admin/TeacherSubstituteModal.astro';

const lang = 'es';
---

<AppLayout
  title="Cuerpo Docente"
  pageTitle="Planta Docente & Gestión Académica"
  activeSection="teachers"
  role="school_admin"
  schoolName="Institución"
  lang={lang}
  activeRoute="/app/school-admin/teachers"
  breadcrumbs={[{ label: 'Institución', href: `/${lang}/app/school-admin` }, { label: 'Cuerpo Docente' }]}
>
  <div class="stat-grid" style="margin-bottom:18px;">
    <div class="stat-card">
      <div class="stat-label">DOCENTES EN PLANTA</div>
      <div class="stat-num" id="teacher-stat-total">0</div>
      <div class="stat-sub" id="teacher-stat-total-sub">Sin información cargada</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">DOCENTES ACTIVOS</div>
      <div class="stat-num" id="teacher-stat-active">0</div>
      <div class="stat-sub" id="teacher-stat-active-sub">Sin información cargada</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">DISPONIBILIDAD SUPLENCIAS</div>
      <div class="stat-num" style="color:var(--olive-dark);">0</div>
      <div class="stat-sub">Módulo pendiente por conectar</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">CUMPLIMIENTO NOTAS</div>
      <div class="stat-num">--</div>
      <div class="stat-sub">Sin información académica</div>
    </div>
  </div>

  <div class="panel" style="margin-bottom:18px; border-left:4px solid var(--ink);">
    <div id="teacher-live-notice" class="panel-body" style="padding:12px 18px;">
      <div style="font-size:13px; color:var(--ink);">
        <strong style="font-family:var(--mono); font-size:11px; text-transform:uppercase; margin-right:8px;">[Tenant en vivo]</strong>
        La planta docente se cargará desde Supabase para esta institución.
      </div>
    </div>
  </div>

  <div class="panel" style="margin-bottom:20px; background:var(--cream); padding:12px 16px;">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
      <div style="position:relative; flex:1; min-width:280px;">
        <input id="teacherSearchInput" type="text" placeholder="Filtrar por docente, correo o especialidad..." style="width:100%; padding:7px 12px; border:1px solid var(--ink); background:var(--paper); font-family:var(--sans); font-size:12.5px; border-radius:2px;" />
      </div>
      <select id="filterCapacity" style="border:1px solid var(--ink); background:var(--paper); padding:7px 12px; font-family:var(--mono); font-size:11.5px; border-radius:2px;">
        <option value="all">Todos los Docentes</option>
        <option value="free">Disponibles para Suplencias</option>
        <option value="directors">Directores de Grupo</option>
        <option value="leave">Con Novedad de Salud</option>
      </select>
      <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('inviteModal').style.display='flex';" style="font-size:11.5px; font-weight:700;">＋ Vincular Docente</button>
    </div>
  </div>

  <div id="departmentsContainer" style="display:flex; flex-direction:column; gap:22px; margin-bottom:30px;">
    <div class="panel" style="border:2px dashed var(--ink); background:var(--paper);">
      <div class="panel-body" style="padding:34px; text-align:center;">
        <div style="font-family:var(--serif); font-size:21px; font-weight:700; color:var(--ink); margin-bottom:6px;">Sin docentes vinculados</div>
        <div style="font-size:13px; color:var(--ink-soft); margin-bottom:16px;">Cuando existan docentes reales en Supabase, aparecerán aquí.</div>
        <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('inviteModal').style.display='flex';">＋ Vincular Docente</button>
      </div>
    </div>
  </div>

  <TeacherScheduleModal id="teacherScheduleModal" lang={lang} />
  <TeacherSubstituteModal id="teacherSubstituteModal" lang={lang} teachers={[]} />
  <TeacherRegisterModal id="inviteModal" lang={lang} departments={[]} />
</AppLayout>

<script>
  import { schoolAdminTenantService } from '../../../../../services/schoolAdminTenantService';

  function escapeHtml(value) {
    return String(value || '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;',
    }[char]));
  }

  function renderLiveTeachers(teachers) {
    const container = document.getElementById('departmentsContainer');
    if (!container) return;

    const total = teachers.length;
    const active = teachers.filter((teacher) => teacher.status === 'active').length;
    document.getElementById('teacher-stat-total').textContent = String(total);
    document.getElementById('teacher-stat-total-sub').textContent = total ? 'Datos vivos del tenant actual' : 'Sin docentes vinculados';
    document.getElementById('teacher-stat-active').innerHTML = `${active} <span style="font-size:16px; font-weight:400; color:var(--ink-soft);">/ ${total}</span>`;
    document.getElementById('teacher-stat-active-sub').textContent = total ? 'Docentes activos en Supabase' : 'Vincula el primer docente desde el botón superior';

    if (!total) return;

    container.innerHTML = `
      <div class="dept-block panel" data-dept-id="tenant-live">
        <div class="panel-header" style="background:var(--cream); display:flex; justify-content:space-between; align-items:center; padding:12px 20px;">
          <div style="display:flex; align-items:center; gap:10px;">
            <span class="plan-tag" style="background:var(--ink); color:#FFFFFF; border-color:var(--ink); font-weight:800; font-size:10.5px; padding:2px 7px;">TENANT</span>
            <h2 style="font-family:var(--serif); font-size:16.5px; margin:0; font-weight:700; color:var(--ink);">Planta Docente Registrada</h2>
          </div>
          <div style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft);"><strong>${total} docentes</strong> · ${active} activos</div>
        </div>
        <div class="panel-body">
          <table class="data-table">
            <thead><tr><th>Docente</th><th>Correo / Contacto</th><th>Cargo</th><th>Estado</th><th style="text-align:right;">Acciones</th></tr></thead>
            <tbody>
              ${teachers.map((teacher) => {
                const initials = schoolAdminTenantService.initials(teacher.name);
                const search = `${teacher.name} ${teacher.email} ${teacher.specialty || ''} ${teacher.jobTitle || ''}`.toLowerCase();
                return `
                  <tr class="teacher-table-row" data-search-text="${escapeHtml(search)}" data-has-free="false" data-is-director="false" data-has-leave="false">
                    <td class="cell-name"><div style="display:flex; align-items:center; gap:12px;"><div style="width:34px; height:34px; background:var(--ink); color:#FFFFFF; font-family:var(--mono); font-size:12.5px; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0; border-radius:2px;">${escapeHtml(initials)}</div><div><div style="font-weight:700; font-size:14px;">${escapeHtml(teacher.name)}</div><div style="font-size:11.5px; color:var(--ink-soft); margin-top:1px;">${escapeHtml(teacher.specialty || 'Docente de área')}</div></div></div></td>
                    <td class="cell-muted"><div style="font-family:var(--mono); font-size:11.5px; color:var(--rust); font-weight:700;">${escapeHtml(teacher.email)}</div><div style="font-size:11px; color:var(--ink-soft);">${escapeHtml(teacher.phone || 'Sin teléfono registrado')}</div></td>
                    <td><span class="plan-tag">${escapeHtml(teacher.jobTitle || 'Docente')}</span></td>
                    <td><span class="badge badge-${teacher.status === 'active' ? 'active' : 'suspended'}">${teacher.status === 'active' ? 'Activo' : escapeHtml(teacher.status)}</span></td>
                    <td class="cell-actions"><button type="button" class="btn btn-secondary btn-sm" style="font-size:11px;">Ficha</button></td>
                  </tr>
                `;
              }).join('')}
            </tbody>
          </table>
        </div>
      </div>
    `;
  }

  function wireLiveTeacherFilters() {
    const searchInput = document.getElementById('teacherSearchInput');
    const filterCap = document.getElementById('filterCapacity');
    function applyFilters() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      const selectedCap = filterCap?.value || 'all';
      document.querySelectorAll('.teacher-table-row').forEach((row) => {
        const text = row.getAttribute('data-search-text') || '';
        const hasFree = row.getAttribute('data-has-free') === 'true';
        const isDirector = row.getAttribute('data-is-director') === 'true';
        const hasLeave = row.getAttribute('data-has-leave') === 'true';
        let matchCap = true;
        if (selectedCap === 'free') matchCap = hasFree;
        if (selectedCap === 'directors') matchCap = isDirector;
        if (selectedCap === 'leave') matchCap = hasLeave;
        row.style.display = (!query || text.includes(query)) && matchCap ? '' : 'none';
      });
    }
    searchInput?.addEventListener('input', applyFilters);
    filterCap?.addEventListener('change', applyFilters);
  }

  async function hydrateTeachers() {
    try {
      const context = await schoolAdminTenantService.getTenantContext();
      if (!context) return;
      const teachers = await schoolAdminTenantService.getTenantUsers('teacher');
      renderLiveTeachers(teachers);
      wireLiveTeacherFilters();
    } catch (error) {
      console.warn('No se pudo hidratar docentes del tenant:', error);
    }
  }

  const teachersLoad = hydrateTeachers();
  (window as any).SchoolOSApp?.registerPageLoad(teachersLoad);
</script>
