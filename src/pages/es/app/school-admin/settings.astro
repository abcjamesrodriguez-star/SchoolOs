---
// ============================================================
// SchoolOS — Configuración del Colegio (/es/app/school-admin/settings)
// ============================================================
import AppLayout from '../../../../layouts/AppLayout.astro';

const lang = 'es';
---

<AppLayout
  title="Configuración"
  pageTitle="Configuración Institucional & Plan"
  activeSection="settings"
  role="school_admin"
  schoolName="Institución"
  lang={lang}
  activeRoute="/app/school-admin/settings"
  breadcrumbs={[{ label: 'Institución', href: `/${lang}/app/school-admin` }, { label: 'Configuración' }]}
>
  <div style="display:grid; grid-template-columns: 1fr 1fr; gap:24px;">
    
    <!-- PANEL 1: DATOS INSTITUCIONALES -->
    <div class="panel">
      <div class="panel-header">
        <h2>01 · IDENTIDAD Y DATOS DEL COLEGIO</h2>
      </div>
      <div class="panel-body padded">
        <form onsubmit="event.preventDefault(); alert('¡Datos institucionales actualizados!');">
          <div class="form-grid">
            <div class="form-field full">
              <label>Nombre Oficial de la Institución</label>
              <input id="settings-school-name" type="text" value="" placeholder="Sin información" required />
            </div>

            <div class="form-field">
              <label>Código DANE / Registro Educativo</label>
              <input id="settings-school-dane" type="text" value="" placeholder="Sin información" style="font-family:var(--mono);" />
            </div>

            <div class="form-field">
              <label>Ciudad y País</label>
              <input id="settings-school-city" type="text" value="" placeholder="Sin información" required />
            </div>

            <div class="form-field full">
              <label>Dirección Sede Principal</label>
              <input id="settings-school-address" type="text" value="" placeholder="Sin información" />
            </div>

            <div class="form-field full">
              <label>Correo Electrónico de Rectoría</label>
              <input id="settings-school-email" type="email" value="" placeholder="Sin información" required style="font-family:var(--mono);" />
            </div>
          </div>

          <div style="margin-top:20px; text-align:right;">
            <button type="submit" class="btn btn-primary btn-sm">Guardar Cambios</button>
          </div>
        </form>
      </div>
    </div>

    <!-- PANEL 2: PLAN Y CAPACIDAD -->
    <div class="panel">
      <div class="panel-header">
        <h2>02 · ESTADO DE SUSCRIPCIÓN & CUPOS</h2>
      </div>
      <div class="panel-body padded">
        <div style="background:var(--cream); border:1px solid var(--ink); padding:16px; margin-bottom:18px;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
            <span id="settings-plan-name" class="plan-tag" style="background:var(--ink); color:#FFFFFF; border-color:var(--ink); font-weight:700;">Sin plan cargado</span>
            <span id="settings-plan-status" class="badge badge-pending">Sin información</span>
          </div>
          <div id="settings-plan-price" style="font-family:var(--serif); font-size:22px; font-weight:700; margin:6px 0;">--</div>
          <div id="settings-plan-renewal" style="font-size:12px; color:var(--ink-soft);">Sin información de facturación.</div>
        </div>

        <div style="margin-bottom:18px;">
          <div style="display:flex; justify-content:space-between; font-family:var(--mono); font-size:11.5px; margin-bottom:6px;">
            <span>Consumo de Matrícula:</span>
            <strong id="settings-capacity-label">0 / 0 alumnos (0%)</strong>
          </div>
          <div style="width:100%; height:6px; background:var(--line); overflow:hidden;">
            <div id="settings-capacity-bar" style="width:0%; height:100%; background:var(--rust);"></div>
          </div>
          <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-top:4px;">
            <span id="settings-capacity-free">Sin cupos cargados.</span>
          </div>
        </div>

        <div style="border-top:1px dashed var(--line); padding-top:16px;">
          <button class="btn btn-secondary btn-sm" style="width:100%; text-align:center;" type="button" disabled>
            Solicitar Ampliación de Cupos al Equipo SchoolOS →
          </button>
        </div>
      </div>
    </div>

    <!-- PANEL 3: SEGURIDAD DE CUENTA -->
    <div class="panel" style="grid-column: span 2;">
      <div class="panel-header">
        <h2>03 · SEGURIDAD DE CUENTA DEL RECTOR</h2>
      </div>
      <div class="panel-body padded">
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px; align-items:start;">
          <div style="background:var(--cream); border:1px solid var(--line-strong); padding:16px;">
            <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">Protocolo institucional</div>
            <div style="font-family:var(--serif); font-size:19px; font-weight:700; color:var(--ink); margin-top:6px;">Cambios auditados por Super Admin</div>
            <div style="font-size:13px; color:var(--ink-soft); margin-top:8px; line-height:1.45;">
              Por seguridad no se muestran contraseñas anteriores. Si pierdes acceso, crea una solicitud y el equipo central ejecutará el cambio desde un canal seguro.
            </div>
          </div>

          <form id="own-password-ticket-form" style="border:1px solid var(--ink); background:var(--paper); padding:16px;">
            <div class="form-field" style="margin-bottom:12px;">
              <label>Motivo de la solicitud</label>
              <textarea id="own-password-ticket-reason" rows="4" required placeholder="Describe por qué necesitas restablecer la contraseña."></textarea>
            </div>
            <div class="form-field" style="margin-bottom:12px;">
              <label>Método preferido</label>
              <select id="own-password-ticket-method">
                <option value="manual_support">Soporte manual</option>
                <option value="recovery_link">Enlace de recuperación</option>
              </select>
            </div>
            <div id="own-password-ticket-feedback" style="display:none; padding:10px 14px; margin-bottom:12px; font-family:var(--mono); font-size:12px; font-weight:600;"></div>
            <button id="own-password-ticket-submit" type="submit" class="btn btn-primary btn-sm">Solicitar cambio de contraseña</button>
          </form>
        </div>

        <div style="margin-top:22px;">
          <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:10px;">Mis solicitudes recientes</div>
          <div id="own-password-ticket-list" style="border:1px solid var(--line-strong);">
            <div class="empty-state" style="padding:22px;">Cargando solicitudes...</div>
          </div>
        </div>
      </div>
    </div>

    <!-- PANEL 3: DOMINIO Y CONECTIVIDAD -->
    <div class="panel" style="grid-column: span 2;">
      <div class="panel-header">
        <h2>04 · DOMINIO WEB & PROTOCOLOS DE ACCESO</h2>
      </div>
      <div class="panel-body padded">
        <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:16px;">
          <div style="background:var(--cream); border:1px solid var(--line-strong); padding:14px 16px;">
            <div style="font-family:var(--mono); font-size:10px; text-transform:uppercase; color:var(--ink-soft);">Subdominio Asignado</div>
            <div id="settings-subdomain" style="font-family:var(--mono); font-size:13px; font-weight:700; color:var(--ink); margin-top:4px;">Sin información</div>
            <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-top:2px;">Pendiente configurar dominio</div>
          </div>

          <div style="background:var(--cream); border:1px solid var(--line-strong); padding:14px 16px;">
            <div style="font-family:var(--mono); font-size:10px; text-transform:uppercase; color:var(--ink-soft);">Zona Horaria del Tenant</div>
            <div style="font-family:var(--serif); font-size:15px; font-weight:700; color:var(--ink); margin-top:4px;">America/Bogota (UTC-5)</div>
            <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-top:2px;">Configuración regional predeterminada</div>
          </div>

          <div style="background:var(--cream); border:1px solid var(--line-strong); padding:14px 16px;">
            <div style="font-family:var(--mono); font-size:10px; text-transform:uppercase; color:var(--ink-soft);">Auditoría del Sistema</div>
            <div id="settings-audit-status" style="font-family:var(--serif); font-size:15px; font-weight:700; color:var(--ink); margin-top:4px;">Sin alertas</div>
            <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-top:2px;">Sin información judicial cargada</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</AppLayout>

<script>
  import { schoolAdminTenantService } from '../../../../services/schoolAdminTenantService';
  import { apiClient } from '../../../../lib/apiClient';

  function badgeClass(status: string) {
    if (status === 'completed') return 'badge-active';
    if (status === 'rejected' || status === 'failed') return 'badge-revoked';
    if (status === 'expired' || status === 'cancelled') return 'badge-expired';
    return 'badge-pending';
  }

  function escapeHtml(value: any) {
    return String(value || '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function renderTickets(tickets: any[]) {
    const list = document.getElementById('own-password-ticket-list');
    if (!list) return;

    if (!tickets.length) {
      list.innerHTML = '<div class="empty-state" style="padding:22px;">No tienes solicitudes de contraseña registradas.</div>';
      return;
    }

    list.innerHTML = tickets.map((ticket) => `
      <div style="display:grid; grid-template-columns:140px 1fr 130px; gap:14px; padding:14px 16px; border-bottom:1px solid var(--line); align-items:center;">
        <span class="badge ${badgeClass(ticket.status)}">${escapeHtml(ticket.status)}</span>
        <div>
          <div style="font-weight:700;">${escapeHtml(ticket.reason)}</div>
          <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft); margin-top:3px;">${escapeHtml(ticket.resetMethod)}</div>
        </div>
        <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); text-align:right;">${new Date(ticket.createdAt).toLocaleDateString('es-CO')}</div>
      </div>
    `).join('');
  }

  // ─── Cargar tickets propios via API (no directo a Supabase) ───────────────
  async function loadOwnPasswordTickets() {
    try {
      const json = await apiClient.get('/api/school-admin/password-tickets');
      if (json.ok) {
        renderTickets(json.tickets || []);
      } else {
        throw new Error(json.error || 'Error desconocido');
      }
    } catch (err) {
      console.error('Error cargando tickets propios:', err);
      const list = document.getElementById('own-password-ticket-list');
      if (list) list.innerHTML = '<div class="empty-state" style="padding:22px;">No fue posible cargar las solicitudes.</div>';
    }
  }

  async function hydrateSettings() {
    try {
      const [context, stats] = await Promise.all([
        schoolAdminTenantService.getTenantContext(),
        schoolAdminTenantService.getTenantStats(),
      ]);

      if (context?.school) {
        const school = context.school;
        const name = document.getElementById('settings-school-name') as HTMLInputElement;
        const email = document.getElementById('settings-school-email') as HTMLInputElement;
        const city = document.getElementById('settings-school-city') as HTMLInputElement;
        const dane = document.getElementById('settings-school-dane') as HTMLInputElement;
        const address = document.getElementById('settings-school-address') as HTMLInputElement;
        const plan = document.getElementById('settings-plan-name');
        const status = document.getElementById('settings-plan-status');
        const subdomain = document.getElementById('settings-subdomain');
        const audit = document.getElementById('settings-audit-status');

        if (name) name.value = school.name || '';
        if (email) email.value = school.rectorEmail || context.user?.email || '';
        if (city) city.value = [school.location, school.country].filter(Boolean).join(', ');
        if (dane) dane.value = '';
        if (address) address.value = school.address || '';
        if (plan) plan.textContent = school.planName ? `Plan ${school.planName}` : 'Sin plan cargado';
        if (status) {
          status.textContent = school.status || 'Sin información';
          status.className = `badge badge-${school.status || 'pending'}`;
        }
        if (subdomain) subdomain.textContent = school.domain || school.slug || 'Sin información';
        if (audit) audit.textContent = school.auditStatus && school.auditStatus !== 'none' ? school.auditStatus : 'Sin alertas';
      }

      if (stats) {
        const label = document.getElementById('settings-capacity-label');
        const bar = document.getElementById('settings-capacity-bar') as HTMLElement;
        const free = document.getElementById('settings-capacity-free');
        if (label) label.textContent = `${stats.totalStudents} / ${stats.maxStudentsPlan} alumnos (${stats.planUsagePercent}%)`;
        if (bar) bar.style.width = `${Math.min(stats.planUsagePercent, 100)}%`;
        if (free) free.textContent = `${Math.max(stats.maxStudentsPlan - stats.totalStudents, 0)} cupos restantes disponibles.`;
      }
    } catch (error) {
      console.warn('No se pudo hidratar configuración del tenant:', error);
    }
  }

  const settingsLoad = Promise.all([
    hydrateSettings(),
    loadOwnPasswordTickets(),
  ]);
  (window as any).SchoolOSApp?.registerPageLoad(settingsLoad);

  const form = document.getElementById('own-password-ticket-form');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const reasonInput = document.getElementById('own-password-ticket-reason') as HTMLTextAreaElement;
    const methodInput = document.getElementById('own-password-ticket-method') as HTMLSelectElement;
    const feedback = document.getElementById('own-password-ticket-feedback') as HTMLElement;
    const submit = document.getElementById('own-password-ticket-submit') as HTMLButtonElement;
    const reason = reasonInput?.value.trim() || '';

    if (!reason) {
      feedback.style.cssText = 'display:block; padding:10px 14px; background:#FEE2E2; border:1px solid var(--danger); color:var(--danger); font-family:var(--mono); font-size:12px; font-weight:600; margin-bottom:12px;';
      feedback.textContent = 'Escribe el motivo de la solicitud.';
      return;
    }

    try {
      submit.disabled = true;
      submit.textContent = 'Enviando solicitud...';
      feedback.style.display = 'none';

      // ✅ Via API segura — no directo a Supabase
      const json = await apiClient.post('/api/school-admin/password-tickets', {
        reason,
        resetMethod: methodInput?.value || 'manual_support'
      });
      if (!json.ok) throw new Error(json.error || 'Error desconocido');

      feedback.style.cssText = 'display:block; padding:10px 14px; background:#E6F4EA; border:1px solid var(--sage-dark); color:var(--sage-dark); font-family:var(--mono); font-size:12px; font-weight:600; margin-bottom:12px;';
      feedback.textContent = 'Solicitud enviada al Super Admin.';
      reasonInput.value = '';
      await loadOwnPasswordTickets();
    } catch (err: any) {
      console.error('Error creando solicitud propia:', err);
      feedback.style.cssText = 'display:block; padding:10px 14px; background:#FEE2E2; border:1px solid var(--danger); color:var(--danger); font-family:var(--mono); font-size:12px; font-weight:600; margin-bottom:12px;';
      feedback.textContent = 'No fue posible enviar la solicitud. Verifica tu sesión de rector.';
    } finally {
      submit.disabled = false;
      submit.textContent = 'Solicitar cambio de contraseña';
    }
  });
</script>
