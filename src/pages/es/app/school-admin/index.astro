---
import AppLayout from '../../../../layouts/AppLayout.astro';
import InviteUserModal from '../../../../components/app/school-admin/InviteUserModal.astro';

const lang = 'es';
---

<AppLayout
  title="Despacho de Rectoría"
  pageTitle="Centro de Mando Institucional"
  activeSection="dashboard"
  role="school_admin"
  schoolName="Institución"
  lang={lang}
  activeRoute="/app/school-admin"
  breadcrumbs={[{ label: 'Institución' }, { label: 'Despacho de Rectoría' }]}
>
  <div style="background:var(--paper); border:2px solid var(--ink); padding:14px 20px; margin-bottom:24px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; box-shadow:4px 4px 0 rgba(18, 17, 14, 0.08);">
    <div style="display:flex; align-items:center; gap:12px;">
      <span class="plan-tag" style="background:var(--ink); color:#FFFFFF; border-color:var(--ink); font-weight:900; font-size:11px; padding:3px 8px; letter-spacing:0.06em;">TENANT ACTIVO</span>
      <span style="font-family:var(--mono); font-size:12.5px; font-weight:700; color:var(--ink);" data-tenant-name>INSTITUCIÓN</span>
    </div>
    <div style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft);">Datos vivos desde Supabase</div>
  </div>

  <div class="stat-grid" style="margin-bottom:24px;">
    <div class="stat-card" style="border:2px solid var(--ink);">
      <div class="stat-label">Estudiantes</div>
      <div class="stat-num" id="dashboard-stat-students" style="color:var(--ink); font-size:32px;">0</div>
      <div class="stat-sub" id="dashboard-stat-students-sub">Sin información cargada</div>
    </div>
    <div class="stat-card" style="border:2px solid var(--ink);">
      <div class="stat-label">Docentes</div>
      <div class="stat-num" id="dashboard-stat-teachers" style="color:var(--ink); font-size:32px;">0</div>
      <div class="stat-sub" id="dashboard-stat-teachers-sub">Sin información cargada</div>
    </div>
    <div class="stat-card" style="border:2px solid var(--ink);">
      <div class="stat-label">Cursos</div>
      <div class="stat-num accent" id="dashboard-stat-courses" style="color:var(--rust); font-size:32px;">0</div>
      <div class="stat-sub" id="dashboard-stat-courses-sub">Sin cursos creados todavía</div>
    </div>
    <div class="stat-card" style="border:2px solid var(--ink);">
      <div class="stat-label">Capacidad</div>
      <div class="stat-num" id="dashboard-stat-capacity" style="color:var(--ink); font-size:32px;">0%</div>
      <div class="stat-sub" id="dashboard-stat-capacity-sub">Sin matrícula activa</div>
    </div>
  </div>

  <div style="display:grid; grid-template-columns: 2fr 1fr; gap:24px; margin-bottom:28px;">
    <div class="panel" style="border:2px solid var(--ink);">
      <div class="panel-header">
        <h2>Actividad Institucional</h2>
      </div>
      <div class="panel-body" id="dashboard-live-activity" style="padding:34px; text-align:center;">
        <div style="font-family:var(--serif); font-size:21px; font-weight:700; color:var(--ink); margin-bottom:6px;">Sin información operativa</div>
        <div style="font-size:13px; color:var(--ink-soft); max-width:640px; margin:0 auto;">
          Cuando se creen cursos, estudiantes, docentes, novedades y reportes reales para este tenant, se mostrarán aquí.
        </div>
      </div>
    </div>

    <div style="display:flex; flex-direction:column; gap:20px;">
      <div class="panel" style="border:2px solid var(--ink); box-shadow:4px 4px 0 rgba(18, 17, 14, 0.08);">
        <div class="panel-header" style="background:var(--ink); color:#FFFFFF;">
          <h2 style="font-size:12px; color:#FFFFFF; letter-spacing:0.08em;">Acciones de Rectoría</h2>
        </div>
        <div class="panel-body padded" style="display:flex; flex-direction:column; gap:10px;">
          <a href={`/${lang}/app/school-admin/courses`} class="btn btn-secondary" style="justify-content:space-between; display:flex; font-size:12px; padding:10px 12px;"><span>Ver cursos</span><span>→</span></a>
          <a href={`/${lang}/app/school-admin/teachers`} class="btn btn-secondary" style="justify-content:space-between; display:flex; font-size:12px; padding:10px 12px;"><span>Ver docentes</span><span>→</span></a>
          <a href={`/${lang}/app/school-admin/students`} class="btn btn-secondary" style="justify-content:space-between; display:flex; font-size:12px; padding:10px 12px;"><span>Ver estudiantes</span><span>→</span></a>
          <button type="button" class="btn btn-primary" onclick="document.getElementById('inviteModal').style.display='flex';" style="justify-content:space-between; display:flex; font-size:12px; padding:10px 12px;"><span>Invitar usuario</span><span>＋</span></button>
        </div>
      </div>

      <div class="panel" style="border:1.5px solid var(--ink); background:var(--cream); padding:16px;">
        <div style="font-family:var(--mono); font-size:10.5px; font-weight:800; text-transform:uppercase; color:var(--ink-soft); margin-bottom:6px;">Capacidad de Matrícula</div>
        <div style="font-family:var(--serif); font-size:20px; font-weight:700; color:var(--ink);"><span id="dashboard-capacity-text">0 / 0 estudiantes</span></div>
        <div style="width:100%; height:5px; background:var(--line); margin:8px 0; border:1px solid var(--ink);">
          <div id="dashboard-capacity-bar" style="width:0%; height:100%; background:var(--rust);"></div>
        </div>
        <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft); display:flex; justify-content:space-between;">
          <span id="dashboard-capacity-usage">Ocupación: 0%</span>
          <span id="dashboard-capacity-free">0 cupos</span>
        </div>
      </div>
    </div>
  </div>

  <InviteUserModal id="inviteModal" defaultRole="teacher" lang={lang} />
</AppLayout>

<script>
  import { schoolAdminTenantService } from '../../../../services/schoolAdminTenantService';

  async function hydrateDashboard() {
    try {
      const context = await schoolAdminTenantService.getTenantContext();
      if (!context) return;
      const stats = await schoolAdminTenantService.getTenantStats();
      if (!stats) return;

      const students = document.getElementById('dashboard-stat-students');
      const studentsSub = document.getElementById('dashboard-stat-students-sub');
      const teachers = document.getElementById('dashboard-stat-teachers');
      const teachersSub = document.getElementById('dashboard-stat-teachers-sub');
      const courses = document.getElementById('dashboard-stat-courses');
      const coursesSub = document.getElementById('dashboard-stat-courses-sub');
      const capacity = document.getElementById('dashboard-stat-capacity');
      const capacitySub = document.getElementById('dashboard-stat-capacity-sub');
      const capacityText = document.getElementById('dashboard-capacity-text');
      const capacityBar = document.getElementById('dashboard-capacity-bar');
      const capacityUsage = document.getElementById('dashboard-capacity-usage');
      const capacityFree = document.getElementById('dashboard-capacity-free');
      const activity = document.getElementById('dashboard-live-activity');

      if (students) students.textContent = String(stats.totalStudents);
      if (studentsSub) studentsSub.textContent = stats.totalStudents ? 'Estudiantes vinculados al tenant' : 'Sin estudiantes vinculados';
      if (teachers) teachers.textContent = String(stats.totalTeachers);
      if (teachersSub) teachersSub.textContent = stats.totalTeachers ? 'Docentes vinculados al tenant' : 'Sin docentes vinculados';
      if (courses) courses.textContent = String(stats.activeCourses);
      if (coursesSub) coursesSub.textContent = stats.activeCourses ? 'Cursos activos en Supabase' : 'Sin cursos creados todavía';
      if (capacity) capacity.textContent = `${stats.planUsagePercent}%`;
      if (capacitySub) capacitySub.textContent = `${Math.max(stats.maxStudentsPlan - stats.totalStudents, 0)} cupos disponibles`;
      if (capacityText) capacityText.textContent = `${stats.totalStudents} / ${stats.maxStudentsPlan} estudiantes`;
      if (capacityBar) capacityBar.style.width = `${Math.min(stats.planUsagePercent, 100)}%`;
      if (capacityUsage) capacityUsage.textContent = `Ocupación: ${stats.planUsagePercent}%`;
      if (capacityFree) capacityFree.textContent = `${Math.max(stats.maxStudentsPlan - stats.totalStudents, 0)} cupos`;

      if (activity && (stats.totalStudents || stats.totalTeachers || stats.activeCourses)) {
        activity.innerHTML = `
          <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:14px; text-align:left;">
            <div style="border:1px solid var(--line-strong); background:var(--cream); padding:16px;"><div style="font-family:var(--mono); font-size:10px; color:var(--ink-soft); text-transform:uppercase;">Estudiantes</div><div style="font-family:var(--serif); font-size:24px; font-weight:700;">${stats.totalStudents}</div></div>
            <div style="border:1px solid var(--line-strong); background:var(--cream); padding:16px;"><div style="font-family:var(--mono); font-size:10px; color:var(--ink-soft); text-transform:uppercase;">Docentes</div><div style="font-family:var(--serif); font-size:24px; font-weight:700;">${stats.totalTeachers}</div></div>
            <div style="border:1px solid var(--line-strong); background:var(--cream); padding:16px;"><div style="font-family:var(--mono); font-size:10px; color:var(--ink-soft); text-transform:uppercase;">Cursos</div><div style="font-family:var(--serif); font-size:24px; font-weight:700;">${stats.activeCourses}</div></div>
          </div>
        `;
      }
    } catch (error) {
      console.warn('No se pudo hidratar dashboard de Rectoría:', error);
    }
  }

  const dashboardLoad = hydrateDashboard();
  (window as any).SchoolOSApp?.registerPageLoad(dashboardLoad);
</script>
