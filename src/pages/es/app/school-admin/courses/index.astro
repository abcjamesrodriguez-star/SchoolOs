  // ── 2. REVISIÓN POR SALÓN / CURSO (POPUP & MATRIZ) ────────────
  function getAllClassroomsList(): string[] {
    const allRooms: string[] = [];
    cachedCapacities.forEach((g) => {
      if (g.isOffered !== false && g.sectionsCount > 0) {
        for (let i = 1; i <= g.sectionsCount; i++) {
          allRooms.push(`${g.gradeLevel}-${i}`);
        }
      }
    });
    return allRooms;
  }

  (window as any)._openClassroomPicker = function() {
    const rooms = getAllClassroomsList();
    if ((window as any).openClassroomPickerModal) {
      (window as any).openClassroomPickerModal(rooms, selectedClassroomId, (chosenRoom: string) => {
        selectedClassroomId = chosenRoom;
        renderClassroomSchedule();
      });
    }
  };

  (window as any)._selectClassroom = function(classroom: string) {
    selectedClassroomId = classroom;
    renderClassroomSchedule();
  };

