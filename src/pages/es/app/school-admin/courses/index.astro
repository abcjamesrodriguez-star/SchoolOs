    (window as any)._editSubject = function(subjectId: string) {
      const found = cachedCurriculum.find((c) => c.id === subjectId);
      if (found && (window as any).openSubjectModal) {
        (window as any).openSubjectModal(found, currentLoadedSchoolId, cachedFaculty);
      }
    };

    (window as any)._deleteSubject = async function(subjectId: string) {
      if (!confirm('ATENCIÓN: Al eliminar una materia se borrarán permanentemente sus clases, estudiantes matriculados y calificaciones asociadas. ¿Estás absolutamente seguro de proceder?')) return;
      try {
        await courseManagementService.deleteCourse(subjectId);
        window.dispatchEvent(new CustomEvent('curriculum:updated'));
        window.location.reload();
      } catch(err: any) {
        alert('Error al eliminar materia: ' + err.message);
      }
    };

    (window as any)._editGradeByLevel = function(gradeLevel: string) {
    const found = cachedCapacities.find((g) => g.gradeLevel === gradeLevel);
    if (found && (window as any).openGradeCapacityModal) {
      (window as any).openGradeCapacityModal(found, currentLoadedSchoolId);
    }
  };

  async function renderGradeCapacities() {
    const grid = document.getElementById('gradeCapacityGrid');
    if (!grid) return;

    try {
      const res = await courseManagementService.getGradeCapacities(currentLoadedSchoolId);
      let gradeCapacities = res.data;

      if (!gradeCapacities || gradeCapacities.length === 0) {
        // Inicializar grados por defecto si no existen
        const defaultGrades = ['6°', '7°', '8°', '9°', '10°', '11°'].map((g) => ({
          school_id: currentLoadedSchoolId,
          grade_level: g,
          sections_count: 2,
          capacity_per_room: 35,
          is_offered: true
        }));
        
        const initRes = await courseManagementService.initDefaultGrades(defaultGrades);
        const refreshed = initRes.data;
        cachedCapacities = (refreshed || []).map((g: any) => ({
          id: g.id,
          schoolId: g.school_id,
          gradeLevel: g.grade_level,
          sectionsCount: g.sections_count || 1,
          capacityPerRoom: g.capacity_per_room || 35,
          totalCapacity: (g.sections_count || 1) * (g.capacity_per_room || 35),
          isOffered: g.is_offered !== false,
          enrolledCount: 0,
        }));
      } else {
        cachedCapacities = gradeCapacities.map((g: any) => ({
          id: g.id,
          schoolId: g.school_id,
          gradeLevel: g.grade_level,
          sectionsCount: g.sections_count || 1,
          capacityPerRoom: g.capacity_per_room || 35,
          totalCapacity: (g.sections_count || 1) * (g.capacity_per_room || 35),
          isOffered: g.is_offered !== false,
          enrolledCount: 0,
        }));
      }

      grid.innerHTML = cachedCapacities.map((g: any) => {
        const sectionsCount = g.sectionsCount || 0;
        const isOffered = g.isOffered !== false;

        return `
          <div
            class="grade-capacity-card"
            onclick="window._editGradeByLevel('${escapeHtml(g.gradeLevel)}')"
            style="border:2px solid var(--ink); background:#FFFFFF; padding:14px; box-shadow:2px 2px 0 var(--ink); cursor:pointer;"
          >
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:4px;">
              <h3 style="font-family:var(--serif); font-size:16px; font-weight:800; color:var(--ink); margin:0;">
                ${escapeHtml(g.gradeLevel)}
              </h3>
              <span style="font-family:var(--mono); font-size:10px; font-weight:800; color:var(--rust);">
                ${isOffered ? `${sectionsCount} SALONES` : '0 SALONES'}
              </span>
            </div>
            <div style="font-size:11.5px; color:var(--ink-soft); margin-top:4px;">
              Ocupación: <strong>${g.enrolledCount} / ${g.totalCapacity} cupos</strong>
            </div>
          </div>
        `;
      }).join('');

    } catch (err) {
      console.warn('Error renderizando aforos:', err);
    }
  }

  // ── INICIALIZACIÓN GLOBAL ──────────────────────────────────────
  async function loadCurriculum() {
    try {
      // 1. Cargar planta docente vía teacherService
      const facRes = await teacherService.getTeachers(currentLoadedSchoolId);
      const faculty = facRes.data || [];

      cachedFaculty = faculty;
      const teacherMap = new Map(faculty.map((t: any) => [t.id, t]));

      // 2. Cargar materias vía courseManagementService
      const subRes = await courseManagementService.getSubjects(currentLoadedSchoolId);
      let dbCourses = subRes.data || [];

      if (!dbCourses || dbCourses.length === 0) {
        const defaultInitialSubjects = [
          { name: 'Matemáticas y Geometría', code: 'MAT-101', grade_level: 'Ciencias Exactas', hours_per_week: 5, color: '#1B2A4A' },
          { name: 'Lengua Castellana y Literatura', code: 'ESP-101', grade_level: 'Humanidades', hours_per_week: 5, color: '#8C2D19' },
          { name: 'Ciencias Naturales y Biología', code: 'BIO-101', grade_level: 'Ciencias Naturales', hours_per_week: 4, color: '#1B2A4A' },
          { name: 'Ciencias Sociales e Historia', code: 'SOC-101', grade_level: 'Ciencias Sociales', hours_per_week: 4, color: '#8C2D19' },
          { name: 'Inglés Comunicativo', code: 'ING-101', grade_level: 'Idiomas Extranjeros', hours_per_week: 5, color: '#1B2A4A' },
          { name: 'Educación Física y Deportes', code: 'EFI-101', grade_level: 'Bienestar y Salud', hours_per_week: 2, color: '#1B2A4A' },
          { name: 'Tecnología e Informática', code: 'INF-101', grade_level: 'Tecnología', hours_per_week: 2, color: '#1B2A4A' },
          { name: 'Educación Artística', code: 'ART-101', grade_level: 'Artes', hours_per_week: 2, color: '#8C2D19' },
          { name: 'Ética y Valores', code: 'ETI-101', grade_level: 'Formación Humana', hours_per_week: 1, color: '#1B2A4A' },
        ];
        const initRes = await courseManagementService.initSubjects(currentLoadedSchoolId, defaultInitialSubjects);
        dbCourses = initRes.data || [];
      }

      // 3. Cargar clases / horarios asignados vía scheduleService
      const clsRes = await scheduleService.getSchoolClasses(currentLoadedSchoolId);
      const classes = clsRes.classes || [];

      // 4. Mapear currículo para las vistas
      cachedCurriculum = (dbCourses || []).map((course: any) => {
        const courseClasses = classes.filter((c: any) => c.course_id === course.id);
        const courseTeacherIds = new Set<string>();
        if (course.teacher_id) courseTeacherIds.add(course.teacher_id);
        courseClasses.forEach((c: any) => {
          if (c.teacher_id) courseTeacherIds.add(c.teacher_id);
        });

        const teachers = Array.from(courseTeacherIds).map((tId) => {
          const live: any = teacherMap.get(tId);
          const teacherClasses = courseClasses.filter((c: any) => c.teacher_id === tId);

          const assignments = teacherClasses.map((cls: any) => ({
            id: cls.id,
            classroom: cls.classroom,
            gradeLevel: cls.classroom.split('-')[0],
            day: cls.day_of_week,
            dayIndex: cls.day_index,
            slotId: cls.slot_id,
            timeLabel: `${cls.start_time} - ${cls.end_time}`,
            roomLocation: cls.room_location || `Salón ${cls.classroom}`,
          }));

          return {
            teacherId: tId,
            teacherName: live?.name || 'Docente Titular',
            teacherCode: live?.document_id || 'DOC',
            teacherEmail: live?.email || '',
            specialty: live?.specialty || '',
            avatarUrl: live?.avatar_url || '/avatars/women/fila-2-columna-1.png',
            status: live?.status || 'active',
            assignments,
          };
        });

        const totalClassrooms = new Set();
        let totalAssignedHours = 0;
        teachers.forEach((t: any) => {
          (t.assignments || []).forEach((asg: any) => {
            if (asg.classroom) totalClassrooms.add(asg.classroom);
            totalAssignedHours += 1;
          });
        });

        return {
          id: course.id,
          name: course.name,
          code: course.code,
          department: course.grade_level || 'Área General',
          weeklyHoursTarget: course.hours_per_week || 4,
          color: course.color || '#1B2A4A',
          qualified_teacher_ids: course.qualified_teacher_ids || [],
          teachers,
          teachersCount: teachers.length,
          classroomsCount: totalClassrooms.size,
          totalAssignedHours,
        };
      });

      renderTeacherSchedule();
      renderClassroomSchedule();
      renderSubjectsCatalog();
    } catch (err) {
      console.error('Error cargando currículo:', err);
    }
  }

  async function hydrateAcademicCenter() {
    try {
      const context = await schoolAdminTenantService.getTenantContext();
      currentLoadedSchoolId = context?.school?.id || context?.school?.slug || '';
      if (!currentLoadedSchoolId) return;

      await Promise.all([
        loadTimeSlots(),
        renderGradeCapacities(),
        loadCurriculum(),
      ]);
    } catch (err) {
      console.warn('Error hidratando centro académico:', err);
    }
  }

  window.addEventListener('curriculum:updated', () => {
    loadCurriculum();
    renderGradeCapacities();
  });
  window.addEventListener('time-slots:updated', () => {
    loadTimeSlots();
    loadCurriculum();
  });

  const academicLoad = hydrateAcademicCenter();
  (window as any).SchoolOSApp?.registerPageLoad(academicLoad);
</script>
