---
// ============================================================
// SchoolOS — Asignación de Horarios, Malla Curricular & Aforos (Rectoría)
// Flujo Ordenado: Docente -> Salón/Materia -> Horario con Prevención de Cruces
// Popup de Selección Rápida de Docentes y Salones con Buscador en Vivo
// Cero Emojis, Diseño Editorial Brutalista Institucional
// ============================================================
import AppLayout from '../../../../../layouts/AppLayout.astro';
import GradeCapacityModal from '../../../../../components/app/school-admin/GradeCapacityModal.astro';
import NewGradeModal from '../../../../../components/app/school-admin/NewGradeModal.astro';
import SubjectModal from '../../../../../components/app/school-admin/SubjectModal.astro';
import AssignTeacherSubjectModal from '../../../../../components/app/school-admin/AssignTeacherSubjectModal.astro';
import ClassScheduleModal from '../../../../../components/app/school-admin/ClassScheduleModal.astro';
import TimeSlotsModal from '../../../../../components/app/school-admin/TimeSlotsModal.astro';
import ScheduleSlotAssignmentModal from '../../../../../components/app/school-admin/ScheduleSlotAssignmentModal.astro';
import TeacherPickerModal from '../../../../../components/app/school-admin/TeacherPickerModal.astro';
import ClassroomPickerModal from '../../../../../components/app/school-admin/ClassroomPickerModal.astro';

const lang = 'es';
---

<AppLayout
  title="Horarios & Carga Docente"
  pageTitle="Asignación de Horarios & Carga Académica"
  activeSection="courses"
  role="school_admin"
  schoolName="Institución"
  lang={lang}
  activeRoute="/app/school-admin/courses"
  breadcrumbs={[{ label: 'Institución', href: `/${lang}/app/school-admin` }, { label: 'Horarios & Carga Docente' }]}
>
  <!-- SELECTOR DE VISTAS PRINCIPALES (TABS) -->
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:20px;">
    <div style="display:flex; gap:6px; flex-wrap:wrap;">
      <button
        type="button"
        id="tabBtnSchedule"
        class="btn btn-primary btn-sm academic-tab-btn active"
        onclick="window._switchMainTab('schedule')"
        style="font-family:var(--mono); font-weight:800; font-size:11.5px; padding:8px 14px;"
      >
        1. ASIGNACIÓN DE HORARIOS & CARGA DOCENTE
      </button>
      <button
        type="button"
        id="tabBtnSubjects"
        class="btn btn-secondary btn-sm academic-tab-btn"
        onclick="window._switchMainTab('subjects')"
        style="font-family:var(--mono); font-weight:800; font-size:11.5px; padding:8px 14px;"
      >
        2. CATÁLOGO DE MATERIAS & AFORO DE SALONES
      </button>
      <button
        type="button"
        id="tabBtnTimeSlots"
        class="btn btn-secondary btn-sm academic-tab-btn"
        onclick="window._switchMainTab('timeslots')"
        style="font-family:var(--mono); font-weight:800; font-size:11.5px; padding:8px 14px;"
      >
        3. FRANJAS HORARIAS BASE
      </button>
    </div>

    <div style="display:flex; gap:8px;">
      <button
        type="button"
        class="btn btn-secondary btn-sm"
        onclick="window.openTimeSlotsModal && window.openTimeSlotsModal()"
        style="font-family:var(--mono); font-size:11px; font-weight:800;"
      >
        Configurar Franjas
      </button>
        <button
          type="button"
          class="btn btn-primary btn-sm"
          onclick="window.openSubjectModal && window.openSubjectModal(null, currentLoadedSchoolId, cachedFaculty)"
          style="font-family:var(--mono); font-size:11px; font-weight:800;"
        >
          ＋ Nueva Materia
        </button>
    </div>
  </div>

  <!-- ============================================================ -->
  <!-- TAB 1: ASIGNACIÓN DE HORARIOS DOCENTE A DOCENTE (FLUJO ORDENADO) -->
  <!-- ============================================================ -->
  <div id="tabSectionSchedule" class="academic-tab-content" style="display:block;">
    
    <!-- CONMUTADOR DE VISTA: POR DOCENTE VS POR SALÓN -->
    <div class="panel" style="margin-bottom:18px; background:var(--cream); padding:14px 18px; box-shadow:2px 2px 0 var(--ink);">
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        
        <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
          <div style="font-family:var(--mono); font-size:11px; font-weight:800; color:var(--rust); text-transform:uppercase;">
            Modo de Asignación:
          </div>

          <div style="display:flex; gap:4px;">
            <button
              type="button"
              id="modeTeacherBtn"
              class="btn btn-primary btn-sm"
              onclick="window._setScheduleMode('teacher')"
              style="font-size:11px; font-weight:800; padding:6px 12px;"
            >
              🧑‍🏫 Asignación por Docente (Individual)
            </button>
            <button
              type="button"
              id="modeClassroomBtn"
              class="btn btn-secondary btn-sm"
              onclick="window._setScheduleMode('classroom')"
              style="font-size:11px; font-weight:800; padding:6px 12px;"
            >
              🏫 Vista de Revisión por Salón / Grupo
            </button>
          </div>
        </div>

        <div style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft);">
          Validación en tiempo real: <strong>Cero Cruces de Profesores y Salones</strong>
        </div>

      </div>
    </div>

    <!-- SECCIÓN A: ASIGNACIÓN POR DOCENTE (CON POPUP DE BÚSQUEDA) -->
    <div id="scheduleSectionTeacher" style="display:block;">
      
      <!-- BARRA DE DOCENTE ACTIVO + BOTÓN POPUP DE BÚSQUEDA -->
      <div class="panel" style="margin-bottom:18px; background:#FFFFFF; padding:14px 18px; border:2px solid var(--ink); box-shadow:4px 4px 0 var(--ink);">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
          
          <!-- Info del Docente Activo -->
          <div id="activeTeacherCardSummary" style="display:flex; align-items:center; gap:12px;">
            <!-- Cargado dinámicamente -->
          </div>

          <!-- Botón Popup de Búsqueda Rápida de Docente -->
          <div>
            <button
              type="button"
              class="btn btn-primary"
              onclick="window._openTeacherPicker()"
              style="font-family:var(--mono); font-size:12px; font-weight:800; padding:9px 16px; display:flex; align-items:center; gap:8px;"
            >
              <span>🔍 Buscar / Cambiar Docente</span>
              <span id="facultyCountBadge" style="background:#FFFFFF; color:var(--ink); font-size:10.5px; padding:1px 6px; border:1px solid var(--ink);">
                0 docentes
              </span>
              <span>▾</span>
            </button>
          </div>

        </div>
      </div>

      <!-- MATRIZ HORARIA SEMANAL DEL DOCENTE SELECCIONADO -->
      <div class="panel" style="border:2px solid var(--ink); box-shadow:6px 6px 0 var(--ink); overflow:hidden; margin-bottom:30px;">
        
        <!-- CABECERA DE LA MATRIZ -->
        <div id="selectedTeacherHeader" class="panel-header" style="background:var(--cream); padding:12px 18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; border-bottom:2px solid var(--ink);">
          <!-- Cargado dinámicamente -->
        </div>

        <!-- CUADRÍCULA SEMANAL DEL DOCENTE (LUNES A VIERNES) -->
        <div style="overflow-x:auto; background:var(--paper);">
          <table class="data-table" style="margin:0; width:100%; border-collapse:collapse; min-width:850px;">
            <thead>
              <tr style="background:var(--cream); border-bottom:2px solid var(--ink);">
                <th style="width:13%; border-right:2px solid var(--ink); text-align:center; font-family:var(--mono); font-size:11px; font-weight:900; padding:12px 8px;">
                  BLOQUE / HORA
                </th>
                <th style="width:17.4%; border-right:1.5px solid var(--ink); text-align:center; font-family:var(--mono); font-size:12px; font-weight:900; padding:12px 8px;">
                  LUNES
                </th>
                <th style="width:17.4%; border-right:1.5px solid var(--ink); text-align:center; font-family:var(--mono); font-size:12px; font-weight:900; padding:12px 8px;">
                  MARTES
                </th>
                <th style="width:17.4%; border-right:1.5px solid var(--ink); text-align:center; font-family:var(--mono); font-size:12px; font-weight:900; padding:12px 8px;">
                  MIÉRCOLES
                </th>
                <th style="width:17.4%; border-right:1.5px solid var(--ink); text-align:center; font-family:var(--mono); font-size:12px; font-weight:900; padding:12px 8px;">
                  JUEVES
                </th>
                <th style="width:17.4%; text-align:center; font-family:var(--mono); font-size:12px; font-weight:900; padding:12px 8px;">
                  VIERNES
                </th>
              </tr>
            </thead>
            <tbody id="teacherScheduleTbody">
              <!-- Renderizado dinámicamente -->
            </tbody>
          </table>
        </div>

      </div>

    </div>

    <!-- SECCIÓN B: REVISIÓN POR SALÓN / CURSO (CON POPUP DE BÚSQUEDA) -->
    <div id="scheduleSectionClassroom" style="display:none;">
      
      <!-- BARRA DE SALÓN ACTIVO + BOTÓN POPUP DE BÚSQUEDA -->
      <div class="panel" style="margin-bottom:18px; background:#FFFFFF; padding:14px 18px; border:2px solid var(--ink); box-shadow:4px 4px 0 var(--ink);">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
          
          <div id="activeClassroomCardSummary" style="display:flex; align-items:center; gap:12px;">
            <!-- Cargado dinámicamente -->
          </div>

          <div>
            <button
              type="button"
              class="btn btn-primary"
              onclick="window._openClassroomPicker()"
              style="font-family:var(--mono); font-size:12px; font-weight:800; padding:9px 16px; display:flex; align-items:center; gap:8px;"
            >
              <span>🏫 Cambiar Salón / Curso</span>
              <span id="classroomCountBadge" style="background:#FFFFFF; color:var(--ink); font-size:10.5px; padding:1px 6px; border:1px solid var(--ink);">
                0 salones
              </span>
              <span>▾</span>
            </button>
          </div>

        </div>
      </div>

      <!-- MATRIZ HORARIA CONSOLIDADA DEL SALÓN -->
      <div class="panel" style="border:2px solid var(--ink); box-shadow:6px 6px 0 var(--ink); overflow:hidden; margin-bottom:30px;">
        
        <div id="selectedClassroomHeader" class="panel-header" style="background:var(--cream); padding:12px 18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; border-bottom:2px solid var(--ink);">
          <!-- Cargado dinámicamente -->
        </div>

        <div style="overflow-x:auto; background:var(--paper);">
          <table class="data-table" style="margin:0; width:100%; border-collapse:collapse; min-width:850px;">
            <thead>
              <tr style="background:var(--cream); border-bottom:2px solid var(--ink);">
                <th style="width:13%; border-right:2px solid var(--ink); text-align:center; font-family:var(--mono); font-size:11px; font-weight:900; padding:12px 8px;">
                  BLOQUE / HORA
                </th>
                <th style="width:17.4%; border-right:1.5px solid var(--ink); text-align:center; font-family:var(--mono); font-size:12px; font-weight:900; padding:12px 8px;">
                  LUNES
                </th>
                <th style="width:17.4%; border-right:1.5px solid var(--ink); text-align:center; font-family:var(--mono); font-size:12px; font-weight:900; padding:12px 8px;">
                  MARTES
                </th>
                <th style="width:17.4%; border-right:1.5px solid var(--ink); text-align:center; font-family:var(--mono); font-size:12px; font-weight:900; padding:12px 8px;">
                  MIÉRCOLES
                </th>
                <th style="width:17.4%; border-right:1.5px solid var(--ink); text-align:center; font-family:var(--mono); font-size:12px; font-weight:900; padding:12px 8px;">
                  JUEVES
                </th>
                <th style="width:17.4%; text-align:center; font-family:var(--mono); font-size:12px; font-weight:900; padding:12px 8px;">
                  VIERNES
                </th>
              </tr>
            </thead>
            <tbody id="classroomScheduleTbody">
              <!-- Renderizado dinámicamente -->
            </tbody>
          </table>
        </div>

      </div>

    </div>

  </div>

  <!-- ============================================================ -->
  <!-- TAB 2: CATÁLOGO DE MATERIAS & AFORO DE SALONES -->
  <!-- ============================================================ -->
  <div id="tabSectionSubjects" class="academic-tab-content" style="display:none;">
    
    <!-- CATÁLOGO DE MATERIAS -->
    <div class="panel" style="margin-bottom:24px;">
      <div class="panel-header" style="background:var(--cream); padding:12px 18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
        <div>
          <span class="plan-tag" style="background:var(--ink); color:#FFF; font-size:10px; font-weight:800;">CATÁLOGO INSTITUCIONAL</span>
          <h2 style="font-family:var(--serif); font-size:16px; margin:2px 0 0; font-weight:700; color:var(--ink);">
            Materias & Asignaturas Curriculares
          </h2>
        </div>
        <button
          type="button"
          class="btn btn-primary btn-sm"
          onclick="window.openSubjectModal && window.openSubjectModal(null, currentLoadedSchoolId, cachedFaculty)"
          style="font-size:11px; font-weight:800;"
        >
          ＋ Agregar Materia
        </button>
      </div>

      <div class="panel-body padded" style="background:#FFFDF9;">
        <div id="subjectsCatalogGrid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:14px;">
          <!-- Cargado dinámicamente -->
        </div>
      </div>
    </div>

    <!-- MATRIZ DE AFOROS Y PRECONTEO DE CUPOS -->
    <div class="panel" style="margin-bottom:24px;">
      <div class="panel-header" style="background:var(--cream); padding:12px 18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
        <div>
          <span class="plan-tag" style="background:var(--ink); color:#FFF; font-size:10px; font-weight:800;">AFORO DE SALONES</span>
          <h2 style="font-family:var(--serif); font-size:16px; margin:2px 0 0; font-weight:700; color:var(--ink);">
            Preconteo de Cupos por Grado / Nivel
          </h2>
        </div>
        <button
          type="button"
          class="btn btn-primary btn-sm"
          onclick="window.openNewGradeModal && window.openNewGradeModal()"
          style="font-size:11px; font-weight:800;"
        >
          ＋ Agregar Grado
        </button>
      </div>

      <div class="panel-body padded" style="background:#FFFDF9;">
        <div id="gradeCapacityGrid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(230px, 1fr)); gap:14px;">
          <!-- Cargado dinámicamente -->
        </div>
      </div>
    </div>

  </div>

  <!-- ============================================================ -->
  <!-- TAB 3: FRANJAS HORARIAS BASE -->
  <!-- ============================================================ -->
  <div id="tabSectionTimeSlots" class="academic-tab-content" style="display:none;">
    
    <div class="panel" style="margin-bottom:24px;">
      <div class="panel-header" style="display:flex; justify-content:space-between; align-items:center; background:var(--cream); flex-wrap:wrap; gap:10px;">
        <div>
          <span class="plan-tag" style="background:var(--ink); color:#FFF; font-size:10px; font-weight:800;">CRONOGRAMA BASE</span>
          <h2 style="font-family:var(--serif); font-size:16px; margin:2px 0 0; font-weight:700; color:var(--ink);">
            Franjas Horarias & Bloques de Tiempo Oficiales
          </h2>
        </div>
        <button
          type="button"
          class="btn btn-primary btn-sm"
          onclick="window.openTimeSlotsModal && window.openTimeSlotsModal()"
          style="font-size:11px; font-weight:800;"
        >
          ＋ Modificar Franjas Horarias
        </button>
      </div>

      <div class="panel-body padded" style="background:#FFFDF9;">
        <div style="font-size:13px; color:var(--ink-soft); line-height:1.45; margin-bottom:18px;">
          Las franjas horarias configuran la cuadrícula sobre la cual se estructuran las clases semanales de los docentes y cursos del plantel.
        </div>

        <div style="border:2px solid var(--ink); background:#FFFFFF; margin-bottom:20px; box-shadow:4px 4px 0 var(--ink); overflow-x:auto;">
          <table class="data-table" style="margin:0; width:100%;">
            <thead>
              <tr style="background:var(--cream); border-bottom:2px solid var(--ink);">
                <th style="font-family:var(--mono); font-size:11px; padding:10px;">ORDEN / BLOQUE</th>
                <th style="font-family:var(--mono); font-size:11px; padding:10px;">HORARIO</th>
                <th style="font-family:var(--mono); font-size:11px; padding:10px;">TIPO DE FRANJA</th>
                <th style="text-align:right; font-family:var(--mono); font-size:11px; padding:10px;">ACCIONES</th>
              </tr>
            </thead>
            <tbody id="timeSlotsTableBody">
              <!-- Cargado dinámicamente -->
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>

  <!-- MODALES DEL SISTEMA ACADÉMICO -->
  <ScheduleSlotAssignmentModal id="scheduleSlotAssignmentModal" />
  <TeacherPickerModal id="teacherPickerModal" />
  <ClassroomPickerModal id="classroomPickerModal" />
  <SubjectModal id="subjectModal" />
  <AssignTeacherSubjectModal id="assignTeacherSubjectModal" />
  <ClassScheduleModal id="classScheduleModal" />
  <TimeSlotsModal id="timeSlotsModal" />
  <GradeCapacityModal id="gradeCapacityModal" />
  <NewGradeModal id="newGradeModal" />

</AppLayout>

<style is:global>
  .calendar-occupied-card {
    background: #FFFFFF;
    border: 1.5px solid var(--ink);
    padding: 8px 10px;
    box-shadow: 2px 2px 0 var(--ink);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .calendar-free-cell {
    border: 1px dashed #D0CBC0;
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
    background: #FAF8F5;
  }
  .calendar-free-cell:hover {
    background: #F0EDE6;
    border-color: var(--ink);
  }
  .calendar-free-cell:hover .btn-assign-slot {
    opacity: 1 !important;
  }
</style>

<script>
  import { schoolAdminTenantService } from '../../../../../services/schoolAdminTenantService';
  import { courseManagementService } from '../../../../../services/courseManagementService';
  import { scheduleService } from '../../../../../services/scheduleService';
  import { teacherService } from '../../../../../services/teacherService';

// APIs modularizadas vía courseManagementService

  function escapeHtml(value: any) {
    return String(value || '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;',
    }[char]));
  }

  let currentLoadedSchoolId = '';
  let cachedCurriculum: any[] = [];
  let cachedFaculty: any[] = [];
  let cachedCapacities: any[] = [];
  let cachedTimeSlots: any[] = [];

  let selectedTeacherId = '';
  let selectedClassroomId = '';
  let activeScheduleMode = 'teacher'; // 'teacher' | 'classroom'

  // ── MANEJO DE PESTAÑAS PRINCIPALES ────────────────────────────
  (window as any)._switchMainTab = function(tabName: string) {
    const tabs: Record<string, { btn: string; section: string }> = {
      'schedule': { btn: 'tabBtnSchedule', section: 'tabSectionSchedule' },
      'subjects': { btn: 'tabBtnSubjects', section: 'tabSectionSubjects' },
      'timeslots': { btn: 'tabBtnTimeSlots', section: 'tabSectionTimeSlots' },
    };

    Object.keys(tabs).forEach((key) => {
      const item = tabs[key];
      const btnEl = document.getElementById(item.btn);
      const secEl = document.getElementById(item.section);

      if (key === tabName) {
        if (btnEl) btnEl.className = 'btn btn-primary btn-sm academic-tab-btn active';
        if (secEl) secEl.style.display = 'block';
      } else {
        if (btnEl) btnEl.className = 'btn btn-secondary btn-sm academic-tab-btn';
        if (secEl) secEl.style.display = 'none';
      }
    });
  };

  // ── CONMUTADOR DE MODO: POR DOCENTE VS POR SALÓN ──────────────
  (window as any)._setScheduleMode = function(mode: string) {
    activeScheduleMode = mode;
    const btnT = document.getElementById('modeTeacherBtn');
    const btnC = document.getElementById('modeClassroomBtn');
    const secT = document.getElementById('scheduleSectionTeacher');
    const secC = document.getElementById('scheduleSectionClassroom');

    if (mode === 'teacher') {
      if (btnT) btnT.className = 'btn btn-primary btn-sm';
      if (btnC) btnC.className = 'btn btn-secondary btn-sm';
      if (secT) secT.style.display = 'block';
      if (secC) secC.style.display = 'none';
      renderTeacherSchedule();
    } else {
      if (btnT) btnT.className = 'btn btn-secondary btn-sm';
      if (btnC) btnC.className = 'btn btn-primary btn-sm';
      if (secT) secT.style.display = 'none';
      if (secC) secC.style.display = 'block';
      renderClassroomSchedule();
    }
  };

  // ── 1. ASIGNACIÓN POR DOCENTE (POPUP & MATRIZ) ─────────────────
  (window as any)._openTeacherPicker = function() {
    const hoursMap: Record<string, number> = {};
    cachedCurriculum.forEach((s) => {
      (s.teachers || []).forEach((t: any) => {
        hoursMap[t.teacherId] = (hoursMap[t.teacherId] || 0) + (t.assignments ? t.assignments.length : 0);
      });
    });

    if ((window as any).openTeacherPickerModal) {
      (window as any).openTeacherPickerModal(cachedFaculty, hoursMap, selectedTeacherId, (chosenId: string) => {
        selectedTeacherId = chosenId;
        renderTeacherSchedule();
      });
    }
  };

  (window as any)._selectTeacher = function(teacherId: string) {
    selectedTeacherId = teacherId;
    renderTeacherSchedule();
  };

  function renderTeacherSchedule() {
    const summaryCard = document.getElementById('activeTeacherCardSummary');
    const header = document.getElementById('selectedTeacherHeader');
    const tbody = document.getElementById('teacherScheduleTbody');
    const badge = document.getElementById('facultyCountBadge');

    if (badge) {
      badge.textContent = `${cachedFaculty.length} docentes`;
    }

    if (!selectedTeacherId && cachedFaculty.length > 0) {
      selectedTeacherId = cachedFaculty[0].id;
    }

    const teacher = cachedFaculty.find((t) => t.id === selectedTeacherId);
    if (!teacher || !summaryCard || !header || !tbody) {
      if (summaryCard) summaryCard.innerHTML = '<div style="font-size:13px; color:var(--ink-soft);">No hay docentes registrados en la institución.</div>';
      return;
    }

    // Obtener asignaciones de este docente en todas las materias
    const teacherAssignments: any[] = [];
    cachedCurriculum.forEach((subj) => {
      (subj.teachers || []).forEach((tch: any) => {
        if (tch.teacherId === teacher.id) {
          (tch.assignments || []).forEach((asg: any) => {
            teacherAssignments.push({
              ...asg,
              subjectId: subj.id,
              subjectName: subj.name,
              subjectCode: subj.code,
            });
          });
        }
      });
    });

    const totalHours = teacherAssignments.length;

    // Resumen en la barra superior
    summaryCard.innerHTML = `
      <div style="width:44px; height:44px; border:2px solid var(--ink); background:#FFFFFF; display:flex; align-items:center; justify-content:center; overflow:hidden;">
