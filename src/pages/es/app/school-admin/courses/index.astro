  (window as any)._openAssignSlotModal = function(teacherId: string, day: string, slotId: string) {
    const teacher = cachedFaculty.find((t) => t.id === teacherId);
    const slot = cachedTimeSlots.find((s) => s.id === slotId);

    if (teacher && slot && (window as any).openScheduleSlotAssignmentModal) {
      (window as any).openScheduleSlotAssignmentModal({
        teacher,
        day,
        slot,
        curriculum: cachedCurriculum,
        gradeCapacities: cachedCapacities,
        timeSlots: cachedTimeSlots,
        schoolId: currentLoadedSchoolId,
      });
    }
