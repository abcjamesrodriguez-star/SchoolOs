  // ── 4. FRANJAS HORARIAS BASE ──────────────────────────────────
  // ── 4. FRANJAS HORARIAS BASE ──────────────────────────────────
  async function loadTimeSlots() {
    try {
      const res = await scheduleService.getTimeSlots(currentLoadedSchoolId);
      const dbSlots = res.data || [];

      if (Array.isArray(dbSlots) && dbSlots.length > 0) {
        cachedTimeSlots = dbSlots.map((s: any) => ({
          id: s.slot_id || s.id,
          name: s.name,
          startTime: s.start_time,
          endTime: s.end_time,
          isBreak: s.is_break === true,
        }));
      } else {
        cachedTimeSlots = [
          { id: 'slot-1', name: 'Bloque 1', startTime: '07:00', endTime: '07:55', isBreak: false },
          { id: 'slot-2', name: 'Bloque 2', startTime: '07:55', endTime: '08:50', isBreak: false },
          { id: 'slot-break-1', name: 'Primer Receso', startTime: '08:50', endTime: '09:15', isBreak: true },
          { id: 'slot-3', name: 'Bloque 3', startTime: '09:15', endTime: '10:10', isBreak: false },
          { id: 'slot-4', name: 'Bloque 4', startTime: '10:10', endTime: '11:05', isBreak: false },
          { id: 'slot-break-2', name: 'Segundo Receso', startTime: '11:05', endTime: '11:20', isBreak: true },
          { id: 'slot-5', name: 'Bloque 5', startTime: '11:20', endTime: '12:15', isBreak: false },
          { id: 'slot-6', name: 'Bloque 6', startTime: '12:15', endTime: '13:10', isBreak: false }
        ];
      }
      renderTimeSlotsTable();
    } catch (err) {
      console.error('Error cargando slots:', err);
    }
  }

  function renderTimeSlotsTable() {
    const tbody = document.getElementById('timeSlotsTableBody');
    if (!tbody) return;

    if (!cachedTimeSlots.length) {
      tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:14px; font-size:12px; color:var(--ink-soft);">Sin franjas configuradas.</td></tr>';
      return;
    }

    tbody.innerHTML = cachedTimeSlots.map((s) => {
      const isBreak = s.isBreak === true;
      const typeBadge = isBreak
        ? '<span style="background:var(--rust); color:#FFFFFF; font-family:var(--mono); font-size:9.5px; font-weight:800; padding:2px 6px;">RECESO / DESCANSO</span>'
        : '<span style="background:var(--ink); color:#FFFFFF; font-family:var(--mono); font-size:9.5px; font-weight:800; padding:2px 6px;">BLOQUE DE CLASE</span>';

      return `
        <tr>
          <td><strong>${escapeHtml(s.name)}</strong></td>
          <td><strong style="font-family:var(--mono); font-size:13px; color:var(--ink);">${s.startTime} - ${s.endTime}</strong></td>
          <td>${typeBadge}</td>
          <td style="text-align:right;">
            <button type="button" class="btn btn-secondary btn-sm" onclick="window.openTimeSlotsModal && window.openTimeSlotsModal('${currentLoadedSchoolId}')" style="font-size:10px; padding:3px 8px;">
              Editar
            </button>
          </td>
        </tr>
      `;
    }).join('');
  }

