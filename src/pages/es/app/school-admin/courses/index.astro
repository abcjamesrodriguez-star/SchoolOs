  (window as any)._deleteTeacherClass = async function(subjectId: string, teacherId: string, assignmentId: string) {
    if (!confirm('¿Deseas desprogramar esta clase del horario del docente?')) return;
    try {
      await scheduleService.deleteClassSlot(assignmentId);
      await loadCurriculum();
    } catch (err) {
      console.error('Error eliminando clase:', err);
