---
import AppLayout from '../../../../../layouts/AppLayout.astro';

const lang = 'es';
---

<AppLayout
  title="Nuevo Curso"
  pageTitle="Apertura de Curso o Asignatura"
  activeSection="courses"
  role="school_admin"
  schoolName="Institución"
  lang={lang}
  activeRoute="/app/school-admin/courses/new"
  breadcrumbs={[
    { label: 'Institución', href: `/${lang}/app/school-admin` },
    { label: 'Cursos', href: `/${lang}/app/school-admin/courses` },
    { label: 'Nuevo' },
  ]}
>
  <div style="max-width:760px; margin:0 auto;">
    <a href={`/${lang}/app/school-admin/courses`} class="btn btn-secondary btn-sm" style="margin-bottom:20px; display:inline-block;">
      ← Volver al Directorio de Cursos
    </a>

    <div class="panel">
      <div class="panel-header">
        <h2>DATOS DEL NUEVO CURSO ACADÉMICO</h2>
      </div>

      <div class="panel-body padded">
        <form onsubmit="event.preventDefault(); alert('La creación real de cursos aún no está conectada a Supabase.');">
          <div class="form-grid">
            <div class="form-field full">
              <label>Nombre de la Asignatura / Curso</label>
              <input type="text" placeholder="Nombre del curso" required />
            </div>

            <div class="form-field">
              <label>Grado / Grupo</label>
              <input type="text" placeholder="Ej. 10A" required />
            </div>

            <div class="form-field">
              <label>Área de Conocimiento</label>
              <input type="text" placeholder="Área" required />
            </div>

            <div class="form-field full">
              <label>Docente Titular Responsable</label>
              <select required disabled>
                <option>Sin docentes reales vinculados</option>
              </select>
              <span class="hint">Cuando existan docentes en Supabase, se podrán asignar aquí.</span>
            </div>

            <div class="form-field">
              <label>Horario Semanal</label>
              <input type="text" placeholder="Horario" />
            </div>

            <div class="form-field">
              <label>Cupo Máximo de Alumnos</label>
              <input type="number" placeholder="0" min="0" max="80" />
            </div>

            <div class="form-field full">
              <label>Periodo Lectivo</label>
              <input type="text" placeholder="Periodo" />
            </div>
          </div>

          <div style="display:flex; justify-content:flex-end; gap:12px; margin-top:24px; padding-top:16px; border-top:1px solid var(--line);">
            <a href={`/${lang}/app/school-admin/courses`} class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary" disabled>Crear curso cuando backend esté listo</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</AppLayout>
