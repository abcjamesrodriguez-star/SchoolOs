---
import AppLayout from '../../../../../layouts/AppLayout.astro';

const lang = 'es';
---

<AppLayout
  title="Noticias"
  pageTitle="Comunicación Escolar & Noticias"
  activeSection="news"
  role="school_admin"
  schoolName="Institución"
  lang={lang}
  activeRoute="/app/school-admin/news"
  breadcrumbs={[{ label: 'Institución', href: `/${lang}/app/school-admin` }, { label: 'Noticias' }]}
>
  <div style="display:grid; grid-template-columns: 2fr 1.2fr; gap:24px;">
    <div>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
        <h2 style="font-family:var(--mono); font-size:12px; letter-spacing:0.08em; text-transform:uppercase; margin:0;">
          COMUNICADOS Y BOLETINES PUBLICADOS (0)
        </h2>
      </div>
      <div style="background:var(--paper); border:2px dashed var(--ink); padding:34px; text-align:center;">
        <div style="font-family:var(--serif); font-size:21px; font-weight:700; color:var(--ink); margin-bottom:6px;">Sin comunicados publicados</div>
        <div style="font-size:13px; color:var(--ink-soft); max-width:620px; margin:0 auto;">Cuando se conecte el módulo de noticias a Supabase, los comunicados reales aparecerán aquí.</div>
      </div>
    </div>

    <div>
      <div class="panel" style="position:sticky; top:80px;">
        <div class="panel-header">
          <h2>REDACTAR NUEVO COMUNICADO</h2>
        </div>
        <div class="panel-body padded">
          <form onsubmit="event.preventDefault(); alert('El módulo de publicación real aún no está conectado.');">
            <div class="form-grid">
              <div class="form-field full">
                <label>Categoría del Aviso</label>
                <select required>
                  <option value="academic">Académica</option>
                  <option value="urgent">Urgente</option>
                  <option value="event">Evento</option>
                  <option value="general">General</option>
                </select>
              </div>
              <div class="form-field full">
                <label>Título del Comunicado</label>
                <input type="text" placeholder="Título" required />
              </div>
              <div class="form-field full">
                <label>Cuerpo del Mensaje</label>
                <textarea rows="5" placeholder="Contenido del comunicado" required style="border:1px solid var(--ink); background:var(--cream); padding:10px; width:100%; font-family:var(--sans); font-size:13px;"></textarea>
              </div>
            </div>
            <div style="margin-top:20px;">
              <button type="submit" class="btn btn-primary" style="width:100%;" disabled>
                Publicación pendiente de backend
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</AppLayout>
