    let activeModalToken: string | null = null;
    let modalPollTimer: any = null;

    function stopModalPolling() {
      if (modalPollTimer) {
        clearInterval(modalPollTimer);
        modalPollTimer = null;
      }
    }

    async function checkTokenStatusInModal(tokenId: string) {
      if (!tokenId || activeModalToken !== tokenId) return;
      try {
        const res = await fetch(`/api/labs/submit?tokenId=${encodeURIComponent(tokenId)}`);
        const json = await res.json();
        if (json.ok && json.data) {
          const { status, tasksCompleted, totalMissions, score, hasSurvey, resolvedIn, device, markedByUnity } = json.data;
          if (status === 'completed') {
            const waitBox = document.getElementById('modal-wait-box');
            const waitText = document.getElementById('modal-wait-text');
            const waitTag = document.getElementById('modal-wait-tag');
            const waitIcon = document.getElementById('modal-wait-icon');
            const surveyTrigger = document.getElementById('btn-survey-trigger') as HTMLButtonElement;
            const surveySection = document.getElementById('modal-survey-section');
            const surveyLockedNotice = document.getElementById('modal-survey-locked-notice');

            const step1ActionBox = document.getElementById('modal-step1-action-box');
            const step1BurnedBox = document.getElementById('modal-step1-burned-box');
            if (step1ActionBox) step1ActionBox.style.display = 'none';
            if (step1BurnedBox) step1BurnedBox.style.display = 'block';

            if (surveyLockedNotice) surveyLockedNotice.style.display = 'none';

            const finalDev = (resolvedIn || device || 'PC').toUpperCase();
            const devLabel = finalDev === 'AMBOS' ? '🔄 Híbrido (PC + VR)' : (finalDev === 'VR' ? '🥽 Visor VR' : '🖥️ PC');

            const modeEl = document.getElementById('modal-mode-display');
            if (modeEl) modeEl.textContent = devLabel;

            const devRadio = document.querySelector(`input[name="deviceUsed"][value="${finalDev}"]`) as HTMLInputElement;
            if (devRadio) devRadio.checked = true;

            if (waitBox) {
              waitBox.style.background = '#FFE5D0';
              waitBox.style.borderColor = 'var(--orange-vibrant)';
            }
            if (waitIcon) waitIcon.textContent = '✓';
            if (waitTag) {
              waitTag.textContent = markedByUnity ? 'SERVIDOR: REGISTRADO POR UNITY 🎮' : 'SERVIDOR: SIMULACIÓN CONFIRMADA';
              waitTag.style.color = 'var(--orange-vibrant)';
            }
            if (waitText) {
              waitText.textContent = `Aciertos: ${tasksCompleted} / ${totalMissions || tasksCompleted} · Calificación: ${score}/10 · Resuelto en: ${devLabel}`;
              waitText.style.color = 'var(--ink)';
            }
            if (surveyTrigger) {
              surveyTrigger.disabled = false;
              surveyTrigger.style.cursor = 'pointer';
              surveyTrigger.style.background = 'var(--orange-vibrant)';
              surveyTrigger.style.color = '#FFFFFF';
              surveyTrigger.textContent = hasSurvey ? '✓ ENCUESTA YA REGISTRADA' : 'CONTINUAR AL PASO 2: ENCUESTA →';
            }
            if (surveySection && surveySection.style.display === 'none' && !hasSurvey) {
              surveySection.style.display = 'block';
            }
            renderStudentModalMissions(body.feedback?.missions || [], true);
            stopModalPolling();
          }
        }
      } catch (_) {}
    }

    function renderStudentModalMissions(missions: any[], isDone: boolean) {
      const container = document.getElementById('student-modal-missions-list');
      const badge = document.getElementById('student-missions-count-badge');
      if (!container) return;

      if (Array.isArray(missions) && missions.length > 0) {
        if (badge) badge.textContent = `${missions.length} MISIONES = 10.0 PTS`;
        container.innerHTML = missions.map((m: any, idx: number) => {
          const isPassed = Boolean(
            m.passed === true ||
            m.pass === true ||
            m.status === 'pass' ||
            m.pass === 'pass' ||
            String(m.passed ?? m.status ?? m.pass ?? '').toLowerCase().trim() === 'pass'
          );
          const title = m.mission || m.name || m.title || m.description || `Misión ${idx + 1}`;
          const statusBadge = isDone
            ? `<span style="font-family:var(--mono); font-size:9.5px; font-weight:900; color:${isPassed ? '#2E7D32' : 'var(--rust)'}; background:${isPassed ? '#E8F5E9' : '#FFF0EE'}; border:1px solid ${isPassed ? '#A8C99B' : 'var(--rust)'}; padding:1px 6px; border-radius:2px;">${isPassed ? '✓ SUPERADA' : '✗ NO SUPERADA'}</span>`
            : `<span style="font-family:var(--mono); font-size:9.5px; font-weight:800; color:var(--ink-soft); background:var(--cream); padding:1px 6px; border:1px solid var(--ink);">En juego</span>`;

          return `
            <div style="background:${isDone ? (isPassed ? '#F1F8E9' : '#FFF8F6') : 'var(--cream)'}; border:1px solid var(--ink); padding:8px 10px; display:flex; justify-content:space-between; align-items:center; border-radius:3px;">
              <span style="font-size:11.5px; font-weight:700; color:var(--ink);">🎯 ${idx + 1}. ${title}</span>
              ${statusBadge}
            </div>
          `;
        }).join('');
      } else {
        if (badge) badge.textContent = isDone ? 'FINALIZADO' : 'EN VIVO';
        container.innerHTML = `
          <div style="background:var(--cream); border:1px dashed var(--ink); padding:12px; font-size:11.5px; color:var(--ink); font-family:var(--mono); line-height:1.4; text-align:center;">
            🎮 Las misiones son configuradas y evaluadas en tiempo real por este experimento en Unity.
            <div style="font-size:10px; color:var(--ink-soft); margin-top:4px;">(Al concluir tu práctica en el simulador, se desglosarán aquí tus misiones aprobadas)</div>
          </div>
        `;
      }
    }

    (window as any).handleOpenLab = function(tokenId: string) {
      const labs = (window as any).studentLabsCache || [];
      const lab = labs.find((l: any) => l.tokenId === tokenId);
      if (!lab) return;

      stopModalPolling();
      activeModalToken = tokenId;
      const modal = document.getElementById('labModal');
      const titleEl = document.getElementById('modal-lab-title');
      const tokenEl = document.getElementById('modal-token-display');
      const modeEl = document.getElementById('modal-mode-display');
      const waitBox = document.getElementById('modal-wait-box');
      const waitText = document.getElementById('modal-wait-text');
      const waitTag = document.getElementById('modal-wait-tag');
      const waitIcon = document.getElementById('modal-wait-icon');
      const surveyTrigger = document.getElementById('btn-survey-trigger') as HTMLButtonElement;
      const surveySection = document.getElementById('modal-survey-section');

      let parsedFeedback: any = {};
      try {
        if (lab.feedbackText && typeof lab.feedbackText === 'string') {
          parsedFeedback = JSON.parse(lab.feedbackText);
        }
      } catch (_) {}

      const effectiveDevice = (
        parsedFeedback.resolvedIn ||
        parsedFeedback.device ||
        parsedFeedback.survey?.deviceUsed ||
        parsedFeedback.playMode ||
        lab.playMode ||
        'PC'
      ).toUpperCase();

      const devLabel = effectiveDevice === 'AMBOS'
        ? '🔄 Híbrido (PC + VR)'
        : effectiveDevice === 'VR'
        ? '🥽 Visor VR'
        : '🖥️ PC';

      if (titleEl) titleEl.textContent = lab.labName;
      if (tokenEl) tokenEl.textContent = lab.tokenId;
      if (modeEl) {
        modeEl.textContent = effectiveDevice === 'AMBOS'
          ? '🔄 AMBOS (PC + VR)'
          : effectiveDevice === 'VR'
          ? '🥽 VISOR VR'
          : '🖥️ COMPUTADOR (PC)';
      }

      const hasSurvey = Boolean(parsedFeedback?.survey?.submittedAt);
      const isCompleted = lab.status === 'completed' || hasSurvey;

      renderStudentModalMissions(parsedFeedback.missions || lab.missions || [], isCompleted);

      const step1ActionBox = document.getElementById('modal-step1-action-box');
      const step1BurnedBox = document.getElementById('modal-step1-burned-box');
      const btnSubmitSurvey = document.getElementById('btn-submit-survey');
      const surveyBurnedBanner = document.getElementById('survey-burned-banner');
      const form = document.getElementById('lab-research-form') as HTMLFormElement;
      const surveyLockedNotice = document.getElementById('modal-survey-locked-notice');

      if (isCompleted) {
        if (surveyLockedNotice) surveyLockedNotice.style.display = 'none';
        if (waitBox) {
          waitBox.style.background = '#FFE5D0';
          waitBox.style.borderColor = 'var(--orange-vibrant)';
        }
        if (waitIcon) waitIcon.textContent = '✓';
        if (waitTag) {
          waitTag.textContent = parsedFeedback.markedByUnity ? 'SERVIDOR: REGISTRADO POR UNITY 🎮' : 'RESULTADOS CONFIRMADOS POR EL SERVIDOR';
          waitTag.style.color = 'var(--orange-vibrant)';
        }
        if (waitText) {
          waitText.textContent = `Aciertos: ${lab.tasksCompleted} | Fallos: ${lab.tasksMissing} · Resuelto en: ${devLabel} · Sesión registrada con éxito.`;
          waitText.style.color = 'var(--ink)';
        }

        if (hasSurvey) {
          // TOKEN COMPLETAMENTE QUEMADO (SIMULACIÓN Y ENCUESTA REALIZADAS)
          if (step1ActionBox) step1ActionBox.style.display = 'none';
          if (step1BurnedBox) step1BurnedBox.style.display = 'block';

          if (surveyTrigger) {
            surveyTrigger.disabled = false;
            surveyTrigger.style.cursor = 'pointer';
            surveyTrigger.style.background = 'var(--ink)';
            surveyTrigger.style.color = '#FFFFFF';
            surveyTrigger.textContent = 'VER RESPUESTAS DE LA ENCUESTA (SOLO LECTURA) ↓';
          }
          if (surveySection) surveySection.style.display = 'block';

          // Bloquear campos de la encuesta en modo solo lectura
          if (form) {
            form.querySelectorAll('input, textarea').forEach((el: any) => {
              el.disabled = true;
            });
          }
          if (btnSubmitSurvey) btnSubmitSurvey.style.display = 'none';
          if (surveyBurnedBanner) surveyBurnedBanner.style.display = 'block';

        } else {
          // SIMULACIÓN COMPLETADA, PERO ENCUESTA PENDIENTE
          if (step1ActionBox) step1ActionBox.style.display = 'none';
          if (step1BurnedBox) step1BurnedBox.style.display = 'block';

          if (surveyTrigger) {
            surveyTrigger.disabled = false;
            surveyTrigger.style.cursor = 'pointer';
            surveyTrigger.style.background = 'var(--orange-vibrant)';
            surveyTrigger.style.color = '#FFFFFF';
            surveyTrigger.textContent = 'DILIGENCIAR ENCUESTA DE INVESTIGACIÓN →';
          }
          if (surveySection) surveySection.style.display = 'block';

          // Habilitar campos de la encuesta
          if (form) {
            form.querySelectorAll('input, textarea').forEach((el: any) => {
              el.disabled = false;
            });
          }
          if (btnSubmitSurvey) {
            btnSubmitSurvey.style.display = 'block';
            (btnSubmitSurvey as HTMLButtonElement).disabled = false;
          }
          if (surveyBurnedBanner) surveyBurnedBanner.style.display = 'none';
        }

        // Pre-cargar respuestas previamente guardadas en el formulario
        if (hasSurvey && parsedFeedback.survey) {
          const s = parsedFeedback.survey;
          const dev = (s.deviceUsed || parsedFeedback.resolvedIn || parsedFeedback.device || 'PC').toUpperCase();
          const devR = document.querySelector(`input[name="deviceUsed"][value="${dev}"]`) as HTMLInputElement;
          if (devR) devR.checked = true;

          if (s.understandingScore) {
            const r = document.querySelector(`input[name="understandingScore"][value="${s.understandingScore}"]`) as HTMLInputElement;
            if (r) r.checked = true;
          }
          if (s.usabilityScore) {
            const r = document.querySelector(`input[name="usabilityScore"][value="${s.usabilityScore}"]`) as HTMLInputElement;
            if (r) r.checked = true;
          }
          if (s.motivationScore) {
            const r = document.querySelector(`input[name="motivationScore"][value="${s.motivationScore}"]`) as HTMLInputElement;
            if (r) r.checked = true;
          }
          const ch = document.getElementById('survey-challenging') as HTMLInputElement;
          if (ch) ch.value = s.challengingMission || '';
          const sg = document.getElementById('survey-suggestions') as HTMLTextAreaElement;
          if (sg) sg.value = s.suggestions || '';
        } else {
          // Pre-seleccionar dispositivo marcado por Unity o token
          const devR = document.querySelector(`input[name="deviceUsed"][value="${effectiveDevice}"]`) as HTMLInputElement;
          if (devR) devR.checked = true;
          const ch = document.getElementById('survey-challenging') as HTMLInputElement;
          if (ch) ch.value = '';
          const sg = document.getElementById('survey-suggestions') as HTMLTextAreaElement;
          if (sg) sg.value = '';
        }
      } else {
        // TOKEN PENDIENTE / NUEVO INTENTO (FRESH)
        if (step1ActionBox) step1ActionBox.style.display = 'flex';
        if (step1BurnedBox) step1BurnedBox.style.display = 'none';

        if (form) {
          form.querySelectorAll('input, textarea').forEach((el: any) => {
            el.disabled = false;
          });
        }
        if (btnSubmitSurvey) {
          btnSubmitSurvey.style.display = 'block';
          (btnSubmitSurvey as HTMLButtonElement).disabled = false;
        }
        if (surveyBurnedBanner) surveyBurnedBanner.style.display = 'none';

        if (waitBox) {
          waitBox.style.background = '#FFF1E6';
          waitBox.style.borderColor = 'var(--ink)';
        }
        if (waitIcon) waitIcon.textContent = '⏳';
        if (waitTag) {
          waitTag.textContent = 'ESTADO DEL SERVIDOR';
          waitTag.style.color = 'var(--orange-vibrant)';
        }
        if (waitText) {
          waitText.textContent = 'Esperando que el juego termine y envíe tus resultados...';
          waitText.style.color = 'var(--ink)';
        }
        if (surveyTrigger) {
          surveyTrigger.disabled = true;
          surveyTrigger.style.cursor = 'not-allowed';
          surveyTrigger.style.background = '#E8E2D9';
          surveyTrigger.style.color = '#7A756D';
          surveyTrigger.textContent = 'ENCUESTA BLOQUEADA 🔒';
        }
        if (surveyLockedNotice) surveyLockedNotice.style.display = 'block';
        if (surveySection) surveySection.style.display = 'none';

        // Iniciar monitoreo reactivo para detectar cuando Unity envíe los datos
        modalPollTimer = setInterval(() => checkTokenStatusInModal(tokenId), 2500);
      }

      if (modal) modal.style.display = 'flex';
    };

    // Cerrar modal
    document.getElementById('btn-close-lab-modal')?.addEventListener('click', () => {
      stopModalPolling();
      const modal = document.getElementById('labModal');
      if (modal) modal.style.display = 'none';
    });

    // Botón manual de comprobar estado con el servidor
    document.getElementById('btn-check-server-now')?.addEventListener('click', async () => {
      if (!activeModalToken) return;
      const checkBtn = document.getElementById('btn-check-server-now');
      if (checkBtn) checkBtn.textContent = '⏳ ...';
      await checkTokenStatusInModal(activeModalToken);
      if (checkBtn) checkBtn.textContent = '↻ Comprobar';
    });

    // Copiar código de acceso
    document.getElementById('btn-copy-token')?.addEventListener('click', () => {
      if (activeModalToken) {
        navigator.clipboard.writeText(activeModalToken);
        const btn = document.getElementById('btn-copy-token');
        if (btn) {
          const original = btn.textContent;
          btn.textContent = '¡COPIADO! ✓';
          setTimeout(() => { btn.textContent = original; }, 2000);
        }
      }
    });

    // Desbloquear / scroll a encuesta
    document.getElementById('btn-survey-trigger')?.addEventListener('click', () => {
      const surveyLockedNotice = document.getElementById('modal-survey-locked-notice');
      if (surveyLockedNotice) surveyLockedNotice.style.display = 'none';
      const surveySection = document.getElementById('modal-survey-section');
      if (surveySection) {
        surveySection.style.display = 'block';
        surveySection.scrollIntoView({ behavior: 'smooth' });
      }
    });

    // Finalizar simulación y abrir encuesta directamente
    document.getElementById('btn-simulate-unity-finish')?.addEventListener('click', async () => {
      if (!activeModalToken) return;
      const simBtn = document.getElementById('btn-simulate-unity-finish') as HTMLButtonElement;
      if (simBtn) {
        simBtn.disabled = true;
        simBtn.textContent = 'ENVIANDO RESULTADOS AL SERVIDOR...';
      }

      try {
        const chosenDev = (document.getElementById('select-test-device') as HTMLSelectElement)?.value || 'PC';
        const payload = {
          tokenId: activeModalToken,
          timeSpentSeconds: 140,
          device: chosenDev,
          playMode: chosenDev,
          resolvedIn: chosenDev,
          missions: [
            { mission: "Obten aceite.", passed: true, status: 'pass' },
            { mission: "Obten agua", passed: true, status: 'pass' },
            { mission: "Consigue un recipiente vacío (vaso precipitado recomendado).", passed: true, status: 'pass' },
            { mission: "Consigue un embudo.", passed: true, status: 'pass' },
            { mission: "Consigue un embudo de decantación.", passed: true, status: 'pass' },
          ]
        };

        const res = await fetchAuth('/api/labs/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const resJson = await res.json();

        if (res.ok && resJson.ok) {
          stopModalPolling();
          const step1ActionBox = document.getElementById('modal-step1-action-box');
          const step1BurnedBox = document.getElementById('modal-step1-burned-box');
          if (step1ActionBox) step1ActionBox.style.display = 'none';
          if (step1BurnedBox) step1BurnedBox.style.display = 'block';

          const waitBox = document.getElementById('modal-wait-box');
          const waitText = document.getElementById('modal-wait-text');
          const waitTag = document.getElementById('modal-wait-tag');
          const waitIcon = document.getElementById('modal-wait-icon');
          const surveyTrigger = document.getElementById('btn-survey-trigger') as HTMLButtonElement;
          const surveySection = document.getElementById('modal-survey-section');
          const surveyLockedNotice = document.getElementById('modal-survey-locked-notice');
          if (surveyLockedNotice) surveyLockedNotice.style.display = 'none';

          const finalDev = (resJson.data?.resolvedIn || resJson.data?.device || chosenDev).toUpperCase();
          const devLabel = finalDev === 'AMBOS' ? '🔄 Híbrido (PC + VR)' : (finalDev === 'VR' ? '🥽 Visor VR' : '🖥️ PC');

          const modeEl = document.getElementById('modal-mode-display');
          if (modeEl) modeEl.textContent = devLabel;

          const devRadio = document.querySelector(`input[name="deviceUsed"][value="${finalDev}"]`) as HTMLInputElement;
          if (devRadio) devRadio.checked = true;

          if (waitBox) {
            waitBox.style.background = '#FFE5D0';
            waitBox.style.borderColor = 'var(--orange-vibrant)';
          }
          if (waitIcon) waitIcon.textContent = '✓';
          if (waitTag) {
            waitTag.textContent = 'SERVIDOR: SIMULACIÓN CONFIRMADA';
            waitTag.style.color = 'var(--orange-vibrant)';
          }
          if (waitText) {
            waitText.textContent = `Aciertos: ${resJson.data.tasksCompleted} / ${resJson.data.totalMissions} (${resJson.data.percentage}%) · Calificación: ${resJson.data.score}/10 · Resuelto en: ${devLabel}`;
            waitText.style.color = 'var(--ink)';
          }
          if (surveyTrigger) {
            surveyTrigger.disabled = false;
            surveyTrigger.style.cursor = 'pointer';
            surveyTrigger.style.background = 'var(--orange-vibrant)';
            surveyTrigger.style.color = '#FFFFFF';
            surveyTrigger.textContent = 'PASO 2: DILIGENCIAR ENCUESTA ↓';
          }
          if (surveySection) {
            surveySection.style.display = 'block';
            surveySection.scrollIntoView({ behavior: 'smooth' });
          }

          alert(`✓ ¡Simulación registrada en el servidor como ${devLabel}! Procede a responder la encuesta de investigación a continuación.`);
        } else if (res.status === 409 || resJson.status === 'already_completed' || resJson.status === 'token_burned') {
          stopModalPolling();
          const step1ActionBox = document.getElementById('modal-step1-action-box');
          const step1BurnedBox = document.getElementById('modal-step1-burned-box');
          if (step1ActionBox) step1ActionBox.style.display = 'none';
          if (step1BurnedBox) step1BurnedBox.style.display = 'block';
          alert('🔒 Token consumido: ' + (resJson.error || 'Este token ya fue utilizado previamente. Solicita al docente de Química que reactive tu intento.'));
        } else {
          alert('Aviso del Servidor: ' + (resJson.error || 'Error al procesar intento.'));
        }
      } catch (err: any) {
        alert('Error en conexión: ' + err.message);
      } finally {
        if (simBtn) {
          simBtn.disabled = false;
          simBtn.textContent = '⚡ FINALIZAR SIMULACIÓN Y ABRIR ENCUESTA';
        }
      }
    });

    // Envío del formulario de la encuesta
    document.getElementById('lab-research-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!activeModalToken) return;

      const form = e.target as HTMLFormElement;
      const formData = new FormData(form);
      const submitBtn = document.getElementById('btn-submit-survey') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'GUARDANDO EN EL SERVIDOR...';
      }

      try {
        const devRadio = form.querySelector('input[name="deviceUsed"]:checked') as HTMLInputElement;
        const deviceUsed = devRadio ? devRadio.value : ((formData.get('deviceUsed') as string) || 'PC');
        const uRadio = form.querySelector('input[name="understandingScore"]:checked') as HTMLInputElement;
        const usRadio = form.querySelector('input[name="usabilityScore"]:checked') as HTMLInputElement;
        const mRadio = form.querySelector('input[name="motivationScore"]:checked') as HTMLInputElement;
        const chEl = document.getElementById('survey-challenging') as HTMLInputElement;
        const sgEl = document.getElementById('survey-suggestions') as HTMLTextAreaElement;

        const answers = {
          deviceUsed,
          understandingScore: uRadio ? Number(uRadio.value) : (Number(formData.get('understandingScore')) || 5),
          usabilityScore: usRadio ? Number(usRadio.value) : (Number(formData.get('usabilityScore')) || 4),
          motivationScore: mRadio ? Number(mRadio.value) : (Number(formData.get('motivationScore')) || 5),
          challengingMission: chEl ? chEl.value.trim() : '',
          suggestions: sgEl ? sgEl.value.trim() : '',
        };

        const res = await fetchAuth('/api/labs/survey', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tokenId: activeModalToken, answers })
        });
        const resJson = await res.json();

        if (res.ok && resJson.ok) {
          stopModalPolling();
          alert('✓ ¡Práctica y encuesta completadas exitosamente! Tus respuestas y calificación han quedado asentadas en el sistema. Tu token ha quedado consumido.');
          const modal = document.getElementById('labModal');
          if (modal) modal.style.display = 'none';
          await hydrateStudentDashboard();
        } else if (res.status === 409 || resJson.status === 'token_burned') {
          stopModalPolling();
          alert('🔒 Token consumido: ' + (resJson.error || 'Este token ya fue quemado. Solicita a tu docente de Química que reactive tu intento.'));
          const modal = document.getElementById('labModal');
          if (modal) modal.style.display = 'none';
          await hydrateStudentDashboard();
        } else {
          alert('Error: ' + (resJson.error || 'No se pudo guardar la encuesta.'));
        }
      } catch (err: any) {
        alert('Error: ' + err.message);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'ENVIAR ENCUESTA Y FINALIZAR PRÁCTICA ✓';
        }
      }
    });

    const studentDashboardLoad = hydrateStudentDashboard();
    (window as any).SchoolOSApp?.registerPageLoad(studentDashboardLoad);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => hydrateStudentDashboard());
    }
  </script>

</AppLayout>
