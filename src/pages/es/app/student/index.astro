  <!-- ── 5. SCRIPT DE HIDRATACIÓN REACTIVA ── -->
  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <script>
    import { fetchAuth } from '../../../../lib/apiClient';

    async function hydrateStudentDashboard() {
      try {
        const res = await fetchAuth('/api/student/dashboard');
        const json = await res.json().catch(() => null);

        if (!json || !json.ok) {
          console.error('[Dashboard Student] Error cargando dashboard:', json?.error);
          return;
        }

        const data = json.data;
        const profile = data.profile || {};
        const todaySchedule = data.todaySchedule || [];
        const pendingEvals = data.pendingEvaluations || [];
        const activeLabs = data.activeLabs || [];

        // Sincronizar Topbar con los datos reales del estudiante
        if (typeof (window as any).updateTopbarUser === 'function' && profile.name) {
          (window as any).updateTopbarUser({
            name: profile.name,
            role: 'student',
            avatarUrl: profile.avatarUrl,
            schoolName: profile.schoolName,
          });
        }

        // Perfil
        const avatarEl = document.getElementById('std-avatar') as HTMLImageElement;
        if (avatarEl && profile.avatarUrl) avatarEl.src = profile.avatarUrl;

        const gradeEl = document.getElementById('std-grade');
        if (gradeEl) gradeEl.textContent = (profile.grade || 'ESTUDIANTE').toUpperCase();

        const contextEl = document.getElementById('std-context');
        if (contextEl) contextEl.textContent = `SALÓN ${profile.classroom || 'GENERAL'} · ${profile.schoolName || 'INSTITUCIÓN'}`;

        const greetingEl = document.getElementById('std-greeting');
        if (greetingEl) {
          const firstName = (profile.name || '').split(' ')[0] || 'ESTUDIANTE';
          greetingEl.textContent = `¡HOLA, ${firstName.toUpperCase()}!`;
        }

        const avgEl = document.getElementById('std-average');
        if (avgEl) avgEl.textContent = profile.generalAverage > 0 ? profile.generalAverage.toFixed(1) : '--';

        const coursesBadge = document.getElementById('courses-count-badge');
        if (coursesBadge) coursesBadge.textContent = String(profile.coursesCount || 0);

        const statCoursesEl = document.getElementById('stat-courses-num');
        if (statCoursesEl) statCoursesEl.textContent = String(profile.coursesCount || 0);

        const statEvalsEl = document.getElementById('stat-evals-num');
        if (statEvalsEl) statEvalsEl.textContent = String(pendingEvals.length);

        const statLabsEl = document.getElementById('stat-labs-num');
        if (statLabsEl) statLabsEl.textContent = String(activeLabs.length);

        // Fecha y hora
        const dateNow = new Date();
        const options: Intl.DateTimeFormatOptions = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' };
        const dateStr = dateNow.toLocaleDateString('es-ES', options);
        const titleDateEl = document.getElementById('schedule-title-date');
        if (titleDateEl) {
          titleDateEl.textContent = `JORNADA DE HOY · ${dateStr.toUpperCase()}`;
        }

        const hours = String(dateNow.getHours()).padStart(2, '0');
        const minutes = String(dateNow.getMinutes()).padStart(2, '0');
        const currentTimeEl = document.getElementById('schedule-current-time');
        if (currentTimeEl) {
          currentTimeEl.innerHTML = `Hora en aula: <strong style="color:#FFF8F5;">${hours}:${minutes}</strong>`;
        }

        // Tira de Horario
        const scheduleStrip = document.getElementById('today-schedule-strip');
        if (scheduleStrip) {
          if (todaySchedule.length === 0) {
            scheduleStrip.innerHTML = `
              <div style="padding:24px; text-align:center; color:var(--ink-soft); font-family:var(--mono); font-size:12.5px; grid-column: 1 / -1;">
                No tienes clases programadas para el día de hoy en el salón <strong>${profile.classroom}</strong>.
              </div>
            `;
