---
// ============================================================
// SchoolOS — Panel Estudiante: El Cockpit del Alumno
// Diseño Brutalista Editorial Oficial (Vibrant Brutalism)
// Sincronizado en Vivo con Datos del Servidor y Supabase
// ============================================================
import AppLayout from '../../../../layouts/AppLayout.astro';

const lang = 'es';
---

<AppLayout
  title="Mi Jornada"
  pageTitle="Mi Día en el Colegio"
  activeSection="dashboard"
  role="student"
  schoolName="SchoolOS"
  lang={lang}
  activeRoute="/app/student"
  breadcrumbs={[{ label: 'Estudiante' }, { label: 'Mi Jornada Hoy' }]}
>

  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <!-- ── 1. CINTILLO INSTITUCIONAL BRUTALISTA: CONTEXTO EN VIVO ── -->
  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <div style="background:var(--paper); border:2px solid var(--ink); padding:16px 22px; margin-bottom:24px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; box-shadow:4px 4px 0 var(--ink);">
    
    <div style="display:flex; align-items:center; gap:16px;">
      <div style="position:relative;">
        <img
          id="std-avatar"
          src="/avatars/men/fila-1-columna-2.png"
          alt="Avatar del Estudiante"
          style="width:52px; height:52px; border-radius:0; border:2px solid var(--ink); object-fit:cover; display:block; box-shadow:2px 2px 0 var(--ink);"
        />
        <span style="position:absolute; bottom:-3px; right:-3px; width:12px; height:12px; border-radius:0; background:#4ADE80; border:2px solid var(--ink);" title="Estado: Activo"></span>
      </div>
      <div>
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
          <span class="plan-tag" id="std-grade" style="background:var(--orange-vibrant); color:#FFFFFF; border-color:var(--ink); font-weight:900; font-size:10px; padding:2px 6px; border-radius:0; letter-spacing:0.06em;">
            ESTUDIANTE
          </span>
          <span id="std-context" style="font-family:var(--mono); font-size:11.5px; font-weight:700; color:var(--ink);">
            Sincronizando salón...
          </span>
        </div>
        <h1 id="std-greeting" style="font-family:var(--sans); font-size:24px; font-weight:900; text-transform:uppercase; letter-spacing:-0.03em; color:var(--ink); margin:0; line-height:1;">
          ¡HOLA!
        </h1>
      </div>
    </div>

    <div style="display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
      <div style="background:var(--cream); border:1.5px solid var(--ink); border-radius:0; padding:8px 16px; text-align:right;">
        <div style="font-family:var(--mono); font-size:9.5px; color:var(--ink-soft); font-weight:800; text-transform:uppercase; letter-spacing:0.06em;">Tu Promedio</div>
        <div style="display:flex; align-items:baseline; gap:4px; justify-content:flex-end;">
          <span id="std-average" style="font-family:var(--mono); font-size:24px; font-weight:900; color:var(--ink); line-height:1;">--</span>
          <span style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); font-weight:700;">/ 10.0</span>
        </div>
      </div>

      <div style="background:#FFF1E6; border:1.5px solid var(--ink); border-radius:0; padding:10px 16px; text-align:center;">
        <div style="font-family:var(--mono); font-size:9px; color:var(--orange-vibrant); font-weight:900; text-transform:uppercase; letter-spacing:0.08em;">Asistencia Hoy</div>
        <div style="font-family:var(--mono); font-size:13px; font-weight:900; color:var(--ink); margin-top:2px;">PRESENTE ✓</div>
      </div>
    </div>

  </div>

  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <!-- ── 2. METRIC CARDS MODULARES (01, 02, 03) ── -->
  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <div class="module-card-grid" style="margin-bottom:24px;">
    
    <!-- CARD 01: MATERIAS -->
    <div class="module-card" style="border:2px solid var(--ink); box-shadow:4px 4px 0 rgba(18, 17, 14, 0.08);">
      <div class="module-card-header">
        <span class="module-num-badge">01</span>
        <span class="module-pill-tag" style="color:var(--ink); font-weight:800;">INSCRIPCIÓN</span>
      </div>
      <div class="module-card-body">
        <h3 class="module-card-title">MATERIAS ACTIVAS</h3>
        <div class="module-card-sub">CURSOS ASIGNADOS AL SALÓN</div>
        <div style="margin-top:16px; display:flex; align-items:baseline; gap:8px;">
          <span id="stat-courses-num" style="font-family:var(--mono); font-size:38px; font-weight:900; color:var(--ink); line-height:1;">0</span>
          <span style="font-family:var(--mono); font-size:12px; color:var(--ink-soft); font-weight:700;">asignaturas</span>
        </div>
      </div>
      <a href={`/${lang}/app/student/courses`} class="module-card-footer footer-stone" style="text-decoration:none;">
        <span>Ver todas las materias</span>
        <span class="arrow-symbol">→</span>
      </a>
    </div>

    <!-- CARD 02: EVALUACIONES -->
    <div class="module-card" style="border:2px solid var(--ink); box-shadow:4px 4px 0 rgba(18, 17, 14, 0.08);">
      <div class="module-card-header">
        <span class="module-num-badge">02</span>
        <span class="module-pill-tag" style="color:var(--orange-vibrant); font-weight:800;">TAREAS & QUICES</span>
      </div>
      <div class="module-card-body">
        <h3 class="module-card-title">EVALUACIONES</h3>
        <div class="module-card-sub">ACTIVIDADES POR PRESENTAR</div>
        <div style="margin-top:16px; display:flex; align-items:baseline; gap:8px;">
          <span id="stat-evals-num" style="font-family:var(--mono); font-size:38px; font-weight:900; color:var(--orange-vibrant); line-height:1;">0</span>
          <span style="font-family:var(--mono); font-size:12px; color:var(--ink-soft); font-weight:700;">pendientes</span>
        </div>
      </div>
      <a href={`/${lang}/app/student/grades`} class="module-card-footer footer-orange" style="text-decoration:none;">
        <span>Consultar boletín</span>
        <span class="arrow-symbol">→</span>
      </a>
    </div>

    <!-- CARD 03: LABORATORIOS SIMULACIÓN -->
    <div class="module-card" style="border:2px solid var(--ink); box-shadow:4px 4px 0 rgba(18, 17, 14, 0.08);">
      <div class="module-card-header">
        <span class="module-num-badge">03</span>
        <span class="module-pill-tag" style="color:var(--orange-vibrant); font-weight:800;">SIMULACIÓN PC / VR</span>
      </div>
      <div class="module-card-body">
        <h3 class="module-card-title">LABS VIRTUALES</h3>
        <div class="module-card-sub">PRÁCTICAS Y SIMULADORES</div>
        <div style="margin-top:16px; display:flex; align-items:baseline; gap:8px;">
          <span id="stat-labs-num" style="font-family:var(--mono); font-size:38px; font-weight:900; color:var(--orange-vibrant); line-height:1;">0</span>
          <span style="font-family:var(--mono); font-size:12px; color:var(--ink-soft); font-weight:700;">prácticas listas</span>
        </div>
      </div>
      <div class="module-card-footer footer-orange">
        <span>Prácticas en simulador</span>
        <span class="arrow-symbol">→</span>
      </div>
    </div>

  </div>

  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <!-- ── 3. TIRA DE HORARIO DE HOY (AULA HOY) ── -->
  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <div style="background:var(--paper); border:2px solid var(--ink); overflow:hidden; margin-bottom:28px; box-shadow:4px 4px 0 var(--ink);">
    
    <div style="background:var(--ink); color:#FFFFFF; padding:12px 20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
      <div style="display:flex; align-items:center; gap:10px;">
        <span style="background:var(--orange-vibrant); width:8px; height:8px; display:inline-block;"></span>
        <span id="schedule-title-date" style="font-family:var(--mono); font-size:11.5px; font-weight:800; letter-spacing:0.08em; text-transform:uppercase;">
          Jornada de Hoy
        </span>
      </div>
      <div id="schedule-current-time" style="font-family:var(--mono); font-size:11.5px; color:#E8E2D9;">
        Sincronizando hora...
      </div>
    </div>

    <!-- Tira de Bloques -->
    <div id="today-schedule-strip" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); background:var(--cream); min-height:85px; align-items:stretch;">
      <div style="font-family:var(--mono); font-size:12px; color:var(--ink-soft); text-align:center; padding:24px; width:100%; grid-column: 1 / -1;">
        Sincronizando bloques de clase con el servidor...
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <!-- ── 4. CUERPO PRINCIPAL: CANVAS vs RAIL (ESTILO SUPER-ADMIN) ── -->
  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <div class="dashboard-grid" style="margin-bottom:28px;">

    <!-- LEFT / MAIN CANVAS -->
    <div class="main-canvas">

      <!-- 1. MISIÓN URGENTE / EVALUACIÓN PENDIENTE -->
      <div id="urgent-eval-container">
        <!-- Renderizado dinámico -->
      </div>

      <!-- 2. LABORATORIOS VIRTUALES ASIGNADOS -->
      <div id="active-labs-container">
        <!-- Renderizado dinámico -->
      </div>

      <!-- 3. PANEL: TUS MATERIAS MATRICULADAS -->
      <div class="panel" style="border:2px solid var(--ink); box-shadow:4px 4px 0 rgba(18, 17, 14, 0.08);">
        <div class="panel-header" style="display:flex; justify-content:space-between; align-items:center; background:var(--cream); border-bottom:2px solid var(--ink); padding:12px 20px;">
          <h2 style="font-family:var(--mono); font-size:12px; font-weight:900; text-transform:uppercase; letter-spacing:0.06em; margin:0;">
            Materias del Salón (<span id="courses-count-badge">0</span>)
          </h2>
          <a href={`/${lang}/app/student/courses`} style="font-family:var(--mono); font-size:11px; font-weight:800; color:var(--rust); text-decoration:none;">
            Ver catálogo completo →
          </a>
        </div>

        <div id="enrolled-courses-grid" style="display:grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap:12px; padding:18px;">
          <div style="font-family:var(--mono); font-size:12px; color:var(--ink-soft); padding:16px; grid-column: 1 / -1; text-align:center;">
            Cargando materias asignadas...
          </div>
        </div>
      </div>

    </div>

    <!-- RIGHT / INTEL RAIL -->
    <div class="intel-rail">

      <!-- 1. AVISOS DE TUS PROFESORES -->
      <div class="panel" style="border:2px solid var(--ink); box-shadow:4px 4px 0 rgba(18, 17, 14, 0.08);">
        <div class="panel-header" style="background:var(--ink); color:#FFFFFF; padding:12px 16px; display:flex; justify-content:space-between; align-items:center;">
          <h2 style="font-family:var(--mono); font-size:11px; font-weight:900; letter-spacing:0.08em; text-transform:uppercase; color:#FFFFFF; margin:0;">
            Avisos de Aula
          </h2>
          <span style="font-family:var(--mono); font-size:9.5px; font-weight:800; background:var(--orange-vibrant); color:#FFFFFF; padding:1px 6px;">
            OFICIAL
          </span>
        </div>
        <div class="panel-body padded" style="padding:16px;">
          <div style="background:var(--cream); border-left:3px solid var(--rust); padding:12px 14px; margin-bottom:12px;">
            <div style="font-family:var(--mono); font-size:10px; font-weight:900; color:var(--rust); text-transform:uppercase; margin-bottom:4px;">
              Información de Salón
            </div>
            <p style="font-size:12.5px; color:var(--ink); line-height:1.5; margin:0;">
              Bienvenido al ciclo académico. Asiste puntualmente a tus clases en tu salón asignado y mantén al día tus actividades.
            </p>
          </div>
          <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">
            Sincronizado con la malla horaria oficial.
          </div>
        </div>
      </div>

      <!-- 2. ÚLTIMAS CALIFICACIONES -->
      <div class="panel" style="border:2px solid var(--ink); box-shadow:4px 4px 0 rgba(18, 17, 14, 0.08);">
        <div class="panel-header" style="background:var(--cream); border-bottom:2px solid var(--ink); padding:12px 16px; display:flex; justify-content:space-between; align-items:center;">
          <h2 style="font-family:var(--mono); font-size:11px; font-weight:900; letter-spacing:0.06em; text-transform:uppercase; margin:0;">
            Tus Calificaciones
          </h2>
          <a href={`/${lang}/app/student/grades`} style="font-family:var(--mono); font-size:10.5px; color:var(--rust); font-weight:800; text-decoration:none;">
            Boletín →
          </a>
        </div>
        <div id="recent-grades-feed" style="padding:16px;">
          <div style="font-family:var(--mono); font-size:12px; color:var(--ink-soft); text-align:center;">
            Cargando boletín...
          </div>
        </div>
      </div>

      <!-- 3. AGENDA DEL COLEGIO -->
      <div class="panel" style="border:2px solid var(--ink); background:var(--paper); padding:16px; box-shadow:4px 4px 0 rgba(18, 17, 14, 0.08);">
        <div style="font-family:var(--mono); font-size:10.5px; font-weight:900; text-transform:uppercase; letter-spacing:0.08em; color:var(--ink); margin-bottom:12px; border-bottom:1.5px solid var(--ink); padding-bottom:6px;">
          CALENDARIO INSTITUCIONAL
        </div>
        <div style="display:flex; flex-direction:column; gap:10px; font-size:12px;">
          <div style="border-left:3px solid var(--rust); padding-left:10px;">
            <div style="font-family:var(--mono); font-size:9.5px; color:var(--rust); font-weight:900;">PERIODO 1</div>
            <strong style="color:var(--ink); display:block;">Actividades en curso</strong>
            <div style="font-size:11px; color:var(--ink-soft);">Presenta tus talleres y quices</div>
          </div>
          <div style="border-left:3px solid var(--ink); padding-left:10px;">
            <div style="font-family:var(--mono); font-size:9.5px; color:var(--ink-soft); font-weight:800;">CIERRE ACADÉMICO</div>
            <strong style="color:var(--ink); display:block;">Publicación de Notas</strong>
            <div style="font-size:11px; color:var(--ink-soft);">Cierre oficial del boletín</div>
          </div>
        </div>
      </div>

    </div>

  </div>

  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <!-- ── 4.5 MODAL: SIMULADOR DE LABORATORIO & ENCUESTA DE INVESTIGACIÓN ── -->
  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <div id="labModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(18,17,14,0.92); z-index:10000; justify-content:center; align-items:center; padding:16px; box-sizing:border-box;">
    <div style="background:var(--paper); border:2.5px solid var(--ink); box-shadow:8px 8px 0 var(--ink); width:100%; max-width:1100px; max-height:92vh; display:flex; flex-direction:column; overflow:hidden;">
      
      <!-- Modal Header -->
      <div style="background:var(--ink); color:#FFFFFF; padding:14px 22px; display:flex; justify-content:space-between; align-items:center; border-bottom:3px solid var(--orange-vibrant);">
        <div style="display:flex; align-items:center; gap:12px;">
          <span style="background:var(--orange-vibrant); color:#FFFFFF; font-family:var(--mono); font-size:10px; font-weight:900; padding:4px 8px; letter-spacing:0.08em; text-transform:uppercase;">
            SIMULACIÓN EDUCATIVA
          </span>
          <h2 id="modal-lab-title" style="font-family:var(--sans); font-size:16px; font-weight:900; text-transform:uppercase; margin:0; color:#FFFFFF; letter-spacing:0.02em;">
            LABORATORIO VIRTUAL
          </h2>
        </div>
        <button id="btn-close-lab-modal" type="button" style="background:transparent; border:none; color:#FFFFFF; font-size:24px; cursor:pointer; font-weight:900; line-height:1; transition:color 0.15s;">✕</button>
      </div>

      <!-- Modal Body (Scrollable, Two-Panel Grid) -->
      <div style="padding:22px; overflow-y:auto; flex:1; background:#FFF8F3;">
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(440px, 1fr)); gap:22px; align-items:start;">

          <!-- ══════════════════════════════════════════════════════════ -->
          <!-- ── PANEL 1 (IZQUIERDA): SIMULADOR UNITY & ESTADO ── -->
          <!-- ══════════════════════════════════════════════════════════ -->
          <div style="display:flex; flex-direction:column; gap:16px;">
            
            <div style="display:flex; align-items:center; justify-content:space-between; border-bottom:2px solid var(--ink); padding-bottom:6px;">
              <span style="font-family:var(--mono); font-size:11px; font-weight:900; color:var(--rust); text-transform:uppercase; letter-spacing:0.05em;">
                🎮 PASO 1 · PRÁCTICA EN SIMULADOR
              </span>
              <span style="font-family:var(--mono); font-size:10px; font-weight:800; background:#FFF; border:1px solid var(--ink); padding:2px 6px;">
                UNITY 3D / VR
              </span>
            </div>

            <!-- Context Banner: Código de Acceso & Modo -->
            <div style="background:#FFF1E6; border:2px solid var(--ink); padding:14px 16px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; box-shadow:2px 2px 0 var(--ink);">
              <div>
                <div style="font-family:var(--mono); font-size:9.5px; font-weight:900; color:var(--orange-vibrant); text-transform:uppercase; letter-spacing:0.06em;">
                  CÓDIGO DE ACCESO A LA PRÁCTICA (UN SOLO USO)
                </div>
                <div style="display:flex; align-items:center; gap:8px; margin-top:4px;">
                  <code id="modal-token-display" style="font-family:var(--mono); font-size:13px; font-weight:900; color:var(--ink); background:#FFFFFF; border:1.5px solid var(--ink); padding:4px 8px;">
                    --
                  </code>
                  <button id="btn-copy-token" type="button" style="background:var(--ink); color:#FFFFFF; border:1.5px solid var(--ink); font-family:var(--mono); font-size:10px; font-weight:800; padding:5px 10px; cursor:pointer; text-transform:uppercase; box-shadow:1px 1px 0 var(--ink);">
                    Copiar
                  </button>
                </div>
              </div>
              <div style="text-align:right;">
                <div style="font-family:var(--mono); font-size:9.5px; font-weight:900; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.06em;">MODALIDAD</div>
                <div id="modal-mode-display" style="font-family:var(--mono); font-size:13px; font-weight:900; color:var(--ink); margin-top:2px;">
                  PC / GAFAS VR
                </div>
              </div>
            </div>

            <!-- Guía Paso a Paso -->
            <div style="background:#FFF; border:2px solid var(--ink); padding:16px; box-shadow:2px 2px 0 var(--ink);">
              <div style="font-family:var(--mono); font-size:10px; font-weight:900; color:var(--rust); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:10px;">
                📖 ¿CÓMO RESOLVER ESTA PRÁCTICA? (3 PASOS FÁCILES)
              </div>
              <div style="display:flex; flex-direction:column; gap:8px; font-size:12px; line-height:1.4; color:var(--ink);">
                <div style="display:flex; align-items:flex-start; gap:8px;">
                  <span style="background:var(--ink); color:#FFF; font-family:var(--mono); font-size:9.5px; font-weight:900; padding:2px 6px; border-radius:2px;">1</span>
                  <div><strong>Abre el simulador en tu PC o visor VR</strong> e ingresa con tu usuario institucional o código de estudiante.</div>
                </div>
                <div style="display:flex; align-items:flex-start; gap:8px;">
                  <span style="background:var(--ink); color:#FFF; font-family:var(--mono); font-size:9.5px; font-weight:900; padding:2px 6px; border-radius:2px;">2</span>
                  <div><strong>¡El juego detecta tu práctica automáticamente!</strong> No requieres copiar ni pegar códigos ni tokens en el casco VR.</div>
                </div>
                <div style="display:flex; align-items:flex-start; gap:8px;">
                  <span style="background:var(--ink); color:#FFF; font-family:var(--mono); font-size:9.5px; font-weight:900; padding:2px 6px; border-radius:2px;">3</span>
                  <div><strong>Cumple las misiones experimentales de la práctica.</strong> Al completarlas, Unity enviará tus notas, quemará el intento y desbloqueará la encuesta del panel derecho.</div>
                </div>
              </div>
            </div>

            <!-- Rúbrica de Misiones Evaluadas (Componente Dinámico) -->
            <div id="student-modal-missions-container" style="background:#FFF; border:2px solid var(--ink); padding:14px 16px; box-shadow:2px 2px 0 var(--ink);">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <span style="font-family:var(--mono); font-size:10px; font-weight:900; color:var(--ink); text-transform:uppercase; letter-spacing:0.06em;">
                  📋 MISIONES EVALUADAS EN SIMULADOR (UNITY)
                </span>
                <span id="student-missions-count-badge" style="font-family:var(--mono); font-size:9.5px; font-weight:800; color:var(--rust); background:#FFF0EE; border:1px solid var(--rust); padding:2px 6px;">
                  EVALUACIÓN DINÁMICA
                </span>
              </div>
              <div id="student-modal-missions-list" style="display:flex; flex-direction:column; gap:6px;">
                <!-- Se llena dinámicamente según el experimento -->
              </div>
            </div>

            <!-- Caja de Instrucciones y Acción -->
            <div style="background:var(--ink); border:2px solid var(--ink); padding:16px; color:#FFFFFF; box-shadow:3px 3px 0 var(--orange-vibrant);">
              <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
                <span style="font-size:18px;">🕹️</span>
                <h4 style="font-family:var(--sans); font-size:13px; font-weight:900; text-transform:uppercase; margin:0; color:#FFFFFF;">
                  Sincronización del Intento
                </h4>
              </div>

              <!-- Simulation Finalize / Test Trigger -->
