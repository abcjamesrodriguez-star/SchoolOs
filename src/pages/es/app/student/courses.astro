---
// ============================================================
// SchoolOS — Panel Estudiante: Mis Cursos
// Fase 4 | Mateo Gómez
// ============================================================
import AppLayout from '../../../../layouts/AppLayout.astro';
import { getStudentCourses, getStudentProfile } from '../../../../data/app/mock-student';

const lang = 'es';
const student = getStudentProfile();
const courses = getStudentCourses();
---

<AppLayout
  title="Mis Cursos — Mateo Gómez"
  pageTitle="Mis Materias Matriculadas"
  activeSection="courses"
  role="student"
  schoolName="Colegio Norte"
  lang={lang}
  activeRoute="/app/student/courses"
  breadcrumbs={[
    { label: 'Colegio Norte' },
    { label: 'Panel Estudiante', href: `/${lang}/app/student` },
    { label: 'Mis Cursos' },
  ]}
>

  <!-- HEADER -->
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; flex-wrap:wrap; gap:12px;">
    <div>
      <h1 style="font-family:var(--serif); font-size:22px; font-weight:800; margin:0 0 4px 0;">
        Mis Materias — {student.grade}
      </h1>
      <div style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft);">
        {courses.length} asignaturas matriculadas · Periodo 1 · 2026
      </div>
    </div>
    <a
      href={`/${lang}/app/student`}
      class="btn btn-secondary btn-sm"
      style="font-size:11.5px; font-weight:700;"
    >
      ← Volver al Dashboard
    </a>
  </div>

  <!-- GRID DE CURSOS -->
  <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap:20px; margin-bottom:32px;">
    {courses.map((c) => {
      const progressPct = c.guidesTotal > 0 ? Math.round((c.guidesRead / c.guidesTotal) * 100) : 0;
      const avgColor = c.currentAverage >= 8 ? '#4A7C59' : c.currentAverage >= 6 ? '#C8860A' : 'var(--rust)';
      return (
        <div style="background:var(--paper); border:2px solid var(--ink); border-radius:10px; overflow:hidden; box-shadow:5px 5px 0 rgba(18,17,14,0.07); display:flex; flex-direction:column;">
          <!-- Card Header -->
          <div style="background:var(--ink); padding:14px 18px; display:flex; justify-content:space-between; align-items:flex-start;">
            <div>
              <div style="font-family:var(--mono); font-size:9.5px; color:rgba(255,255,255,0.6); font-weight:700; text-transform:uppercase; margin-bottom:4px;">
                {c.subject}
              </div>
              <div style="font-family:var(--serif); font-size:15px; font-weight:700; color:#FFFFFF; line-height:1.3;">
                {c.courseName}
              </div>
            </div>
            <div style={`font-family:var(--mono); font-size:20px; font-weight:900; color:${avgColor === '#4A7C59' ? '#7EBC8E' : avgColor === '#C8860A' ? '#F4C150' : '#F08060'}; line-height:1;`}>
              {c.currentAverage.toFixed(1)}
            </div>
          </div>

          <!-- Card Body -->
          <div style="padding:16px 18px; flex:1; display:flex; flex-direction:column; gap:12px;">
            <!-- Profesor -->
            <div style="display:flex; align-items:center; gap:9px;">
              <img
                src={c.teacherAvatarUrl || '/avatars/women/fila-1-columna-1.png'}
                alt={c.teacherName}
                style="width:28px; height:28px; border-radius:50%; border:1.5px solid var(--line); object-fit:cover;"
              />
              <div>
                <div style="font-size:11.5px; font-weight:700; color:var(--ink);">{c.teacherName}</div>
                <div style="font-family:var(--mono); font-size:10px; color:var(--ink-soft);">{c.schedule}</div>
              </div>
            </div>

            <!-- Progreso de Guías -->
            <div>
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:5px;">
                <span style="font-family:var(--mono); font-size:10px; color:var(--ink-soft); font-weight:700;">GUÍAS LEÍDAS</span>
                <span style="font-family:var(--mono); font-size:11px; font-weight:800; color:var(--ink);">{c.guidesRead}/{c.guidesTotal}</span>
              </div>
              <div style="height:6px; background:var(--line); border-radius:3px; overflow:hidden;">
                <div style={`height:100%; width:${progressPct}%; background:${progressPct === 100 ? '#4A7C59' : 'var(--rust)'}; border-radius:3px; transition:width 0.3s;`}></div>
              </div>
              <div style="font-family:var(--mono); font-size:9px; color:var(--ink-soft); margin-top:3px;">{progressPct}% completado</div>
            </div>
          </div>

          <!-- Card Footer -->
          <div style="border-top:1.5px solid var(--line); padding:12px 18px; display:flex; gap:8px;">
            <a
              href={`/${lang}/app/student/courses`}
              class="btn btn-secondary btn-sm"
              style="flex:1; text-align:center; font-size:11px; font-weight:700; border-radius:4px;"
            >
              Ver Guías
            </a>
            <a
              href={`/${lang}/app/student/grades`}
              class="btn btn-secondary btn-sm"
              style="flex:1; text-align:center; font-size:11px; font-weight:700; border-radius:4px;"
            >
              Ver Notas
            </a>
          </div>
        </div>
      );
    })}
  </div>

</AppLayout>
