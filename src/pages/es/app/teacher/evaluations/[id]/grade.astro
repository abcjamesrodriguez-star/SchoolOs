---
// ============================================================
// SchoolOS — Calificación Manual (Teacher)
// Fase 3 | Planilla de notas para evaluaciones presenciales
// ============================================================
import AppLayout from '../../../../../../layouts/AppLayout.astro';
import { getEvaluationById, getResultsByEvaluation } from '../../../../../../data/app/mock-content';

const lang = 'es';
const { id } = Astro.params;
const evaluation = getEvaluationById(id!);
const students = getResultsByEvaluation(id!);
---

{evaluation ? (
  <AppLayout
    title={`Cargar Notas — ${evaluation.title}`}
    pageTitle="Calificación Manual"
    activeSection="courses"
    role="teacher"
    schoolName="Raptor Crew"
    lang={lang}
    activeRoute={`/app/teacher/evaluations/${id}/grade`}
    breadcrumbs={[
      { label: 'Raptor Crew' },
      { label: 'Panel Docente', href: `/${lang}/app/teacher` },
      { label: evaluation.guideTitle, href: `/${lang}/app/teacher/guides/${evaluation.guideId}` },
      { label: 'Cargar Notas' },
    ]}
  >

    <!-- ── CINTILLO INFORMATIVO ── -->
    <div style="background:var(--cream); border:2px solid var(--rust); padding:12px 18px; margin-bottom:20px; display:flex; align-items:center; gap:12px;">
      <span class="plan-tag" style="background:var(--rust); color:#FFFFFF; border-color:var(--rust); font-size:10px; font-weight:900; white-space:nowrap;">EVALUACIÓN PRESENCIAL</span>
      <span style="font-family:var(--mono); font-size:12px; color:var(--ink);">Carga manual de calificaciones — Las notas no se auto-generan en modalidad presencial/papel.</span>
    </div>

    <!-- ── HEADER ── -->
    <div style="background:var(--paper); border:2px solid var(--ink); padding:16px 20px; margin-bottom:20px; display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:12px; box-shadow:4px 4px 0 rgba(18,17,14,0.08);">
      <div>
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
          <span class="badge badge-warning" style="font-size:10px; font-weight:800;">PRESENCIAL</span>
          <span style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">{students.length} alumnos pendientes · Aprobación ≥ {evaluation.passingScore}%</span>
        </div>
        <h1 style="font-family:var(--serif); font-size:22px; font-weight:700; color:var(--ink); margin:0 0 4px 0;">{evaluation.title}</h1>
        <div style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft);">Guía: {evaluation.guideTitle}</div>
      </div>
      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <a href={`/${lang}/app/teacher/courses`} class="btn btn-secondary btn-sm" style="font-size:11px;">Cancelar</a>
      </div>
    </div>

    <!-- ── NOTA DE ESCALA ── -->
    <div style="background:var(--paper); border:1.5px solid var(--ink); padding:12px 16px; margin-bottom:20px; display:grid; grid-template-columns: repeat(4, 1fr); gap:8px; font-family:var(--mono); font-size:11px;">
      <div style="text-align:center; padding:8px; background:var(--cream); border:1px solid var(--line-strong);">
        <div style="font-size:9px; color:var(--ink-soft); text-transform:uppercase;">Escala</div>
        <div style="font-weight:800; color:var(--ink);">0 – 100%</div>
      </div>
      <div style="text-align:center; padding:8px; background:var(--cream); border:1px solid var(--line-strong);">
        <div style="font-size:9px; color:var(--ink-soft); text-transform:uppercase;">Equivalencia CL</div>
        <div style="font-weight:800; color:var(--ink);">0.0 – 5.0</div>
      </div>
      <div style="text-align:center; padding:8px; background:var(--cream); border:1px solid var(--line-strong);">
        <div style="font-size:9px; color:var(--ink-soft); text-transform:uppercase;">Aprobación</div>
        <div style="font-weight:800; color:var(--rust);">≥ {evaluation.passingScore}% / {(evaluation.passingScore / 20).toFixed(1)}</div>
      </div>
      <div style="text-align:center; padding:8px; background:var(--cream); border:1px solid var(--line-strong);">
        <div style="font-size:9px; color:var(--ink-soft); text-transform:uppercase;">Intentos</div>
        <div style="font-weight:800; color:var(--ink);">{evaluation.maxAttempts} máx.</div>
      </div>
    </div>

    <!-- ── PLANILLA DE CALIFICACIONES ── -->
    <div class="panel" style="border:2px solid var(--ink); box-shadow:6px 6px 0 rgba(18,17,14,0.08); margin-bottom:20px;">
      <div class="panel-header" style="background:var(--ink);">
        <h2 style="font-size:12px; color:#FFFFFF; letter-spacing:0.08em;">PLANILLA DE NOTAS — {students.length} ALUMNOS</h2>
      </div>
      <div class="panel-body" style="padding:0;">
        <table style="width:100%; border-collapse:collapse;">
          <thead>
            <tr style="border-bottom:2px solid var(--ink); background:var(--cream);">
              <th style="text-align:left; padding:10px 16px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink);">Estudiante</th>
              <th style="text-align:center; padding:10px 12px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink);">Grupo</th>
              <th style="text-align:center; padding:10px 12px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink);">Nota (0–100)</th>
              <th style="text-align:center; padding:10px 12px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink);">Equivalencia</th>
              <th style="text-align:center; padding:10px 12px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink);">Acción</th>
            </tr>
          </thead>
          <tbody>
            {students.map((s, i) => (
              <tr style={`border-bottom:1.5px solid var(--line); ${i % 2 === 0 ? 'background:var(--paper);' : 'background:var(--cream);'}`}>
                <td style="padding:12px 16px;">
                  <div style="display:flex; align-items:center; gap:8px;">
                    <div style="width:28px; height:28px; background:var(--cream); border:1.5px solid var(--ink); border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:var(--mono); font-size:9px; font-weight:800; flex-shrink:0;">
                      {s.studentName.split(' ').map((n: string) => n[0]).slice(0,2).join('')}
                    </div>
                    <span style="font-size:13px; font-weight:600; color:var(--ink);">{s.studentName}</span>
                  </div>
                </td>
                <td style="padding:12px; text-align:center; font-family:var(--mono); font-size:11.5px; color:var(--ink-soft);">{s.groupCode}</td>
                <td style="padding:12px; text-align:center;">
                  <input
                    type="number"
                    min="0"
                    max="100"
                    placeholder="0–100"
                    style="width:80px; padding:6px 10px; border:2px solid var(--ink); background:var(--paper); font-family:var(--mono); font-size:14px; font-weight:700; color:var(--ink); text-align:center; outline:none;"
                  />
                </td>
                <td style="padding:12px; text-align:center; font-family:var(--mono); font-size:11px; color:var(--ink-soft);">
                  <span id={`equiv-${i}`}>—</span>
                </td>
                <td style="padding:12px; text-align:center;">
                  <button
                    class="btn btn-secondary btn-sm"
                    onclick={`alert('Nota guardada para ${s.studentName}. Recuerda guardar todas las notas al finalizar.');`}
                    style="font-size:10.5px;"
                  >
                    Guardar
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- ── BOTÓN GUARDAR TODO ── -->
    <div style="display:flex; gap:14px; flex-wrap:wrap; align-items:center;">
      <button
        class="btn btn-primary"
        onclick="alert(' Todas las calificaciones han sido guardadas correctamente. Los alumnos pueden consultar sus notas desde su panel.')"
        style="font-size:13px; font-weight:800; padding:12px 24px;"
      >
        ✓ Guardar Todas las Notas
      </button>
      <a href={`/${lang}/app/teacher/courses`} class="btn btn-secondary" style="font-size:12px; padding:11px 20px;">
        Cancelar y volver
      </a>
      <span style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft); margin-left:8px;">
        Los alumnos serán notificados automáticamente al publicar las notas.
      </span>
    </div>

  </AppLayout>
) : (
  <AppLayout title="Evaluación no encontrada" pageTitle="Error" activeSection="courses" role="teacher" schoolName="Raptor Crew" lang={lang} activeRoute="/app/teacher" breadcrumbs={[{ label: 'Error' }]}>
    <div style="padding:40px; text-align:center;">
      <h2>Evaluación no encontrada</h2>
      <a href={`/${lang}/app/teacher/courses`} class="btn btn-primary">Volver</a>
    </div>
  </AppLayout>
)}
