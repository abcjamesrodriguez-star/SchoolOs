---
// ============================================================
// SchoolOS — Mis Estudiantes (Teacher)
// Fase 3 | Directorio de todos los alumnos del docente (Hydrated via RPC)
// ============================================================
import AppLayout from '../../../../../layouts/AppLayout.astro';
const lang = 'es';
---

<AppLayout
  title="Mis Estudiantes"
  pageTitle="Directorio de Mis Estudiantes"
  activeSection="students"
  role="teacher"
  schoolName="Raptor Crew"
  lang={lang}
  activeRoute="/app/teacher/students"
  breadcrumbs={[{ label: 'Raptor Crew' }, { label: 'Panel Docente', href: `/${lang}/app/teacher` }, { label: 'Mis Estudiantes' }]}
>

  <!-- ── HEADER CON FILTRO ── -->
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px; margin-bottom:20px;">
    <div>
      <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-bottom:4px;">
        Total: <strong id="studentsTotalHeader" style="color:var(--ink);">0 alumnos mostrados</strong> en tus materias activas
      </div>
      <p style="font-size:12.5px; color:var(--ink-soft); margin:0;">Incluye alumnos de tus cursos activos. Para ver todos los del colegio, contacta al rector.</p>
    </div>

    <!-- Filtros -->
    <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
      <input
        type="text"
        id="searchInput"
        placeholder="Buscar por nombre..."
        style="padding:8px 14px; border:2px solid var(--ink); background:var(--paper); font-family:var(--mono); font-size:12px; color:var(--ink); outline:none; width:200px;"
      />
    </div>
  </div>

  <!-- ── TABLA DE ESTUDIANTES ── -->
  <div class="panel" style="border:2px solid var(--ink); box-shadow:6px 6px 0 rgba(18,17,14,0.08);">
    <div class="panel-header" style="background:var(--ink);">
      <h2 style="font-size:12px; color:#FFFFFF; letter-spacing:0.08em;">DIRECTORIO DE ALUMNOS (SEGURO)</h2>
    </div>
    <div class="panel-body" style="padding:0; overflow-x:auto;">
      <table style="width:100%; border-collapse:collapse; font-size:12.5px;">
        <thead>
          <tr style="border-bottom:2px solid var(--ink); background:var(--cream);">
            <th style="text-align:left; padding:10px 16px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink);">Estudiante</th>
            <th style="text-align:left; padding:10px 12px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink);">Documento</th>
            <th style="text-align:left; padding:10px 12px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink);">Email</th>
          </tr>
        </thead>
        <tbody id="studentsTableBody">
          <tr><td colspan="3" style="padding:30px; text-align:center;">Cargando estudiantes de forma segura desde la BD...</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Footer de la tabla -->
    <div style="padding:12px 16px; border-top:1.5px solid var(--ink); background:var(--cream); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
      <div id="studentsFooterStatus" style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft);">
        Cargando...
      </div>
    </div>
  </div>

  <script type="module">
    import { teacherService } from '../../../../../services/teacherService';
    
    let allStudents = [];

    async function loadDirectory() {
      try {
        const res = await teacherService.getTeacherStudents();
        allStudents = res.data || [];
        renderTable(allStudents);
      } catch (err) {
        console.error('Error fetching directory:', err);
        document.getElementById('studentsTableBody').innerHTML = '<tr><td colspan="3" style="padding:30px; color:red;">Error cargando directorio. Revisa consola.</td></tr>';
      }
    }

    function renderTable(students) {
      document.getElementById('studentsTotalHeader').innerText = students.length + ' alumnos mostrados';
      document.getElementById('studentsFooterStatus').innerText = 'Mostrando ' + students.length + ' alumnos directos.';

      const tbody = document.getElementById('studentsTableBody');
      if (students.length === 0) {
        tbody.innerHTML = '<tr><td colspan="3" style="padding:30px; text-align:center;">No tienes estudiantes matriculados en tus cursos aún.</td></tr>';
        return;
      }

      tbody.innerHTML = students.map((student, i) => {
        const initials = (student.name || 'NN').split(' ').map(n => n[0]).slice(0,2).join('').toUpperCase();
        const bgRow = i % 2 === 0 ? 'background:var(--paper);' : 'background:var(--cream);';
        
        return `
          <tr class="student-row" data-name="${(student.name || '').toLowerCase()}" style="border-bottom:1.5px solid var(--line); ${bgRow}">
            <td style="padding:12px 16px;">
              <div style="display:flex; align-items:center; gap:10px;">
                <div style="width:32px; height:32px; border:1.5px solid var(--ink); border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:var(--mono); font-size:9px; font-weight:800; flex-shrink:0; background:var(--cream); color:var(--ink);">
                  ${initials}
                </div>
                <div style="font-weight:600; color:var(--ink); font-size:13px;">${student.name || 'Sin Nombre'}</div>
              </div>
            </td>
            <td style="padding:12px; font-family:var(--mono); color:var(--ink-soft); font-size:11px;">
              ${student.document_id || '---'}
            </td>
            <td style="padding:12px; color:var(--ink); font-size:12px;">
              ${student.email || 'Sin correo'}
            </td>
          </tr>
        `;
      }).join('');
    }

    document.getElementById('searchInput')?.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase();
      const filtered = allStudents.filter(s => (s.name || '').toLowerCase().includes(q));
      renderTable(filtered);
    });

    document.addEventListener('DOMContentLoaded', loadDirectory);
  </script>

</AppLayout>
