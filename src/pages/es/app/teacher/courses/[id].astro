---
// ============================================================
// SchoolOS — Detalle de Curso (Teacher)
// Fase 3 | Espacio de Trabajo por Curso con Pestañas
// ============================================================
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { getTeacherCourses, getTeacherCourseById, getGuidesByCourse, getStudentsByCourse } from '../../../../../data/app/mock-content';


const lang = 'es';
const { id } = Astro.params;
const course = getTeacherCourseById(id!);
const guides = getGuidesByCourse(id!);
const students = getStudentsByCourse(id!);
const honorStudents = students.filter(s => s.status === 'honor');
const riskStudents = students.filter(s => s.status === 'risk');
---

{course ? (
  <AppLayout
    title={course.name}
    pageTitle={course.name}
    activeSection="courses"
    role="teacher"
    schoolName="Raptor Crew"
    lang={lang}
    activeRoute={`/app/teacher/courses/${id}`}
    breadcrumbs={[
      { label: 'Raptor Crew' },
      { label: 'Panel Docente', href: `/${lang}/app/teacher` },
      { label: 'Mis Cursos', href: `/${lang}/app/teacher/courses` },
      { label: course.name },
    ]}
  >

    <!-- ── 1. HEADER DEL CUADERNO DE CURSO ── -->
    <div style="background:var(--paper); border:2px solid var(--ink); border-radius:8px; padding:18px 24px; margin-bottom:20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; box-shadow:4px 4px 0 rgba(18,17,14,0.08);">
      <div>
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
          <span class="plan-tag" style="background:var(--rust); color:#FFFFFF; border-color:var(--rust); font-size:9.5px; font-weight:900; padding:2px 8px; border-radius:3px;">
            {course.level}
          </span>
          <span style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft);">
             {course.room} ·  {course.schedule}
          </span>
        </div>

        <h1 id="courseTitleDOM" style="font-family:var(--serif); font-size:24px; font-weight:700; color:var(--ink); margin:0;">{course.name}</h1>

        <div style="font-family:var(--mono); font-size:12px; color:var(--ink-soft); margin-top:4px;">
          <strong><span class="studentsCount">0</span> estudiantes matriculados</strong> · Promedio actual del grupo: <strong style="color:var(--rust); font-size:13px;"><span id="courseAverage">--</span> / 10</strong>
        </div>
      </div>

      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <a href={`/${lang}/app/teacher/courses/${id}/guides/new`} class="btn btn-primary btn-sm" style="font-size:12px; font-weight:800; padding:8px 16px; border-radius:4px; text-decoration:none;">
          + Nueva Guía
        </a>
        <a href={`/${lang}/app/teacher/grades`} class="btn btn-secondary btn-sm" style="font-size:12px; font-weight:700; padding:8px 14px; border-radius:4px; border-color:var(--ink); text-decoration:none;">
          Planilla de Notas →
        </a>
      </div>
    </div>

    <!-- ── 2. BARRA DE PESTAÑAS TÁCTIL ── -->
    <div style="display:flex; border-bottom:2px solid var(--ink); margin-bottom:20px; gap:4px; flex-wrap:wrap;">
      <button
        type="button"
        id="tabBtnGuides"
        onclick="switchCourseTab('guides');"
        class="course-tab-btn active"
        style="padding:10px 20px; font-family:var(--mono); font-size:12px; font-weight:800; border:2px solid var(--ink); border-bottom:none; border-radius:6px 6px 0 0; background:var(--ink); color:#FFFFFF; cursor:pointer; transition:all 0.15s ease;"
      >
         Guías y Material (<span class="guidesCount">0</span>)
      </button>

      <button
        type="button"
        id="tabBtnStudents"
        onclick="switchCourseTab('students');"
        class="course-tab-btn"
        style="padding:10px 20px; font-family:var(--mono); font-size:12px; font-weight:800; border:2px solid var(--ink); border-bottom:none; border-radius:6px 6px 0 0; background:var(--cream); color:var(--ink); cursor:pointer; transition:all 0.15s ease;"
      >
         Estudiantes del Salón (<span class="studentsCount">0</span>)
      </button>

      <button
        type="button"
        id="tabBtnGrades"
        onclick="switchCourseTab('grades');"
        class="course-tab-btn"
        style="padding:10px 20px; font-family:var(--mono); font-size:12px; font-weight:800; border:2px solid var(--ink); border-bottom:none; border-radius:6px 6px 0 0; background:var(--cream); color:var(--ink); cursor:pointer; transition:all 0.15s ease;"
      >
         Evaluaciones & Calificaciones
      </button>

      <button
        type="button"
        id="tabBtnLabs"
        onclick="switchCourseTab('labs');"
        class="course-tab-btn"
        style="padding:10px 20px; font-family:var(--mono); font-size:12px; font-weight:800; border:2px solid var(--ink); border-bottom:none; border-radius:6px 6px 0 0; background:var(--rust); color:#FFF; cursor:pointer; transition:all 0.15s ease;"
      >
         Laboratorios Virtuales (Unity)
      </button>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <!-- ── PESTAÑA 1: GUÍAS Y MATERIAL PEDAGÓGICO ── -->
    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <div id="courseTabContent-guides" class="course-tab-panel">
      
      <div class="panel" style="border:2px solid var(--ink); border-radius:8px; box-shadow:5px 5px 0 rgba(18,17,14,0.08); background:var(--paper); overflow:hidden;">
        <div class="panel-header" style="background:var(--cream); border-bottom:1.5px solid var(--ink); padding:12px 20px; display:flex; justify-content:space-between; align-items:center;">
          <h2 style="font-size:13px; font-weight:800; margin:0; letter-spacing:0.04em;">
            GUÍAS DIDÁCTICAS ASIGNADAS A ESTE GRUPO (<span class="guidesCount">0</span>)
          </h2>
          <a href={`/${lang}/app/teacher/courses/${id}/guides/new`} class="btn btn-primary btn-sm" style="font-size:11px; font-weight:800; border-radius:3px;">
            + Crear Guía
          </a>
        </div>

        
          <div class="panel-body" style="padding:0;">
            <!-- Contenedor dinámico para guías creadas en el Estudio Pedagógico -->
            <div id="customGuidesList"></div>

            
          </div>
        
      </div>

    </div>

    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <!-- ── PESTAÑA 2: ESTUDIANTES DEL SALÓN ── -->
    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <div id="courseTabContent-students" class="course-tab-panel" style="display:none;">
      
      <!-- Barra de Filtros y Búsqueda -->
      <div style="background:var(--paper); border:2px solid var(--ink); border-radius:8px; padding:14px 18px; margin-bottom:16px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
          <input
            type="text"
            id="studentCourseSearch"
            placeholder="Buscar por nombre..."
            oninput="filterCourseStudents();"
            style="padding:7px 12px; border:1.5px solid var(--ink); border-radius:4px; background:#FFFFFF; font-family:var(--mono); font-size:11.5px; color:var(--ink); outline:none; width:220px;"
          />
          
          <div style="display:flex; gap:4px;">
            <button
              type="button"
              id="filterPillAll"
              onclick="setStudentFilter('all');"
              class="student-filter-pill active"
              style="padding:5px 10px; font-family:var(--mono); font-size:10.5px; font-weight:800; border:1px solid var(--ink); border-radius:3px; background:var(--ink); color:#FFFFFF; cursor:pointer;"
            >
              Todos (<span class="studentsCount">0</span>)
            </button>
            <button
              type="button"
              id="filterPillHonor"
              onclick="setStudentFilter('honor');"
              class="student-filter-pill"
              style="padding:5px 10px; font-family:var(--mono); font-size:10.5px; font-weight:800; border:1px solid var(--ink); border-radius:3px; background:var(--cream); color:var(--ink); cursor:pointer;"
            >
               Honor ({honorStudents.length})
            </button>
            <button
              type="button"
              id="filterPillRisk"
              onclick="setStudentFilter('risk');"
              class="student-filter-pill"
              style="padding:5px 10px; font-family:var(--mono); font-size:10.5px; font-weight:800; border:1px solid var(--rust); border-radius:3px; background:#FFF0EE; color:var(--rust); cursor:pointer;"
            >
               Refuerzo ({riskStudents.length})
            </button>
          </div>
        </div>

        <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">
          Mostrando <strong id="visibleStudentCount" style="color:var(--ink);"><span class="studentsCount">0</span></strong> de <span class="studentsCount">0</span> estudiantes
        </div>
      </div>

      <!-- Tabla de Estudiantes -->
      <div class="panel" style="border:2px solid var(--ink); border-radius:8px; box-shadow:5px 5px 0 rgba(18,17,14,0.08); background:#FFFFFF; overflow:hidden;">
        <div style="overflow-x:auto;">
          <table style="width:100%; border-collapse:collapse; font-size:12.5px;">
            <thead>
              <tr style="border-bottom:2px solid var(--ink); background:var(--cream);">
                <th style="text-align:center; width:44px; padding:10px 6px; font-family:var(--mono); font-size:10px; font-weight:800; color:var(--ink-soft); border-right:1px solid var(--line);">#</th>
                <th style="text-align:left; padding:10px 16px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink); border-right:1px solid var(--line);">Estudiante</th>
                <th style="text-align:left; padding:10px 16px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink); border-right:1px solid var(--line);">Promedio en la Materia</th>
                <th style="text-align:center; padding:10px 12px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink); border-right:1px solid var(--line);">Pendientes</th>
                <th style="text-align:center; padding:10px 12px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink);">Desempeño</th>
              </tr>
            </thead>
            <tbody id="courseStudentsTableBody">
              
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <!-- ── PESTAÑA 3: EVALUACIONES & CALIFICACIONES ── -->
    <!-- ══════════════════════════════════════════════════════════════════════════ -->

    <div id="courseTabContent-grades" class="course-tab-panel" style="display:none;">
      <div class="panel-body padded" style="text-align:center; padding:50px 20px; border:2px solid var(--ink); border-radius:8px; background:var(--paper); box-shadow:5px 5px 0 rgba(18,17,14,0.08);">
        <div style="font-family:var(--serif); font-size:20px; font-weight:700; color:var(--ink); margin-bottom:8px;">
          Planilla de Evaluaciones Vacía
        </div>
        <p style="font-size:13px; color:var(--ink-soft); margin-bottom:20px; max-width:440px; margin-left:auto; margin-right:auto;">
          Aún no se han configurado rúbricas ni notas para este grupo. Utiliza el módulo de Calificaciones para empezar.
        </p>
        <a href="/es/app/teacher/grades" class="btn btn-primary" style="font-size:12px; font-weight:800;">
          Ir a Calificaciones →
        </a>
      </div>
    </div>
  

    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <!-- ── PESTAÑA 4: LABORATORIOS VIRTUALES (UNITY) ── -->
    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <div id="courseTabContent-labs" class="course-tab-panel" style="display:none;">
      
      <div class="panel" style="border:2px solid var(--ink); border-radius:8px; box-shadow:5px 5px 0 rgba(18,17,14,0.08); background:var(--paper); overflow:hidden;">
        <div class="panel-header" style="background:var(--rust); border-bottom:1.5px solid var(--ink); padding:16px 20px; display:flex; justify-content:space-between; align-items:center; color:#FFF;">
          <div>
            <h2 style="font-size:15px; font-weight:800; margin:0; letter-spacing:0.04em; color:#FFF;">
              PANEL DE LABORATORIOS VIRTUALES
            </h2>
            <div style="font-family:var(--mono); font-size:11px; margin-top:4px;">Asigna simuladores a tus estudiantes. Los resultados llegarán en tiempo real.</div>
          </div>
          <button id="btnFetchLabs" class="btn btn-sm" style="background:#FFF; color:var(--rust); border:2px solid var(--ink); font-weight:900; box-shadow:2px 2px 0 var(--ink);">
            ↻ Actualizar Datos
          </button>
        </div>

        <div class="panel-body" style="padding:24px;">
          
          <!-- Controles de Asignación -->
          <div style="background:var(--cream); border:1.5px dashed var(--ink); padding:20px; margin-bottom:24px; display:flex; gap:16px; align-items:flex-end; flex-wrap:wrap;">
            <div style="flex:1; min-width:250px;">
              <label style="display:block; font-family:var(--mono); font-size:11px; font-weight:800; color:var(--ink); margin-bottom:6px;">SELECCIONA EL LABORATORIO:</label>
              <select id="selectVirtualLab" style="width:100%; padding:10px; font-size:13px; border:2px solid var(--ink); border-radius:4px; font-family:var(--serif);">
                <option value="">Cargando laboratorios del catálogo...</option>
              </select>
            </div>
            
            <button id="btnAssignLabBatch" class="btn btn-primary" style="padding:10px 24px; font-size:13px; font-weight:800; white-space:nowrap;">
              ⚡ Generar Tokens a Toda la Clase
            </button>
          </div>

          <!-- Tabla de Resultados en Vivo -->
          <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; text-align:left; font-size:12px;">
              <thead>
                <tr style="background:var(--ink); color:#FFF; font-family:var(--mono); font-size:10px;">
                  <th style="padding:10px 12px; border:1px solid var(--ink);">ESTUDIANTE</th>
                  <th style="padding:10px 12px; border:1px solid var(--ink);">ESTADO</th>
                  <th style="padding:10px 12px; border:1px solid var(--ink);">BUENAS</th>
                  <th style="padding:10px 12px; border:1px solid var(--ink);">MALAS</th>
                  <th style="padding:10px 12px; border:1px solid var(--ink);">TIEMPO</th>
                  <th style="padding:10px 12px; border:1px solid var(--ink);">MODO</th>
                  <th style="padding:10px 12px; border:1px solid var(--ink);">FEEDBACK EN VIVO (ENTER PARA GUARDAR)</th>
                </tr>
              </thead>
              <tbody id="labTokensTableBody">
                <tr>
                  <td colspan="7" style="padding:20px; text-align:center; font-family:var(--mono); color:var(--ink-soft);">
                    Cargando tokens de la base de datos...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

        </div>
      </div>
    </div>

    <!-- SCRIPT DE PESTAÑAS Y BÚSQUEDA -->
    <script is:inline>
      let currentFilterStatus = 'all';

      function switchCourseTab(tabName) {
        // Ocultar todos los paneles
        document.querySelectorAll('.course-tab-panel').forEach(panel => {
          panel.style.display = 'none';
        });

        // Desactivar todos los botones
        document.querySelectorAll('.course-tab-btn').forEach(btn => {
          btn.style.background = 'var(--cream)';
          btn.style.color = 'var(--ink)';
        });

        // Mostrar panel activo
        const activePanel = document.getElementById(`courseTabContent-${tabName}`);
        if (activePanel) activePanel.style.display = 'block';

        // Activar botón
        const activeBtn = document.getElementById(`tabBtn${tabName.charAt(0).toUpperCase() + tabName.slice(1)}`);
        if (activeBtn) {
          activeBtn.style.background = 'var(--ink)';
          activeBtn.style.color = '#FFFFFF';
        }
      }

      function setStudentFilter(status) {
        currentFilterStatus = status;

        // Reset pills
        document.querySelectorAll('.student-filter-pill').forEach(pill => {
          pill.style.background = 'var(--cream)';
          pill.style.color = 'var(--ink)';
          pill.style.borderColor = 'var(--ink)';
        });

        const activePill = document.getElementById(`filterPill${status.charAt(0).toUpperCase() + status.slice(1)}`);
        if (activePill) {
          if (status === 'risk') {
            activePill.style.background = 'var(--rust)';
            activePill.style.color = '#FFFFFF';
            activePill.style.borderColor = 'var(--rust)';
          } else {
            activePill.style.background = 'var(--ink)';
            activePill.style.color = '#FFFFFF';
          }
        }

        filterCourseStudents();
      }

      function filterCourseStudents() {
        const query = (document.getElementById('studentCourseSearch')?.value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('.course-student-row');
        let visibleCount = 0;

        rows.forEach(row => {
          const name = row.getAttribute('data-name') || '';
          const status = row.getAttribute('data-status') || '';

          const matchName = name.includes(query);
          const matchStatus = (currentFilterStatus === 'all') || (status === currentFilterStatus);

          if (matchName && matchStatus) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        const countEl = document.getElementById('visibleStudentCount');
        if (countEl) countEl.innerText = visibleCount;
      }

      // Renderizar guías creadas por el docente en el Estudio Pedagógico
      function loadCustomGuides() {
        try {
          const listContainer = document.getElementById('customGuidesList');
          if (!listContainer) return;
          const currentCourseId = window.location.pathname.split('/courses/')[1]?.split('/')[0] || '';
          const customGuidesRaw = localStorage.getItem('schoolos_custom_guides');
          if (!customGuidesRaw) return;
          const customGuides = JSON.parse(customGuidesRaw);
          const courseGuides = customGuides.filter(g => g.courseId === currentCourseId);

          if (courseGuides.length === 0) return;

          let html = '';
          courseGuides.forEach(g => {
            const isPub = g.status === 'published';
            const badgeClass = isPub ? 'badge badge-active' : 'badge badge-warning';
            const badgeText = isPub ? 'PUBLICADA (NUEVA)' : 'BORRADOR GUARDADO';
            const dateStr = new Date(g.updatedAt || g.createdAt).toLocaleDateString('es-CO', { day:'2-digit', month:'short', year:'numeric' });

            html += `
              <div style="padding:20px 24px; border-bottom:1.5px solid var(--line); background:#FFFDF8; border-left:4px solid var(--rust); transition:background 0.15s ease;">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px; flex-wrap:wrap; gap:8px;">
                  <div style="display:flex; gap:8px; align-items:center;">
                    <span class="${badgeClass}" style="font-size:9.5px; font-weight:800; padding:2px 8px; border-radius:3px;">
                      ${badgeText}
                    </span>
                    <span style="font-family:var(--mono); font-size:11px; color:var(--rust); font-weight:700;">
                       Creada en Estudio Pedagógico · ${g.blocks?.length || 0} bloques · ~${g.estimatedMinutes || 25} min lectura
                    </span>
                  </div>
                  <span style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">
                    Actualizada: ${dateStr}
                  </span>
                </div>

                <h3 style="font-family:var(--serif); font-size:18px; font-weight:700; color:var(--ink); margin:0 0 6px 0;">
                  ${g.title}
                </h3>
                <p style="font-size:13px; color:var(--ink-soft); margin:0 0 16px 0; line-height:1.5; max-width:820px;">
                  ${g.description || 'Sin descripción adicional.'}
                </p>

                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; border-top:1px dashed var(--line); padding-top:12px;">
                  <div style="display:flex; gap:10px; flex-wrap:wrap;">
                    <a href="/es/app/teacher/courses/${currentCourseId}/guides/new" class="btn btn-secondary btn-sm" style="font-size:11.5px; font-weight:700; border-radius:4px; text-decoration:none;">
                      Abrir en Estudio Pedagógico 
                    </a>
                  </div>
                  ${isPub ? '<div style="font-family:var(--mono); font-size:11px; color:#2E5E1E; font-weight:700; background:#E5EFE0; padding:3px 10px; border-radius:4px; border:1px solid #A8C99B;">✓ Visible en Portal de Estudiantes</div>' : ''}
                </div>
              </div>
            `;
          });
          listContainer.innerHTML = html;
        } catch (e) {
          console.error('Error cargando guías personalizadas:', e);
        }
      }

      document.addEventListener('DOMContentLoaded', loadCustomGuides);
      loadCustomGuides();
    </script>

  </AppLayout>
) : (
  <AppLayout title="Curso no encontrado" pageTitle="Error" activeSection="courses" role="teacher" schoolName="Raptor Crew" lang={lang} activeRoute="/app/teacher/courses" breadcrumbs={[{ label: 'Raptor Crew' }, { label: 'Cursos' }]}>
    <div style="padding:40px; text-align:center;">
      <h2>Curso no encontrado</h2>
      <a href={`/${lang}/app/teacher/courses`} class="btn btn-primary">Volver a Mis Cursos</a>
    </div>
  </AppLayout>
)}


<script type="module">
  import { teacherService } from "../../../../../services/teacherService";

  let currentTokens = [];
  const courseId = window.location.pathname.split("/").pop();

  async function hydrateCourseDetails() {
    const urlParams = new URLSearchParams(window.location.search);
    const classroom = urlParams.get('classroom');
    if (!courseId || !classroom) return;

    try {
      const res = await teacherService.getVirtualClassroomDetails(courseId, classroom);
      const result = res.data;
      if (!result) return;

      const { course, students, student_count } = result;
      if (course) {
        const titleEl = document.getElementById('courseTitleDOM');
        if (titleEl) titleEl.textContent = course.name + ' (' + classroom + ')';
      }
      document.querySelectorAll('.studentsCount').forEach(el => el.textContent = student_count);
      const visibleCount = document.getElementById('visibleStudentCount');
      if (visibleCount) visibleCount.textContent = student_count;
      const tableBody = document.getElementById('courseStudentsTableBody');
      if (tableBody) {
        if (student_count === 0) {
          tableBody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:20px; font-family:var(--mono); color:var(--ink-soft);">No hay estudiantes matriculados en este salon.</td></tr>';
        } else {
          tableBody.innerHTML = students.map((std, idx) => `
            <tr style="border-bottom:1px solid var(--line);">
              <td style="text-align:center; font-family:var(--mono); font-size:11px; font-weight:800; color:var(--ink-soft); padding:8px 6px; border-right:1px solid var(--line);">${idx + 1}</td>
              <td style="padding:10px 16px; border-right:1px solid var(--line);">
                <div style="display:flex; align-items:center; gap:10px;">
                  <img src="${std.avatar_url || '/avatars/men/fila-1-columna-1.png'}" style="width:30px; height:30px; border-radius:50%; border:1px solid var(--ink);" />
                  <div style="font-weight:700;">${std.name}</div>
                </div>
              </td>
              <td style="padding:10px 16px; font-family:var(--mono); font-size:14px; font-weight:900; color:var(--ink); border-right:1px solid var(--line);">-</td>
              <td style="text-align:center; padding:10px 16px; font-family:var(--mono); font-size:14px; font-weight:900; color:var(--ink); border-right:1px solid var(--line);">-</td>
              <td style="text-align:center; padding:10px 16px; font-family:var(--mono); font-size:10px; font-weight:800; color:var(--ink-soft);">ACTIVO</td>
            </tr>
          `).join('');
        }
      }
    } catch (error) {
      console.error('Error fetching classroom details:', error);
    }
  }

  async function loadLabsCatalog() {
    try {
      const json = await teacherService.getLabCatalog();
      if (json.ok && json.labs) {
        const select = document.getElementById("selectVirtualLab");
        if (select) {
          select.innerHTML = '<option value="">-- Elige un simulador del catalogo --</option>' +
            json.labs.map(lab => `<option value="${lab.id}">${lab.name}</option>`).join('');
        }
      }
    } catch (err) {
      console.error('Error cargando catalogo de labs:', err);
    }
  }

  async function loadLabTokens() {
    if (!courseId || courseId.length < 5) return;
    try {
      const json = await teacherService.getLabTokens(courseId);
      if (json.ok && json.tokens) {
        currentTokens = json.tokens;
        renderTokensTable();
      }
    } catch (err) {
      console.error('Error cargando tokens de labs:', err);
    }
  }

  function renderTokensTable() {
    const tbody = document.getElementById("labTokensTableBody");
    if (!tbody) return;
    if (currentTokens.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" style="padding:20px; text-align:center; color:var(--ink-soft);">No hay laboratorios asignados en este curso todavia.</td></tr>';
      return;
    }
    tbody.innerHTML = currentTokens.map(token => {
      let statusBadge = '';
      if (token.status === 'pending') statusBadge = '<span style="background:var(--cream); border:1px solid var(--ink); padding:2px 6px; font-size:10px; border-radius:4px;">Pendiente</span>';
      else if (token.status === 'in_progress') statusBadge = '<span style="background:#FFC107; color:#000; padding:2px 6px; font-size:10px; border-radius:4px; font-weight:bold;">Jugando</span>';
      else if (token.status === 'completed') statusBadge = '<span style="background:var(--rust); color:#FFF; padding:2px 6px; font-size:10px; border-radius:4px;">Terminado</span>';
      return `
        <tr style="border-bottom:1px solid var(--line-strong);">
          <td style="padding:8px 12px; display:flex; align-items:center; gap:8px;">
            <img src="${token.student?.avatar_url || '/default-avatar.png'}" style="width:24px; height:24px; border-radius:50%; border:1px solid var(--ink);" />
            <span style="font-weight:700;">${token.student?.name || 'Alumno Desconocido'}</span>
          </td>
          <td style="padding:8px 12px;">${statusBadge}</td>
          <td style="padding:8px 12px; font-weight:bold; color:var(--rust);">${token.tasks_completed || '-'}</td>
          <td style="padding:8px 12px;">${token.tasks_missing || '-'}</td>
          <td style="padding:8px 12px;">${token.time_spent_seconds ? token.time_spent_seconds + 's' : '-'}</td>
          <td style="padding:8px 12px; font-weight:bold;">${token.play_mode || '-'}</td>
          <td style="padding:8px 12px;">
            <input type="text" class="feedback-input" data-token-id="${token.id}" value="${token.feedback_text || ''}" placeholder="Escribe un comentario..." style="width:100%; padding:4px 8px; border:1px solid var(--ink); border-radius:3px; font-family:var(--serif); font-size:11px;" />
          </td>
        </tr>
      `;
    }).join('');

    document.querySelectorAll('.feedback-input').forEach(input => {
      input.addEventListener('keypress', async (e) => {
        if (e.key === 'Enter') {
          input.disabled = true;
          try {
            await teacherService.updateLabFeedback(input.getAttribute('data-token-id'), input.value);
            input.style.borderColor = 'var(--rust)';
          } catch (err) {
            console.error('Error actualizando feedback:', err);
          } finally {
            input.disabled = false;
          }
        }
      });
    });
  }

  document.getElementById("btnAssignLabBatch")?.addEventListener("click", async () => {
    const labId = document.getElementById("selectVirtualLab").value;
    if (!labId) return alert("Por favor selecciona un simulador primero.");
    try {
      const json = await teacherService.assignLabBatch(labId, courseId);
      if (!json.ok) throw new Error(json.error || 'Error asignando laboratorio.');
      alert('Simulador asignado a ' + json.assignedCount + ' alumnos exitosamente!');
      loadLabTokens();
    } catch (err) {
      console.error(err);
      alert(err.message || 'Error asignando laboratorio.');
    }
  });

  document.addEventListener("DOMContentLoaded", () => {
    hydrateCourseDetails();
    loadLabsCatalog();
    loadLabTokens();
  });
</script>