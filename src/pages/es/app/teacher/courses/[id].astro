    <!-- SCRIPT DE PESTAÑAS Y BÚSQUEDA -->
    <script is:inline>
      let currentFilterStatus = 'all';

      function switchCourseTab(tabName) {
        // Ocultar todos los paneles
        document.querySelectorAll('.course-tab-panel').forEach(panel => {
          panel.style.display = 'none';
        });

        // Desactivar todos los botones
        document.querySelectorAll('.course-tab-btn').forEach(btn => {
          btn.style.background = 'var(--cream)';
          btn.style.color = 'var(--ink)';
        });

        // Mostrar panel activo
        const activePanel = document.getElementById(`courseTabContent-${tabName}`);
        if (activePanel) activePanel.style.display = 'block';

        // Activar botón
        const activeBtn = document.getElementById(`tabBtn${tabName.charAt(0).toUpperCase() + tabName.slice(1)}`);
        if (activeBtn) {
          activeBtn.style.background = 'var(--ink)';
          activeBtn.style.color = '#FFFFFF';
        }

        try {
          const url = new URL(window.location.href);
          url.searchParams.set('tab', tabName);
          window.history.replaceState({}, '', url.toString());
          sessionStorage.setItem('active_course_tab_' + window.location.pathname, tabName);
        } catch (_) {}
      }

      document.addEventListener('DOMContentLoaded', () => {
        try {
          const urlParams = new URLSearchParams(window.location.search);
          const savedTab = urlParams.get('tab') || sessionStorage.getItem('active_course_tab_' + window.location.pathname);
          if (savedTab && document.getElementById(`courseTabContent-${savedTab}`)) {
            switchCourseTab(savedTab);
          }
        } catch (_) {}
      });

      function setStudentFilter(status) {
        currentFilterStatus = status;

        // Reset pills
        document.querySelectorAll('.student-filter-pill').forEach(pill => {
          pill.style.background = 'var(--cream)';
          pill.style.color = 'var(--ink)';
          pill.style.borderColor = 'var(--ink)';
        });

        const activePill = document.getElementById(`filterPill${status.charAt(0).toUpperCase() + status.slice(1)}`);
        if (activePill) {
          if (status === 'risk') {
            activePill.style.background = 'var(--rust)';
            activePill.style.color = '#FFFFFF';
            activePill.style.borderColor = 'var(--rust)';
          } else {
            activePill.style.background = 'var(--ink)';
            activePill.style.color = '#FFFFFF';
          }
        }

        filterCourseStudents();
      }

      function filterCourseStudents() {
        const query = (document.getElementById('studentCourseSearch')?.value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('.course-student-row');
        let visibleCount = 0;

        rows.forEach(row => {
          const name = row.getAttribute('data-name') || '';
          const status = row.getAttribute('data-status') || '';

          const matchName = name.includes(query);
          const matchStatus = (currentFilterStatus === 'all') || (status === currentFilterStatus);

          if (matchName && matchStatus) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        const countEl = document.getElementById('visibleStudentCount');
        if (countEl) countEl.innerText = visibleCount;
      }

      // Renderizar guías creadas por el docente en el Estudio Pedagógico
      function loadCustomGuides() {
        try {
          const listContainer = document.getElementById('customGuidesList');
          if (!listContainer) return;
          const currentCourseId = window.location.pathname.split('/courses/')[1]?.split('/')[0] || '';
          const customGuidesRaw = localStorage.getItem('schoolos_custom_guides');
          if (!customGuidesRaw) return;
          const customGuides = JSON.parse(customGuidesRaw);
          const courseGuides = customGuides.filter(g => g.courseId === currentCourseId);

          if (courseGuides.length === 0) return;

          let html = '';
          courseGuides.forEach(g => {
            const isPub = g.status === 'published';
            const badgeClass = isPub ? 'badge badge-active' : 'badge badge-warning';
            const badgeText = isPub ? 'PUBLICADA (NUEVA)' : 'BORRADOR GUARDADO';
            const dateStr = new Date(g.updatedAt || g.createdAt).toLocaleDateString('es-CO', { day:'2-digit', month:'short', year:'numeric' });

            html += `
              <div style="padding:20px 24px; border-bottom:1.5px solid var(--line); background:#FFFDF8; border-left:4px solid var(--rust); transition:background 0.15s ease;">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px; flex-wrap:wrap; gap:8px;">
                  <div style="display:flex; gap:8px; align-items:center;">
                    <span class="${badgeClass}" style="font-size:9.5px; font-weight:800; padding:2px 8px; border-radius:3px;">
                      ${badgeText}
                    </span>
                    <span style="font-family:var(--mono); font-size:11px; color:var(--rust); font-weight:700;">
                       Creada en Estudio Pedagógico · ${g.blocks?.length || 0} bloques · ~${g.estimatedMinutes || 25} min lectura
                    </span>
                  </div>
                  <span style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">
                    Actualizada: ${dateStr}
                  </span>
                </div>

                <h3 style="font-family:var(--serif); font-size:18px; font-weight:700; color:var(--ink); margin:0 0 6px 0;">
                  ${g.title}
                </h3>
                <p style="font-size:13px; color:var(--ink-soft); margin:0 0 16px 0; line-height:1.5; max-width:820px;">
                  ${g.description || 'Sin descripción adicional.'}
                </p>

                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; border-top:1px dashed var(--line); padding-top:12px;">
                  <div style="display:flex; gap:10px; flex-wrap:wrap;">
                    <a href="/es/app/teacher/courses/${currentCourseId}/guides/new" class="btn btn-secondary btn-sm" style="font-size:11.5px; font-weight:700; border-radius:4px; text-decoration:none;">
                      Abrir en Estudio Pedagógico 
                    </a>
                  </div>
                  ${isPub ? '<div style="font-family:var(--mono); font-size:11px; color:#2E5E1E; font-weight:700; background:#E5EFE0; padding:3px 10px; border-radius:4px; border:1px solid #A8C99B;">✓ Visible en Portal de Estudiantes</div>' : ''}
                </div>
              </div>
            `;
          });
          listContainer.innerHTML = html;
        } catch (e) {
          console.error('Error cargando guías personalizadas:', e);
        }
      }

      document.addEventListener('DOMContentLoaded', loadCustomGuides);
      loadCustomGuides();
    </script>

  </AppLayout>
) : (
  <AppLayout title="Curso no encontrado" pageTitle="Error" activeSection="courses" role="teacher" schoolName="Raptor Crew" lang={lang} activeRoute="/app/teacher/courses" breadcrumbs={[{ label: 'Raptor Crew' }, { label: 'Cursos' }]}>
    <div style="padding:40px; text-align:center;">
      <h2>Curso no encontrado</h2>
      <a href={`/${lang}/app/teacher/courses`} class="btn btn-primary">Volver a Mis Cursos</a>
    </div>
  </AppLayout>
)}


<script type="module">
  import { teacherService } from "../../../../../services/teacherService";

  let currentTokens = [];
  let activeReportModalToken = null;
  const labsTabEl = document.getElementById("courseTabContent-labs");
  const courseId = labsTabEl?.dataset.courseId || window.location.pathname.split("/").filter(Boolean).pop();

  async function hydrateCourseDetails() {
    const urlParams = new URLSearchParams(window.location.search);
    let classroom = urlParams.get('classroom');
    if (!courseId) return;

    if (!classroom) {
      try {
        const classesRes = await fetch('/api/teacher/classes').then(r => r.json());
        const matched = (classesRes?.data || []).find(c => c.course?.id === courseId);
        if (matched && matched.room) classroom = matched.room;
      } catch (_) {}
    }

    let studentsList = [];
    let studentCount = 0;

    if (classroom) {
      try {
        const res = await teacherService.getVirtualClassroomDetails(courseId, classroom);
        if (res?.data?.students && res.data.students.length > 0) {
          studentsList = res.data.students;
          studentCount = res.data.student_count || studentsList.length;
          if (res.data.course) {
            const titleEl = document.getElementById('courseTitleDOM');
            if (titleEl) titleEl.textContent = res.data.course.name + ' (' + classroom + ')';
          }
        }
      } catch (e) {
        console.error('Error fetching classroom details:', e);
      }
    }

    // Si no hay classroom o no devolvió alumnos, consultar vía api/teacher/labs?action=students
    if (studentsList.length === 0) {
      try {
        const res = await teacherService.getCourseStudents(courseId);
        if (res?.ok && Array.isArray(res.students) && res.students.length > 0) {
          studentsList = res.students.map(s => s.student || s);
          studentCount = studentsList.length;
        }
      } catch (e) {
        console.error('Error fetching course students:', e);
      }
    }

    document.querySelectorAll('.studentsCount').forEach(el => el.textContent = studentCount);
    const visibleCount = document.getElementById('visibleStudentCount');
    if (visibleCount) visibleCount.textContent = studentCount;

    const pillAll = document.getElementById('filterPillAll');
    if (pillAll) pillAll.innerHTML = `Todos (<span class="studentsCount">${studentCount}</span>)`;

    const tableBody = document.getElementById('courseStudentsTableBody');
    if (tableBody) {
      if (!studentsList || studentsList.length === 0) {
        tableBody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:24px; font-family:var(--mono); color:var(--ink-soft);">No hay estudiantes matriculados en este curso todavía.</td></tr>';
      } else {
        tableBody.innerHTML = studentsList.map((std, idx) => `
          <tr class="course-student-row" data-name="${(std.name || '').toLowerCase()}" data-status="enrolled" style="border-bottom:1px solid var(--line);">
            <td style="text-align:center; font-family:var(--mono); font-size:11px; font-weight:800; color:var(--ink-soft); padding:10px 6px; border-right:1px solid var(--line);">${idx + 1}</td>
            <td style="padding:10px 16px; border-right:1px solid var(--line);">
              <div style="display:flex; align-items:center; gap:10px;">
                <img src="${std.avatar_url || '/avatars/men/fila-1-columna-1.png'}" alt="" style="width:32px; height:32px; border-radius:50%; border:1.5px solid var(--ink); object-fit:cover;" />
                <div>
                  <div style="font-weight:700; color:var(--ink); font-size:13px;">${std.name}</div>
                  <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft);">${std.email || std.job_title || ''}</div>
                </div>
              </div>
            </td>
            <td style="padding:10px 16px; font-family:var(--mono); font-size:13px; font-weight:700; color:var(--ink); border-right:1px solid var(--line);">-</td>
            <td style="text-align:center; padding:10px 16px; font-family:var(--mono); font-size:12px; font-weight:800; color:var(--ink); border-right:1px solid var(--line);">0</td>
            <td style="text-align:center; padding:10px 16px;">
              <span class="badge badge-active" style="background:#E5EFE0; color:#2E5E1E; border:1px solid #A8C99B; font-size:10px; font-weight:800; padding:2px 8px; border-radius:3px;">MATRICULADO</span>
            </td>
          </tr>
        `).join('');
      }
    }
  }

  function showLabAlert(message, type = 'info') {
    const alertEl = document.getElementById("labAssignAlert");
    if (!alertEl) return;
    alertEl.style.display = 'block';
    if (type === 'success') {
      alertEl.style.background = '#FFF1E6';
      alertEl.style.color = 'var(--rust)';
      alertEl.style.border = '1.5px solid var(--rust)';
    } else {
      alertEl.style.background = '#FFE5D0';
      alertEl.style.color = '#B71C1C';
      alertEl.style.border = '1.5px solid #B71C1C';
    }
    alertEl.textContent = message;
    setTimeout(() => { alertEl.style.display = 'none'; }, 6000);
  }

  async function loadLabsCatalog() {
    if (!document.getElementById('courseTabContent-labs')) return;
    try {
      const json = await teacherService.getLabCatalog();
      if (json.ok && json.labs && json.labs.length > 0) {
        const select = document.getElementById("selectVirtualLab");
        if (select) {
          select.innerHTML = json.labs.map((lab, idx) => 
            `<option value="${lab.id}" ${idx === 0 ? 'selected' : ''}>${lab.name}</option>`
          ).join('');
        }
      }
    } catch (err) {
      console.error('Error cargando catalogo de labs:', err);
    }
  }

  let currentCourseStudents: any[] = [];

  async function loadLabTokens() {
    if (!document.getElementById('courseTabContent-labs')) return;
    if (!courseId || courseId.length < 5) return;
    try {
      const [tokensJson, studentsJson] = await Promise.all([
        teacherService.getLabTokens(courseId).catch(() => ({ ok: false, tokens: [] })),
        teacherService.getCourseStudents(courseId).catch(() => ({ ok: false, students: [] })),
      ]);

      if (tokensJson.ok && tokensJson.tokens) {
        currentTokens = tokensJson.tokens;
      }
      if (studentsJson.ok && studentsJson.students) {
        currentCourseStudents = studentsJson.students;
      }

      renderTokensTable();
      renderGradesTabSync();
    } catch (err) {
      console.error('Error cargando tokens y alumnos de labs:', err);
    }
  }

  function renderGradesTabSync() {
    const summaryBadge = document.getElementById('gradesTabSummaryBadge');
    const miniTableBody = document.getElementById('gradesTabMiniTableBody');
    if (!summaryBadge || !miniTableBody) return;

    const completed = currentTokens.filter(t => {
      let pf: any = {};
      try { if (t.feedback_text?.startsWith('{')) pf = JSON.parse(t.feedback_text); } catch(_) {}
      return t.status === 'completed' || Boolean(pf?.survey?.submittedAt);
    });

    const totalStudents = currentCourseStudents.length || currentTokens.length || 1;
    const completedCount = completed.length;
    const percentage = Math.round((completedCount / totalStudents) * 100);

    let avgScore = 0;
    if (completedCount > 0) {
      const sum = completed.reduce((acc, t) => {
        let pf: any = {};
        try { if (t.feedback_text?.startsWith('{')) pf = JSON.parse(t.feedback_text); } catch(_) {}
        const sc = pf.score !== undefined ? Number(pf.score) : 10.0;
        return acc + sc;
      }, 0);
      avgScore = parseFloat((sum / completedCount).toFixed(1));
    }

    summaryBadge.innerHTML = `
      <span style="color:var(--rust); font-weight:900;">${completedCount} / ${totalStudents}</span> entregas (${percentage}%) · Promedio: <strong style="color:var(--rust);">${avgScore > 0 ? avgScore + ' / 10' : '--'}</strong>
    `;

    const tokensByStudent = new Map<string, any>();
    currentTokens.forEach(tok => {
      const sId = tok.student_id || tok.student?.id;
      if (sId) tokensByStudent.set(sId, tok);
    });

    const list = currentCourseStudents.length > 0
      ? currentCourseStudents.map((cs: any) => ({
          student: cs.student || { id: cs.student_id, name: 'Alumno' },
          token: tokensByStudent.get(cs.student?.id || cs.student_id),
        }))
      : currentTokens.map(tok => ({
          student: tok.student || { id: tok.student_id, name: 'Alumno' },
          token: tok,
        }));

    miniTableBody.innerHTML = list.map(({ student, token }: any) => {
      if (token) {
        let pf: any = {};
        try { if (token.feedback_text?.startsWith('{')) pf = JSON.parse(token.feedback_text); } catch(_) {}
        const isDone = token.status === 'completed' || Boolean(pf?.survey?.submittedAt);
        const tasksDone = token.tasks_completed || (isDone ? 4 : 0);
        const totalT = (token.tasks_completed || 0) + (token.tasks_missing || 0) || 4;
        const score = pf.score !== undefined ? pf.score : (isDone ? '10.0' : '--');

        return `
          <tr style="border-bottom:1px solid var(--line);">
            <td style="padding:10px 12px; font-weight:700; color:var(--ink);">${student.name}</td>
            <td style="padding:10px 12px; text-align:center;">
              <span style="font-family:var(--mono); font-size:10px; font-weight:800; padding:3px 7px; border-radius:3px; background:${isDone ? '#E5EFE0' : 'var(--cream)'}; color:${isDone ? '#2E5E1E' : 'var(--ink)'}; border:1px solid var(--ink);">
                ${isDone ? '✓ ENTREGADO' : '⏳ PENDIENTE'}
              </span>
            </td>
            <td style="padding:10px 12px; text-align:center; font-family:var(--mono); font-size:11px;">
              ${tasksDone} / ${totalT} misiones
            </td>
            <td style="padding:10px 12px; text-align:center; font-family:var(--mono); font-weight:900; font-size:13px; color:${isDone ? 'var(--rust)' : 'var(--ink-soft)'};">
              ${isDone ? score + ' / 10' : 'Sin calificar'}
            </td>
            <td style="padding:10px 12px; text-align:right;">
              ${isDone ? `
                <button type="button" class="btn-view-lab-report" data-token-id="${token.id}" style="background:var(--ink); color:#FFF; border:1px solid var(--ink); padding:4px 8px; font-family:var(--mono); font-size:10px; font-weight:800; cursor:pointer;">
                  Ver Reporte
                </button>
              ` : `
                <button type="button" onclick="switchCourseTab('labs')" style="background:#FFF; color:var(--ink); border:1px solid var(--ink); padding:4px 8px; font-family:var(--mono); font-size:10px; font-weight:800; cursor:pointer;">
                  Ver en Labs →
                </button>
              `}
            </td>
          </tr>
        `;
      } else {
        return `
          <tr style="border-bottom:1px solid var(--line);">
            <td style="padding:10px 12px; font-weight:700; color:var(--ink);">${student.name}</td>
            <td style="padding:10px 12px; text-align:center;">
              <span style="font-family:var(--mono); font-size:10px; font-weight:800; padding:3px 7px; border-radius:3px; background:#F5F5F5; color:var(--ink-soft); border:1px dashed var(--ink);">
                SIN ASIGNAR
              </span>
            </td>
            <td style="padding:10px 12px; text-align:center; font-family:var(--mono); font-size:11px; color:var(--ink-soft);">-</td>
            <td style="padding:10px 12px; text-align:center; font-family:var(--mono); font-size:11px; color:var(--ink-soft);">Sin evaluar</td>
            <td style="padding:10px 12px; text-align:right;">
              <button type="button" onclick="switchCourseTab('labs')" style="background:var(--rust); color:#FFF; border:1px solid var(--ink); padding:4px 8px; font-family:var(--mono); font-size:10px; font-weight:900; cursor:pointer;">
                Asignar en Labs →
              </button>
            </td>
          </tr>
        `;
      }
    }).join('');
  }

  function renderTokensTable() {
    const tbody = document.getElementById("labTokensTableBody");
    if (!tbody) return;

    // Mapa de tokens por student_id
    const tokensByStudent = new Map<string, any>();
    currentTokens.forEach(tok => {
      const sId = tok.student_id || tok.student?.id;
      if (sId) tokensByStudent.set(sId, tok);
    });

    // Consolidar todos los estudiantes matriculados
    let displayList: any[] = [];
    if (currentCourseStudents.length > 0) {
      displayList = currentCourseStudents.map((cs: any) => {
        const studentInfo = cs.student || { id: cs.student_id, name: 'Alumno' };
        const token = tokensByStudent.get(studentInfo.id || cs.student_id);
        return {
          student: studentInfo,
          token: token || null,
        };
      });
    } else if (currentTokens.length > 0) {
      displayList = currentTokens.map(tok => ({
        student: tok.student || { id: tok.student_id, name: 'Alumno' },
        token: tok,
      }));
    }

    if (displayList.length === 0) {
      tbody.innerHTML = '<tr><td colspan="8" style="padding:28px; text-align:center; font-family:var(--mono); color:var(--ink-soft);">No hay estudiantes matriculados en este curso todavía.</td></tr>';
      return;
    }

    tbody.innerHTML = displayList.map(({ student, token }) => {
      if (token) {
        const rawTokenId = token.token_id || token.id;
        const formattedTime = token.time_spent_seconds ? `${Math.floor(token.time_spent_seconds / 60)}m ${token.time_spent_seconds % 60}s` : '-';
        const tasksCompleted = token.tasks_completed || 0;
        const tasksMissing = token.tasks_missing || 0;
        const totalTasks = tasksCompleted + tasksMissing;
        
        let parsedFeedback = null;
        try {
          if (token.feedback_text && typeof token.feedback_text === 'string' && token.feedback_text.startsWith('{')) {
            parsedFeedback = JSON.parse(token.feedback_text);
          }
        } catch (_) {}

        const calculatedScore = (parsedFeedback?.score !== undefined && parsedFeedback?.score !== null)
          ? parsedFeedback.score
          : (totalTasks > 0 ? ((tasksCompleted / totalTasks) * 10).toFixed(1) : (token.status === 'completed' ? '0.0' : null));
        const hasSurvey = Boolean(parsedFeedback?.survey?.submittedAt);
        const isDone = token.status === 'completed' || hasSurvey;

        const displayScore = (calculatedScore !== null && calculatedScore !== undefined) ? calculatedScore : (isDone ? '0.0' : '--');
        const displayTotalTasks = totalTasks > 0 ? totalTasks : (parsedFeedback?.missions?.length || 0);
        const missionsSubtitle = displayTotalTasks > 0 ? `${tasksCompleted}/${displayTotalTasks} misiones` : `${tasksCompleted} misiones`;

        const hasMultipleAttempts = (token.totalAttempts && token.totalAttempts > 1) || (token.attemptHistory && token.attemptHistory.length > 1);
        const attemptBadge = hasMultipleAttempts
          ? `<div style="margin-top:4px;"><span style="font-family:var(--mono); font-size:9.5px; font-weight:900; background:#FFF1E6; color:var(--rust); border:1px solid var(--rust); padding:2px 6px; border-radius:3px; display:inline-block;">📜 Intento #${token.totalAttempts || token.attemptHistory?.length} (${token.attemptHistory?.length || 1} registros)</span></div>`
          : '';

        const scoreDisplay = isDone
          ? `
            <div style="display:flex; flex-direction:column; align-items:center; gap:4px;">
              <strong style="color:var(--rust); font-size:16px; font-weight:900;">${displayScore} / 10</strong>
              <div style="font-size:10px; color:var(--ink-soft); font-family:var(--mono);">${missionsSubtitle}</div>
              <button
                type="button"
                class="btn-view-lab-report"
                data-token-id="${token.id}"
                style="background:var(--rust); color:#FFF; border:1.5px solid var(--ink); border-radius:3px; padding:3px 8px; font-size:10px; font-family:var(--mono); font-weight:800; cursor:pointer; margin-top:2px; box-shadow:1px 1px 0 var(--ink); white-space:nowrap;"
              >
                📊 Ver Reporte & Encuesta
              </button>
            </div>
          `
          : `
            <span style="color:var(--ink-soft); font-family:var(--mono); font-size:11px;">Pendiente</span>
            <div style="font-size:9.5px; color:var(--ink-soft); margin-top:2px;">(Sin entrega aún)</div>
          `;

        const statusBadge = isDone
          ? `<span style="background:#E5EFE0; color:#2E5E1E; border:1.5px solid #A8C99B; padding:4px 8px; font-size:10.5px; border-radius:4px; font-weight:800; font-family:var(--mono); display:inline-block;">✓ COMPLETADO</span><div style="font-size:9px; color:#2E5E1E; font-family:var(--mono); margin-top:3px; font-weight:800;">🔒 TOKEN CONSUMIDO</div>${attemptBadge}`
          : token.status === 'in_progress'
          ? `<span style="background:#FFF3E0; color:#E64A19; border:1.5px solid #FF5722; padding:4px 8px; font-size:10.5px; border-radius:4px; font-weight:800; font-family:var(--mono); display:inline-block;">🎮 EN PARTIDA</span>${attemptBadge}`
          : `
            <span style="background:var(--cream); color:var(--ink); border:1.5px solid var(--ink); padding:4px 8px; font-size:10.5px; border-radius:4px; font-weight:800; font-family:var(--mono); display:inline-block;">⏳ PENDIENTE</span>
            <div style="font-size:9px; color:var(--ink-soft); margin-top:4px; font-family:var(--mono); line-height:1.2;">Esperando que el alumno ingrese</div>
            ${attemptBadge}
          `;

        const refreshBtnStyle = isDone
          ? 'background:#FFF0EE; border:1.5px solid var(--rust); border-radius:3px; padding:4px 10px; font-family:var(--mono); font-size:10px; font-weight:900; cursor:pointer; color:var(--rust); box-shadow:1px 1px 0 var(--ink);'
          : 'background:var(--cream); border:1px solid var(--ink); border-radius:3px; padding:3px 8px; font-family:var(--mono); font-size:10px; font-weight:800; cursor:pointer; color:var(--ink);';
        const refreshBtnText = isDone ? '↻ Permitir Presentar Otra Vez' : '↻ Regenerar Token';

        const effectiveDevice = (
          parsedFeedback?.survey?.deviceUsed ||
          parsedFeedback?.device ||
          parsedFeedback?.playMode ||
          token.play_mode ||
          'PC'
        ).toUpperCase();

        let deviceBadge = `<span style="font-family:var(--mono); font-size:10px; font-weight:900; background:#EEF2F6; color:#1E293B; border:1.5px solid var(--ink); padding:2px 7px;">🖥️ PC</span>`;
        if (effectiveDevice === 'VR') {
          deviceBadge = `<span style="font-family:var(--mono); font-size:10px; font-weight:900; background:#FFF1E6; color:var(--rust); border:1.5px solid var(--ink); padding:2px 7px;">🥽 VR</span>`;
        } else if (effectiveDevice === 'AMBOS' || effectiveDevice === 'HIBRIDO' || effectiveDevice === 'BOTH') {
          deviceBadge = `<span style="font-family:var(--mono); font-size:10px; font-weight:900; background:#E8F5E9; color:#1B5E20; border:1.5px solid var(--ink); padding:2px 7px;">🔄 AMBOS</span>`;
        }

        return `
          <tr style="border-bottom:1px solid var(--line); transition:background 0.1s ease;">
            <td style="padding:12px 14px; border-right:1px solid var(--line);">
              <div style="display:flex; align-items:center; gap:10px;">
                <img src="${student.avatar_url || '/avatars/men/fila-1-columna-1.png'}" style="width:32px; height:32px; border-radius:50%; border:1.5px solid var(--ink); object-fit:cover;" />
                <div>
                  <div style="font-weight:700; color:var(--ink); font-size:13px;">${student.name || 'Alumno'}</div>
                  <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft);">${student.email || student.job_title || ''}</div>
                </div>
              </div>
            </td>
            <td style="padding:12px 14px; font-weight:600; color:var(--ink); border-right:1px solid var(--line);">
              ${token.lab?.name || 'Laboratorio Virtual de Química'}
            </td>
            <td style="padding:12px 14px; border-right:1px solid var(--line);">
              <div style="display:flex; flex-direction:column; gap:6px;">
                <div style="display:flex; align-items:center; gap:6px;">
                  <span style="font-family:var(--mono); font-size:9.5px; font-weight:900; background:var(--ink); color:#FFF; padding:2px 5px; border-radius:2px;">TOKEN</span>
                  <code style="background:var(--cream); border:1px solid var(--ink); border-radius:3px; padding:2px 6px; font-family:var(--mono); font-size:11px; font-weight:800; color:var(--ink); max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="${rawTokenId}">
                    ${rawTokenId.slice(0, 8).toUpperCase()}...
                  </code>
                </div>
                <div style="display:flex; gap:6px; flex-wrap:wrap;">
                  <button type="button" class="btn-copy-token" data-token="${rawTokenId}" style="background:#FFF; border:1.5px solid var(--ink); border-radius:3px; padding:4px 10px; font-size:10.5px; font-family:var(--mono); font-weight:800; cursor:pointer; white-space:nowrap; box-shadow:1px 1px 0 var(--ink);">
                    📋 Copiar JWT
                  </button>
                </div>
              </div>
            </td>
            <td style="padding:12px 14px; text-align:center; border-right:1px solid var(--line);">${statusBadge}</td>
            <td style="padding:12px 14px; text-align:center; font-family:var(--mono); border-right:1px solid var(--line);">${scoreDisplay}</td>
            <td style="padding:12px 14px; text-align:center; font-family:var(--mono); font-size:11.5px; border-right:1px solid var(--line);">${formattedTime}</td>
            <td style="padding:12px 14px; text-align:center; border-right:1px solid var(--line);">
              ${deviceBadge}
            </td>
            <td style="padding:12px 14px;">
              <div style="display:flex; flex-direction:column; gap:6px;">
                <input type="text" class="feedback-input" data-token-id="${token.id}" value="${typeof token.feedback_text === 'string' && !token.feedback_text.startsWith('{') ? token.feedback_text : ''}" placeholder="Nota docente (Enter para guardar)..." style="width:100%; padding:5px 8px; border:1.5px solid var(--ink); border-radius:4px; font-family:var(--serif); font-size:11.5px; background:#FFF;" />
                <div style="display:flex; justify-content:space-between; align-items:center;">
                  <button type="button" class="btn-refresh-token" data-token-id="${token.id}" data-student-name="${student.name || 'Alumno'}" style="${refreshBtnStyle}">
                    ${refreshBtnText}
                  </button>
                  <span class="feedback-saved-indicator" style="display:none; font-family:var(--mono); font-size:10px; color:var(--rust); font-weight:800;">✓ Guardado</span>
                </div>
              </div>
            </td>
          </tr>
        `;
      } else {
        // Estudiante sin token aún
        return `
          <tr style="border-bottom:1px solid var(--line); background:#FCFAF7;">
            <td style="padding:12px 14px; border-right:1px solid var(--line);">
              <div style="display:flex; align-items:center; gap:10px;">
                <img src="${student.avatar_url || '/avatars/men/fila-1-columna-1.png'}" style="width:32px; height:32px; border-radius:50%; border:1.5px solid var(--ink); object-fit:cover; opacity:0.85;" />
                <div>
                  <div style="font-weight:700; color:var(--ink); font-size:13px;">${student.name || 'Alumno'}</div>
                  <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft);">${student.email || student.job_title || ''}</div>
                </div>
              </div>
            </td>
            <td style="padding:12px 14px; font-weight:600; color:var(--ink-soft); border-right:1px solid var(--line);">
              Laboratorio Virtual de Química
            </td>
            <td style="padding:12px 14px; border-right:1px solid var(--line); font-family:var(--mono); font-size:11px; color:var(--ink-soft); font-style:italic;">
              (Sin token generado)
            </td>
            <td style="padding:12px 14px; text-align:center; border-right:1px solid var(--line);">
              <span style="background:var(--cream); color:var(--ink-soft); border:1px dashed var(--ink); padding:4px 8px; font-size:10px; border-radius:4px; font-weight:800; font-family:var(--mono); display:inline-block;">
                ⏳ SIN ASIGNAR
              </span>
              <div style="font-size:9px; color:var(--ink-soft); margin-top:3px; font-family:var(--mono);">Listo para habilitar</div>
            </td>
            <td style="padding:12px 14px; text-align:center; font-family:var(--mono); color:var(--ink-soft); border-right:1px solid var(--line);">-</td>
            <td style="padding:12px 14px; text-align:center; font-family:var(--mono); color:var(--ink-soft); border-right:1px solid var(--line);">-</td>
            <td style="padding:12px 14px; text-align:center; border-right:1px solid var(--line);">
              <span style="font-family:var(--mono); font-size:10.5px; font-weight:800; background:#FFF; border:1px solid var(--ink); padding:2px 6px; border-radius:3px; opacity:0.7;">PC</span>
            </td>
            <td style="padding:12px 14px;">
              <button
                type="button"
                class="btn-assign-single-student"
                data-student-id="${student.id}"
                data-student-name="${student.name || 'este estudiante'}"
                style="background:var(--rust); color:#FFF; border:1.5px solid var(--ink); border-radius:3px; padding:6px 12px; font-family:var(--mono); font-size:10px; font-weight:900; cursor:pointer; box-shadow:2px 2px 0 var(--ink); white-space:nowrap; text-transform:uppercase;"
              >
                ⚡ Asignar Token
              </button>
            </td>
          </tr>
        `;
      }
    }).join('');

    // Eventos de Asignación Individual
    document.querySelectorAll('.btn-assign-single-student').forEach(btn => {
      btn.addEventListener('click', async () => {
        const studentId = btn.getAttribute('data-student-id');
        const studentName = btn.getAttribute('data-student-name') || 'este estudiante';
        const select = document.getElementById("selectVirtualLab") as HTMLSelectElement;
        const labId = select?.value;
        if (!studentId || !labId) {
          showLabAlert('Error: Selecciona primero un simulador en el menú desplegable.', 'error');
          return;
        }

        (btn as HTMLButtonElement).disabled = true;
        btn.textContent = '⏳ Asignando...';

        try {
          const res = await teacherService.assignSingleLabToken(labId, courseId, studentId);
          if (res.ok) {
            showLabAlert(`✓ Token asignado exitosamente a ${studentName}. Ya puede realizar la práctica.`, 'success');
            await loadLabTokens();
          } else {
            showLabAlert(res.error || 'No se pudo asignar el token individual.', 'error');
            (btn as HTMLButtonElement).disabled = false;
            btn.textContent = '⚡ Asignar Token';
          }
        } catch (err: any) {
          showLabAlert(err.message || 'Error al conectar con el servidor.', 'error');
          (btn as HTMLButtonElement).disabled = false;
          btn.textContent = '⚡ Asignar Token';
        }
      });
    });

    // Eventos de Copiar Token
    document.querySelectorAll('.btn-copy-token').forEach(btn => {
      btn.addEventListener('click', async () => {
        const tokenVal = btn.getAttribute('data-token');
        if (!tokenVal) return;
        try {
          await navigator.clipboard.writeText(tokenVal);
          const originalText = btn.innerHTML;
          btn.innerHTML = '✓ Copiado';
          btn.style.background = 'var(--rust)';
          btn.style.color = '#FFF';
          setTimeout(() => {
            btn.innerHTML = originalText;
            btn.style.background = '#FFF';
            btn.style.color = 'var(--ink)';
          }, 1800);
        } catch (_) {
          prompt('Copia este token de acceso JWT:', tokenVal);
        }
      });
    });

    // Eventos de Ver Reporte & Encuesta Modal
    document.querySelectorAll('.btn-view-lab-report').forEach(btn => {
      btn.addEventListener('click', () => {
        const tokenId = btn.getAttribute('data-token-id');
        const token = currentTokens.find(t => t.id === tokenId);
        if (token) openLabReportModal(token);
      });
    });

    // Eventos de Reactivar Token (Nuevo Intento)
    document.querySelectorAll('.btn-refresh-token').forEach(btn => {
      btn.addEventListener('click', async () => {
        const tokenId = btn.getAttribute('data-token-id');
        const studentName = btn.getAttribute('data-student-name') || 'este estudiante';
        if (!tokenId) return;
        if (!confirm(`¿Deseas permitir que ${studentName} presente el laboratorio nuevamente?\n\nEsta acción reseteará su intento anterior y generará un nuevo token activo para que pueda iniciar la práctica desde su portal.`)) return;
        btn.disabled = true;
        btn.textContent = '⏳ Reactivando...';
        try {
          const res = await teacherService.refreshLabToken(tokenId);
          if (res.ok) {
            showLabAlert(`✓ ${res.message || 'Token reactivado con éxito para ' + studentName + '. Ya puede presentar un nuevo intento.'}`, 'success');
            await loadLabTokens();
          } else {
            throw new Error(res.error || 'Error al reactivar token');
          }
        } catch (err: any) {
          showLabAlert(err.message || 'Error reactivando token.', 'error');
        } finally {
          btn.disabled = false;
        }
      });
    });

    // Eventos de Feedback Docente
    document.querySelectorAll('.feedback-input').forEach(input => {
      input.addEventListener('keypress', async (e) => {
        if (e.key === 'Enter') {
          input.disabled = true;
          const row = input.closest('tr');
          const indicator = row?.querySelector('.feedback-saved-indicator');
          try {
            await teacherService.updateLabFeedback(input.getAttribute('data-token-id'), input.value);
            input.style.borderColor = 'var(--rust)';
            if (indicator) {
              indicator.style.display = 'inline';
              setTimeout(() => { indicator.style.display = 'none'; }, 2000);
            }
          } catch (err) {
            console.error('Error actualizando feedback:', err);
          } finally {
            input.disabled = false;
          }
        }
      });
    });
  }

  function openLabReportModal(token: any) {
    activeReportModalToken = token;
    const modal = document.getElementById('labReportModal');
    if (!modal) return;

    const nameEl = document.getElementById('modalReportStudentName');
    if (nameEl) nameEl.textContent = `${token.student?.name || 'Estudiante'} · ${token.lab?.name || 'Simulador'}`;

    const historyBar = document.getElementById('modalReportHistoryBar');
    const historyButtons = document.getElementById('modalReportHistoryButtons');
    const historySummary = document.getElementById('modalReportHistorySummary');

    const history = (Array.isArray(token.attemptHistory) && token.attemptHistory.length > 0)
      ? token.attemptHistory
      : [];

    function renderAttemptDetails(dataObj: any, activeAttemptNum: number) {
      let parsedFeedback: any = {};
      try {
        if (dataObj.feedback && typeof dataObj.feedback === 'object') {
          parsedFeedback = dataObj.feedback;
        } else if (dataObj.feedback_text && typeof dataObj.feedback_text === 'string' && dataObj.feedback_text.startsWith('{')) {
          parsedFeedback = JSON.parse(dataObj.feedback_text);
        }
      } catch (_) {}

      const feedbackMissions = Array.isArray(parsedFeedback.missions) ? parsedFeedback.missions : [];
      
      function isMissionPassed(m: any): boolean {
        if (m === true) return true;
        if (m === false) return false;
        if (!m) return false;
        if (typeof m.passed === 'boolean') return m.passed;
        if (typeof m.pass === 'boolean') return m.pass;
        if (typeof m.success === 'boolean') return m.success;
        if (typeof m.completed === 'boolean') return m.completed;
        const raw = String(m.passed ?? m.pass ?? m.status ?? m.result ?? m.state ?? m.value ?? '').toLowerCase().trim();
        return raw === 'pass' || raw === 'passed' || raw === 'true' || raw === 'ok' || raw === 'aprobado' || raw === 'success' || raw === '1';
      }

      const tasksCompleted = (dataObj.tasks_completed !== undefined && dataObj.tasks_completed !== null)
        ? dataObj.tasks_completed
        : (dataObj.tasksCompleted !== undefined ? dataObj.tasksCompleted : feedbackMissions.filter(isMissionPassed).length);

      const tasksMissing = (dataObj.tasks_missing !== undefined && dataObj.tasks_missing !== null)
        ? dataObj.tasks_missing
        : (dataObj.tasksMissing !== undefined ? dataObj.tasksMissing : (feedbackMissions.length > 0 ? feedbackMissions.length - tasksCompleted : 0));

      const totalTasks = (tasksCompleted + tasksMissing) > 0
        ? (tasksCompleted + tasksMissing)
        : (feedbackMissions.length > 0 ? feedbackMissions.length : 5);

      const percentage = (dataObj.percentage !== undefined && dataObj.percentage !== null)
        ? dataObj.percentage
        : (parsedFeedback.percentage !== undefined ? parsedFeedback.percentage : (totalTasks > 0 ? Math.round((tasksCompleted / totalTasks) * 100) : 0));

      const isDone = dataObj.status === 'completed' || Boolean(parsedFeedback.survey?.submittedAt);

      const score = (dataObj.score !== undefined && dataObj.score !== null)
        ? dataObj.score
        : (parsedFeedback.score !== undefined ? parsedFeedback.score : (totalTasks > 0 ? Number(((tasksCompleted / totalTasks) * 10).toFixed(1)) : (isDone ? 0.0 : '--')));

      const seconds = dataObj.time_spent_seconds ?? dataObj.timeSpentSeconds ?? parsedFeedback.timeSpentSeconds ?? 0;
      const formattedTime = seconds ? `${Math.floor(seconds / 60)}m ${seconds % 60}s` : '-';

      const scoreEl = document.getElementById('modalReportScore');
      if (scoreEl) scoreEl.textContent = `${score} / 10`;

      const percEl = document.getElementById('modalReportPercentage');
      if (percEl) percEl.textContent = `${percentage}%`;

      const timeEl = document.getElementById('modalReportTime');
      if (timeEl) timeEl.textContent = formattedTime;

      const modeEl = document.getElementById('modalReportMode');
      const effectiveDevice = (
        parsedFeedback.survey?.deviceUsed ||
        parsedFeedback.device ||
        parsedFeedback.playMode ||
        dataObj.play_mode ||
        dataObj.playMode ||
        'PC'
      ).toUpperCase();

      if (modeEl) {
        modeEl.textContent = effectiveDevice === 'AMBOS'
          ? '🔄 AMBOS (PC + VR)'
          : effectiveDevice === 'VR'
          ? '🥽 VISOR VR'
          : '🖥️ COMPUTADOR (PC)';
      }

      // Misiones Unity
      const missionsList = document.getElementById('modalReportMissionsList');
      if (missionsList) {
        if (feedbackMissions.length === 0) {
          missionsList.innerHTML = `
            <div style="text-align:center; padding:18px 14px; color:var(--ink-soft); font-family:var(--mono); font-size:11.5px; background:var(--cream); border:1.5px dashed var(--ink); border-radius:4px;">
              ${isDone
                ? 'Práctica finalizada. No se registraron misiones individuales en la entrega de este simulador.'
                : 'Simulación pendiente de ejecución en Unity. Las misiones evaluadas se registrarán dinámicamente al finalizar la práctica.'}
            </div>
          `;
        } else {
          missionsList.innerHTML = feedbackMissions.map((m: any, idx: number) => {
            const passed = isMissionPassed(m);
            const title = m.mission || m.name || m.title || m.description || `Misión ${idx + 1}`;
            return `
              <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 14px; background:${passed ? '#E8F5E9' : '#FFF0EE'}; border:1.5px solid var(--ink); border-radius:4px; box-shadow:1.5px 1.5px 0 var(--ink);">
                <div style="display:flex; align-items:center; gap:8px;">
                  <span style="font-size:14px;">${passed ? '✅' : '❌'}</span>
                  <span style="font-size:12.5px; font-weight:700; color:var(--ink);">${title}</span>
                </div>
                <span style="font-family:var(--mono); font-size:10px; font-weight:900; color:${passed ? '#2E7D32' : 'var(--rust)'}; background:${passed ? '#C8E6C9' : '#FFCDD2'}; border:1px solid ${passed ? '#2E7D32' : 'var(--rust)'}; padding:2px 8px; border-radius:3px;">
                  ${passed ? '✓ SUPERADA' : '✗ NO SUPERADA'}
                </span>
              </div>
            `;
          }).join('');
        }
      }

      // Encuesta
      const surveyBody = document.getElementById('modalReportSurveyBody');
      if (surveyBody) {
        const survey = parsedFeedback.survey;
        if (survey && survey.submittedAt) {
          const renderStars = (rating: number) => {
            const full = '★'.repeat(rating || 0);
            const empty = '☆'.repeat(Math.max(0, 5 - (rating || 0)));
            return `<span style="color:var(--orange-vibrant); font-size:15px; letter-spacing:2px;">${full}${empty}</span> (${rating || 0}/5)`;
          };

          const reportedDev = (survey.deviceUsed || effectiveDevice).toUpperCase();
          const devLabel = reportedDev === 'AMBOS' ? '🔄 AMBOS (PC + VR)' : reportedDev === 'VR' ? '🥽 REALIDAD VIRTUAL' : '🖥️ COMPUTADOR (PC)';

          surveyBody.innerHTML = `
            <div style="background:#FFF1E6; border:1.5px solid var(--ink); padding:8px 12px; margin-bottom:10px; display:flex; justify-content:space-between; align-items:center;">
              <span style="font-family:var(--mono); font-size:10px; font-weight:900; color:var(--rust); text-transform:uppercase;">Plataforma Evaluada por el Alumno:</span>
              <span style="font-family:var(--mono); font-size:11px; font-weight:900; color:var(--ink);">${devLabel}</span>
            </div>

            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap:10px;">
              <div style="background:var(--paper); border:1px solid var(--ink); padding:10px 12px;">
                <div style="font-family:var(--mono); font-size:9.5px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Comprensión del Tema</div>
                <div style="margin-top:4px; font-weight:800; font-size:12.5px; color:var(--ink);">${renderStars(survey.understandingScore)}</div>
              </div>

              <div style="background:var(--paper); border:1px solid var(--ink); padding:10px 12px;">
                <div style="font-family:var(--mono); font-size:9.5px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Usabilidad de la App</div>
                <div style="margin-top:4px; font-weight:800; font-size:12.5px; color:var(--ink);">${renderStars(survey.usabilityScore)}</div>
              </div>

              <div style="background:var(--paper); border:1px solid var(--ink); padding:10px 12px;">
                <div style="font-family:var(--mono); font-size:9.5px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Motivación Generada</div>
                <div style="margin-top:4px; font-weight:800; font-size:12.5px; color:var(--ink);">${renderStars(survey.motivationScore)}</div>
              </div>
            </div>

            <div style="background:var(--cream); border:1.5px solid var(--ink); padding:12px; margin-top:4px;">
              <div style="font-family:var(--mono); font-size:10px; font-weight:900; color:var(--rust); text-transform:uppercase;">Misión que requirió mayor esfuerzo:</div>
              <div style="font-size:12.5px; color:var(--ink); font-weight:700; margin-top:4px; font-style:italic;">
                "${survey.challengingMission || 'Ninguna en particular, proceso fluido.'}"
              </div>
            </div>

            <div style="background:var(--cream); border:1.5px solid var(--ink); padding:12px;">
              <div style="font-family:var(--mono); font-size:10px; font-weight:900; color:var(--rust); text-transform:uppercase;">Sugerencias y Feedback del Estudiante:</div>
              <div style="font-size:12.5px; color:var(--ink); font-weight:700; margin-top:4px; font-style:italic;">
                "${survey.suggestions || 'Sin sugerencias adicionales reportadas.'}"
              </div>
            </div>

            <div style="font-family:var(--mono); font-size:9.5px; color:var(--ink-soft); text-align:right;">
              ✓ Encuesta registrada el: ${new Date(survey.submittedAt).toLocaleString('es-CO')}
            </div>
          `;
        } else {
          surveyBody.innerHTML = `
            <div style="text-align:center; padding:18px; color:var(--ink-soft); font-family:var(--mono); font-size:12px; background:var(--cream); border:1px dashed var(--ink);">
              ⏳ El estudiante completó la simulación técnica, pero aún no ha enviado la encuesta de investigación pedagógica desde su portal.
            </div>
          `;
        }
      }
    }

    // Si hay más de un intento en el histórico, pintar la barra de navegación entre intentos
    if (history.length > 1 && historyBar && historyButtons) {
      historyBar.style.display = 'block';
      if (historySummary) {
        historySummary.textContent = `${history.length} intentos registrados para este alumno`;
      }
      historyButtons.innerHTML = history.map((att: any, idx: number) => {
        const isLatest = idx === 0;
        const attNum = att.attemptNumber || (history.length - idx);
        return `
          <button
            type="button"
            class="btn-attempt-selector"
            data-attempt-index="${idx}"
            style="background:${isLatest ? 'var(--rust)' : '#FFF'}; color:${isLatest ? '#FFF' : 'var(--ink)'}; border:1.5px solid var(--ink); padding:4px 10px; font-family:var(--mono); font-size:11px; font-weight:800; cursor:pointer; box-shadow:1px 1px 0 var(--ink);"
          >
            Intento #${attNum} (${att.score ?? '--'}/10) ${isLatest ? '★' : ''}
          </button>
        `;
      }).join('');

      historyButtons.querySelectorAll('.btn-attempt-selector').forEach((btn: any) => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-attempt-index') || '0', 10);
          const selected = history[idx];
          historyButtons.querySelectorAll('.btn-attempt-selector').forEach((b: any) => {
            b.style.background = '#FFF';
            b.style.color = 'var(--ink)';
          });
          btn.style.background = 'var(--rust)';
          btn.style.color = '#FFF';
          renderAttemptDetails(selected, selected.attemptNumber || (history.length - idx));
        });
      });
    } else if (historyBar) {
      historyBar.style.display = 'none';
    }

    // Render inicial con el intento más relevante o el token raíz
    const initialData = (history.length > 0) ? history[0] : token;
    renderAttemptDetails(initialData, history.length || 1);

    modal.style.display = 'flex';
  }

  document.getElementById('btnCloseLabReportModal')?.addEventListener('click', () => {
    const modal = document.getElementById('labReportModal');
    if (modal) modal.style.display = 'none';
  });

  document.getElementById('btnCloseLabReportModalFooter')?.addEventListener('click', () => {
    const modal = document.getElementById('labReportModal');
    if (modal) modal.style.display = 'none';
  });

  document.getElementById('btnModalReactivateToken')?.addEventListener('click', async () => {
    if (!activeReportModalToken) return;
    const studentName = activeReportModalToken.student?.name || 'el estudiante';
    if (!confirm(`¿Deseas permitir que ${studentName} presente el laboratorio nuevamente?\n\nEsta acción reseteará su intento anterior y generará un nuevo token activo para que pueda iniciar la práctica desde su portal.`)) return;

    const btn = document.getElementById('btnModalReactivateToken') as HTMLButtonElement;
    if (btn) {
      btn.disabled = true;
      btn.textContent = '⏳ Reactivando intento...';
    }

    try {
      const res = await teacherService.refreshLabToken(activeReportModalToken.id);
      if (res.ok) {
        const modal = document.getElementById('labReportModal');
        if (modal) modal.style.display = 'none';
        showLabAlert(`✓ Token reactivado con éxito para ${studentName}. Ya puede presentar un nuevo intento desde su portal.`, 'success');
        await loadLabTokens();
      } else {
        throw new Error(res.error || 'Error al reactivar token');
      }
    } catch (err: any) {
      showLabAlert(err.message || 'Error reactivando token.', 'error');
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = '↻ Reactivar Intento (Permitir Presentar Otra Vez)';
      }
    }
  });

  document.getElementById("btnAssignLabBatch")?.addEventListener("click", async () => {
    const labId = document.getElementById("selectVirtualLab").value;
    if (!labId) {
      showLabAlert("Por favor selecciona un simulador del catálogo primero.", "error");
      return;
    }
    const btn = document.getElementById("btnAssignLabBatch");
    if (btn) {
      btn.disabled = true;
      btn.textContent = "⏳ Generando tokens...";
    }
    try {
      const json = await teacherService.assignLabBatch(labId, courseId);
      if (!json.ok) throw new Error(json.error || 'Error asignando laboratorio.');
      showLabAlert(json.message || `¡Simulador asignado con éxito a ${json.assignedCount} estudiante(s)!`, "success");
      await loadLabTokens();
    } catch (err) {
      console.error(err);
      showLabAlert(err.message || 'Error asignando laboratorio.', "error");
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = "⚡ Generar Tokens a Toda la Clase";
      }
    }
  });

  document.getElementById("btnRefreshLabTokensManual")?.addEventListener("click", async () => {
    const refreshBtn = document.getElementById("btnRefreshLabTokensManual");
    if (refreshBtn) {
      refreshBtn.textContent = "↻ Actualizando...";
      refreshBtn.style.opacity = '0.7';
    }
    await loadLabTokens();
    if (refreshBtn) {
      refreshBtn.textContent = "✓ Actualizado";
      setTimeout(() => {
        refreshBtn.textContent = "↻ Refrescar Entregas";
        refreshBtn.style.opacity = '1';
      }, 1500);
    }
  });

  document.getElementById("btnFetchLabs")?.addEventListener("click", async () => {
    const fetchBtn = document.getElementById("btnFetchLabs");
    if (fetchBtn) fetchBtn.textContent = "↻ Cargando...";
    await loadLabTokens();
    if (fetchBtn) fetchBtn.textContent = "↻ Actualizar Lista";
  });

  async function triggerLabExcelDownload() {
    if (!courseId) return;
    showLabAlert("⏳ Generando libro de Excel (.xlsx) con calificaciones, encuestas y tarjetas KPI...", "info");
    try {
      await teacherService.downloadLabExcel(courseId);
      showLabAlert("✓ Libro de Excel (.xlsx) descargado con éxito. Ábrelo directamente en Microsoft Excel sin formatear nada.", "success");
    } catch (err: any) {
      console.error('Error al descargar Excel:', err);
      showLabAlert(`Error al descargar Excel: ${err.message || 'Error al generar archivo'}`, "error");
    }
  }

  async function triggerLabCsvDownload() {
    if (!courseId) return;
    showLabAlert("⏳ Generando y descargando archivo CSV ordenado...", "info");
    try {
      await teacherService.downloadLabCsv(courseId);
      showLabAlert("✓ Reporte CSV descargado con éxito. Puedes abrirlo directamente en Excel o Google Sheets.", "success");
    } catch (err: any) {
      console.error('Error al descargar CSV:', err);
      showLabAlert(`Error al descargar reporte: ${err.message || 'Error de autenticación 401'}`, "error");
    }
  }

  document.getElementById("btnExportLabExcel")?.addEventListener("click", triggerLabExcelDownload);
  document.getElementById("btnExportLabExcelSecondary")?.addEventListener("click", triggerLabExcelDownload);
  document.getElementById("btnExportLabCSV")?.addEventListener("click", triggerLabCsvDownload);
  document.getElementById("btnExportLabCSVSecondary")?.addEventListener("click", triggerLabCsvDownload);

  let labTokensInterval = null;
  function startLabsPolling() {
    if (!document.getElementById('courseTabContent-labs')) return;
    if (labTokensInterval) return;
    labTokensInterval = setInterval(() => {
      const labsTab = document.getElementById('courseTabContent-labs');
      if (labsTab && labsTab.style.display !== 'none') {
        loadLabTokens();
      }
    }, 4000);
  }

  function initCourseDetails() {
    hydrateCourseDetails();
    loadLabsCatalog();
    loadLabTokens();
    startLabsPolling();
  }

  if (document.readyState !== 'loading') {
    initCourseDetails();
  } else {
    document.addEventListener('DOMContentLoaded', initCourseDetails);
  }
</script>