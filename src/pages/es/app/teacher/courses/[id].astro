---
// ============================================================
// SchoolOS — Detalle de Curso (Teacher)
// Fase 3 | Espacio de Trabajo por Curso con Pestañas
// ============================================================
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { getTeacherCourseById } from '../../../../../data/app/mock-content';
import { createAdminSupabase } from '../../../../../lib/supabase-admin';

const lang = 'es';
const { id } = Astro.params;
const classroom = Astro.url.searchParams.get('classroom') || '';

let course: any = null;
let schoolName = 'RaptorCrew';

if (id) {
  try {
    const admin = createAdminSupabase();
    const { data: dbCourse } = await admin
      .from('courses')
      .select('*')
      .eq('id', id)
      .maybeSingle();

    if (dbCourse) {
      if (dbCourse.school_id) {
        const { data: sch } = await admin
          .from('schools')
          .select('name')
          .eq('id', dbCourse.school_id)
          .maybeSingle();
        if (sch?.name) schoolName = sch.name;
      }

      const { count: stdCount } = await admin
        .from('course_students')
        .select('*', { count: 'exact', head: true })
        .eq('course_id', id);

      const { count: gCount } = await admin
        .from('guides')
        .select('*', { count: 'exact', head: true })
        .eq('course_id', id);

      course = {
        id: dbCourse.id,
        name: dbCourse.name,
        code: dbCourse.code || 'CRS',
        level: dbCourse.grade_level ? `Grado ${dbCourse.grade_level}` : 'Educación Secundaria',
        teacherId: dbCourse.teacher_id,
        studentCount: stdCount || 0,
        guidesPublished: gCount || 0,
        averageScore: 0,
        schedule: 'Lunes a Viernes',
        room: classroom || 'Aula General',
        schoolName: schoolName,
      };
    }
  } catch (err) {
    console.error('[course-detail] Error fetching course SSR:', err);
  }
}

// Fallback solo para identificadores demo locales antiguos (ej: 'c-1', 'crs-bio-10a')
if (!course && id) {
  course = getTeacherCourseById(id);
}

const isChemistryCourse = Boolean(
  (course?.name || '').toLowerCase().includes('química') ||
  (course?.name || '').toLowerCase().includes('quimica') ||
  (course?.code || '').toLowerCase().includes('qui')
);
---

{course ? (
  <AppLayout
    title={course.name}
    pageTitle={course.name}
    activeSection="courses"
    role="teacher"
    schoolName={course.schoolName || 'RaptorCrew'}
    lang={lang}
    activeRoute={`/app/teacher/courses/${id}`}
    breadcrumbs={[
      { label: course.schoolName || 'Institución' },
      { label: 'Panel Docente', href: `/${lang}/app/teacher` },
      { label: 'Mis Cursos', href: `/${lang}/app/teacher/courses` },
      { label: course.name },
    ]}
  >

    <!-- ── 1. HEADER DEL CUADERNO DE CURSO ── -->
    <div style="background:var(--paper); border:2px solid var(--ink); border-radius:8px; padding:18px 24px; margin-bottom:20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; box-shadow:4px 4px 0 rgba(18,17,14,0.08);">
      <div>
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
          <span class="plan-tag" style="background:var(--rust); color:#FFFFFF; border-color:var(--rust); font-size:9.5px; font-weight:900; padding:2px 8px; border-radius:3px;">
            {course.level}
          </span>
          <span style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft);">
             {course.room} ·  {course.schedule}
          </span>
        </div>

        <h1 id="courseTitleDOM" style="font-family:var(--serif); font-size:24px; font-weight:700; color:var(--ink); margin:0;">{course.name}</h1>

        <div style="font-family:var(--mono); font-size:12px; color:var(--ink-soft); margin-top:4px;">
          <strong><span class="studentsCount">{course.studentCount}</span> estudiantes matriculados</strong> · Promedio actual del grupo: <strong style="color:var(--rust); font-size:13px;"><span id="courseAverage">--</span> / 10</strong>
        </div>
      </div>

      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <a href={`/${lang}/app/teacher/courses/${id}/guides/new`} class="btn btn-primary btn-sm" style="font-size:12px; font-weight:800; padding:8px 16px; border-radius:4px; text-decoration:none;">
          + Nueva Guía
        </a>
        <a href={`/${lang}/app/teacher/grades`} class="btn btn-secondary btn-sm" style="font-size:12px; font-weight:700; padding:8px 14px; border-radius:4px; border-color:var(--ink); text-decoration:none;">
          Planilla de Notas →
        </a>
      </div>
    </div>

    <!-- ── 2. BARRA DE PESTAÑAS TÁCTIL ── -->
    <div style="display:flex; border-bottom:2px solid var(--ink); margin-bottom:20px; gap:4px; flex-wrap:wrap;">
      <button
        type="button"
        id="tabBtnGuides"
        onclick="switchCourseTab('guides');"
        class="course-tab-btn active"
        style="padding:10px 20px; font-family:var(--mono); font-size:12px; font-weight:800; border:2px solid var(--ink); border-bottom:none; border-radius:6px 6px 0 0; background:var(--ink); color:#FFFFFF; cursor:pointer; transition:all 0.15s ease;"
      >
         Guías y Material (<span class="guidesCount">{course.guidesPublished}</span>)
      </button>

      <button
        type="button"
        id="tabBtnStudents"
        onclick="switchCourseTab('students');"
        class="course-tab-btn"
        style="padding:10px 20px; font-family:var(--mono); font-size:12px; font-weight:800; border:2px solid var(--ink); border-bottom:none; border-radius:6px 6px 0 0; background:var(--cream); color:var(--ink); cursor:pointer; transition:all 0.15s ease;"
      >
         Estudiantes del Salón (<span class="studentsCount">{course.studentCount}</span>)
      </button>

      <button
        type="button"
        id="tabBtnGrades"
        onclick="switchCourseTab('grades');"
        class="course-tab-btn"
        style="padding:10px 20px; font-family:var(--mono); font-size:12px; font-weight:800; border:2px solid var(--ink); border-bottom:none; border-radius:6px 6px 0 0; background:var(--cream); color:var(--ink); cursor:pointer; transition:all 0.15s ease;"
      >
         Evaluaciones & Calificaciones
      </button>

      {isChemistryCourse && (
        <button
          type="button"
          id="tabBtnLabs"
          onclick="switchCourseTab('labs');"
          class="course-tab-btn"
          style="padding:10px 20px; font-family:var(--mono); font-size:12px; font-weight:800; border:2px solid var(--ink); border-bottom:none; border-radius:6px 6px 0 0; background:var(--rust); color:#FFF; cursor:pointer; transition:all 0.15s ease;"
        >
           Laboratorio Virtual de Química (Unity)
        </button>
      )}
    </div>

    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <!-- ── PESTAÑA 1: GUÍAS Y MATERIAL PEDAGÓGICO ── -->
    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <div id="courseTabContent-guides" class="course-tab-panel">
      
      <div class="panel" style="border:2px solid var(--ink); border-radius:8px; box-shadow:5px 5px 0 rgba(18,17,14,0.08); background:var(--paper); overflow:hidden;">
        <div class="panel-header" style="background:var(--cream); border-bottom:1.5px solid var(--ink); padding:12px 20px; display:flex; justify-content:space-between; align-items:center;">
          <h2 style="font-size:13px; font-weight:800; margin:0; letter-spacing:0.04em;">
            GUÍAS DIDÁCTICAS ASIGNADAS A ESTE GRUPO (<span class="guidesCount">0</span>)
          </h2>
          <a href={`/${lang}/app/teacher/courses/${id}/guides/new`} class="btn btn-primary btn-sm" style="font-size:11px; font-weight:800; border-radius:3px;">
            + Crear Guía
          </a>
        </div>

        
          <div class="panel-body" style="padding:0;">
            <!-- Contenedor dinámico para guías creadas en el Estudio Pedagógico -->
            <div id="customGuidesList"></div>

            
          </div>
        
      </div>

    </div>

    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <!-- ── PESTAÑA 2: ESTUDIANTES DEL SALÓN ── -->
    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <div id="courseTabContent-students" class="course-tab-panel" style="display:none;">
      
      <!-- Barra de Filtros y Búsqueda -->
      <div style="background:var(--paper); border:2px solid var(--ink); border-radius:8px; padding:14px 18px; margin-bottom:16px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
          <input
            type="text"
            id="studentCourseSearch"
            placeholder="Buscar por nombre..."
            oninput="filterCourseStudents();"
            style="padding:7px 12px; border:1.5px solid var(--ink); border-radius:4px; background:#FFFFFF; font-family:var(--mono); font-size:11.5px; color:var(--ink); outline:none; width:220px;"
          />
          
          <div style="display:flex; gap:4px;">
            <button
              type="button"
              id="filterPillAll"
              onclick="setStudentFilter('all');"
              class="student-filter-pill active"
              style="padding:5px 10px; font-family:var(--mono); font-size:10.5px; font-weight:800; border:1px solid var(--ink); border-radius:3px; background:var(--ink); color:#FFFFFF; cursor:pointer;"
            >
              Todos (<span class="studentsCount">{course.studentCount}</span>)
            </button>
            <button
              type="button"
              id="filterPillEnrolled"
              onclick="setStudentFilter('enrolled');"
              class="student-filter-pill"
              style="padding:5px 10px; font-family:var(--mono); font-size:10.5px; font-weight:800; border:1px solid var(--ink); border-radius:3px; background:var(--cream); color:var(--ink); cursor:pointer;"
            >
              Matriculados Activos
            </button>
          </div>
        </div>

        <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">
          Mostrando <strong id="visibleStudentCount" style="color:var(--ink);"><span class="studentsCount">{course.studentCount}</span></strong> de <span class="studentsCount">{course.studentCount}</span> estudiantes
        </div>
      </div>

      <!-- Tabla de Estudiantes -->
      <div class="panel" style="border:2px solid var(--ink); border-radius:8px; box-shadow:5px 5px 0 rgba(18,17,14,0.08); background:#FFFFFF; overflow:hidden;">
        <div style="overflow-x:auto;">
          <table style="width:100%; border-collapse:collapse; font-size:12.5px;">
            <thead>
              <tr style="border-bottom:2px solid var(--ink); background:var(--cream);">
                <th style="text-align:center; width:44px; padding:10px 6px; font-family:var(--mono); font-size:10px; font-weight:800; color:var(--ink-soft); border-right:1px solid var(--line);">#</th>
                <th style="text-align:left; padding:10px 16px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink); border-right:1px solid var(--line);">Estudiante</th>
                <th style="text-align:left; padding:10px 16px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink); border-right:1px solid var(--line);">Promedio en la Materia</th>
                <th style="text-align:center; padding:10px 12px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink); border-right:1px solid var(--line);">Pendientes</th>
                <th style="text-align:center; padding:10px 12px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink);">Desempeño</th>
              </tr>
            </thead>
            <tbody id="courseStudentsTableBody">
              
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <!-- ── PESTAÑA 3: EVALUACIONES & CALIFICACIONES ── -->
    <!-- ══════════════════════════════════════════════════════════════════════════ -->

    <div id="courseTabContent-grades" class="course-tab-panel" style="display:none;">
      {isChemistryCourse ? (
        <div style="display:flex; flex-direction:column; gap:20px;">
          <!-- Card de Evaluación Ligada del Laboratorio -->
          <div style="background:var(--paper); border:2px solid var(--ink); box-shadow:5px 5px 0 rgba(18,17,14,0.08); overflow:hidden;">
            <div style="background:var(--ink); color:#FFF; padding:16px 20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; border-bottom:3px solid var(--orange-vibrant);">
              <div style="display:flex; align-items:center; gap:10px;">
                <span style="background:var(--rust); color:#FFF; font-family:var(--mono); font-size:10.5px; font-weight:900; padding:3px 8px; letter-spacing:0.04em;">EVALUACIÓN PRÁCTICA OFICIAL</span>
                <h3 style="font-size:16px; font-weight:800; margin:0; color:#FFF;">🔬 Práctica 1: Laboratorio Virtual de Química (Disoluciones y pH)</h3>
              </div>
              <span style="font-family:var(--mono); font-size:11px; font-weight:800; background:#FFF; color:var(--ink); padding:4px 10px; border-radius:3px;">
                DISPONIBLE 24/7 (CUALQUIER MOMENTO)
              </span>
            </div>

            <div style="padding:20px;">
              <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:14px; margin-bottom:18px;">
                <div style="background:var(--cream); border:1.5px solid var(--ink); padding:12px 16px;">
                  <div style="font-family:var(--mono); font-size:10px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Tipo de Evaluación</div>
                  <div style="font-size:13.5px; font-weight:800; color:var(--ink); margin-top:2px;">Simulación Práctica en Unity (PC / VR)</div>
                </div>
                <div style="background:var(--cream); border:1.5px solid var(--ink); padding:12px 16px;">
                  <div style="font-family:var(--mono); font-size:10px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Escala Evaluativa</div>
                  <div style="font-size:13.5px; font-weight:800; color:var(--rust); margin-top:2px;">0.0 a 10.0 (4 misiones × 2.5 pts)</div>
                </div>
                <div style="background:var(--cream); border:1.5px solid var(--ink); padding:12px 16px;">
                  <div style="font-family:var(--mono); font-size:10px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Entregas del Grupo</div>
                  <div id="gradesTabSummaryBadge" style="font-size:13.5px; font-weight:800; color:var(--ink); margin-top:2px;">Sincronizando notas...</div>
                </div>
              </div>

              <div style="background:#FFF1E6; border:1.5px solid var(--rust); padding:12px 16px; margin-bottom:18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
                <div style="font-size:12.5px; color:var(--ink);">
                  💡 Los estudiantes pueden resolver esta evaluación en cualquier momento desde su portal. Sus calificaciones se asientan automáticamente.
                </div>
                <button type="button" onclick="switchCourseTab('labs')" class="btn btn-primary btn-sm" style="font-family:var(--mono); font-size:11px; font-weight:900; background:var(--rust); border-color:var(--ink); box-shadow:2px 2px 0 var(--ink); cursor:pointer;">
                  Gestionar Tokens y Ver Reportes Detallados →
                </button>
              </div>

              <!-- Mini Tabla de Calificaciones de la Evaluación -->
              <div style="border:1.5px solid var(--ink); overflow-x:auto;">
                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                  <thead>
                    <tr style="background:var(--ink); color:#FFF; font-family:var(--mono); font-size:10.5px;">
                      <th style="padding:10px 12px; text-align:left;">Estudiante</th>
                      <th style="padding:10px 12px; text-align:center;">Estado Evaluación</th>
                      <th style="padding:10px 12px; text-align:center;">Misiones Superadas</th>
                      <th style="padding:10px 12px; text-align:center;">Calificación Obtenida</th>
                      <th style="padding:10px 12px; text-align:right;">Acción</th>
                    </tr>
                  </thead>
                  <tbody id="gradesTabMiniTableBody">
                    <tr><td colspan="5" style="padding:20px; text-align:center; font-family:var(--mono); color:var(--ink-soft);">Cargando notas de la práctica...</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      ) : (
        <div class="panel-body padded" style="text-align:center; padding:50px 20px; border:2px solid var(--ink); border-radius:8px; background:var(--paper); box-shadow:5px 5px 0 rgba(18,17,14,0.08);">
          <div style="font-family:var(--serif); font-size:20px; font-weight:700; color:var(--ink); margin-bottom:8px;">
            Planilla de Evaluaciones Vacía
          </div>
          <p style="font-size:13px; color:var(--ink-soft); margin-bottom:20px; max-width:440px; margin-left:auto; margin-right:auto;">
            Aún no se han configurado rúbricas ni notas para este grupo. Utiliza el módulo de Calificaciones para empezar.
          </p>
          <a href="/es/app/teacher/grades" class="btn btn-primary" style="font-size:12px; font-weight:800;">
            Ir a Calificaciones →
          </a>
        </div>
      )}
    </div>
  

    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <!-- ── PESTAÑA 4: LABORATORIOS VIRTUALES (UNITY) ── -->
    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    {isChemistryCourse && (
      <div id="courseTabContent-labs" class="course-tab-panel" data-course-id={course.id} style="display:none;">
      
      <div class="panel" style="border:2px solid var(--ink); border-radius:8px; box-shadow:5px 5px 0 rgba(18,17,14,0.08); background:var(--paper); overflow:hidden;">
        <div class="panel-header" style="background:var(--rust); border-bottom:1.5px solid var(--ink); padding:16px 20px; display:flex; justify-content:space-between; align-items:center; color:#FFF; flex-wrap:wrap; gap:12px;">
          <div>
            <h2 style="font-size:16px; font-weight:800; margin:0; letter-spacing:0.04em; color:#FFF;">
              PANEL DE LABORATORIOS VIRTUALES (UNITY)
            </h2>
            <div style="font-family:var(--mono); font-size:11.5px; margin-top:4px; opacity:0.95;">
              Asigna y gestiona tokens de acceso para tus simuladores interactivos. Los puntajes y métricas se actualizan en tiempo real.
            </div>
          </div>
          <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
            <button id="btnExportLabExcel" type="button" class="btn btn-sm" style="background:#1D6F42; color:#FFF; border:2px solid var(--ink); font-weight:900; box-shadow:2px 2px 0 var(--ink); cursor:pointer; display:inline-flex; align-items:center; gap:6px;" title="Descarga libro de Excel nativo (.xlsx) con 3 hojas, colores corporativos y tablas ordenadas">
              📊 Descargar Reporte Excel (.xlsx)
            </button>
            <button id="btnExportLabCSV" type="button" class="btn btn-sm" style="background:#FFF; color:var(--ink); border:2px solid var(--ink); font-weight:800; box-shadow:2px 2px 0 var(--ink); cursor:pointer; display:inline-flex; align-items:center; gap:5px;" title="Descargar como archivo de texto CSV">
              📄 CSV
            </button>
            <button id="btnFetchLabs" type="button" class="btn btn-sm" style="background:#FFF; color:var(--rust); border:2px solid var(--ink); font-weight:900; box-shadow:2px 2px 0 var(--ink); cursor:pointer;">
              ↻ Actualizar Lista
            </button>
          </div>
        </div>

        <div class="panel-body" style="padding:24px;">
          
          <!-- Banner Contextual de Curso Activo -->
          <div style="background:#FFF1E6; border:1.5px solid var(--rust); border-radius:6px; padding:12px 18px; margin-bottom:20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
            <div style="font-size:13px; color:var(--ink);">
              📚 <strong>Viendo laboratorio para el curso:</strong> <strong style="color:var(--rust); text-transform:uppercase;">{course?.name || 'Asignatura'}</strong>
              <div style="font-size:11.5px; color:var(--ink-soft); margin-top:2px;">
                Cada materia tiene sus propios tokens y calificaciones independientes.
              </div>
            </div>
            <a href="/es/app/teacher/courses" style="font-family:var(--mono); font-size:11.5px; font-weight:800; color:var(--rust); text-decoration:underline;">
              Cambiar de asignatura / Ver otros cursos →
            </a>
          </div>

          <!-- Controles de Asignación con Alertas y Feedback Pedagógico -->
          <div style="background:var(--cream); border:2px solid var(--ink); border-radius:8px; padding:20px; margin-bottom:24px; box-shadow:3px 3px 0 var(--ink);">
            
            <div style="display:flex; align-items:flex-start; gap:12px; margin-bottom:16px; background:#FFF; border:1px solid var(--ink); border-radius:6px; padding:12px 14px;">
              <span style="font-size:20px; line-height:1;">🔑</span>
              <div style="font-size:12.5px; color:var(--ink); line-height:1.45;">
                <strong>¿Cómo funciona el Token JWT?</strong> Al hacer clic en <em>"Generar Tokens a Toda la Clase"</em>, cada estudiante matriculado recibirá un código de acceso único. Los alumnos verán su token directamente en su portal de estudiantes, o puedes copiarlo aquí mismo en la tabla para enviárselo directamente.
              </div>
            </div>

            <div style="display:flex; gap:16px; align-items:flex-end; flex-wrap:wrap;">
              <div style="flex:1; min-width:260px;">
                <label for="selectVirtualLab" style="display:block; font-family:var(--mono); font-size:11px; font-weight:800; color:var(--ink); margin-bottom:6px; text-transform:uppercase;">
                  Selecciona el Simulador / Laboratorio:
                </label>
                <select id="selectVirtualLab" style="width:100%; padding:10px 12px; font-size:13px; border:2px solid var(--ink); border-radius:4px; font-family:var(--serif); background:#FFF; font-weight:600;">
                  <option value="">Cargando laboratorios del catálogo...</option>
                </select>
              </div>
              
              <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                <button id="btnAssignLabBatch" type="button" class="btn btn-primary" style="padding:11px 22px; font-size:13px; font-weight:900; white-space:nowrap; background:var(--rust); border-color:var(--ink); box-shadow:2px 2px 0 var(--ink);">
                  ⚡ Generar Tokens a Toda la Clase
                </button>
                <button id="btnRefreshLabTokensManual" type="button" class="btn btn-secondary" style="padding:11px 16px; font-size:12px; font-weight:800; white-space:nowrap; background:#FFF; border:1.5px solid var(--ink); box-shadow:2px 2px 0 var(--ink); cursor:pointer;">
                  ↻ Refrescar Entregas
                </button>
