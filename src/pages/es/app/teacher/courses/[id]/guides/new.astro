---
// ============================================================
// SchoolOS — Wizard de Creación de Guías (Teacher)
// Fase 3 | Layout propio sin distracciones + React Island
// ============================================================
import { getTeacherCourses, getTeacherCourseById } from '../../../../../../../data/app/mock-content';
import GuideWizard from '../../../../../../../components/app/teacher/GuideWizard';
import type { Lang } from '../../../../../../../i18n';
import '../../../../../../../styles/app.css';

export async function getStaticPaths() {
  const courses = getTeacherCourses();
  return courses.map((c) => ({ params: { id: c.id } }));
}

const lang: Lang = 'es';
const { id } = Astro.params;
const course = getTeacherCourseById(id!);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nueva Guía — {course?.name} — SchoolOS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,450;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        try {
          var auth = localStorage.getItem('schoolos-auth');
          if (!auth) window.location.replace('/login?redirect=' + encodeURIComponent(window.location.pathname));
        } catch (_) {}
      })();
    </script>
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--cream, #F4EFE6); font-family: 'Inter', sans-serif; }
      .wizard-shell { min-height: 100vh; display: flex; flex-direction: column; }
      .wizard-topbar {
        background: var(--paper, #FCFAF7);
        border-bottom: 2px solid var(--ink, #12110E);
        padding: 12px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      .wizard-brand { font-family: 'Fraunces', serif; font-size: 18px; font-weight: 700; color: var(--ink, #12110E); text-decoration: none; }
      .wizard-brand span { color: var(--rust, #C3532C); }
      .wizard-course-tag { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--ink-soft, #524E44); }
      .wizard-exit { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--rust, #C3532C); font-weight: 700; text-decoration: none; }
      .wizard-exit:hover { text-decoration: underline; }
      .wizard-body { flex: 1; padding: 24px; max-width: 960px; margin: 0 auto; width: 100%; }
    </style>
  </head>
  <body>
    <div class="wizard-shell">
      <!-- Topbar mínima del wizard -->
      <div class="wizard-topbar">
        <div style="display:flex; align-items:center; gap:16px;">
          <a href={`/${lang}/app/teacher`} class="wizard-brand">School<span>OS</span></a>
          <div style="width:1px; height:20px; background:var(--line, #E8E2D9);"></div>
          <div class="wizard-course-tag">
            Nueva Guía en: <strong style="color:var(--ink);">{course?.name ?? 'Curso'}</strong>
          </div>
        </div>
        <a href={`/${lang}/app/teacher/courses/${id}`} class="wizard-exit">
          ✕ Cancelar y salir
        </a>
      </div>

      <!-- Wizard React Island -->
      <div class="wizard-body">
        <GuideWizard
          client:load
          courseId={id!}
          courseName={course?.name ?? 'Mi Curso'}
          lang={lang}
          returnUrl={`/${lang}/app/teacher/courses/${id}`}
        />
      </div>
    </div>
  </body>
</html>
