---
// ============================================================
// SchoolOS — Mis Cursos Asignados (Teacher)
// Fase 3 | Solo cursos donde el profesor está asignado
// ============================================================
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { getTeacherCourses, getGuidesByCourse } from '../../../../../data/app/mock-content';

const lang = 'es';
const courses = getTeacherCourses();
---

<AppLayout
  title="Mis Cursos"
  pageTitle="Mis Cursos Asignados"
  activeSection="courses"
  role="teacher"
  schoolName="Colegio Norte"
  lang={lang}
  activeRoute="/app/teacher/courses"
  breadcrumbs={[{ label: 'Colegio Norte' }, { label: 'Panel Docente', href: `/${lang}/app/teacher` }, { label: 'Mis Cursos' }]}
>

  <!-- ── HEADER EXPLICATIVO ── -->
  <div style="margin-bottom:20px; padding:12px 16px; background:var(--paper); border:1.5px solid var(--line-strong); border-left:4px solid var(--rust);">
    <div style="font-family:var(--mono); font-size:11px; font-weight:700; color:var(--rust); text-transform:uppercase; margin-bottom:2px;">Vista Filtrada</div>
    <div style="font-size:13px; color:var(--ink-soft);">Solo los cursos donde estás asignado como docente. Los demás cursos del colegio no son visibles desde este panel.</div>
  </div>

  <!-- ── GRID DE CURSOS ── -->
  <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:20px; margin-bottom:28px;">
    {courses.map((course) => {
      const guides = getGuidesByCourse(course.id);
      const publishedGuides = guides.filter(g => g.status === 'published');
      const barWidth = Math.round(course.averageScore * 10);
      return (
        <div class="panel" style="border:2px solid var(--ink); box-shadow:6px 6px 0 rgba(18,17,14,0.08); display:flex; flex-direction:column;">
          <!-- Encabezado de tarjeta -->
          <div style="padding:16px 18px 12px; border-bottom:1.5px solid var(--line);">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;">
              <span class={publishedGuides.length > 0 ? 'badge badge-active' : 'badge badge-warning'} style="font-size:9.5px; font-weight:800;">
                {publishedGuides.length > 0 ? 'ACTIVO' : 'SIN PUBLICAR'}
              </span>
              <span style="font-family:var(--mono); font-size:10px; color:var(--ink-soft);">{course.room}</span>
            </div>
            <h3 style="font-family:var(--serif); font-size:17px; font-weight:700; color:var(--ink); margin:0 0 4px 0; line-height:1.2;">{course.name}</h3>
            <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">{course.level}</div>
          </div>

          <!-- Stats de tarjeta -->
          <div style="padding:12px 18px; border-bottom:1.5px solid var(--line); display:grid; grid-template-columns: repeat(3, 1fr); gap:8px; text-align:center;">
            <div>
              <div style="font-family:var(--mono); font-size:9.5px; color:var(--ink-soft); text-transform:uppercase;">Alumnos</div>
              <div style="font-family:var(--mono); font-size:16px; font-weight:800; color:var(--ink);">{course.studentCount}</div>
            </div>
            <div>
              <div style="font-family:var(--mono); font-size:9.5px; color:var(--ink-soft); text-transform:uppercase;">Guías</div>
              <div style="font-family:var(--mono); font-size:16px; font-weight:800; color:var(--ink);">{publishedGuides.length}</div>
            </div>
            <div>
              <div style="font-family:var(--mono); font-size:9.5px; color:var(--ink-soft); text-transform:uppercase;">Promedio</div>
              <div style="font-family:var(--mono); font-size:16px; font-weight:800; color:var(--rust);">{course.averageScore.toFixed(1)}</div>
            </div>
          </div>

          <!-- Barra de promedio + schedule -->
          <div style="padding:12px 18px 16px; flex:1; display:flex; flex-direction:column; justify-content:space-between; gap:10px;">
            <div>
              <div style="font-family:var(--mono); font-size:10px; color:var(--ink-soft); margin-bottom:4px;">PROMEDIO GENERAL</div>
              <div style="width:100%; height:6px; background:var(--line); border:1px solid var(--ink); position:relative;">
                <div style={`width:${barWidth}%; height:100%; background:${course.averageScore >= 8 ? 'var(--rust)' : course.averageScore >= 6 ? '#8B7355' : '#cc4444'};`}></div>
              </div>
              <div style="font-family:var(--mono); font-size:10px; color:var(--ink-soft); margin-top:3px;">{course.schedule}</div>
            </div>
            <a href={`/${lang}/app/teacher/courses/${course.id}`} class="btn btn-primary btn-sm" style="font-size:12px; font-weight:700; text-align:center; display:block;">
              Ver Curso →
            </a>
          </div>
        </div>
      );
    })}
  </div>

</AppLayout>
