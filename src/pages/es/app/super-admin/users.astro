<script define:vars={{ usersJson, schoolsJson, passwordTicketsJson }}>
// ============================================================
// DATOS EN CLIENTE
// ============================================================
window.USERS = JSON.parse(usersJson || '[]');
window.SCHOOLS = JSON.parse(schoolsJson || '[]');
window.PASSWORD_TICKETS = JSON.parse(passwordTicketsJson || '[]');
window._selectedRectorAvatarFile = null;

// ============================================================
// MODAL: RESTABLECIMIENTO DIRECTO DE CONTRASEÑA
// ============================================================
function generateSecurePassword() {
  const words = ['Profe', 'Educa', 'Clase', 'Colegio', 'Saber', 'Futuro'];
  const prefix = words[Math.floor(Math.random() * words.length)];
  const chars = '23456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz';
  let rand = '';
  for (let i = 0; i < 4; i++) {
    rand += chars.charAt(Math.floor(Math.random() * chars.length));
  }
  return `${prefix}!2026#${rand}`;
}

window.openDirectResetPasswordModal = function(userId) {
  const user = window.USERS.find(u => u.id === userId);
  if (!user) return;

  const idInput = document.getElementById('password-ticket-user-id');
  const userLabel = document.getElementById('password-ticket-user-label');
  const userSub = document.getElementById('password-ticket-user-sub');
  const roleBadge = document.getElementById('password-ticket-role-badge');
  const passInput = document.getElementById('password-direct-new-input');
  const reasonInput = document.getElementById('password-ticket-reason');
  const reqCheck = document.getElementById('password-ticket-require-change');
  const fb = document.getElementById('password-ticket-feedback');
  const submitBtn = document.getElementById('password-ticket-submit-btn');

  if (idInput) idInput.value = user.id;
  if (userLabel) userLabel.textContent = `${user.name || 'Usuario'} · ${user.email}`;
  if (userSub) userSub.textContent = `Institución: ${user.schoolName || 'Sistema Central'} · Teléfono: ${user.phone || 'N/A'}`;
  
  if (roleBadge) {
    const roleText = user.role === 'super_admin' ? 'SUPER ADMIN' 
      : user.role === 'school_admin' ? (user.jobTitle || 'RECTOR')
      : user.role === 'teacher' ? (user.specialty || 'DOCENTE')
      : user.role === 'student' ? 'ESTUDIANTE'
      : user.role.toUpperCase();
    roleBadge.textContent = roleText;
  }

  if (passInput) passInput.value = generateSecurePassword();
  if (reasonInput) reasonInput.value = 'Restablecimiento directo por administración.';
  if (reqCheck) reqCheck.checked = false;

  if (fb) {
    fb.style.display = 'none';
    fb.textContent = '';
  }

  if (submitBtn) {
    submitBtn.disabled = false;
    submitBtn.textContent = '🔑 Guardar y Aplicar Clave Inmediatamente';
  }

  const overlay = document.getElementById('password-ticket-modal-overlay');
  const panel = document.getElementById('password-ticket-modal-panel');
  if (overlay && panel) {
    overlay.style.display = 'flex';
    panel.getBoundingClientRect();
    panel.style.opacity = '1';
    panel.style.transform = 'scale(1)';
  }

  if (passInput) passInput.focus();
};

window.openPasswordTicketModal = window.openDirectResetPasswordModal;

window.closePasswordTicketModal = function() {
  const overlay = document.getElementById('password-ticket-modal-overlay');
  const panel = document.getElementById('password-ticket-modal-panel');
  if (!panel) return;
  panel.style.opacity = '0';
  panel.style.transform = 'scale(0.96)';
  setTimeout(() => {
    if (overlay) overlay.style.display = 'none';
    document.body.style.overflow = '';
  }, 220);
};

window.executePasswordResetTicket = async function(ticketId, targetEmail) {
  const ticket = (window.PASSWORD_TICKETS || []).find(t => t.id === ticketId);
  if (ticket && ticket.targetUserId) {
    window.openDirectResetPasswordModal(ticket.targetUserId);
    return;
  }

  const newPassword = window.prompt(`Nueva contraseña temporal para ${targetEmail || 'el usuario'}:`, generateSecurePassword());
  if (!newPassword) return;

  if (newPassword.length < 6) {
    window.alert('La contraseña debe tener mínimo 6 caracteres.');
    return;
  }

  const confirmed = window.confirm(`Esto cambiará la contraseña real de ${targetEmail} en Supabase Auth inmediatamente. ¿Continuar?`);
  if (!confirmed) return;

  try {
    const res = await window.fetchAuth('/api/admin/password-tickets', {
      method: 'POST',
      body: JSON.stringify({ action: 'execute_ticket', ticketId, newPassword }),
    });
    const data = await res.json();
    if (!data.ok) throw new Error(data.error || 'Error desconocido');

    window.alert(`✓ Contraseña actualizada exitosamente en Supabase Auth.\nNueva contraseña: ${newPassword}`);
    window.location.reload();
  } catch (err) {
    console.error('Error ejecutando cambio de contraseña:', err);
    window.alert('No fue posible cambiar la contraseña: ' + (err.message || 'Error del servidor'));
  }
};

// ============================================================
// MODAL FLOTANTE: REGISTRO & GESTIÓN DE RECTOR
// ============================================================
window.openRectorModal = function(rectorId, preselectedSchoolId) {
  window._selectedRectorAvatarFile = null;
  const schoolSelect = document.getElementById('rector-school-id');
  
  // Llenar selector de escuelas
  schoolSelect.innerHTML = window.SCHOOLS.map(s => 
    `<option value="${s.id}">${s.name} (${s.domain || s.slug})</option>`
  ).join('');

  const fb = document.getElementById('rector-feedback');
  fb.style.display = 'none';
  fb.textContent = '';

  const submitBtn = document.getElementById('rector-submit-btn');
  submitBtn.disabled = false;
  submitBtn.textContent = 'Guardar Rector en Supabase';

  const previewImg = document.getElementById('rector-avatar-preview-img');
  const placeholder = document.getElementById('rector-avatar-placeholder');
  const removeBtn = document.getElementById('rector-btn-remove-avatar');
  const fileInput = document.getElementById('rector-avatar-file-input');
  if (fileInput) fileInput.value = '';

  const statusContainer = document.getElementById('rector-status-container');
  const jwtInfoBlock = document.getElementById('rector-jwt-info-block');
  const rectorDeleteBtn = document.getElementById('rector-delete-btn');

  if (rectorId) {
    // MODO EDICIÓN DE RECTOR EXISTENTE
    const user = window.USERS.find(u => u.id === rectorId);
    if (!user) return;

    document.getElementById('rector-id').value = user.id;
    document.getElementById('rector-modal-title').textContent = `Editar Directivo: ${user.name}`;
    document.getElementById('rector-name').value = user.name || '';
    document.getElementById('rector-email').value = user.email || '';
    document.getElementById('rector-phone').value = user.phone || '';
    document.getElementById('rector-doc-type').value = user.documentType || 'CC';
    document.getElementById('rector-doc-id').value = user.documentId || '';
    document.getElementById('rector-avatar-url').value = user.avatarUrl || '';
    document.getElementById('rector-job-title').value = user.jobTitle || 'Rector General';
    document.getElementById('rector-specialty').value = user.specialty || '';
    document.getElementById('rector-appointment-date').value = user.appointmentDate || user.appointment_date || new Date().toISOString().split('T')[0];
    document.getElementById('rector-status').value = user.status || 'active';
    
    // Mostrar selector de estado y botón de eliminar en edición
    if (statusContainer) statusContainer.style.display = 'flex';
    if (jwtInfoBlock) jwtInfoBlock.style.display = 'none';
    if (rectorDeleteBtn) rectorDeleteBtn.style.display = 'inline-block';
    document.getElementById('rector-submit-btn').textContent = 'Guardar Cambios';
    
    if (user.schoolId) schoolSelect.value = user.schoolId;

    if (user.avatarUrl) {
      previewImg.src = user.avatarUrl;
      previewImg.style.display = 'block';
      placeholder.style.display = 'none';
      removeBtn.style.display = 'inline-block';
    } else {
      previewImg.src = '';
      previewImg.style.display = 'none';
      placeholder.style.display = 'block';
      removeBtn.style.display = 'none';
    }
  } else {
    // MODO CREACIÓN DE NUEVO RECTOR (SIEMPRE INVITACIÓN PENDIENTE JWT)
    document.getElementById('rector-id').value = '';
    document.getElementById('rector-modal-title').textContent = 'Registro de Rector / Directivo';
    document.getElementById('rector-name').value = '';
    document.getElementById('rector-email').value = '';
    document.getElementById('rector-phone').value = '';
    document.getElementById('rector-doc-type').value = 'CC';
    document.getElementById('rector-doc-id').value = '';
    document.getElementById('rector-avatar-url').value = '';
    document.getElementById('rector-job-title').value = 'Rector General';
    document.getElementById('rector-specialty').value = '';
    document.getElementById('rector-appointment-date').value = new Date().toISOString().split('T')[0];
    document.getElementById('rector-status').value = 'invited';

    // Ocultar selector de estado y botón de eliminar en creación
    if (statusContainer) statusContainer.style.display = 'none';
    if (jwtInfoBlock) jwtInfoBlock.style.display = 'block';
    if (rectorDeleteBtn) rectorDeleteBtn.style.display = 'none';
    document.getElementById('rector-submit-btn').textContent = 'Registrar y Enviar Invitación JWT →';

    if (preselectedSchoolId) schoolSelect.value = preselectedSchoolId;

    previewImg.src = '';
    previewImg.style.display = 'none';
    placeholder.style.display = 'block';
    removeBtn.style.display = 'none';
  }

  // Mostrar modal flotante
  const overlay = document.getElementById('rector-modal-overlay');
  const panel   = document.getElementById('rector-modal-panel');
  overlay.style.display = 'flex';
  panel.getBoundingClientRect();
  panel.style.opacity   = '1';
  panel.style.transform = 'scale(1)';
  document.getElementById('rector-name').focus();
};

window.closeRectorModal = function() {
  const overlay = document.getElementById('rector-modal-overlay');
  const panel   = document.getElementById('rector-modal-panel');
  if (!panel) return;
  panel.style.opacity   = '0';
  panel.style.transform = 'scale(0.96)';
  setTimeout(() => {
    if (overlay) overlay.style.display = 'none';
    document.body.style.overflow = '';
  }, 220);
};

window.saveRector = async function() {
  const submitBtn = document.getElementById('rector-submit-btn');
  const fb        = document.getElementById('rector-feedback');
  const rectorId  = document.getElementById('rector-id').value;

  submitBtn.disabled    = true;
  submitBtn.textContent = 'Guardando…';
  fb.style.display      = 'none';

  const schoolId        = document.getElementById('rector-school-id').value;
  const name            = document.getElementById('rector-name').value.trim();
  const email           = document.getElementById('rector-email').value.trim().toLowerCase();
  const docType         = document.getElementById('rector-doc-type').value;
  const docId           = document.getElementById('rector-doc-id').value.trim();
  const phone           = document.getElementById('rector-phone').value.trim();
  const jobTitle        = document.getElementById('rector-job-title').value;
  const specialty       = document.getElementById('rector-specialty').value.trim();
  const appointmentDate = document.getElementById('rector-appointment-date').value;
  // Todo nuevo rector siempre es 'invited'; en edición se respeta el valor elegido
  const status          = rectorId ? (document.getElementById('rector-status')?.value || 'active') : 'invited';

  if (!name || !email) {
    fb.style.cssText = 'display:block; padding:10px 14px; background:#FEE2E2; border:1px solid var(--danger); color:var(--danger); font-family:var(--mono); font-size:12px; font-weight:600; margin-bottom:16px;';
    fb.textContent = 'Por favor completa el nombre y correo del directivo.';
    submitBtn.disabled = false;
    submitBtn.textContent = rectorId ? 'Guardar Cambios' : 'Registrar y Enviar Invitación JWT →';
    return;
  }

  if (!rectorId && (!docId || !phone)) {
    fb.style.cssText = 'display:block; padding:10px 14px; background:#FEE2E2; border:1px solid var(--danger); color:var(--danger); font-family:var(--mono); font-size:12px; font-weight:600; margin-bottom:16px;';
    fb.textContent = 'Para la activación segura JWT es obligatorio ingresar el Documento de Identidad y el Teléfono registrado.';
    submitBtn.disabled = false;
    submitBtn.textContent = 'Registrar y Enviar Invitación JWT →';
    return;
  }

  try {
    let avatarUrl = document.getElementById('rector-avatar-url').value.trim() || null;

    // Subir foto vía endpoint seguro (sin apikey hardcodeada)
    if (window._selectedRectorAvatarFile) {
      submitBtn.textContent = 'Subiendo foto…';
      const file = window._selectedRectorAvatarFile;
      const fd = new FormData();
      fd.append('file', file);
      fd.append('type', 'avatar');
      fd.append('slug', 'rector-' + Date.now());
      const uploadRes = await window.fetchAuth('/api/admin/upload-asset', { method: 'POST', body: fd });
      const uploadData = await uploadRes.json();
      if (uploadData.ok) {
        avatarUrl = uploadData.url;
      } else {
        console.warn('Error subiendo avatar:', uploadData.error);
      }
    }

    submitBtn.textContent = 'Aprovisionando directivo…';

    const payload = {
      id: rectorId || null,
      name,
      email,
      schoolId,
      phone,
      documentType: docType,
      documentId: docId,
      jobTitle,
      specialty: specialty || undefined,
      appointmentDate: appointmentDate || undefined,
      status,
      avatarUrl
    };

    // 1. Guardar a través de la API segura con credenciales de servicio
    let savedUser = null;
    let confirmUrl = null;
    let emailSent = false;

    const res = await fetch('/api/admin/rector', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const resData = await res.json();
    if (resData.ok) {
      savedUser = resData.user;
      confirmUrl = resData.confirmUrl;
      emailSent = !!resData.emailSent;
    } else {
      // ✅ Si la API falla, lanzar error — no hacer fallback directo a Supabase
      throw new Error(resData.error || 'Error al guardar el rector en el servidor.');
    }

    // 3. Actualizar memoria del cliente
    const clientPayload = {
      id: rectorId || (savedUser && savedUser.id) || crypto.randomUUID(),
      name,
      email,
      role: 'school_admin',
      schoolId,
      documentType: docType,
      documentId: docId || null,
      phone: phone || null,
      jobTitle: jobTitle,
      avatarUrl,
      status,
      schoolName: (window.SCHOOLS.find(s => s.id === schoolId) || {}).name || 'Colegio',
    };

    const uIdx = window.USERS.findIndex(u => (rectorId && u.id === rectorId) || u.email === email);
    if (uIdx !== -1) {
      window.USERS[uIdx] = { ...window.USERS[uIdx], ...clientPayload };
    } else {
      window.USERS.push({ ...clientPayload, createdAt: new Date().toISOString() });
    }

    const sIdx = window.SCHOOLS.findIndex(s => s.id === schoolId);
    if (sIdx !== -1) {
      window.SCHOOLS[sIdx].rectorName = name;
      window.SCHOOLS[sIdx].rectorEmail = email;
    }

    // Éxito
    fb.style.cssText = 'display:block; padding:10px 14px; background:#E6F4EA; border:1px solid var(--sage-dark); color:var(--sage-dark); font-family:var(--mono); font-size:12px; font-weight:600; margin-bottom:16px;';
    
    if (!rectorId) {
      fb.textContent = emailSent 
        ? `✓ Directivo registrado. Correo de confirmación JWT enviado exitosamente a ${email}.`
        : `✓ Directivo registrado en estado Invitación Pendiente. Enlace JWT generado.`;
    } else {
      fb.textContent = '✓ Cambios del directivo guardados correctamente.';
    }

    submitBtn.textContent = '✓ Guardado';

    setTimeout(() => {
      window.closeRectorModal();
      window.location.reload(); // Recargar para reflejar en tabla
    }, 1200);

  } catch (err) {
    console.error('Error guardando rector:', err);
    fb.style.cssText = 'display:block; padding:10px 14px; background:#FEE2E2; border:1px solid var(--danger); color:var(--danger); font-family:var(--mono); font-size:12px; font-weight:600; margin-bottom:16px;';
    fb.textContent = 'No fue posible registrar el directivo: ' + (err.message || 'Error de conexión');
    submitBtn.disabled = false;
    submitBtn.textContent = rectorId ? 'Guardar Cambios' : 'Registrar y Enviar Invitación JWT →';
  }
};

// ============================================================
// ELIMINAR USUARIO DEFINITIVAMENTE (CASCADA TOTAL)
// ============================================================
window.deleteUser = async function(userId, email, name) {
  const displayName = name || email || 'este usuario';
  const confirmed = await window.showConfirmModal({
    title: '¿Eliminar Usuario?',
    badge: 'PURGA PERMANENTE DE ACCESO',
    message: `¿Estás seguro de eliminar definitivamente a "${displayName}"?\n\nEsta acción borrará todas sus credenciales en Supabase Auth, sus tickets y todos sus registros asociados. Esta acción no se puede deshacer.`,
    confirmText: 'Eliminar Usuario',
    cancelText: 'Cancelar',
    type: 'danger'
  });

  if (!confirmed) return;

  try {
    const res = await window.fetchAuth('/api/admin/delete-user', {
      method: 'POST',
      body: JSON.stringify({ userId, email })
    });
    const data = await res.json();
    if (!data.ok) throw new Error(data.error || 'No se pudo eliminar el usuario.');

    await window.showAlertModal({
      title: 'Usuario Eliminado',
      message: '✓ ' + (data.message || 'Usuario eliminado exitosamente.'),
      type: 'success'
    });
    window.location.reload();
  } catch (err) {
    console.error('Error eliminando usuario:', err);
    await window.showAlertModal({
      title: 'Error de Eliminación',
      message: 'Error al eliminar: ' + (err?.message || 'Error de conexión'),
      type: 'danger'
    });
  }
};

window.deleteCurrentRector = async function() {
  const rectorId = document.getElementById('rector-id')?.value;
  const email = document.getElementById('rector-email')?.value;
  const name = document.getElementById('rector-name')?.value;
  const schoolId = document.getElementById('rector-school-id')?.value;

  if (!rectorId && !email) return;

  const displayName = name || email || 'el directivo';
  const confirmed = await window.showConfirmModal({
    title: '¿Eliminar Directivo?',
    badge: 'PURGA PERMANENTE DE ACCESO',
    message: `¿Estás seguro de eliminar al directivo "${displayName}"?\n\nSe borrará su cuenta en Supabase Auth, se desvinculará de la institución y se limpiarán sus tickets de acceso.`,
    confirmText: 'Eliminar Directivo',
    cancelText: 'Cancelar',
    type: 'danger'
  });

  if (!confirmed) return;

  const delBtn = document.getElementById('rector-delete-btn');
  if (delBtn) { delBtn.disabled = true; delBtn.textContent = 'Eliminando…'; }

  try {
    const res = await window.fetchAuth('/api/admin/delete-user', {
      method: 'POST',
      body: JSON.stringify({ userId: rectorId, email, schoolId })
    });
    const data = await res.json();
    if (!data.ok) throw new Error(data.error || 'No se pudo eliminar el directivo.');

    window.closeRectorModal();
    await window.showAlertModal({
      title: 'Directivo Eliminado',
      message: '✓ ' + (data.message || 'Directivo eliminado exitosamente.'),
      type: 'success'
    });
    window.location.reload();
  } catch (err) {
    console.error('Error eliminando rector:', err);
    await window.showAlertModal({
      title: 'Error de Eliminación',
      message: 'Error al eliminar directivo: ' + (err?.message || 'Error de conexión'),
      type: 'danger'
    });
    if (delBtn) { delBtn.disabled = false; delBtn.textContent = '🗑 Eliminar Directivo'; }
  }
};

// ============================================================
// EVENT LISTENERS
// ============================================================
document.addEventListener('DOMContentLoaded', () => {
  const rectorOverlay = document.getElementById('rector-modal-overlay');
  if (rectorOverlay) {
    rectorOverlay.addEventListener('click', e => {
      if (e.target === e.currentTarget) window.closeRectorModal();
    });
  }

  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (document.getElementById('rector-modal-overlay')?.style.display === 'flex') {
      window.closeRectorModal();
    }
    if (document.getElementById('password-ticket-modal-overlay')?.style.display === 'flex') {
      window.closePasswordTicketModal();
    }
  });

  // Selector de Avatar / Foto
  const btnUploadAvatar = document.getElementById('rector-btn-upload-avatar');
  const avatarFileInput = document.getElementById('rector-avatar-file-input');
  const btnRemoveAvatar = document.getElementById('rector-btn-remove-avatar');
  const avatarPreviewImg = document.getElementById('rector-avatar-preview-img');
  const avatarPlaceholder = document.getElementById('rector-avatar-placeholder');
  const avatarUrlHidden = document.getElementById('rector-avatar-url');

  if (btnUploadAvatar && avatarFileInput) {
    btnUploadAvatar.addEventListener('click', () => avatarFileInput.click());

    avatarFileInput.addEventListener('change', (e) => {
      const file = e.target.files?.[0];
      if (!file) return;

      if (file.size > 4 * 1024 * 1024) {
        alert('La fotografía no puede exceder 4MB.');
        return;
      }

      window._selectedRectorAvatarFile = file;
      const objectUrl = URL.createObjectURL(file);
      if (avatarPreviewImg) {
        avatarPreviewImg.src = objectUrl;
        avatarPreviewImg.style.display = 'block';
      }
      if (avatarPlaceholder) avatarPlaceholder.style.display = 'none';
      if (btnRemoveAvatar) btnRemoveAvatar.style.display = 'inline-block';
    });
  }

  if (btnRemoveAvatar) {
    btnRemoveAvatar.addEventListener('click', () => {
      window._selectedRectorAvatarFile = null;
      if (avatarFileInput) avatarFileInput.value = '';
      if (avatarUrlHidden) avatarUrlHidden.value = '';
      if (avatarPreviewImg) {
        avatarPreviewImg.src = '';
        avatarPreviewImg.style.display = 'none';
      }
      if (avatarPlaceholder) avatarPlaceholder.style.display = 'block';
      btnRemoveAvatar.style.display = 'none';
    });
  }

  // Generador de clave segura para Rector
  const btnGenPass = document.getElementById('rector-btn-generate-pass');
  if (btnGenPass) {
    btnGenPass.addEventListener('click', () => {
      const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%^&*';
      let pass = 'Rector';
      for (let i = 0; i < 6; i++) pass += chars.charAt(Math.floor(Math.random() * chars.length));
      pass += '!2026';
      document.getElementById('rector-password').value = pass;
    });
  }

  // Form submit
  const rectorForm = document.getElementById('rector-form');
  if (rectorForm) {
    rectorForm.addEventListener('submit', async e => {
      e.preventDefault();
      await window.saveRector();
    });
  }

  const passwordTicketOverlay = document.getElementById('password-ticket-modal-overlay');
  if (passwordTicketOverlay) {
    passwordTicketOverlay.addEventListener('click', e => {
      if (e.target === e.currentTarget) window.closePasswordTicketModal();
    });
  }

  // Generador y Copiado de Clave en Modal Directo
  const btnGenPassDirect = document.getElementById('password-direct-btn-generate');
  if (btnGenPassDirect) {
    btnGenPassDirect.addEventListener('click', () => {
      const passInput = document.getElementById('password-direct-new-input');
      if (passInput) passInput.value = generateSecurePassword();
    });
  }

  const btnCopyPassDirect = document.getElementById('password-direct-btn-copy');
  if (btnCopyPassDirect) {
    btnCopyPassDirect.addEventListener('click', async () => {
      const passInput = document.getElementById('password-direct-new-input');
      if (!passInput || !passInput.value) return;
      try {
        await navigator.clipboard.writeText(passInput.value);
        const orig = btnCopyPassDirect.textContent;
        btnCopyPassDirect.textContent = '✓ Copiada';
        setTimeout(() => { btnCopyPassDirect.textContent = orig; }, 1800);
      } catch (err) {
        passInput.select();
        document.execCommand('copy');
      }
    });
  }

  const passwordTicketForm = document.getElementById('password-ticket-form');
  if (passwordTicketForm) {
    passwordTicketForm.addEventListener('submit', async e => {
      e.preventDefault();

      const submitBtn = document.getElementById('password-ticket-submit-btn');
      const fb = document.getElementById('password-ticket-feedback');
      const targetUserId = document.getElementById('password-ticket-user-id')?.value;
      const newPassword = document.getElementById('password-direct-new-input')?.value?.trim();
      const requireChangeOnNextLogin = document.getElementById('password-ticket-require-change')?.checked ?? true;
      const reason = document.getElementById('password-ticket-reason')?.value?.trim() || 'Restablecimiento directo de acceso.';

      if (!targetUserId) {
        fb.style.cssText = 'display:block; padding:10px 14px; background:#FEE2E2; border:1px solid var(--danger); color:var(--danger); font-family:var(--mono); font-size:12px; font-weight:600;';
        fb.textContent = 'Error: no se especificó el usuario a restablecer.';
        return;
      }

      if (!newPassword || newPassword.length < 6) {
        fb.style.cssText = 'display:block; padding:10px 14px; background:#FEE2E2; border:1px solid var(--danger); color:var(--danger); font-family:var(--mono); font-size:12px; font-weight:600;';
        fb.textContent = 'La nueva contraseña debe tener al menos 6 caracteres.';
        return;
      }

      try {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Actualizando en Supabase Auth…';
        fb.style.display = 'none';

        const res = await window.fetchAuth('/api/admin/reset-password', {
          method: 'POST',
          body: JSON.stringify({
            userId: targetUserId,
            newPassword,
            requireChangeOnNextLogin,
            reason,
          }),
        });
        const data = await res.json();
        if (!data.ok) throw new Error(data.error || 'Error restableciendo la contraseña');

        // Intentar copiar al portapapeles automáticamente
        try {
          await navigator.clipboard.writeText(newPassword);
        } catch (_) {}

        fb.style.cssText = 'display:block; padding:12px 14px; background:#E6F4EA; border:1.5px solid var(--ink); color:var(--ink); font-family:var(--sans); font-size:12.5px; line-height:1.45; box-shadow:3px 3px 0 var(--ink); margin-bottom:8px;';
        fb.innerHTML = `
          <div style="font-weight:800; font-size:13px; color:#137333; margin-bottom:4px;">
            ✓ ¡Contraseña Actualizada con Éxito en Supabase Auth!
          </div>
          <div style="margin-bottom:6px; color:var(--ink-soft); font-size:11.5px;">
            Acceso habilitado inmediatamente. Todos sus cursos, notas y datos siguen 100% intactos.
          </div>
          <div style="background:#FFFFFF; border:1px solid var(--ink); padding:6px 10px; font-family:var(--mono); font-size:12.5px; font-weight:800; color:var(--rust); display:flex; justify-content:space-between; align-items:center;">
            <span>Clave: ${newPassword}</span>
            <span style="font-size:10px; color:#137333; font-weight:700;">✓ Copiada al portapapeles</span>
          </div>
        `;
        submitBtn.textContent = '✓ Contraseña Guardada';

        setTimeout(() => {
          window.closePasswordTicketModal();
          window.location.reload();
        }, 2200);
      } catch (err) {
        console.error('Error restableciendo contraseña:', err);
        fb.style.cssText = 'display:block; padding:10px 14px; background:#FEE2E2; border:1px solid var(--danger); color:var(--danger); font-family:var(--mono); font-size:12px; font-weight:600;';
        fb.textContent = 'No fue posible restablecer la clave: ' + (err.message || 'Error de conexión');
        submitBtn.disabled = false;
        submitBtn.textContent = '🔑 Guardar y Aplicar Clave Inmediatamente';
      }
    });
  }

  // Filtros de búsqueda
  const searchInput = document.getElementById('user-search');
  const roleFilter = document.getElementById('user-role-filter');
  const statusFilter = document.getElementById('user-status-filter');

  function applyFilters() {
    const search = (searchInput?.value || '').toLowerCase().trim();
    const role = roleFilter?.value || '';
    const status = statusFilter?.value || '';

    document.querySelectorAll('.user-row').forEach(row => {
      const user = window.USERS.find(u => u.id === row.dataset.id);
      if (!user) return;

      const matchSearch = !search ||
        user.name.toLowerCase().includes(search) ||
        user.email.toLowerCase().includes(search) ||
        (user.schoolName || '').toLowerCase().includes(search);
      const matchRole = !role || user.role === role;
      const matchStatus = !status || (user.status || 'active') === status;

      row.style.display = (matchSearch && matchRole && matchStatus) ? '' : 'none';
    });
  }

  if (searchInput) searchInput.addEventListener('input', applyFilters);
  if (roleFilter) roleFilter.addEventListener('change', applyFilters);
  if (statusFilter) statusFilter.addEventListener('change', applyFilters);
});
</script>
