---
// ============================================================
// SchoolOS — Directorio de Usuarios (/es/app/super-admin/users)
// ============================================================
import AppLayout from '../../../../layouts/AppLayout.astro';
import { userService } from '../../../../services/userService';
import { schoolService } from '../../../../services/schoolService';
import { passwordResetTicketService } from '../../../../services/passwordResetTicketService';

const lang = 'es';
let users: any[] = [];
let schools: any[] = [];
let passwordTickets: any[] = [];
try {
  users = await userService.getUsers();
  schools = await schoolService.getSchools();
  passwordTickets = await passwordResetTicketService.getTicketQueue();
} catch (e) {
  console.error('Error fetching users/schools:', e);
}

const superAdminsCount = users.filter((u) => u.role === 'super_admin').length;
const schoolAdminsCount = users.filter((u) => u.role === 'school_admin').length;
const teachersCount = users.filter((u) => u.role === 'teacher').length;
const openPasswordTicketsCount = passwordTickets.filter((t) => ['pending', 'approved', 'failed'].includes(t.status)).length;

const usersJson = JSON.stringify(users);
const schoolsJson = JSON.stringify(schools);
const passwordTicketsJson = JSON.stringify(passwordTickets);
---

<AppLayout
  title="Usuarios"
  pageTitle="Directorio de Cuentas"
  activeSection="users"
  lang={lang}
  activeRoute="/app/super-admin/users"
  breadcrumbs={[{ label: 'Sistema' }, { label: 'Usuarios' }]}
>
  <!-- TOP SUMMARY RIBBON -->
  <div style="display:grid; grid-template-columns:repeat(5, minmax(0, 1fr)); gap:16px; margin-bottom:24px;">
    <div style="background:var(--paper); border:1px solid var(--ink); padding:16px 20px; border-bottom:3px solid var(--stone-accent);">
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">Total Cuentas</div>
      <div id="stat-total-users" style="font-family:var(--serif); font-size:26px; font-weight:700; color:var(--ink); margin-top:4px;">{users.length}</div>
      <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft); margin-top:2px;">En base de datos</div>
    </div>
    <div style="background:var(--paper); border:1px solid var(--ink); padding:16px 20px; border-bottom:3px solid var(--orange-vibrant);">
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">Super Administradores</div>
      <div id="stat-super-admins" style="font-family:var(--serif); font-size:26px; font-weight:700; color:var(--orange-vibrant); margin-top:4px;">{superAdminsCount}</div>
      <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft); margin-top:2px;">Permisos Globales Root</div>
    </div>
    <div style="background:var(--paper); border:1px solid var(--ink); padding:16px 20px; border-bottom:3px solid var(--sage-accent);">
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">Rectores / Directores</div>
      <div id="stat-school-admins" style="font-family:var(--serif); font-size:26px; font-weight:700; color:var(--sage-dark); margin-top:4px;">{schoolAdminsCount}</div>
      <div style="font-family:var(--mono); font-size:10.5px; color:var(--sage-dark); margin-top:2px;">Cuentas directivas de escuelas</div>
    </div>
    <div style="background:var(--paper); border:1px solid var(--ink); padding:16px 20px; border-bottom:3px solid var(--stone-accent);">
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">Cuerpo Docente</div>
      <div id="stat-teachers" style="font-family:var(--serif); font-size:26px; font-weight:700; color:var(--ink); margin-top:4px;">{teachersCount}</div>
      <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft); margin-top:2px;">Profesores y tutores</div>
    </div>
    <div style="background:var(--paper); border:1px solid var(--ink); padding:16px 20px; border-bottom:3px solid var(--danger);">
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">Tickets de Clave</div>
      <div id="stat-password-tickets" style="font-family:var(--serif); font-size:26px; font-weight:700; color:var(--danger); margin-top:4px;">{openPasswordTicketsCount}</div>
      <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft); margin-top:2px;">Pendientes o aprobados</div>
    </div>
  </div>

  <div class="panel">
    <div class="table-toolbar">
      <div class="filter-row" style="align-items:center;">
        <input id="user-search" type="text" placeholder="Buscar por nombre, correo o colegio..." style="border:1px solid var(--ink); background:var(--cream); padding:7px 12px; font-family:var(--sans); font-size:12.5px; width:280px; border-radius:2px;" />
        <select id="user-role-filter" class="filter-select" style="border:1px solid var(--ink);" aria-label="Filtrar por rol">
          <option value="">Todos los roles</option>
          <option value="super_admin">Super Admin</option>
          <option value="school_admin">Rector / Administrador Escolar</option>
          <option value="teacher">Docente</option>
          <option value="student">Estudiante</option>
        </select>
        <select id="user-status-filter" class="filter-select" style="border:1px solid var(--ink);" aria-label="Filtrar por estado">
          <option value="">Todos los estados</option>
          <option value="active">Activo</option>
          <option value="pending">Pendiente</option>
          <option value="suspended">Suspendido</option>
        </select>
      </div>
      <button class="btn btn-primary" onclick="window.openRectorModal && window.openRectorModal()">
        + Registrar / Invitar Rector
      </button>
    </div>

    <div class="panel-body">
      <table class="data-table" id="users-table">
        <thead>
          <tr>
            <th>Usuario / Nombre</th>
            <th>Correo Electrónico</th>
            <th>Institución Educativa</th>
            <th>Rol & Cargo</th>
            <th>Contacto</th>
            <th>Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="users-tbody">
          {users.map((u) => {
            const isSuper = u.role === 'super_admin';
            const isRector = u.role === 'school_admin';
            const initials = u.name ? u.name.split(' ').map((n: string) => n[0]).join('').slice(0, 2).toUpperCase() : 'U';
            return (
              <tr class="user-row" data-id={u.id}>
                <td class="cell-name">
                  <div style="display:flex; align-items:center; gap:10px;">
                    <div style={`width:30px; height:30px; border:1px solid var(--ink); background:${isSuper ? 'var(--ink)' : isRector ? 'var(--cream)' : '#BACBB0'}; color:${isSuper ? '#FFFFFF' : '#12110E'}; font-family:var(--mono); font-size:11px; font-weight:800; display:flex; align-items:center; justify-content:center; overflow:hidden; flex-shrink:0;`}>
                      {u.avatarUrl ? (
                        <img src={u.avatarUrl} alt={u.name} style="width:100%; height:100%; object-fit:cover;" />
                      ) : (
                        <span>{initials}</span>
                      )}
                    </div>
                    <div>
                      <div style="font-size:13.5px; font-weight:700; color:var(--ink);">{u.name}</div>
                      {u.documentId && (
                        <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft);">{u.documentType || 'CC'} {u.documentId}</div>
                      )}
                    </div>
                  </div>
                </td>
                <td class="cell-muted" style="font-family:var(--mono); font-size:12px;">{u.email}</td>
                <td style="font-weight:600; font-size:13px;">{u.schoolName}</td>
                <td>
                  <div style="display:flex; flex-direction:column; gap:2px;">
                    <span class="plan-tag" style={isSuper ? 'background:var(--ink); color:#FFFFFF; border-color:var(--ink); font-weight:700;' : isRector ? 'background:var(--cream); border-color:var(--sage-dark); color:var(--sage-dark); font-weight:700;' : ''}>
                      {isSuper ? 'Super Admin' : isRector ? (u.jobTitle || 'Rector') : u.role}
                    </span>
                    {u.specialty && (
                      <span style="font-size:10.5px; color:var(--ink-soft); font-style:italic;">{u.specialty}</span>
                    )}
                  </div>
                </td>
                <td style="font-family:var(--mono); font-size:11.5px; color:var(--ink);">
                  {u.phone || '—'}
                </td>
                <td><span class={`badge badge-${u.status || 'active'}`}>{u.status || 'active'}</span></td>
                <td class="cell-actions">
                  {isRector ? (
                    <div style="display:flex; justify-content:flex-end; gap:8px; flex-wrap:wrap;">
                      <button
                        class="btn btn-secondary btn-sm"
                        onclick={`window.openPasswordTicketModal && window.openPasswordTicketModal('${u.id}')`}
                        type="button"
                      >
                        Clave
                      </button>
                      <button
                        class="btn btn-secondary btn-sm"
                        onclick={`window.openRectorModal && window.openRectorModal('${u.id}', '${u.schoolId || ''}')`}
                        type="button"
                      >
                        Editar →
                      </button>
                    </div>
                  ) : (
                    <span style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">Global</span>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>

      {users.length === 0 && (
        <div style="padding:48px; text-align:center; font-family:var(--mono); color:var(--ink-soft);">
          <div style="font-size:32px; margin-bottom:12px;">👥</div>
          <div style="font-weight:700; color:var(--ink); margin-bottom:6px;">No hay usuarios registrados</div>
          <div style="font-size:12px;">Crea el primer directivo o docente desde el botón superior.</div>
        </div>
      )}
    </div>
  </div>

  <div class="panel">
    <div class="panel-header">
      <h2>Tickets de Cambio de Contraseña</h2>
      <span class="panel-link">{passwordTickets.length} registros</span>
    </div>
    <div class="panel-body">
      {passwordTickets.length > 0 ? (
        <table class="data-table">
          <thead>
            <tr>
              <th>Estado</th>
              <th>Usuario</th>
              <th>Institución</th>
              <th>Método</th>
              <th>Solicitado por</th>
              <th>Vence</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {passwordTickets.map((ticket) => (
              <tr>
                <td><span class={`badge badge-${ticket.status}`}>{ticket.status}</span></td>
                <td>
                  <div style="font-weight:700;">{ticket.targetEmail}</div>
                  <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft);">{ticket.reason}</div>
                </td>
                <td>{ticket.targetSchoolName || 'Sistema'}</td>
                <td style="font-family:var(--mono); font-size:11.5px;">{ticket.resetMethod}</td>
                <td class="cell-muted">{ticket.requestedByEmail || 'Soporte'}</td>
                <td class="cell-muted">{new Date(ticket.expiresAt).toLocaleDateString('es-CO')}</td>
                <td class="cell-actions">
                  {['pending', 'approved', 'failed'].includes(ticket.status) ? (
                    <button
                      class="btn btn-danger btn-sm"
                      type="button"
                      onclick={`window.executePasswordResetTicket && window.executePasswordResetTicket('${ticket.id}', '${ticket.targetEmail}')`}
                    >
                      Ejecutar reset
                    </button>
                  ) : (
                    <span style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft);">Cerrado</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <div class="empty-state">
          No hay tickets de contraseña registrados. Cuando un rector necesite cambio de clave, quedará auditado aquí.
        </div>
      )}
    </div>
  </div>
</AppLayout>

<!-- ============================================================ -->
<!-- MODAL: REGISTRO / GESTIÓN DE RECTOR (MODAL FLOTANTE)        -->
<!-- ============================================================ -->
<div
  id="rector-modal-overlay"
  style="display:none; position:fixed; inset:0; background:rgba(18,17,14,0.78); z-index:1200; align-items:center; justify-content:center; padding:20px;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="rector-modal-title"
>
  <div
    id="rector-modal-panel"
    style="
      background:var(--paper);
      border:2px solid var(--ink);
      width:min(760px, 100%);
      max-height:92vh;
      overflow-y:auto;
      display:flex;
      flex-direction:column;
      opacity:0;
      transform:scale(0.96);
      transition:opacity 0.22s ease, transform 0.22s ease;
      box-shadow:8px 8px 0 rgba(18, 17, 14, 0.25);
    "
  >
    <!-- RECTOR HEADER -->
    <div style="border-bottom:1px solid var(--line); padding:18px 24px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; background:var(--paper); z-index:2;">
      <div style="display:flex; align-items:center; gap:12px;">
        <div style="width:36px; height:36px; background:var(--ink); color:#FFFFFF; font-size:18px; display:flex; align-items:center; justify-content:center;">
          👨‍🏫
        </div>
        <div>
          <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:2px;">Directorio Institucional</div>
          <h2 id="rector-modal-title" style="font-family:var(--serif); font-size:19px; font-weight:700; color:var(--ink); margin:0;">Registro de Rector / Directivo</h2>
        </div>
      </div>
      <button
        id="rector-modal-close-btn"
        type="button"
        onclick="window.closeRectorModal && window.closeRectorModal()"
        style="width:32px; height:32px; border:1px solid var(--ink); background:transparent; cursor:pointer; font-size:16px; display:flex; align-items:center; justify-content:center; color:var(--ink);"
        aria-label="Cerrar modal de rector"
      >✕</button>
    </div>

    <!-- FORM -->
    <form id="rector-form" style="padding:24px; display:flex; flex-direction:column; gap:0;">
      <input type="hidden" id="rector-id" />
      <input type="hidden" id="rector-avatar-url" />

      <!-- PASO 1: FOTO & IDENTIFICACIÓN PERSONAL -->
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); font-weight:700; margin-bottom:12px; padding-bottom:6px; border-bottom:1px solid var(--line);">
        01 · Datos Personales & Identificación
      </div>

      <div style="display:grid; grid-template-columns:1fr 180px; gap:20px; margin-bottom:20px; align-items:start;">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
          <div style="display:flex; flex-direction:column; gap:5px; grid-column:span 2;">
            <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Nombre Completo del Rector / Directivo *</label>
            <input id="rector-name" type="text" placeholder="ej. Coach Mike Johnson" required style="border:1px solid var(--ink); background:var(--cream); padding:9px 12px; font-family:var(--sans); font-size:13.5px;" />
          </div>

          <div style="display:flex; flex-direction:column; gap:5px;">
            <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Tipo de Documento</label>
            <select id="rector-doc-type" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--mono); font-size:12px;">
              <option value="CC">Cédula de Ciudadanía (CC)</option>
              <option value="CE">Cédula de Extranjería (CE)</option>
              <option value="PA">Pasaporte (PA)</option>
              <option value="PEP">Permiso Especial (PEP)</option>
            </select>
          </div>

          <div style="display:flex; flex-direction:column; gap:5px;">
            <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Número de Documento</label>
            <input id="rector-doc-id" type="text" placeholder="ej. 1.045.890.123" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--mono); font-size:12.5px;" />
          </div>

          <div style="display:flex; flex-direction:column; gap:5px; grid-column:span 2;">
            <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Teléfono Móvil / WhatsApp de Contacto</label>
            <input id="rector-phone" type="tel" placeholder="ej. +57 300 123 4567" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--sans); font-size:13px;" />
          </div>
        </div>

        <!-- RECTOR AVATAR UPLOAD BOX -->
        <div style="border:2px dashed var(--ink); padding:14px; text-align:center; background:var(--cream); border-radius:4px; display:flex; flex-direction:column; align-items:center; justify-content:center;">
          <div style="font-family:var(--mono); font-size:9.5px; font-weight:700; text-transform:uppercase; margin-bottom:8px; color:var(--ink);">Foto del Rector</div>
          <div id="rector-avatar-preview-box" style="width:85px; height:85px; border:1px solid var(--ink); background:var(--paper); display:flex; align-items:center; justify-content:center; margin-bottom:10px; overflow:hidden;">
            <img id="rector-avatar-preview-img" src="" alt="Foto Rector" style="width:100%; height:100%; object-fit:cover; display:none;" />
            <div id="rector-avatar-placeholder" style="font-family:var(--mono); font-size:10px; color:var(--ink-soft); font-weight:700;">SIN FOTO</div>
          </div>
          <input type="file" id="rector-avatar-file-input" accept="image/png,image/jpeg,image/webp" style="display:none;" />
          <button type="button" id="rector-btn-upload-avatar" class="btn btn-secondary btn-sm" style="font-size:10px; width:100%; padding:5px 6px; font-weight:700;">
            📁 Subir Foto
          </button>
          <button type="button" id="rector-btn-remove-avatar" style="background:none; border:none; color:var(--danger); font-size:10px; font-family:var(--mono); margin-top:6px; cursor:pointer; display:none;">
            ✕ Quitar foto
          </button>
        </div>
      </div>

      <!-- PASO 2: VINCULACIÓN INSTITUCIONAL & CARGO -->
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); font-weight:700; margin-bottom:12px; padding-bottom:6px; border-bottom:1px solid var(--line);">
        02 · Vinculación Institucional & Cargo
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:20px;">
        <div style="display:flex; flex-direction:column; gap:5px; grid-column:span 2;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Institución Educativa Asignada *</label>
          <select id="rector-school-id" required style="border:1px solid var(--ink); background:var(--cream); padding:9px 12px; font-family:var(--sans); font-size:13.5px; font-weight:700;">
            <!-- Opciones renderizadas dinámicamente -->
          </select>
        </div>

        <div style="display:flex; flex-direction:column; gap:5px;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Cargo Oficial</label>
          <select id="rector-job-title" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--sans); font-size:12.5px;">
            <option value="Rector General">Rector General</option>
            <option value="Director Académico">Director Académico</option>
            <option value="Vicerrector">Vicerrector</option>
            <option value="Director Ejecutivo">Director Ejecutivo</option>
            <option value="Coordinador General">Coordinador General</option>
          </select>
        </div>

        <div style="display:flex; flex-direction:column; gap:5px;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Fecha de Nombramiento / Posesión</label>
          <input id="rector-appointment-date" type="date" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--mono); font-size:12px;" />
        </div>

        <div style="display:flex; flex-direction:column; gap:5px; grid-column:span 2;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Título Académico / Especialidad</label>
          <input id="rector-specialty" type="text" placeholder="ej. Magíster en Gestión Educativa y Liderazgo" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--sans); font-size:13px;" />
        </div>
      </div>

      <!-- PASO 3: CREDENCIALES DE ACCESO -->
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); font-weight:700; margin-bottom:12px; padding-bottom:6px; border-bottom:1px solid var(--line);">
        03 · Credenciales de Acceso a SchoolOS
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:20px;">
        <div style="display:flex; flex-direction:column; gap:5px; grid-column:span 2;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Correo Institucional de Acceso *</label>
          <input id="rector-email" type="email" placeholder="rectoria@cafelitosacademy.edu.co" required style="border:1px solid var(--ink); background:var(--cream); padding:9px 12px; font-family:var(--mono); font-size:13px;" />
        </div>

        <div style="display:flex; flex-direction:column; gap:5px;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Contraseña Inicial</label>
            <button type="button" id="rector-btn-generate-pass" style="background:none; border:none; color:var(--sage-dark); font-family:var(--mono); font-size:10.5px; font-weight:700; cursor:pointer;">
              🎲 Generar Segura
            </button>
          </div>
          <input id="rector-password" type="text" placeholder="Mínimo 8 caracteres" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--mono); font-size:12.5px;" />
        </div>

        <div style="display:flex; flex-direction:column; gap:5px;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Estado de la Cuenta</label>
          <select id="rector-status" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--mono); font-size:12px;">
            <option value="active">Activa (Acceso Inmediato)</option>
            <option value="pending">Invitación Pendiente</option>
            <option value="suspended">Suspendida Preventivamente</option>
          </select>
        </div>
      </div>

      <!-- FEEDBACK -->
      <div id="rector-feedback" style="display:none; padding:10px 14px; margin-bottom:16px; font-family:var(--mono); font-size:12px; font-weight:600;"></div>

      <!-- FORM ACTIONS -->
      <div style="display:flex; gap:10px; justify-content:flex-end; padding-top:16px; border-top:1px solid var(--line);">
        <button id="rector-cancel-btn" type="button" class="btn btn-secondary" onclick="window.closeRectorModal && window.closeRectorModal()">Cancelar</button>
        <button id="rector-submit-btn" type="submit" class="btn btn-primary">Registrar Directivo</button>
      </div>
    </form>
  </div>
</div>

<!-- ============================================================ -->
<!-- MODAL: TICKET DE CAMBIO DE CONTRASEÑA                       -->
<!-- ============================================================ -->
<div
  id="password-ticket-modal-overlay"
  style="display:none; position:fixed; inset:0; background:rgba(18,17,14,0.78); z-index:1300; align-items:center; justify-content:center; padding:20px;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="password-ticket-modal-title"
>
  <div
    id="password-ticket-modal-panel"
    style="background:var(--paper); border:2px solid var(--ink); width:min(560px, 100%); box-shadow:8px 8px 0 rgba(18, 17, 14, 0.25); opacity:0; transform:scale(0.96); transition:opacity 0.22s ease, transform 0.22s ease;"
  >
    <div style="border-bottom:1px solid var(--line); padding:18px 22px; display:flex; align-items:center; justify-content:space-between;">
      <div>
        <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:2px;">Seguridad de cuenta</div>
        <h2 id="password-ticket-modal-title" style="font-family:var(--serif); font-size:19px; font-weight:700; color:var(--ink); margin:0;">Ticket de cambio de contraseña</h2>
      </div>
      <button type="button" onclick="window.closePasswordTicketModal && window.closePasswordTicketModal()" style="width:32px; height:32px; border:1px solid var(--ink); background:transparent; cursor:pointer; font-size:16px; display:flex; align-items:center; justify-content:center;">✕</button>
    </div>

    <form id="password-ticket-form" style="padding:22px; display:flex; flex-direction:column; gap:16px;">
      <input type="hidden" id="password-ticket-user-id" />

      <div style="background:var(--cream); border:1px solid var(--line-strong); padding:14px 16px;">
        <div style="font-family:var(--mono); font-size:10px; text-transform:uppercase; color:var(--ink-soft);">Usuario rector</div>
        <div id="password-ticket-user-label" style="font-weight:800; margin-top:4px;">-</div>
        <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-top:4px;">
          No se muestran contraseñas antiguas. Este flujo deja auditoría y prepara el cambio seguro.
        </div>
      </div>

      <div class="form-field" style="margin-bottom:0;">
        <label>Método solicitado</label>
        <select id="password-ticket-method">
          <option value="temporary_password">Contraseña temporal</option>
          <option value="recovery_link">Enlace de recuperación</option>
          <option value="manual_support">Soporte manual</option>
        </select>
      </div>

      <div class="form-field" style="margin-bottom:0;">
        <label>Motivo del cambio</label>
        <textarea id="password-ticket-reason" rows="4" required placeholder="Ej. Rector solicita restablecimiento por pérdida de acceso."></textarea>
      </div>

      <label style="display:flex; align-items:flex-start; gap:10px; font-family:var(--mono); font-size:11.5px; color:var(--ink);">
        <input id="password-ticket-second-approval" type="checkbox" style="margin-top:2px;" />
        Requerir segunda aprobación antes de ejecutar el cambio.
      </label>

      <div id="password-ticket-feedback" style="display:none; padding:10px 14px; font-family:var(--mono); font-size:12px; font-weight:600;"></div>

      <div style="display:flex; gap:10px; justify-content:flex-end; padding-top:14px; border-top:1px solid var(--line);">
        <button type="button" class="btn btn-secondary" onclick="window.closePasswordTicketModal && window.closePasswordTicketModal()">Cancelar</button>
        <button id="password-ticket-submit-btn" type="submit" class="btn btn-primary">Crear Ticket</button>
      </div>
    </form>
  </div>
</div>

<script>
  import { passwordResetTicketService } from '../../../../services/passwordResetTicketService';
  window.passwordResetTicketService = passwordResetTicketService;
</script>

<script define:vars={{ usersJson, schoolsJson, passwordTicketsJson }}>
// ============================================================
// DATOS EN CLIENTE
// ============================================================
window.USERS = JSON.parse(usersJson || '[]');
window.SCHOOLS = JSON.parse(schoolsJson || '[]');
window.PASSWORD_TICKETS = JSON.parse(passwordTicketsJson || '[]');
window._selectedRectorAvatarFile = null;

// ============================================================
// MODAL: TICKET DE CONTRASEÑA
// ============================================================
window.openPasswordTicketModal = function(userId) {
  const user = window.USERS.find(u => u.id === userId);
  if (!user) return;

  document.getElementById('password-ticket-user-id').value = user.id;
  document.getElementById('password-ticket-user-label').textContent = `${user.name || 'Rector'} · ${user.email}`;
  document.getElementById('password-ticket-reason').value = '';
  document.getElementById('password-ticket-method').value = 'temporary_password';
  document.getElementById('password-ticket-second-approval').checked = false;

  const fb = document.getElementById('password-ticket-feedback');
  fb.style.display = 'none';
  fb.textContent = '';

  const submitBtn = document.getElementById('password-ticket-submit-btn');
  submitBtn.disabled = false;
  submitBtn.textContent = 'Crear Ticket';

  const overlay = document.getElementById('password-ticket-modal-overlay');
  const panel = document.getElementById('password-ticket-modal-panel');
  overlay.style.display = 'flex';
  panel.getBoundingClientRect();
  panel.style.opacity = '1';
  panel.style.transform = 'scale(1)';
  document.getElementById('password-ticket-reason').focus();
};

window.closePasswordTicketModal = function() {
  const overlay = document.getElementById('password-ticket-modal-overlay');
  const panel = document.getElementById('password-ticket-modal-panel');
  if (!panel) return;
  panel.style.opacity = '0';
  panel.style.transform = 'scale(0.96)';
  setTimeout(() => {
    if (overlay) overlay.style.display = 'none';
  }, 220);
};

window.executePasswordResetTicket = async function(ticketId, targetEmail) {
  const newPassword = window.prompt(`Nueva contraseña temporal para ${targetEmail || 'el rector'}:`);
  if (!newPassword) return;

  if (newPassword.length < 8) {
    window.alert('La contraseña debe tener mínimo 8 caracteres.');
    return;
  }

  const confirmed = window.confirm('Esto cambiará la contraseña real del rector en Supabase Auth. ¿Continuar?');
  if (!confirmed) return;

  try {
    await window.passwordResetTicketService.executeTicket({
      ticketId,
      newPassword,
    });

    window.alert('Contraseña actualizada. Ahora prueba cerrar sesión e ingresar como rector con la nueva clave temporal.');
    window.location.reload();
  } catch (err) {
    console.error('Error ejecutando cambio de contraseña:', err);
    window.alert('No fue posible cambiar la contraseña. Revisa que la Edge Function esté desplegada y que estés como Super Admin.');
  }
};

// ============================================================
// MODAL FLOTANTE: REGISTRO & GESTIÓN DE RECTOR
// ============================================================
window.openRectorModal = function(rectorId, preselectedSchoolId) {
  window._selectedRectorAvatarFile = null;
  const schoolSelect = document.getElementById('rector-school-id');
  
  // Llenar selector de escuelas
  schoolSelect.innerHTML = window.SCHOOLS.map(s => 
    `<option value="${s.id}">${s.name} (${s.domain || s.slug})</option>`
  ).join('');

  const fb = document.getElementById('rector-feedback');
  fb.style.display = 'none';
  fb.textContent = '';

  const submitBtn = document.getElementById('rector-submit-btn');
  submitBtn.disabled = false;
  submitBtn.textContent = 'Guardar Rector en Supabase';

  const previewImg = document.getElementById('rector-avatar-preview-img');
  const placeholder = document.getElementById('rector-avatar-placeholder');
  const removeBtn = document.getElementById('rector-btn-remove-avatar');
  const fileInput = document.getElementById('rector-avatar-file-input');
  if (fileInput) fileInput.value = '';

  if (rectorId) {
    // MODO EDICIÓN DE RECTOR EXISTENTE
    const user = window.USERS.find(u => u.id === rectorId);
    if (!user) return;

    document.getElementById('rector-id').value = user.id;
    document.getElementById('rector-modal-title').textContent = `Editar Rector: ${user.name}`;
    document.getElementById('rector-name').value = user.name || '';
    document.getElementById('rector-doc-type').value = user.documentType || 'CC';
    document.getElementById('rector-doc-id').value = user.documentId || '';
    document.getElementById('rector-phone').value = user.phone || '';
    document.getElementById('rector-avatar-url').value = user.avatarUrl || '';
    document.getElementById('rector-job-title').value = user.jobTitle || 'Rector General';
    document.getElementById('rector-appointment-date').value = user.appointmentDate || '';
    document.getElementById('rector-specialty').value = user.specialty || '';
    document.getElementById('rector-email').value = user.email || '';
    document.getElementById('rector-password').value = '';
    document.getElementById('rector-password').placeholder = 'Dejar en blanco para conservar clave actual';
    document.getElementById('rector-status').value = user.status || 'active';
    
    if (user.schoolId) schoolSelect.value = user.schoolId;

    if (user.avatarUrl) {
      previewImg.src = user.avatarUrl;
      previewImg.style.display = 'block';
      placeholder.style.display = 'none';
      removeBtn.style.display = 'inline-block';
    } else {
      previewImg.src = '';
      previewImg.style.display = 'none';
      placeholder.style.display = 'block';
      removeBtn.style.display = 'none';
    }
  } else {
    // MODO CREACIÓN DE NUEVO RECTOR
    document.getElementById('rector-id').value = '';
    document.getElementById('rector-modal-title').textContent = 'Registro de Rector / Directivo';
    document.getElementById('rector-name').value = '';
    document.getElementById('rector-doc-type').value = 'CC';
    document.getElementById('rector-doc-id').value = '';
    document.getElementById('rector-phone').value = '';
    document.getElementById('rector-avatar-url').value = '';
    document.getElementById('rector-job-title').value = 'Rector General';
    document.getElementById('rector-appointment-date').value = new Date().toISOString().split('T')[0];
    document.getElementById('rector-specialty').value = '';
    document.getElementById('rector-email').value = '';
    document.getElementById('rector-password').value = 'Rector2026!*';
    document.getElementById('rector-password').placeholder = 'Mínimo 8 caracteres';
    document.getElementById('rector-status').value = 'active';

    if (preselectedSchoolId) schoolSelect.value = preselectedSchoolId;

    previewImg.src = '';
    previewImg.style.display = 'none';
    placeholder.style.display = 'block';
    removeBtn.style.display = 'none';
  }

  // Mostrar modal flotante
  const overlay = document.getElementById('rector-modal-overlay');
  const panel   = document.getElementById('rector-modal-panel');
  overlay.style.display = 'flex';
  panel.getBoundingClientRect();
  panel.style.opacity   = '1';
  panel.style.transform = 'scale(1)';
  document.getElementById('rector-name').focus();
};

window.closeRectorModal = function() {
  const overlay = document.getElementById('rector-modal-overlay');
  const panel   = document.getElementById('rector-modal-panel');
  if (!panel) return;
  panel.style.opacity   = '0';
  panel.style.transform = 'scale(0.96)';
  setTimeout(() => {
    if (overlay) overlay.style.display = 'none';
  }, 220);
};

window.saveRector = async function() {
  const submitBtn = document.getElementById('rector-submit-btn');
  const fb        = document.getElementById('rector-feedback');
  const rectorId  = document.getElementById('rector-id').value;

  submitBtn.disabled    = true;
  submitBtn.textContent = 'Guardando…';
  fb.style.display      = 'none';

  const schoolId = document.getElementById('rector-school-id').value;
  const name     = document.getElementById('rector-name').value.trim();
  const email    = document.getElementById('rector-email').value.trim();
  const password = document.getElementById('rector-password').value.trim();
  const docType  = document.getElementById('rector-doc-type').value;
  const docId    = document.getElementById('rector-doc-id').value.trim();
  const phone    = document.getElementById('rector-phone').value.trim();
  const jobTitle = document.getElementById('rector-job-title').value;
  const specialty= document.getElementById('rector-specialty').value.trim();
  const appDate  = document.getElementById('rector-appointment-date').value;
  const status   = document.getElementById('rector-status').value;

  try {
    const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
    const supabase = createClient(
      'https://tyzeirtdrvlufnkwpron.supabase.co',
      'sb_publishable_416BDuzMEaASLp4BLzqEAQ_jsUgB7Yl'
    );

    let avatarUrl = document.getElementById('rector-avatar-url').value.trim() || null;

    // Subir foto a Supabase Storage si se seleccionó archivo
    if (window._selectedRectorAvatarFile) {
      submitBtn.textContent = 'Subiendo imagen…';
      const file = window._selectedRectorAvatarFile;
      const fileExt = file.name.split('.').pop() || 'png';
      const filePath = `avatars/rector-${Date.now()}.${fileExt}`;

      const { error: upErr } = await supabase.storage
        .from('school-assets')
        .upload(filePath, file, {
          contentType: file.type || 'image/png',
          cacheControl: '3600',
          upsert: true
        });

      if (!upErr) {
        const { data: stData } = supabase.storage.from('school-assets').getPublicUrl(filePath);
        avatarUrl = stData.publicUrl;
      } else {
        console.warn('Storage fallback a DataURL:', upErr);
        avatarUrl = await new Promise((resolve) => {
          const reader = new FileReader();
          reader.onload = () => resolve(reader.result);
          reader.readAsDataURL(file);
        });
      }
    }

    submitBtn.textContent = 'Registrando directivo…';

    let targetUserId = rectorId;

    if (!targetUserId) {
      // 1. Primero crear usuario en auth.users con signUp para obtener ID válido de auth
      const { data: authData, error: authError } = await supabase.auth.signUp({
        email: email,
        password: password || 'Rector2026!*',
        options: {
          data: {
            name: name,
            role: 'school_admin',
            school_id: schoolId
          }
        }
      });

      if (authError) {
        // Si ya existía el usuario en auth, buscamos su ID en public.users
        const { data: existingUser } = await supabase
          .from('users')
          .select('id')
          .eq('email', email)
          .maybeSingle();

        if (existingUser) {
          targetUserId = existingUser.id;
        } else {
          throw authError;
        }
      } else if (authData.user) {
        targetUserId = authData.user.id;
      }
    }

    // 2. Actualizar o asegurar todos los campos del perfil en public.users
    const profilePayload = {
      name: name,
      email: email,
      role: 'school_admin',
      school_id: schoolId,
      document_type: docType,
      document_id: docId || null,
      phone: phone || null,
      job_title: jobTitle,
      specialty: specialty || null,
      appointment_date: appDate || null,
      avatar_url: avatarUrl,
      status: status,
    };

    if (targetUserId) {
      const { error: upsertErr } = await supabase
        .from('users')
        .upsert({ id: targetUserId, ...profilePayload });

      if (upsertErr) {
        console.warn('Upsert fallback a update:', upsertErr);
        await supabase.from('users').update(profilePayload).eq('email', email);
      }
    }

    // 3. Sincronizar rector en la escuela correspondiente
    await supabase.from('schools').update({
      rector_name: name,
      rector_email: email,
    }).eq('id', schoolId);

    // 4. Actualizar memoria
    const uIdx = window.USERS.findIndex(u => (targetUserId && u.id === targetUserId) || u.email === email);
    if (uIdx !== -1) {
      window.USERS[uIdx] = {
        ...window.USERS[uIdx],
        ...profilePayload,
        schoolName: (window.SCHOOLS.find(s => s.id === schoolId) || {}).name || 'Colegio'
      };
    } else {
      window.USERS.push({
        id: targetUserId || crypto.randomUUID(),
        ...profilePayload,
        schoolName: (window.SCHOOLS.find(s => s.id === schoolId) || {}).name || 'Colegio',
        createdAt: new Date().toISOString()
      });
    }

    // Éxito
    fb.style.cssText = 'display:block; padding:10px 14px; background:#E6F4EA; border:1px solid var(--sage-dark); color:var(--sage-dark); font-family:var(--mono); font-size:12px; font-weight:600; margin-bottom:16px;';
    fb.textContent = '✓ Directivo registrado y vinculado correctamente.';
    submitBtn.textContent = '✓ Guardado';

    setTimeout(() => {
      window.closeRectorModal();
      window.location.reload(); // Recargar para reflejar en tabla
    }, 1000);

  } catch (err) {
    console.error('Error guardando rector:', err);
    fb.style.cssText = 'display:block; padding:10px 14px; background:#FEE2E2; border:1px solid var(--danger); color:var(--danger); font-family:var(--mono); font-size:12px; font-weight:600; margin-bottom:16px;';
    fb.textContent = '✗ No fue posible registrar el directivo. Intenta de nuevo.';
    submitBtn.disabled = false;
    submitBtn.textContent = 'Registrar Directivo';
  }
};

// ============================================================
// EVENT LISTENERS
// ============================================================
document.addEventListener('DOMContentLoaded', () => {
  const rectorOverlay = document.getElementById('rector-modal-overlay');
  if (rectorOverlay) {
    rectorOverlay.addEventListener('click', e => {
      if (e.target === e.currentTarget) window.closeRectorModal();
    });
  }

  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (document.getElementById('rector-modal-overlay')?.style.display === 'flex') {
      window.closeRectorModal();
    }
    if (document.getElementById('password-ticket-modal-overlay')?.style.display === 'flex') {
      window.closePasswordTicketModal();
    }
  });

  // Selector de Avatar / Foto
  const btnUploadAvatar = document.getElementById('rector-btn-upload-avatar');
  const avatarFileInput = document.getElementById('rector-avatar-file-input');
  const btnRemoveAvatar = document.getElementById('rector-btn-remove-avatar');
  const avatarPreviewImg = document.getElementById('rector-avatar-preview-img');
  const avatarPlaceholder = document.getElementById('rector-avatar-placeholder');
  const avatarUrlHidden = document.getElementById('rector-avatar-url');

  if (btnUploadAvatar && avatarFileInput) {
    btnUploadAvatar.addEventListener('click', () => avatarFileInput.click());

    avatarFileInput.addEventListener('change', (e) => {
      const file = e.target.files?.[0];
      if (!file) return;

      if (file.size > 4 * 1024 * 1024) {
        alert('La fotografía no puede exceder 4MB.');
        return;
      }

      window._selectedRectorAvatarFile = file;
      const objectUrl = URL.createObjectURL(file);
      if (avatarPreviewImg) {
        avatarPreviewImg.src = objectUrl;
        avatarPreviewImg.style.display = 'block';
      }
      if (avatarPlaceholder) avatarPlaceholder.style.display = 'none';
      if (btnRemoveAvatar) btnRemoveAvatar.style.display = 'inline-block';
    });
  }

  if (btnRemoveAvatar) {
    btnRemoveAvatar.addEventListener('click', () => {
      window._selectedRectorAvatarFile = null;
      if (avatarFileInput) avatarFileInput.value = '';
      if (avatarUrlHidden) avatarUrlHidden.value = '';
      if (avatarPreviewImg) {
        avatarPreviewImg.src = '';
        avatarPreviewImg.style.display = 'none';
      }
      if (avatarPlaceholder) avatarPlaceholder.style.display = 'block';
      btnRemoveAvatar.style.display = 'none';
    });
  }

  // Generador de clave segura para Rector
  const btnGenPass = document.getElementById('rector-btn-generate-pass');
  if (btnGenPass) {
    btnGenPass.addEventListener('click', () => {
      const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%^&*';
      let pass = 'Rector';
      for (let i = 0; i < 6; i++) pass += chars.charAt(Math.floor(Math.random() * chars.length));
      pass += '!2026';
      document.getElementById('rector-password').value = pass;
    });
  }

  // Form submit
  const rectorForm = document.getElementById('rector-form');
  if (rectorForm) {
    rectorForm.addEventListener('submit', async e => {
      e.preventDefault();
      await window.saveRector();
    });
  }

  const passwordTicketOverlay = document.getElementById('password-ticket-modal-overlay');
  if (passwordTicketOverlay) {
    passwordTicketOverlay.addEventListener('click', e => {
      if (e.target === e.currentTarget) window.closePasswordTicketModal();
    });
  }

  const passwordTicketForm = document.getElementById('password-ticket-form');
  if (passwordTicketForm) {
    passwordTicketForm.addEventListener('submit', async e => {
      e.preventDefault();

      const submitBtn = document.getElementById('password-ticket-submit-btn');
      const fb = document.getElementById('password-ticket-feedback');
      const targetUserId = document.getElementById('password-ticket-user-id').value;
      const reason = document.getElementById('password-ticket-reason').value.trim();
      const resetMethod = document.getElementById('password-ticket-method').value;
      const requiresSecondApproval = document.getElementById('password-ticket-second-approval').checked;

      if (!targetUserId || !reason) {
        fb.style.cssText = 'display:block; padding:10px 14px; background:#FEE2E2; border:1px solid var(--danger); color:var(--danger); font-family:var(--mono); font-size:12px; font-weight:600;';
        fb.textContent = 'Escribe el motivo del cambio para dejar la auditoría completa.';
        return;
      }

      try {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Creando ticket...';
        fb.style.display = 'none';

        await window.passwordResetTicketService.createSuperAdminTicket({
          targetUserId,
          reason,
          resetMethod,
          requiresSecondApproval,
        });

        fb.style.cssText = 'display:block; padding:10px 14px; background:#E6F4EA; border:1px solid var(--sage-dark); color:var(--sage-dark); font-family:var(--mono); font-size:12px; font-weight:600;';
        fb.textContent = 'Ticket creado correctamente. El cambio efectivo se ejecuta desde el flujo seguro de servidor.';
        submitBtn.textContent = 'Ticket creado';

        setTimeout(() => {
          window.closePasswordTicketModal();
          window.location.reload();
        }, 1000);
      } catch (err) {
        console.error('Error creando ticket de contraseña:', err);
        fb.style.cssText = 'display:block; padding:10px 14px; background:#FEE2E2; border:1px solid var(--danger); color:var(--danger); font-family:var(--mono); font-size:12px; font-weight:600;';
        fb.textContent = 'No fue posible crear el ticket. Verifica que estés como Super Admin y que la migración 06 esté aplicada.';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Crear Ticket';
      }
    });
  }

  // Filtros de búsqueda
  const searchInput = document.getElementById('user-search');
  const roleFilter = document.getElementById('user-role-filter');
  const statusFilter = document.getElementById('user-status-filter');

  function applyFilters() {
    const search = (searchInput?.value || '').toLowerCase().trim();
    const role = roleFilter?.value || '';
    const status = statusFilter?.value || '';

    document.querySelectorAll('.user-row').forEach(row => {
      const user = window.USERS.find(u => u.id === row.dataset.id);
      if (!user) return;

      const matchSearch = !search ||
        user.name.toLowerCase().includes(search) ||
        user.email.toLowerCase().includes(search) ||
        (user.schoolName || '').toLowerCase().includes(search);
      const matchRole = !role || user.role === role;
      const matchStatus = !status || (user.status || 'active') === status;

      row.style.display = (matchSearch && matchRole && matchStatus) ? '' : 'none';
    });
  }

  if (searchInput) searchInput.addEventListener('input', applyFilters);
  if (roleFilter) roleFilter.addEventListener('change', applyFilters);
  if (statusFilter) statusFilter.addEventListener('change', applyFilters);
});
</script>
