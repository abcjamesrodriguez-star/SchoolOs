---
// ============================================================
// SchoolOS — Registro de Auditoría (/es/app/super-admin/audit-log)
// ============================================================
import AppLayout from '../../../../layouts/AppLayout.astro';
import { auditService } from '../../../../services/auditService';

const lang = 'es';
let logs: any[] = [];
try {
  logs = await auditService.getRecentLogs(20);
} catch (e) {
  console.error('Error fetching audit logs:', e);
}
---

<AppLayout
  title="Registro de Auditoría"
  pageTitle="Auditoría e Integridad del Sistema"
  activeSection="audit-log"
  lang={lang}
  activeRoute="/app/super-admin/audit-log"
  breadcrumbs={[{ label: 'Cumplimiento' }, { label: 'Auditoría' }]}
>
  <!-- TOP INTEGRITY BANNER -->
  <div style="background:var(--ink); color:#FFFFFF; padding:18px 24px; border:1px solid var(--ink); margin-bottom:24px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
    <div style="display:flex; align-items:center; gap:12px;">
      <span style="width:8px; height:8px; border-radius:50%; background:#4ADE80; box-shadow:0 0 8px #4ADE80;"></span>
      <div>
        <div style="font-family:var(--mono); font-size:12px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase;">
          REGISTRO INMUTABLE Y CRIPTOGRÁFICAMENTE SELLADO (SHA-256)
        </div>
        <div style="font-family:var(--mono); font-size:10.5px; color:#A8A28E; margin-top:2px;">
          Cada modificación sobre escuelas, permisos, cuotas y expedientes judiciales queda registrada permanentemente.
        </div>
      </div>
    </div>
    <div style="font-family:var(--mono); font-size:11px; background:#24211A; padding:6px 12px; border:1px solid #383428;">
      HASH CHECK: <span style="color:var(--orange-vibrant);">VERIFICADO OK</span>
    </div>
  </div>

  <div class="panel">
    <div class="table-toolbar">
      <div class="filter-row" style="align-items:center;">
        <input type="text" placeholder="Filtrar por acción, actor o entidad..." style="border:1px solid var(--ink); background:var(--cream); padding:7px 12px; font-family:var(--sans); font-size:12.5px; width:280px; border-radius:2px;" />
        <select class="filter-select" style="border:1px solid var(--ink);">
          <option>Todos los tipos de evento</option>
          <option>Escuelas</option>
          <option>Acceso Judicial</option>
          <option>Usuarios</option>
        </select>
      </div>
      <button class="btn btn-secondary btn-sm" onclick="alert('Mock: Descargando reporte de auditoría firmado');">Exportar Registro CSV</button>
    </div>

    <div class="panel-body">
      <table class="data-table">
        <thead>
          <tr>
            <th>Evento / Código de Acción</th>
            <th>Entidad Objetivo</th>
            <th>Tipo de Registro</th>
            <th>Actor / Operador</th>
            <th>Estampa de Tiempo</th>
          </tr>
        </thead>
        <tbody>
          {logs.map((log) => (
            <tr>
              <td style="font-family:var(--mono); font-size:12px; font-weight:700; color:var(--ink);">
                <span style="display:inline-block; width:6px; height:6px; border-radius:50%; background:var(--orange-vibrant); margin-right:8px;"></span>
                {log.action}
              </td>
              <td class="cell-name">{log.targetName}</td>
              <td><span class="plan-tag" style="font-size:10px;">{log.targetType}</span></td>
              <td class="cell-muted" style="font-family:var(--mono);">{log.actorEmail}</td>
              <td class="cell-muted" style="font-family:var(--mono); font-weight:600; color:var(--ink);">{log.timestamp}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AppLayout>

