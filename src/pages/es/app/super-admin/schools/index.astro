<!-- MODAL: REGISTRO / GESTIÓN DE RECTOR (DISTRIBUCIÓN NATURAL)  -->
<!-- ============================================================ -->
<div
  id="rector-modal-overlay"
  style="display:none; position:fixed; inset:0; background:rgba(18,17,14,0.75); z-index:1200; align-items:center; justify-content:center; padding:20px;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="rector-modal-title"
>
  <div
    id="rector-modal-panel"
    style="
      background:var(--paper);
      border:2px solid var(--ink);
      width:min(760px, 95vw);
      max-height:90vh;
      overflow-y:auto;
      display:flex;
      flex-direction:column;
      opacity:0;
      transform:scale(0.97);
      transition:opacity 0.2s ease, transform 0.2s ease;
      box-shadow:8px 8px 0 var(--ink);
    "
  >
    <!-- RECTOR HEADER -->
    <div style="border-bottom:2px solid var(--ink); padding:16px 24px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; background:var(--cream); z-index:2;">
      <div>
        <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:2px;">Directorio Institucional</div>
        <h2 id="rector-modal-title" style="font-family:var(--serif); font-size:19px; font-weight:700; color:var(--ink); margin:0;">Registro de Rector / Directivo</h2>
      </div>
      <button
        id="rector-modal-close-btn"
        type="button"
        onclick="window.closeRectorModal && window.closeRectorModal()"
        style="width:32px; height:32px; border:2px solid var(--ink); background:var(--paper); cursor:pointer; font-size:16px; font-weight:700; display:flex; align-items:center; justify-content:center; color:var(--ink); box-shadow:2px 2px 0 var(--ink);"
        aria-label="Cerrar modal de rector"
      >✕</button>
    </div>

    <!-- FORM -->
    <form id="rector-form" style="padding:22px 24px; display:flex; flex-direction:column; gap:16px; background:var(--paper);">
      <input type="hidden" id="rector-id" />
      <input type="hidden" id="rector-avatar-url" />

      <!-- PASO 1: IDENTIFICACIÓN Y FOTO INTEGRADA -->
      <div style="background:var(--cream); border:1.5px solid var(--ink); padding:16px; box-shadow:3px 3px 0 var(--ink);">
        <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink); font-weight:800; margin-bottom:12px; padding-bottom:4px; border-bottom:1px solid var(--line);">
          01 · Identificación Personal & Foto
        </div>

        <div style="display:grid; grid-template-columns:110px 1fr; gap:16px; align-items:start;">
          <!-- Foto integrada a la izquierda -->
          <div style="display:flex; flex-direction:column; align-items:center; gap:6px;">
            <div id="rector-avatar-preview-box" style="width:90px; height:90px; border:2px solid var(--ink); background:#FFFFFF; display:flex; align-items:center; justify-content:center; overflow:hidden; box-shadow:2px 2px 0 var(--ink);">
              <img id="rector-avatar-preview-img" src="" alt="Foto Directivo" style="width:100%; height:100%; object-fit:cover; display:none;" />
              <div id="rector-avatar-placeholder" style="font-family:var(--mono); font-size:9.5px; color:var(--ink-soft); font-weight:700; text-align:center;">FOTO</div>
            </div>
            <input type="file" id="rector-avatar-file-input" accept="image/png,image/jpeg,image/webp" style="display:none;" />
            <button type="button" id="rector-btn-upload-avatar" class="btn btn-secondary btn-sm" style="font-size:9.5px; width:100%; padding:4px; font-weight:700;">
              Subir Foto
            </button>
            <button type="button" id="rector-btn-remove-avatar" style="background:none; border:none; color:var(--danger); font-size:9.5px; font-family:var(--mono); cursor:pointer; display:none;">
              ✕ Quitar
            </button>
          </div>

          <!-- Campos alineados en Grid 2x2 a la derecha -->
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
            <div style="display:flex; flex-direction:column; gap:4px; grid-column:span 2;">
              <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink);">Nombre Completo del Directivo *</label>
              <input id="rector-name" type="text" placeholder="ej. Coach Mike Johnson" required style="border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--sans); font-size:13.5px;" />
            </div>

            <div style="display:flex; flex-direction:column; gap:4px; grid-column:span 2;">
              <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink);">Correo Institucional de Acceso *</label>
              <input id="rector-email" type="email" placeholder="rectoria@colegio.edu.co" required style="border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--mono); font-size:13px;" />
            </div>

            <div style="display:flex; flex-direction:column; gap:4px;">
              <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink);">Teléfono / WhatsApp</label>
              <input id="rector-phone" type="tel" placeholder="ej. +57 300 123 4567" style="border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--sans); font-size:13px;" />
            </div>

            <div style="display:flex; flex-direction:column; gap:4px;">
              <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink);">Documento de Identidad</label>
              <div style="display:flex; gap:6px;">
                <select id="rector-doc-type" style="width:70px; border:1.5px solid var(--ink); background:var(--paper); padding:8px 4px; font-family:var(--mono); font-size:11px; font-weight:700;">
                  <option value="CC">CC</option>
                  <option value="CE">CE</option>
                  <option value="PA">PA</option>
                  <option value="PEP">PEP</option>
                </select>
                <input id="rector-doc-id" type="text" placeholder="1.045.890.123" style="flex:1; border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--mono); font-size:12.5px;" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- PASO 2: VINCULACIÓN INSTITUCIONAL & CARGO -->
      <div style="background:var(--cream); border:1.5px solid var(--ink); padding:16px; box-shadow:3px 3px 0 var(--ink);">
        <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink); font-weight:800; margin-bottom:12px; padding-bottom:4px; border-bottom:1px solid var(--line);">
          02 · Asignación de Sede & Cargo
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
          <div style="display:flex; flex-direction:column; gap:4px; grid-column:span 2;">
            <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink);">Institución Educativa Asignada *</label>
            <select id="rector-school-id" required style="border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--sans); font-size:13.5px; font-weight:700;"></select>
          </div>

          <div style="display:flex; flex-direction:column; gap:4px;">
            <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink);">Cargo Oficial</label>
            <select id="rector-job-title" style="border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--sans); font-size:12.5px;">
              <option value="Rector General">Rector General</option>
              <option value="Director Académico">Director Académico</option>
              <option value="Vicerrector">Vicerrector</option>
              <option value="Director Ejecutivo">Director Ejecutivo</option>
              <option value="Coordinador General">Coordinador General</option>
            </select>
          </div>

          <div style="display:flex; flex-direction:column; gap:4px;">
            <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink);">Especialidad / Área Directiva</label>
            <input id="rector-specialty" type="text" placeholder="ej. Gestión Curricular o Dirección General" style="border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--sans); font-size:12.5px;" />
          </div>

          <div style="display:flex; flex-direction:column; gap:4px;">
            <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink);">Fecha de Nombramiento / Posesión</label>
            <input id="rector-appointment-date" type="date" style="border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--mono); font-size:12px;" />
          </div>

          <div id="rector-status-container" style="display:flex; flex-direction:column; gap:4px;">
            <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink);">Estado de la Cuenta</label>
            <select id="rector-status" style="border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--mono); font-size:12px;">
              <option value="active">Activa (Acceso Habilitado)</option>
              <option value="suspended">Suspendida Preventivamente</option>
              <option value="invited">Invitación Pendiente (Esperando JWT)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- PASO 3: INFORMACIÓN DE SEGURIDAD & ACTIVACIÓN JWT -->
      <div id="rector-jwt-info-block" style="background:var(--cream); border:1.5px solid var(--ink); padding:14px 16px; box-shadow:3px 3px 0 var(--ink);">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
          <span style="font-size:16px;">✉️</span>
          <span style="font-family:var(--mono); font-size:11px; font-weight:800; text-transform:uppercase; color:var(--ink);">Activación Segura Obligatoria (JWT)</span>
        </div>
        <p style="font-size:12px; color:var(--ink-soft); line-height:1.45; margin:0;">
          Al registrar al directivo se despachará automáticamente un <strong>correo institucional con token JWT de 24 horas</strong>. El directivo ingresará a la plataforma, confirmará su <strong>cédula</strong> y <strong>teléfono</strong> registrados, y creará su propia contraseña personal.
        </p>
      </div>

      <!-- FEEDBACK -->
      <div id="rector-feedback" style="display:none; padding:10px 14px; font-family:var(--mono); font-size:12px; font-weight:600;"></div>

      <!-- FORM ACTIONS -->
      <div style="display:flex; gap:10px; justify-content:space-between; align-items:center; padding-top:8px;">
        <button id="rector-delete-btn" type="button" class="btn btn-danger btn-sm" style="display:none;" onclick="window.deleteCurrentRector && window.deleteCurrentRector()">
          🗑 Eliminar Directivo
        </button>
        <div style="display:flex; gap:10px; margin-left:auto;">
          <button id="rector-cancel-btn" type="button" class="btn btn-secondary" onclick="window.closeRectorModal && window.closeRectorModal()">Cancelar</button>
          <button id="rector-submit-btn" type="submit" class="btn btn-primary">Registrar y Enviar Invitación →</button>
        </div>
      </div>
    </form>
  </div>
</div>

<script define:vars={{ schoolsJson, usersJson }}>
// ============================================================
// DATOS EN CLIENTE
// ============================================================
window.SCHOOLS = JSON.parse(schoolsJson || '[]');
window.USERS = JSON.parse(usersJson || '[]');
window._currentSchoolId = null;
window._selectedLogoFile = null;
window._selectedRectorAvatarFile = null;

// Helpers globales
function statusLabel(s) {
  const map = { active: 'Activa', trial: 'En Prueba', suspended: 'Suspendida', cancelled: 'Cancelada', pending: 'Pendiente' };
  return map[s] || s;
}
function statusColor(s) {
  const map = { active: 'var(--sage-dark)', trial: 'var(--orange-vibrant)', suspended: 'var(--danger)', cancelled: 'var(--ink-soft)', pending: 'var(--stone-accent)' };
  return map[s] || 'var(--ink)';
}
function auditLabel(a) {
  const map = { under_investigation: 'Bajo investigación', flagged: 'Marcado', none: 'Sin flags' };
  return map[a] || a;
}
function fmtDate(d) {
  if (!d) return '—';
  const parsed = new Date(d);
  if (isNaN(parsed.getTime())) return d;
  return parsed.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' });
}

function cleanInfoRow(label, value) {
  return `
    <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px; padding:7px 0; border-bottom:1px solid var(--line);">
      <span style="font-family:var(--mono); font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--ink-soft); flex-shrink:0;">${label}</span>
      <span style="font-size:12.5px; font-weight:700; color:var(--ink); text-align:right; word-break:break-word;">${value || '—'}</span>
    </div>
  `;
}

function statItem(num, label, value, color) {
  return `
    <div style="padding:12px 16px; border-right:1px solid var(--ink); display:flex; flex-direction:column; justify-content:center;">
      <div style="font-family:var(--mono); font-size:9px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">${num} · ${label}</div>
      <div style="font-family:var(--serif); font-size:22px; font-weight:700; color:${color || 'var(--ink)'}; margin-top:2px; line-height:1.1; word-break:break-all;">${value}</div>
    </div>
  `;
}

// ============================================================
// MODAL FICHA INSTITUCIONAL
// ============================================================
window.openModal = function(schoolId) {
  window._currentSchoolId = schoolId;
  const school = window.SCHOOLS.find(s => s.id === schoolId);
  if (!school) return;

  // 1. Logo de la escuela
  const logoCont = document.getElementById('modal-logo-container');
  const initials = school.name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
  if (school.logoUrl) {
    logoCont.innerHTML = `<img src="${school.logoUrl}" alt="${school.name}" style="max-width:100%; max-height:100%; object-fit:contain;"/>`;
  } else {
    const bg = school.brandColor || 'var(--ink)';
    logoCont.innerHTML = `<div style="width:100%; height:100%; background:${bg}; color:#FFFFFF; font-family:var(--mono); font-size:20px; font-weight:800; display:flex; align-items:center; justify-content:center;">${initials}</div>`;
  }

  // 2. Título y lema
  document.getElementById('modal-school-name').textContent = school.name;
  const sloganEl = document.getElementById('modal-school-slogan');
  sloganEl.textContent = school.slogan ? `«${school.slogan}»` : '';
  sloganEl.style.display = school.slogan ? 'block' : 'none';

  // 3. Badges en cabecera
  document.getElementById('modal-header-badges').innerHTML = `
    <span style="background:${statusColor(school.status)}; color:#FFF; font-family:var(--mono); font-size:10px; font-weight:700; padding:4px 8px; letter-spacing:0.06em; text-transform:uppercase; box-shadow:1px 1px 0 var(--ink);">ESTADO: ${statusLabel(school.status)}</span>
    <span style="background:var(--ink); color:#FFF; font-family:var(--mono); font-size:10px; font-weight:700; padding:4px 8px; letter-spacing:0.06em; text-transform:uppercase; box-shadow:1px 1px 0 var(--ink);">PLAN: ${school.planName}</span>
  `;

  // 4. Franja de 4 KPIs
  document.getElementById('modal-stats-grid').innerHTML =
    statItem('01', 'Estudiantes', (school.studentCount || 0).toLocaleString(), 'var(--sage-dark)') +
    statItem('02', 'Docentes', (school.teacherCount || 0).toLocaleString(), 'var(--stone-dark)') +
    statItem('03', 'Clases Activas', (school.activeClassesCount || 0).toLocaleString(), 'var(--orange-vibrant)') +
    statItem('04', 'Dominio Web', `<span style="font-family:var(--mono); font-size:13px; color:var(--rust);">${school.domain || `${school.slug}.schoolos.com`}</span>`);

  // 5. Datos de Sede & Tenancy en 2 Columnas Integrales
  let locStr = school.location || school.country || 'No registrada';
  if (school.country && school.location && !school.location.toLowerCase().includes(school.country.toLowerCase())) {
    locStr += ` · ${school.country}`;
  }
  const planLimits = school.planName === 'Starter' ? 'Hasta 200 alumnos' : school.planName === 'Enterprise' ? 'Alumnos ilimitados' : 'Hasta 1,500 alumnos';

  // Columna Izquierda: Ubicación y Contacto
  document.getElementById('modal-col-left').innerHTML =
    cleanInfoRow('Ciudad & País', locStr) +
    cleanInfoRow('Dirección Sede', school.address || 'Sin dirección registrada') +
    cleanInfoRow('Correo Institucional', school.contactEmail || 'Sin registrar') +
    cleanInfoRow('Teléfono / PBX', school.phone || 'Sin registrar');

  // Columna Derecha: Parámetros del Tenant & Gobernanza
  document.getElementById('modal-col-right').innerHTML =
    cleanInfoRow('Dominio Oficial', `<a href="https://${school.domain || `${school.slug}.schoolos.com`}" target="_blank" style="color:var(--rust); text-decoration:none; font-family:var(--mono);">${school.domain || `${school.slug}.schoolos.com`} ↗</a>`) +
    cleanInfoRow('Plan & Capacidad', `<span class="plan-tag" style="font-weight:700;">${school.planName}</span> · <span style="font-size:11px; color:var(--ink-soft);">${planLimits}</span>`) +
    cleanInfoRow('Color de Marca', `<div style="display:flex; align-items:center; gap:6px; justify-content:flex-end;"><span style="display:inline-block; width:13px; height:13px; background:${school.brandColor || '#12110E'}; border:1px solid var(--ink);"></span> <span style="font-family:var(--mono); font-size:11px;">${school.brandColor || '#12110E'}</span></div>`) +
    cleanInfoRow('Fecha de Alta', fmtDate(school.createdAt)) +
    cleanInfoRow('Auditoría Forense', auditLabel(school.auditStatus));

  // 6. Sección Superior: Rectoría & Directivos (Componente Reactivo conectado a la API)
  const rectorContent = document.getElementById('modal-rector-content');
  const manageRectorBtn = document.getElementById('modal-manage-rector-btn');
  manageRectorBtn.textContent = '+ Agregar Directivo';
  manageRectorBtn.onclick = () => window.openRectorModal(null, schoolId);

  const sortTenantDirectivos = (userList) => {
    return [...userList].sort((a, b) => {
      const aEmail = (a.email || '').toLowerCase();
      const bEmail = (b.email || '').toLowerCase();
      const sRectorEmail = (school.rectorEmail || school.rector_email || '').toLowerCase();

      const aJob = (a.job_title || a.jobTitle || '').toLowerCase();
      const bJob = (b.job_title || b.jobTitle || '').toLowerCase();
      const aSpec = (a.specialty || '').toLowerCase();
      const bSpec = (b.specialty || '').toLowerCase();

      const aIsPrincipal = (sRectorEmail && aEmail === sRectorEmail) || 
                           aSpec.includes('principal') ||
                           aJob.includes('rector general') ||
                           aJob.includes('rector');
      const bIsPrincipal = (sRectorEmail && bEmail === sRectorEmail) || 
                           bSpec.includes('principal') ||
                           bJob.includes('rector general') ||
                           bJob.includes('rector');

      if (aIsPrincipal && !bIsPrincipal) return -1;
      if (!aIsPrincipal && bIsPrincipal) return 1;
      return 0;
    });
  };

  const renderRectorCardComponent = (rectorUser, idx, total) => {
    const isEspera = rectorUser.status === 'invited' || rectorUser.status === 'pending';
    const avatarUrl = rectorUser.avatar_url || rectorUser.avatarUrl;
    const name = rectorUser.name || 'Directivo';
    const initials = name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase() || 'DR';
    const job = rectorUser.job_title || rectorUser.jobTitle || 'Rector General';
    const spec = (rectorUser.specialty && rectorUser.specialty !== 'DirectorGeneral' && rectorUser.specialty !== 'Rector Principal') ? ` · ${rectorUser.specialty}` : '';
    const phone = rectorUser.phone || 'Sin registrar';
    const docType = rectorUser.document_type || rectorUser.documentType || 'CC';
    const docId = rectorUser.document_id || rectorUser.documentId || '—';

    const uEmail = (rectorUser.email || '').toLowerCase();
    const sRectorEmail = (school.rectorEmail || school.rector_email || '').toLowerCase();
    const isPrincipal = (sRectorEmail && uEmail === sRectorEmail) ||
                        ((rectorUser.specialty || '').toLowerCase().includes('principal')) ||
                        (idx === 0);

    const principalBadge = isPrincipal
      ? '<span style="background:var(--ink); color:#FFF; font-family:var(--mono); font-size:9.5px; font-weight:800; padding:2px 6px; letter-spacing:0.04em; text-transform:uppercase;">RECTOR PRINCIPAL</span>'
      : '<span style="background:var(--cream-dark); color:var(--ink); border:1px solid var(--ink); font-family:var(--mono); font-size:9.5px; font-weight:700; padding:1px 5px; text-transform:uppercase;">EQUIPO DIRECTIVO</span>';

    const statusBadge = isEspera
      ? '<span class="badge badge-trial" style="font-size:10px;">En espera de activación</span>'
      : `<span class="badge badge-${rectorUser.status || 'active'}" style="font-size:10px;">${statusLabel(rectorUser.status || 'active')}</span>`;

    const borderStyle = (total > 1 && idx < total - 1) ? 'border-bottom: 1.5px dashed var(--stone); padding-bottom: 12px; margin-bottom: 12px;' : 'padding: 4px 0;';

    return `
    <div style="display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; ${borderStyle}">
      <div style="display:flex; align-items:center; gap:12px; min-width:0; flex:1;">
        <div style="width:48px; height:48px; border:1.5px solid var(--ink); background:#FFFFFF; display:flex; align-items:center; justify-content:center; flex-shrink:0; overflow:hidden; box-shadow:1.5px 1.5px 0 var(--ink);">
          ${avatarUrl
            ? `<img src="${avatarUrl}" alt="${name}" style="width:100%; height:100%; object-fit:cover;" onerror="this.style.display='none'; this.parentElement.innerHTML='<span style=\\'font-family:var(--mono); font-size:16px; font-weight:800; color:var(--ink);\\'>${initials}</span>';" />`
            : `<span style="font-family:var(--mono); font-size:16px; font-weight:800; color:var(--ink);">${initials}</span>`}
        </div>
        <div style="min-width:0; flex:1;">
          <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
            <span style="font-size:15px; font-weight:700; color:var(--ink);">${name}</span>
            ${principalBadge}
            ${statusBadge}
            <span style="font-family:var(--mono); font-size:11px; font-weight:700; color:var(--sage-dark);">· ${job}${spec}</span>
          </div>
          <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-top:3px; display:flex; gap:14px; flex-wrap:wrap;">
            <span>Correo: <strong style="color:var(--rust);">${rectorUser.email}</strong></span>
            <span>Teléfono: <strong>${phone}</strong></span>
            <span>Documento: <strong>${docType} ${docId}</strong></span>
          </div>
        </div>
      </div>

      <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap; flex-shrink:0;">
        ${isEspera ? `
          <button type="button" class="btn btn-secondary btn-sm" style="font-size:10px; padding:4px 9px; font-weight:700;" onclick="window.resendConfirmationEmail('${rectorUser.id}', '${rectorUser.email}', '${schoolId}', event)">✉ Reenviar Correo</button>
          <button type="button" class="btn btn-secondary btn-sm" style="font-size:10px; padding:4px 9px; font-weight:700;" onclick="window.copyConfirmationLink('${rectorUser.id}', '${rectorUser.email}', '${schoolId}', event)">🔗 Copiar Link</button>
          <button type="button" class="btn btn-primary btn-sm" style="font-size:10px; padding:4px 10px; background:var(--sage-dark); border-color:var(--sage-dark);" onclick="window.quickActivateRector('${rectorUser.id}', '${schoolId}', event)">Activar Acceso</button>
        ` : ''}
        <button type="button" class="btn btn-secondary btn-sm" style="font-size:10.5px; padding:4px 10px; font-weight:700;" onclick="window.openRectorModal('${rectorUser.id}', '${schoolId}')">Editar Directivo →</button>
        <button type="button" class="btn btn-danger btn-sm" style="font-size:10.5px; padding:4px 8px;" onclick="window.deleteRectorDirectly('${rectorUser.id}', '${rectorUser.email}', '${schoolId}', event)" title="Eliminar directivo definitivamente">🗑 Borrar</button>
      </div>
    </div>`;
  };

  // 1. Render inmediato desde caché local si existe
  const localRectorUsers = window.USERS.filter(u => 
    u.role === 'school_admin' && (
      u.schoolId === school.id ||
      u.schoolId === school.slug ||
      u.schoolId === schoolId ||
      (school.rectorEmail && u.email && u.email.toLowerCase() === school.rectorEmail.toLowerCase())
    )
  );

  if (localRectorUsers.length > 0) {
    const sortedLocal = sortTenantDirectivos(localRectorUsers);
    rectorContent.innerHTML = sortedLocal.map((u, i) => renderRectorCardComponent(u, i, sortedLocal.length)).join('');
  } else if (school.rectorName || school.rectorEmail) {
    manageRectorBtn.textContent = '+ Vincular Cuenta';
    manageRectorBtn.onclick = () => window.openRectorModal(null, schoolId, { name: school.rectorName, email: school.rectorEmail });
    rectorContent.innerHTML = `
      <div style="display:flex; align-items:center; justify-content:space-between; gap:16px; padding:4px 0;">
        <div>
          <div style="font-size:14.5px; font-weight:700; color:var(--ink);">${school.rectorName || 'Rector Registrado'}</div>
          <div style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft); margin-top:2px;">Correo de acceso sugerido: <strong style="color:var(--rust);">${school.rectorEmail || 'Sin correo'}</strong></div>
        </div>
        <button type="button" class="btn btn-primary btn-sm" onclick="window.openRectorModal(null, '${schoolId}', { name: '${school.rectorName || ''}', email: '${school.rectorEmail || ''}' })" style="font-size:11px; padding:6px 12px; flex-shrink:0;">
          Crear Credenciales de Acceso →
        </button>
      </div>
    `;
  } else {
    manageRectorBtn.textContent = '+ Asignar Rector';
    manageRectorBtn.onclick = () => window.openRectorModal(null, schoolId);
    rectorContent.innerHTML = `
      <div style="display:flex; align-items:center; justify-content:space-between; gap:16px; padding:4px 0;">
        <div>
          <div style="font-family:var(--mono); font-size:11.5px; font-weight:800; text-transform:uppercase; color:var(--ink);">Sin Rector Asignado</div>
          <div style="font-size:12px; color:var(--ink-soft); margin-top:2px;">Esta institución aún no tiene un directivo con credenciales creadas en la plataforma.</div>
        </div>
        <button type="button" class="btn btn-primary btn-sm" onclick="window.openRectorModal(null, '${schoolId}')" style="font-size:11px; padding:6px 14px; flex-shrink:0;">
          + Crear y Vincular Rector
        </button>
      </div>
    `;
  }

  // 2. Fetch directo en vivo a la tabla de usuarios de Supabase usando el endpoint REST
  window.fetchAuth('/api/admin/rector?schoolId=' + schoolId).then(res => res.json()).then(json => {
    if (json.ok && Array.isArray(json.rectors)) {
      json.rectors.forEach((fetchedUser: any) => {
        const existingIdx = window.USERS.findIndex(u => u.id === fetchedUser.id);
        if (existingIdx >= 0) window.USERS[existingIdx] = fetchedUser;
        else window.USERS.push(fetchedUser);
      });
      const updatedLocal = sortTenantDirectivos(window.USERS.filter(u => u.role === 'school_admin' && (u.school_id === schoolId || u.schoolId === schoolId)));
      rectorContent.innerHTML = updatedLocal.map((u, i) => renderRectorCardComponent(u, i, updatedLocal.length)).join('');
      if (updatedLocal.length > 0) { manageRectorBtn.textContent = '+ Registrar Otro Directivo'; manageRectorBtn.onclick = () => window.openRectorModal(null, schoolId); }
    }
  });

  // 7. Botón suspender / reactivar en el footer
  const suspendBtn = document.getElementById('modal-suspend-btn');
  if (suspendBtn) {
    const isSusp = school.status === 'suspended';
    suspendBtn.textContent = isSusp ? 'Reactivar Institución' : 'Suspender';
    suspendBtn.className = isSusp ? 'btn btn-secondary btn-sm' : 'btn btn-danger btn-sm';
  }

  const overlay = document.getElementById('school-modal-overlay');
  const panel   = document.getElementById('school-modal-panel');
  overlay.style.display = 'flex';
  panel.getBoundingClientRect();
  panel.style.opacity   = '1';
  panel.style.transform = 'scale(1)';
  document.getElementById('modal-close-btn').focus();
  document.body.style.overflow = 'hidden';
};

window.closeModal = function() {
  const overlay = document.getElementById('school-modal-overlay');
  const panel   = document.getElementById('school-modal-panel');
  if (!panel) return;
  panel.style.opacity   = '0';
  panel.style.transform = 'scale(0.97)';
  setTimeout(() => {
    if (overlay) overlay.style.display = 'none';
    document.body.style.overflow = '';
  }, 200);
};

