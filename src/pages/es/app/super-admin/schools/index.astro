// MODAL FLOTANTE: REGISTRO & GESTIÓN DE RECTOR
// ============================================================
window.openRectorModal = function(rectorId, preselectedSchoolId, initialData) {
  window._selectedRectorAvatarFile = null;
  const schoolSelect = document.getElementById('rector-school-id');
  
  schoolSelect.innerHTML = window.SCHOOLS.map(s => 
    `<option value="${s.id}">${s.name} (${s.domain || s.slug})</option>`
  ).join('');

  const fb = document.getElementById('rector-feedback');
  fb.style.display = 'none';
  fb.textContent = '';

  const submitBtn = document.getElementById('rector-submit-btn');
  submitBtn.disabled = false;
  submitBtn.textContent = 'Guardar Rector en Supabase';

  const previewImg = document.getElementById('rector-avatar-preview-img');
  const placeholder = document.getElementById('rector-avatar-placeholder');
  const removeBtn = document.getElementById('rector-btn-remove-avatar');
  const fileInput = document.getElementById('rector-avatar-file-input');
  const statusContainer = document.getElementById('rector-status-container');
  const jwtInfoBlock = document.getElementById('rector-jwt-info-block');
  if (fileInput) fileInput.value = '';

  const rectorDeleteBtn = document.getElementById('rector-delete-btn');

  if (rectorId) {
    const user = window.USERS.find(u => u.id === rectorId);
    if (!user) return;

    document.getElementById('rector-id').value = user.id;
    document.getElementById('rector-modal-title').textContent = `Editar Directivo: ${user.name}`;
    document.getElementById('rector-name').value = user.name || '';
    document.getElementById('rector-email').value = user.email || '';
    document.getElementById('rector-phone').value = user.phone || '';
    document.getElementById('rector-doc-type').value = user.documentType || user.document_type || 'CC';
    document.getElementById('rector-doc-id').value = user.documentId || user.document_id || '';
    document.getElementById('rector-avatar-url').value = user.avatarUrl || user.avatar_url || '';
    document.getElementById('rector-job-title').value = user.jobTitle || user.job_title || 'Rector General';
    document.getElementById('rector-specialty').value = user.specialty || '';
    document.getElementById('rector-appointment-date').value = user.appointmentDate || user.appointment_date || new Date().toISOString().split('T')[0];
    document.getElementById('rector-status').value = user.status || 'active';
    
    // Mostrar selector de estado y botón de eliminar en edición
    if (statusContainer) statusContainer.style.display = 'flex';
    if (jwtInfoBlock) jwtInfoBlock.style.display = 'none';
    if (rectorDeleteBtn) rectorDeleteBtn.style.display = 'inline-block';
    document.getElementById('rector-submit-btn').textContent = 'Guardar Cambios';
    
    if (user.schoolId || user.school_id) schoolSelect.value = user.schoolId || user.school_id;
    else if (preselectedSchoolId) schoolSelect.value = preselectedSchoolId;

    const userAvatar = user.avatarUrl || user.avatar_url;
    if (userAvatar) {
      previewImg.src = userAvatar;
      previewImg.style.display = 'block';
      placeholder.style.display = 'none';
      removeBtn.style.display = 'inline-block';
    } else {
      previewImg.src = '';
      previewImg.style.display = 'none';
      placeholder.style.display = 'block';
      removeBtn.style.display = 'none';
    }
  } else {
    document.getElementById('rector-id').value = '';
    document.getElementById('rector-modal-title').textContent = 'Registro de Rector / Directivo';
    document.getElementById('rector-name').value = initialData?.name || '';
    document.getElementById('rector-email').value = initialData?.email || '';
    document.getElementById('rector-phone').value = '';
    document.getElementById('rector-doc-type').value = 'CC';
    document.getElementById('rector-doc-id').value = '';
    document.getElementById('rector-avatar-url').value = '';
    document.getElementById('rector-job-title').value = 'Rector General';
    document.getElementById('rector-specialty').value = '';
    document.getElementById('rector-appointment-date').value = new Date().toISOString().split('T')[0];
    document.getElementById('rector-status').value = 'invited';

    // Ocultar selector de estado y botón de eliminar en creación
    if (statusContainer) statusContainer.style.display = 'none';
    if (jwtInfoBlock) jwtInfoBlock.style.display = 'block';
    if (rectorDeleteBtn) rectorDeleteBtn.style.display = 'none';
    document.getElementById('rector-submit-btn').textContent = 'Registrar y Enviar Invitación JWT →';

    if (preselectedSchoolId) schoolSelect.value = preselectedSchoolId;

    previewImg.src = '';
    previewImg.style.display = 'none';
    placeholder.style.display = 'block';
    removeBtn.style.display = 'none';
  }

  const overlay = document.getElementById('rector-modal-overlay');
  const panel   = document.getElementById('rector-modal-panel');
  overlay.style.display = 'flex';
  panel.getBoundingClientRect();
  panel.style.opacity   = '1';
  panel.style.transform = 'scale(1)';
  document.getElementById('rector-name').focus();
};

window.closeRectorModal = function() {
  const overlay = document.getElementById('rector-modal-overlay');
  const panel   = document.getElementById('rector-modal-panel');
  if (!panel) return;
  panel.style.opacity   = '0';
  panel.style.transform = 'scale(0.96)';
  setTimeout(() => {
    if (overlay) overlay.style.display = 'none';
    document.body.style.overflow = '';
  }, 220);
};

window.saveRector = async function() {
  const submitBtn = document.getElementById('rector-submit-btn');
  const fb        = document.getElementById('rector-feedback');
  const rectorId  = document.getElementById('rector-id').value;

  submitBtn.disabled    = true;
  submitBtn.textContent = 'Guardando…';
  fb.style.display      = 'none';

  const schoolId        = document.getElementById('rector-school-id').value;
  const name            = document.getElementById('rector-name').value.trim();
  const email           = document.getElementById('rector-email').value.trim().toLowerCase();
  const docType         = document.getElementById('rector-doc-type').value;
  const docId           = document.getElementById('rector-doc-id').value.trim();
  const phone           = document.getElementById('rector-phone').value.trim();
  const jobTitle        = document.getElementById('rector-job-title').value;
  const specialty       = document.getElementById('rector-specialty').value.trim();
  const appointmentDate = document.getElementById('rector-appointment-date').value;
  // Todo nuevo rector siempre es 'invited'; en edición se respeta el valor elegido
  const status          = rectorId ? (document.getElementById('rector-status')?.value || 'active') : 'invited';

  if (!name || !email) {
    fb.style.cssText = 'display:block; padding:10px 14px; background:#FEE2E2; border:1px solid var(--danger); color:var(--danger); font-family:var(--mono); font-size:12px; font-weight:600; margin-bottom:16px;';
    fb.textContent = 'Por favor completa el nombre y correo del directivo.';
    submitBtn.disabled = false;
    submitBtn.textContent = rectorId ? 'Guardar Cambios' : 'Registrar y Enviar Invitación JWT →';
    return;
  }

  if (!rectorId && (!docId || !phone)) {
    fb.style.cssText = 'display:block; padding:10px 14px; background:#FEE2E2; border:1px solid var(--danger); color:var(--danger); font-family:var(--mono); font-size:12px; font-weight:600; margin-bottom:16px;';
    fb.textContent = 'Para la activación segura JWT es obligatorio ingresar el Documento de Identidad y el Teléfono registrado.';
    submitBtn.disabled = false;
    submitBtn.textContent = 'Registrar y Enviar Invitación JWT →';
    return;
  }

  try {
    let avatarUrl = document.getElementById('rector-avatar-url').value.trim() || null;

    if (window._selectedRectorAvatarFile) {
      submitBtn.textContent = 'Subiendo foto…';
      const file = window._selectedRectorAvatarFile;
      
      const fd = new FormData();
      fd.append('file', file);
      fd.append('type', 'avatar');
      fd.append('slug', 'rector-' + Date.now());
      
      const uploadRes = await window.fetchAuth('/api/admin/upload-asset', { method: 'POST', body: fd });
      const uploadData = await uploadRes.json();
      if (uploadData.ok) {
        avatarUrl = uploadData.url;
      } else {
        console.warn('Error subiendo avatar:', uploadData.error);
      }
    }

    submitBtn.textContent = 'Aprovisionando directivo…';

    const payload = {
      id: rectorId || null,
      name,
      email,
      schoolId,
      phone,
      documentType: docType,
      documentId: docId,
      jobTitle,
      specialty: specialty || undefined,
      appointmentDate: appointmentDate || undefined,
      status,
      avatarUrl
    };

    submitBtn.textContent = 'Guardando perfil en el servidor...';
    
    // Llamada segura a la API que creamos
    const res = await window.fetchAuth('/api/admin/rector', {
      method: 'POST',
      body: JSON.stringify(payload)
    });
    const resData = await res.json();
    
    if (!resData.ok) {
      throw new Error(resData.error || 'Error al guardar el directivo.');
    }
    
    const savedUser = resData.user;

    // 4. Actualizar memoria del cliente
    const clientPayload = {
      id: rectorId || (savedUser && savedUser.id) || crypto.randomUUID(),
      name,
      email,
      role: 'school_admin',
      schoolId,
      documentType: docType,
      documentId: docId || null,
      phone: phone || null,
      jobTitle: jobTitle,
      avatarUrl,
      status,
      schoolName: (window.SCHOOLS.find(s => s.id === schoolId) || {}).name || 'Colegio',
    };

    const uIdx = window.USERS.findIndex(u => (rectorId && u.id === rectorId) || u.email === email);
    if (uIdx !== -1) {
      window.USERS[uIdx] = { ...window.USERS[uIdx], ...clientPayload };
    } else {
      window.USERS.push({ ...clientPayload, createdAt: new Date().toISOString() });
    }

    const sIdx = window.SCHOOLS.findIndex(s => s.id === schoolId);
    if (sIdx !== -1) {
      window.SCHOOLS[sIdx].rectorName = name;
      window.SCHOOLS[sIdx].rectorEmail = email;
    }

    // Éxito
    fb.style.cssText = 'display:block; padding:10px 14px; background:#E6F4EA; border:1px solid var(--sage-dark); color:var(--sage-dark); font-family:var(--mono); font-size:12px; font-weight:600; margin-bottom:16px;';
    
    if (!rectorId) {
      fb.textContent = `✓ Directivo registrado. Invitación enviada exitosamente a ${email}.`;
    } else {
      fb.textContent = '✓ Cambios del directivo guardados correctamente.';
    }

    submitBtn.textContent = '✓ Guardado';

    setTimeout(() => {
      window.closeRectorModal();
      window.openModal(schoolId);
    }, 1200);

  } catch (err) {
    console.error('Error guardando rector:', err);
    fb.style.cssText = 'display:block; padding:10px 14px; background:#FEE2E2; border:1px solid var(--danger); color:var(--danger); font-family:var(--mono); font-size:12px; font-weight:600; margin-bottom:16px;';
    fb.textContent = ' No fue posible registrar el directivo: ' + (err.message || 'Error de conexión');
    submitBtn.disabled = false;
    submitBtn.textContent = rectorId ? 'Guardar Cambios' : 'Registrar y Enviar Invitación JWT →';
  }
};

// ============================================================
// ELIMINAR DIRECTIVO DEFINITIVAMENTE (CASCADA TOTAL)
// ============================================================
window.deleteRectorDirectly = async function(userId, email, schoolId, event) {
  if (event) event.stopPropagation();

  const user = window.USERS.find(u => u.id === userId || u.email === email);
  const displayName = user?.name || email || 'este directivo';

  const confirmed = await window.showConfirmModal({
    title: '¿Eliminar Directivo?',
    badge: 'PURGA PERMANENTE DE ACCESO',
    message: `¿Estás seguro de eliminar definitivamente a "${displayName}"?\n\nEsta acción borrará todas sus credenciales en Supabase Auth, sus tickets de acceso y lo desvinculará de la institución escolar.`,
    confirmText: 'Eliminar Directivo',
    cancelText: 'Cancelar',
    type: 'danger'
  });

  if (!confirmed) return;

  const btn = event?.target;
  if (btn) { btn.disabled = true; btn.textContent = 'Borrando…'; }

  try {
    const res = await window.fetchAuth('/api/admin/delete-user', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ userId, email, schoolId })
    });
    const data = await res.json();
    if (!data.ok) throw new Error(data.error || 'No se pudo eliminar el directivo.');

    // Actualizar datos locales
    window.USERS = window.USERS.filter(u => u.id !== userId && u.email !== email);
    const sIdx = window.SCHOOLS.findIndex(s => s.id === schoolId);
    if (sIdx !== -1) {
      window.SCHOOLS[sIdx].rectorName = null;
      window.SCHOOLS[sIdx].rectorEmail = null;
    }

    window.openModal(schoolId);
    await window.showAlertModal({
      title: 'Directivo Eliminado',
      message: '✓ ' + (data.message || 'Directivo eliminado exitosamente de la institución.'),
      type: 'success'
    });
  } catch (err) {
    console.error('Error al eliminar directivo:', err);
    await window.showAlertModal({
      title: 'Error de Eliminación',
      message: 'Error al eliminar directivo: ' + (err?.message || 'Error de conexión'),
      type: 'danger'
    });
    if (btn) { btn.disabled = false; btn.textContent = '🗑 Borrar'; }
  }
};

