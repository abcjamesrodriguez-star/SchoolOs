// PURGA / BORRADO MASIVO DE INSTITUCIÓN
// ============================================================
window.purgeSchool = async function(schoolId) {
  if (!schoolId) return;
  const school = window.SCHOOLS.find(s => s.id === schoolId || s.slug === schoolId);
  const schoolName = school?.name || 'esta institución';

  const confirmed = await window.showConfirmModal({
    title: `¿Eliminar "${schoolName}"?`,
    badge: 'PURGA TOTAL EN CASCADA',
    message: `⚠️ ADVERTENCIA: Esta acción es irreversible.\n\nSe eliminarán de forma definitiva:\n• El registro del colegio "${schoolName}".\n• Todas las cuentas de directivos, docentes y alumnos en Supabase Auth y base de datos.\n• Todas las clases, cursos, evaluaciones y tickets vinculados.\n\n¿Estás completamente seguro de purgar esta escuela?`,
    confirmText: '🗑 Purgar y Eliminar Todo',
    cancelText: 'Cancelar',
    type: 'danger'
  });

  if (!confirmed) return;

  try {
    const res = await window.fetchAuth('/api/admin/school', { method: 'POST',
      body: JSON.stringify({
        action: 'delete_school',
        schoolId
      })
    });

    const data = await res.json();
    if (!data.ok) throw new Error(data.error || 'Error al eliminar la institución.');

    window.closeModal();
    window.closeEditModal();

    await window.showAlertModal({
      title: 'Institución Purgada',
      message: '✓ ' + (data.message || `La institución "${schoolName}" y todos sus usuarios han sido eliminados de la plataforma.`),
      type: 'success'
    });

    window.location.reload();
  } catch (err) {
    console.error('Error al purgar escuela:', err);
    await window.showAlertModal({
      title: 'Error de Eliminación',
      message: 'No fue posible eliminar la escuela: ' + (err?.message || 'Error de conexión'),
      type: 'danger'
    });
  }
};

