            <select id="edit-timezone" style="border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--mono); font-size:12px;">
              <option value="America/Bogota (UTC-5)">America/Bogota (UTC-5)</option>
