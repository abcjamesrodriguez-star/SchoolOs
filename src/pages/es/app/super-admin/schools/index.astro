window.suspendSchool = async function(schoolId) {
  if (!schoolId) return;

  const school = window.SCHOOLS.find(s => s.id === schoolId);
  if (!school) return;

  const isSuspended = school.status === 'suspended';
  const nuevoEstado = isSuspended ? 'active' : 'suspended';
  const etiqueta = isSuspended ? 'Activa' : 'Suspendida';

  const confirmed = await window.showConfirmModal({
    title: isSuspended ? 'Reactivar Institución' : 'Suspender Institución',
    badge: 'ESTADO DE LA INSTITUCIÓN',
    message: isSuspended
      ? `¿Deseas reactivar la institución "${school.name}"? Los usuarios podrán volver a acceder al sistema.`
      : `¿Estás seguro de suspender preventivamente la institución "${school.name}"?\n\nEsto bloqueará el acceso a todos sus directivos, docentes y alumnos de forma inmediata.`,
    confirmText: isSuspended ? 'Reactivar Institución' : 'Suspender Acceso',
    cancelText: 'Cancelar',
    type: isSuspended ? 'success' : 'danger'
  });

  if (!confirmed) return;

  const suspendBtn = document.getElementById('modal-suspend-btn');
  if (suspendBtn) {
    suspendBtn.disabled = true;
    suspendBtn.textContent = 'Procesando…';
  }

  try {
    const res = await window.fetchAuth('/api/admin/school', { method: 'POST',
      body: JSON.stringify({
        action: 'suspend_or_reactivate',
        schoolId,
        updates: { status: nuevoEstado }
      })
    });

    const data = await res.json();
    if (!data.ok) throw new Error(data.error || 'Error al cambiar estado');

    // Actualizar memoria local
    const idx = window.SCHOOLS.findIndex(s => s.id === schoolId);
    if (idx !== -1) window.SCHOOLS[idx].status = nuevoEstado;

    // Actualizar badge en la tabla principal
    const statusCell = document.getElementById(`status-cell-${schoolId}`);
    if (statusCell) statusCell.innerHTML = `<span class="badge badge-${nuevoEstado}">${etiqueta}</span>`;

    // Reabrir ficha actualizada
    window.openModal(schoolId);

    // Actualizar el botón según nuevo estado
    if (suspendBtn) {
      suspendBtn.disabled = false;
      suspendBtn.textContent = isSuspended ? 'Suspender' : 'Reactivar';
      suspendBtn.className = isSuspended ? 'btn btn-danger' : 'btn btn-secondary';
    }

  } catch (err) {
    console.error('Error cambiando estado:', err);
    await window.showAlertModal({
      title: 'Error de Estado',
      message: 'No fue posible cambiar el estado de la institución: ' + (err?.message || 'Error'),
      type: 'danger'
    });
    if (suspendBtn) {
      suspendBtn.disabled = false;
      suspendBtn.textContent = isSuspended ? 'Reactivar' : 'Suspender';
    }
  }
};

