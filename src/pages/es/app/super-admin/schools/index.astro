window.quickActivateRector = async function(userId, schoolId, event) {
  if (event) event.stopPropagation();
  
  const confirmed = await window.showConfirmModal({
    title: 'Activar Acceso Directivo',
    badge: 'AUTORIZACIÓN DE ACCESO',
    message: '¿Confirmas activar el acceso institucional para este directivo inmediatamente en la plataforma?',
    confirmText: 'Activar Cuenta',
    cancelText: 'Cancelar',
    type: 'success'
  });
  if (!confirmed) return;

  const btn = event?.target;
  if (btn) { btn.disabled = true; btn.textContent = 'Activando…'; }

  try {
    const res = await window.fetchAuth('/api/admin/rector', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: userId,
        schoolId,
        status: 'active',
        name: (window.USERS.find(u => u.id === userId) || {}).name || 'Directivo',
