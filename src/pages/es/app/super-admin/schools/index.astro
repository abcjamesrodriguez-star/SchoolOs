---
// ============================================================
// SchoolOS — Listado de Escuelas (/es/app/super-admin/schools)
// ============================================================
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { schoolService } from '../../../../../services/schoolService';
import { userService } from '../../../../../services/userService';

const lang = 'es';
let schools: any[] = [];
let users: any[] = [];
try {
  schools = await schoolService.getSchools();
  users = await userService.getUsers();
} catch (e) {
  console.error('Error fetching data from Supabase:', e);
}

const totalCount = schools.length;
const activeCount = schools.filter((s) => s.status === 'active').length;
const trialCount = schools.filter((s) => s.status === 'trial').length;
const suspendedCount = schools.filter((s) => s.status === 'suspended').length;

function getAuditBadge(auditStatus: string) {
  if (auditStatus === 'under_investigation') return { class: 'badge-investigation', label: 'Bajo investigación' };
  if (auditStatus === 'flagged') return { class: 'badge-flagged', label: 'Marcado' };
  return { class: 'badge-none', label: 'Ninguno' };
}

function getStatusLabel(status: string) {
  switch (status) {
    case 'active': return 'Activa';
    case 'trial': return 'En Prueba';
    case 'suspended': return 'Suspendida';
    case 'cancelled': return 'Cancelada';
    default: return status;
  }
}

// Serializar datos para el script cliente
const schoolsJson = JSON.stringify(schools);
const usersJson = JSON.stringify(users);
---

<AppLayout
  title="Escuelas"
  pageTitle="Directorio de Instituciones"
  activeSection="schools"
  lang={lang}
  activeRoute="/app/super-admin/schools"
  breadcrumbs={[{ label: 'Sistema' }, { label: 'Instituciones' }]}
>
  <!-- TOP SUMMARY RIBBON -->
  <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:16px; margin-bottom:24px;">
    <div style="background:var(--paper); border:1px solid var(--ink); padding:16px 20px; border-bottom:3px solid var(--sage-accent);">
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">Total Instituciones</div>
      <div id="stat-total-count" style="font-family:var(--serif); font-size:26px; font-weight:700; color:var(--ink); margin-top:4px;">{totalCount}</div>
      <div style="font-family:var(--mono); font-size:10.5px; color:var(--sage-dark); font-weight:600; margin-top:2px;">Registradas</div>
    </div>
    <div style="background:var(--paper); border:1px solid var(--ink); padding:16px 20px; border-bottom:3px solid var(--sage-dark);">
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">Escuelas Activas</div>
      <div id="stat-active-count" style="font-family:var(--serif); font-size:26px; font-weight:700; color:var(--ink); margin-top:4px;">{activeCount}</div>
      <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft); margin-top:2px;">{totalCount ? Math.round((activeCount / totalCount) * 100) : 100}% del total</div>
    </div>
    <div style="background:var(--paper); border:1px solid var(--ink); padding:16px 20px; border-bottom:3px solid var(--orange-vibrant);">
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">En Periodo Trial</div>
      <div id="stat-trial-count" style="font-family:var(--serif); font-size:26px; font-weight:700; color:var(--orange-vibrant); margin-top:4px;">{trialCount}</div>
      <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft); margin-top:2px;">prom. 9 días restantes</div>
    </div>
    <div style="background:var(--paper); border:1px solid var(--ink); padding:16px 20px; border-bottom:3px solid var(--danger);">
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">Suspendidas</div>
      <div id="stat-suspended-count" style="font-family:var(--serif); font-size:26px; font-weight:700; color:var(--danger); margin-top:4px;">{suspendedCount}</div>
      <div style="font-family:var(--mono); font-size:10.5px; color:var(--danger); margin-top:2px;">requieren revisión</div>
    </div>
  </div>

  <div class="panel">
    <div class="table-toolbar">
      <div class="filter-row" style="align-items:center;">
        <input
          id="school-search"
          type="text"
          placeholder="Filtrar por nombre o dominio..."
          style="border:1px solid var(--ink); background:var(--cream); padding:7px 12px; font-family:var(--sans); font-size:12.5px; width:240px; border-radius:2px;"
        />
        <select id="school-status-filter" class="filter-select" style="border:1px solid var(--ink);" aria-label="Filtrar por estado">
          <option value="">Todos los estados</option>
          <option value="active">Activa</option>
          <option value="trial">En Prueba</option>
          <option value="suspended">Suspendida</option>
          <option value="cancelled">Cancelada</option>
        </select>
        <select id="school-plan-filter" class="filter-select" style="border:1px solid var(--ink);" aria-label="Filtrar por plan">
          <option value="">Todos los planes</option>
          <option value="Starter">Starter</option>
          <option value="Professional">Professional</option>
          <option value="Enterprise">Enterprise</option>
        </select>
      </div>
      <div style="display:flex; gap:10px;">
        <button class="btn btn-secondary" onclick="window.openRectorModal && window.openRectorModal(null, window._currentSchoolId)">+ Registrar Rector</button>
        <a class="btn btn-primary" href={`/${lang}/app/super-admin/schools/new`}>+ Nueva Escuela</a>
      </div>
    </div>

    <div class="panel-body">
      <table class="data-table" id="schools-table">
        <thead>
          <tr>
            <th>Institución Escolar</th>
            <th>Plan de Suscripción</th>
            <th>Estado</th>
            <th>Auditoría</th>
            <th>Estudiantes</th>
            <th>Registro</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="schools-tbody">
          {schools.map((school) => {
            const audit = getAuditBadge(school.auditStatus);
            const initials = school.name.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
            return (
              <tr class="school-row" data-id={school.id} id={`row-${school.id}`}>
                <td class="cell-name">
                  <div style="display:flex; align-items:center; gap:10px;">
                    <div id={`logo-cell-${school.id}`}>
                      {school.logoUrl ? (
                        <div style="width:34px; height:34px; border:1px solid var(--ink); background:#FFFFFF; padding:2px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                          <img src={school.logoUrl} alt={school.name} style="max-width:100%; max-height:100%; object-fit:contain;" />
                        </div>
                      ) : (
                        <div style={`width:34px; height:34px; background:${school.brandColor || 'var(--ink)'}; color:#FFFFFF; font-family:var(--mono); font-size:11px; font-weight:800; display:flex; align-items:center; justify-content:center; flex-shrink:0;`}>
                          {initials}
                        </div>
                      )}
                    </div>
                    <div>
                      <div id={`name-cell-${school.id}`} style="font-size:14px; font-weight:700; color:var(--ink);">{school.name}</div>
                      <div id={`domain-cell-${school.id}`} style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">{school.domain}</div>
                    </div>
                  </div>
                </td>
                <td id={`plan-cell-${school.id}`}><span class="plan-tag">{school.planName}</span></td>
                <td id={`status-cell-${school.id}`}>
                  <span class={`badge badge-${school.status}`}>
                    {getStatusLabel(school.status)}
                  </span>
                </td>
                <td>
                  <span class={`badge ${audit.class}`}>{audit.label}</span>
                </td>
                <td style="font-family:var(--mono); font-weight:700; font-size:13px;">{school.studentCount.toLocaleString()}</td>
                <td class="cell-muted">{new Date(school.createdAt).toLocaleDateString('es-CO', { year: 'numeric', month: 'short', day: 'numeric' })}</td>
                <td class="cell-actions">
                  <button
                    class="btn btn-secondary btn-sm open-modal-btn"
                    data-school-id={school.id}
                    onclick={`window.openModal && window.openModal('${school.id}')`}
                    type="button"
                  >
                    Ver Ficha →
                  </button>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>

      {schools.length === 0 && (
        <div style="padding:48px; text-align:center; font-family:var(--mono); color:var(--ink-soft);">
          <div style="font-size:32px; margin-bottom:12px;">🏫</div>
          <div style="font-weight:700; color:var(--ink); margin-bottom:6px;">No hay instituciones registradas</div>
          <div style="font-size:12px;">Crea la primera escuela desde el botón "Nueva Escuela".</div>
        </div>
      )}
    </div>
  </div>
</AppLayout>

<!-- ============================================================ -->
<!-- MODAL: FICHA INSTITUCIONAL BRUTALISTA (MODAL CENTRADO)      -->
<!-- ============================================================ -->
<div
  id="school-modal-overlay"
  style="display:none; position:fixed; inset:0; background:rgba(18,17,14,0.7); z-index:1000; align-items:center; justify-content:center; padding:20px;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-school-name"
>
  <div
    id="school-modal-panel"
    style="
      background:var(--paper);
      border:2px solid var(--ink);
      width:min(840px, 95vw);
      max-height:92vh;
      overflow-y:auto;
      display:flex;
      flex-direction:column;
      opacity:0;
      transform:scale(0.97);
      transition:opacity 0.2s ease, transform 0.2s ease;
      box-shadow:8px 8px 0 var(--ink);
    "
  >
    <!-- HEADER BAR BRUTALISTA -->
    <div style="border-bottom:2px solid var(--ink); padding:20px 24px; background:var(--cream); display:flex; align-items:center; justify-content:space-between; gap:16px;">
      <div style="display:flex; align-items:center; gap:18px; min-width:0;">
        <!-- ESCUDO EN GRANDE NÍTIDO -->
        <div
          id="modal-logo-container"
          style="width:76px; height:76px; border:2px solid var(--ink); background:#FFFFFF; padding:4px; display:flex; align-items:center; justify-content:center; flex-shrink:0;"
        ></div>

        <div style="min-width:0;">
          <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:var(--ink-soft); font-weight:700;">
            FICHA INSTITUCIONAL · SCHOOLOS
          </div>
          <h2 id="modal-school-name" style="font-family:var(--serif); font-size:22px; font-weight:700; color:var(--ink); margin:2px 0 3px; line-height:1.2;">—</h2>
          <div id="modal-school-slogan" style="font-style:italic; font-size:13px; color:var(--ink-soft);"></div>
        </div>
      </div>

      <button
        id="modal-close-btn"
        type="button"
        onclick="window.closeModal && window.closeModal()"
        style="
          width:34px; height:34px; border:2px solid var(--ink); background:var(--paper);
          cursor:pointer; font-size:16px; font-weight:700; display:flex; align-items:center; justify-content:center;
          color:var(--ink); flex-shrink:0; box-shadow:2px 2px 0 var(--ink);
        "
        aria-label="Cerrar ficha"
      >✕</button>
    </div>

    <!-- BADGE ROW -->
    <div id="modal-badge-row" style="padding:10px 24px; border-bottom:1px solid var(--ink); background:var(--paper); display:flex; gap:8px; flex-wrap:wrap; align-items:center;"></div>

    <!-- STATS RIBBON -->
    <div id="modal-stats-grid" style="display:grid; grid-template-columns:repeat(3, 1fr); border-bottom:2px solid var(--ink); background:var(--cream);"></div>

    <!-- CONTENIDO: GRIDS DE DATOS -->
    <div style="padding:22px 24px; display:flex; flex-direction:column; gap:20px; background:var(--paper);">
      
      <!-- 2 COLUMNAS DE INFORMACIÓN -->
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
        <!-- COLUMNA 1 -->
        <div>
          <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); font-weight:700; margin-bottom:10px; padding-bottom:4px; border-bottom:1px solid var(--ink);">
            01 · IDENTIDAD & CONTACTO
          </div>
          <div id="modal-identity-grid" style="display:grid; grid-template-columns:1fr; gap:8px;"></div>
        </div>

        <!-- COLUMNA 2 -->
        <div>
          <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); font-weight:700; margin-bottom:10px; padding-bottom:4px; border-bottom:1px solid var(--ink);">
            02 · PLAN & SUSCRIPCIÓN
          </div>
          <div id="modal-plan-grid" style="display:grid; grid-template-columns:1fr; gap:8px;"></div>
        </div>
      </div>

      <!-- SECCIÓN 03: RECTORÍA -->
      <div style="border-top:1px solid var(--ink); padding-top:16px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
          <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); font-weight:700;">
            03 · RECTORÍA & DIRECCIÓN ACADÉMICA
          </div>
          <button id="modal-manage-rector-btn" class="btn btn-secondary btn-sm" type="button" style="font-size:11px;">
            + Gestionar Rector
          </button>
        </div>
        <div id="modal-rector-content"></div>
      </div>

    </div>

    <!-- FOOTER ACTIONS -->
    <div style="padding:16px 24px; display:flex; gap:10px; justify-content:flex-end; align-items:center; border-top:2px solid var(--ink); background:var(--cream);">
      <button class="btn btn-secondary" type="button" onclick="window.closeModal()">Cerrar</button>
      <button class="btn btn-secondary" type="button" onclick="alert('Funcionalidad de cambio de plan disponible próximamente.')">Cambiar Plan</button>
      <button id="modal-edit-btn" class="btn btn-primary" type="button" onclick="if(window._currentSchoolId) window.openEditModal(window._currentSchoolId);">
        Editar Datos & Escudo
      </button>
      <button id="modal-suspend-btn" class="btn btn-danger" type="button" onclick="window.suspendSchool && window.suspendSchool(window._currentSchoolId)">Suspender</button>
    </div>
  </div>
</div>

<!-- ============================================================ -->
<!-- MODAL: EDICIÓN DE INSTITUCIÓN                               -->
<!-- ============================================================ -->
<div
  id="edit-modal-overlay"
  style="display:none; position:fixed; inset:0; background:rgba(18,17,14,0.75); z-index:1100; align-items:center; justify-content:center; padding:20px;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="edit-modal-title"
>
  <div
    id="edit-modal-panel"
    style="
      background:var(--paper);
      border:2px solid var(--ink);
      width:min(740px, 100%);
      max-height:90vh;
      overflow-y:auto;
      display:flex;
      flex-direction:column;
      opacity:0;
      transform:scale(0.97);
      transition:opacity 0.22s ease, transform 0.22s ease;
      box-shadow:8px 8px 0 var(--ink);
    "
  >
    <!-- EDIT HEADER -->
    <div style="border-bottom:2px solid var(--ink); padding:18px 24px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; background:var(--cream); z-index:1;">
      <div>
        <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:2px;">Editando institución</div>
        <h2 id="edit-modal-title" style="font-family:var(--serif); font-size:18px; font-weight:700; color:var(--ink); margin:0;">—</h2>
      </div>
      <button
        id="edit-modal-close-btn"
        type="button"
        onclick="window.closeEditModal && window.closeEditModal()"
        style="width:32px; height:32px; border:2px solid var(--ink); background:var(--paper); cursor:pointer; font-size:16px; font-weight:700; display:flex; align-items:center; justify-content:center; color:var(--ink); box-shadow:2px 2px 0 var(--ink);"
        aria-label="Cerrar editor"
      >✕</button>
    </div>

    <!-- FORM -->
    <form id="edit-school-form" style="padding:24px; display:flex; flex-direction:column; gap:0;">
      <input type="hidden" id="edit-school-id" />

      <!-- GRUPO 1: Identidad & Escudo -->
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); font-weight:700; margin-bottom:12px; padding-bottom:8px; border-bottom:1px solid var(--line);">01 · Identidad & Escudo Institucional</div>
      
      <div style="display:grid; grid-template-columns:1fr 200px; gap:20px; margin-bottom:20px; align-items:start;">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
          <div style="display:flex; flex-direction:column; gap:5px; grid-column:span 2;">
            <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Nombre Oficial *</label>
            <input id="edit-name" type="text" required style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--sans); font-size:13px;" />
          </div>
          <div style="display:flex; flex-direction:column; gap:5px;">
            <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Slug (subdominio)</label>
            <input id="edit-slug" type="text" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--mono); font-size:12px;" />
          </div>
          <div style="display:flex; flex-direction:column; gap:5px;">
            <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Color Institucional</label>
            <div style="display:flex; gap:8px; align-items:center;">
              <input id="edit-brand-color-picker" type="color" style="width:40px; height:36px; border:1px solid var(--ink); cursor:pointer; padding:2px;" />
              <input id="edit-brand-color" type="text" placeholder="#12110E" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--mono); font-size:12px; flex:1;" />
            </div>
          </div>
          <div style="display:flex; flex-direction:column; gap:5px; grid-column:span 2;">
            <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Lema / Slogan</label>
            <input id="edit-slogan" type="text" placeholder="Frase institucional (opcional)" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--sans); font-size:13px; font-style:italic;" />
          </div>
        </div>

        <!-- ESCUDO UPLOAD BOX -->
        <div style="border:2px dashed var(--ink); padding:14px; text-align:center; background:var(--cream); border-radius:0; display:flex; flex-direction:column; align-items:center; justify-content:center;">
          <div style="font-family:var(--mono); font-size:9.5px; font-weight:700; text-transform:uppercase; margin-bottom:8px; color:var(--ink);">Escudo / Logo</div>
          <div id="edit-logo-preview-box" style="width:80px; height:80px; border:1px solid var(--ink); background:#FFFFFF; display:flex; align-items:center; justify-content:center; margin-bottom:10px; overflow:hidden; position:relative;">
            <img id="edit-logo-preview-img" src="" alt="Escudo" style="max-width:100%; max-height:100%; object-fit:contain; display:none;" />
            <div id="edit-logo-placeholder" style="font-family:var(--mono); font-size:10px; color:var(--ink-soft); font-weight:700;">SIN ESCUDO</div>
          </div>
          <input type="file" id="edit-logo-file-input" accept="image/png,image/jpeg,image/webp,image/svg+xml" style="display:none;" />
          <input type="hidden" id="edit-logo-url" />
          <button type="button" id="edit-btn-upload-logo" class="btn btn-secondary btn-sm" style="font-size:10.5px; width:100%; padding:6px 8px; font-weight:700;">
            Subir Escudo
          </button>
          <button type="button" id="edit-btn-remove-logo" style="background:none; border:none; color:var(--danger); font-size:10px; font-family:var(--mono); margin-top:6px; cursor:pointer; display:none;">
            ✕ Quitar escudo
          </button>
        </div>
      </div>

      <!-- GRUPO 2: Contacto & Ubicación -->
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); font-weight:700; margin-bottom:12px; padding-bottom:8px; border-bottom:1px solid var(--line);">02 · Contacto & Ubicación</div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:20px;">
        <div style="display:flex; flex-direction:column; gap:5px;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Dominio</label>
          <input id="edit-domain" type="text" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--mono); font-size:12px;" />
        </div>
        <div style="display:flex; flex-direction:column; gap:5px;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Correo Institucional *</label>
          <input id="edit-contact-email" type="email" required style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--sans); font-size:13px;" />
        </div>
        <div style="display:flex; flex-direction:column; gap:5px;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Ciudad / Ubicación</label>
          <input id="edit-location" type="text" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--sans); font-size:13px;" />
        </div>
        <div style="display:flex; flex-direction:column; gap:5px;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">País</label>
          <input id="edit-country" type="text" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--sans); font-size:13px;" />
        </div>
        <div style="display:flex; flex-direction:column; gap:5px; grid-column:span 2;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Dirección de Sede Principal</label>
          <input id="edit-address" type="text" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--sans); font-size:13px;" />
        </div>
        <div style="display:flex; flex-direction:column; gap:5px;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Teléfono / PBX</label>
          <input id="edit-phone" type="text" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--sans); font-size:13px;" />
        </div>
        <div style="display:flex; flex-direction:column; gap:5px;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Zona Horaria</label>
          <select id="edit-timezone" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--mono); font-size:12px;">
            <option value="America/Bogota (UTC-5)">America/Bogota (UTC-5)</option>
            <option value="America/Lima (UTC-5)">America/Lima (UTC-5)</option>
            <option value="America/Mexico_City (UTC-6)">America/Mexico_City (UTC-6)</option>
            <option value="America/Santiago (UTC-3)">America/Santiago (UTC-3)</option>
            <option value="America/Buenos_Aires (UTC-3)">America/Buenos_Aires (UTC-3)</option>
            <option value="America/Caracas (UTC-4)">America/Caracas (UTC-4)</option>
            <option value="America/New_York (UTC-5)">America/New_York (UTC-5)</option>
          </select>
        </div>
      </div>

      <!-- GRUPO 3: Plan & Estado -->
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); font-weight:700; margin-bottom:12px; padding-bottom:8px; border-bottom:1px solid var(--line);">03 · Plan & Estado Operativo</div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:20px;">
        <div style="display:flex; flex-direction:column; gap:5px;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Plan de Suscripción</label>
          <select id="edit-plan" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--mono); font-size:12px;">
            <option value="Starter">Starter</option>
            <option value="Professional">Professional</option>
            <option value="Enterprise">Enterprise</option>
          </select>
        </div>
        <div style="display:flex; flex-direction:column; gap:5px;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Estado Operativo</label>
          <select id="edit-status" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--mono); font-size:12px;">
            <option value="active">Activa</option>
            <option value="trial">En Prueba (Trial)</option>
            <option value="suspended">Suspendida</option>
            <option value="cancelled">Cancelada</option>
          </select>
        </div>
      </div>

      <!-- FEEDBACK -->
      <div id="edit-feedback" style="display:none; padding:10px 14px; margin-bottom:16px; font-family:var(--mono); font-size:12px; font-weight:600;"></div>

      <!-- FORM ACTIONS -->
      <div style="display:flex; gap:10px; justify-content:flex-end; padding-top:16px; border-top:1px solid var(--line);">
        <button id="edit-cancel-btn" type="button" class="btn btn-secondary" onclick="window.closeEditModal && window.closeEditModal()">Cancelar</button>
        <button id="edit-submit-btn" type="submit" class="btn btn-primary">Guardar Cambios</button>
      </div>
    </form>
  </div>
</div>

<!-- ============================================================ -->
<!-- MODAL: REGISTRO / GESTIÓN DE RECTOR (BRUTALISTA)            -->
<!-- ============================================================ -->
<div
  id="rector-modal-overlay"
  style="display:none; position:fixed; inset:0; background:rgba(18,17,14,0.75); z-index:1200; align-items:center; justify-content:center; padding:20px;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="rector-modal-title"
>
  <div
    id="rector-modal-panel"
    style="
      background:var(--paper);
      border:2px solid var(--ink);
      width:min(760px, 100%);
      max-height:92vh;
      overflow-y:auto;
      display:flex;
      flex-direction:column;
      opacity:0;
      transform:scale(0.97);
      transition:opacity 0.2s ease, transform 0.2s ease;
      box-shadow:8px 8px 0 var(--ink);
    "
  >
    <!-- RECTOR HEADER -->
    <div style="border-bottom:2px solid var(--ink); padding:18px 24px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; background:var(--cream); z-index:2;">
      <div>
        <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:2px;">Directorio Institucional</div>
        <h2 id="rector-modal-title" style="font-family:var(--serif); font-size:19px; font-weight:700; color:var(--ink); margin:0;">Registro de Rector / Directivo</h2>
      </div>
      <button
        id="rector-modal-close-btn"
        type="button"
        onclick="window.closeRectorModal && window.closeRectorModal()"
        style="width:32px; height:32px; border:2px solid var(--ink); background:var(--paper); cursor:pointer; font-size:16px; font-weight:700; display:flex; align-items:center; justify-content:center; color:var(--ink); box-shadow:2px 2px 0 var(--ink);"
        aria-label="Cerrar modal de rector"
      >✕</button>
    </div>

    <!-- FORM -->
    <form id="rector-form" style="padding:24px; display:flex; flex-direction:column; gap:0;">
      <input type="hidden" id="rector-id" />
      <input type="hidden" id="rector-avatar-url" />

      <!-- PASO 1: FOTO & IDENTIFICACIÓN PERSONAL -->
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); font-weight:700; margin-bottom:12px; padding-bottom:6px; border-bottom:1px solid var(--line);">
        01 · Datos Personales & Identificación
      </div>

      <div style="display:grid; grid-template-columns:1fr 180px; gap:20px; margin-bottom:20px; align-items:start;">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
          <div style="display:flex; flex-direction:column; gap:5px; grid-column:span 2;">
            <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Nombre Completo del Rector / Directivo *</label>
            <input id="rector-name" type="text" placeholder="ej. Coach Mike Johnson" required style="border:1px solid var(--ink); background:var(--cream); padding:9px 12px; font-family:var(--sans); font-size:13.5px;" />
          </div>

          <div style="display:flex; flex-direction:column; gap:5px;">
            <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Tipo de Documento</label>
            <select id="rector-doc-type" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--mono); font-size:12px;">
              <option value="CC">Cédula de Ciudadanía (CC)</option>
              <option value="CE">Cédula de Extranjería (CE)</option>
              <option value="PA">Pasaporte (PA)</option>
              <option value="PEP">Permiso Especial (PEP)</option>
            </select>
          </div>

          <div style="display:flex; flex-direction:column; gap:5px;">
            <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Número de Documento</label>
            <input id="rector-doc-id" type="text" placeholder="ej. 1.045.890.123" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--mono); font-size:12.5px;" />
          </div>

          <div style="display:flex; flex-direction:column; gap:5px; grid-column:span 2;">
            <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Teléfono Móvil / WhatsApp de Contacto</label>
            <input id="rector-phone" type="tel" placeholder="ej. +57 300 123 4567" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--sans); font-size:13px;" />
          </div>
        </div>

        <!-- RECTOR AVATAR UPLOAD BOX -->
        <div style="border:2px dashed var(--ink); padding:14px; text-align:center; background:var(--cream); display:flex; flex-direction:column; align-items:center; justify-content:center;">
          <div style="font-family:var(--mono); font-size:9.5px; font-weight:700; text-transform:uppercase; margin-bottom:8px; color:var(--ink);">Foto del Rector</div>
          <div id="rector-avatar-preview-box" style="width:76px; height:76px; border:1px solid var(--ink); background:#FFFFFF; display:flex; align-items:center; justify-content:center; margin-bottom:10px; overflow:hidden;">
            <img id="rector-avatar-preview-img" src="" alt="Foto Rector" style="width:100%; height:100%; object-fit:cover; display:none;" />
            <div id="rector-avatar-placeholder" style="font-family:var(--mono); font-size:10px; color:var(--ink-soft); font-weight:700;">SIN FOTO</div>
          </div>
          <input type="file" id="rector-avatar-file-input" accept="image/png,image/jpeg,image/webp" style="display:none;" />
          <button type="button" id="rector-btn-upload-avatar" class="btn btn-secondary btn-sm" style="font-size:10px; width:100%; padding:5px 6px; font-weight:700;">
            Subir Foto
          </button>
          <button type="button" id="rector-btn-remove-avatar" style="background:none; border:none; color:var(--danger); font-size:10px; font-family:var(--mono); margin-top:6px; cursor:pointer; display:none;">
            ✕ Quitar foto
          </button>
        </div>
      </div>

      <!-- PASO 2: VINCULACIÓN INSTITUCIONAL & CARGO -->
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); font-weight:700; margin-bottom:12px; padding-bottom:6px; border-bottom:1px solid var(--line);">
        02 · Vinculación Institucional & Cargo
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:20px;">
        <div style="display:flex; flex-direction:column; gap:5px; grid-column:span 2;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Institución Educativa Asignada *</label>
          <select id="rector-school-id" required style="border:1px solid var(--ink); background:var(--cream); padding:9px 12px; font-family:var(--sans); font-size:13.5px; font-weight:700;">
          </select>
        </div>

        <div style="display:flex; flex-direction:column; gap:5px;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Cargo Oficial</label>
          <select id="rector-job-title" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--sans); font-size:12.5px;">
            <option value="Rector General">Rector General</option>
            <option value="Director Académico">Director Académico</option>
            <option value="Vicerrector">Vicerrector</option>
            <option value="Director Ejecutivo">Director Ejecutivo</option>
            <option value="Coordinador General">Coordinador General</option>
          </select>
        </div>

        <div style="display:flex; flex-direction:column; gap:5px;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Fecha de Nombramiento / Posesión</label>
          <input id="rector-appointment-date" type="date" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--mono); font-size:12px;" />
        </div>

        <div style="display:flex; flex-direction:column; gap:5px; grid-column:span 2;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Título Académico / Especialidad</label>
          <input id="rector-specialty" type="text" placeholder="ej. Magíster en Gestión Educativa y Liderazgo" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--sans); font-size:13px;" />
        </div>
      </div>

      <!-- PASO 3: CREDENCIALES DE ACCESO -->
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); font-weight:700; margin-bottom:12px; padding-bottom:6px; border-bottom:1px solid var(--line);">
        03 · Credenciales de Acceso a SchoolOS
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:20px;">
        <div style="display:flex; flex-direction:column; gap:5px; grid-column:span 2;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Correo Institucional de Acceso *</label>
          <input id="rector-email" type="email" placeholder="rectoria@cafelitosacademy.edu.co" required style="border:1px solid var(--ink); background:var(--cream); padding:9px 12px; font-family:var(--mono); font-size:13px;" />
        </div>

        <div style="display:flex; flex-direction:column; gap:5px;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Contraseña Inicial</label>
            <button type="button" id="rector-btn-generate-pass" style="background:none; border:none; color:var(--sage-dark); font-family:var(--mono); font-size:10.5px; font-weight:700; cursor:pointer;">
              Generar Segura
            </button>
          </div>
          <input id="rector-password" type="text" placeholder="Mínimo 8 caracteres" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--mono); font-size:12.5px;" />
        </div>

        <div style="display:flex; flex-direction:column; gap:5px;">
          <label style="font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink);">Estado de la Cuenta</label>
          <select id="rector-status" style="border:1px solid var(--ink); background:var(--cream); padding:8px 10px; font-family:var(--mono); font-size:12px;">
            <option value="active">Activa (Acceso Inmediato)</option>
            <option value="pending">Invitación Pendiente</option>
            <option value="suspended">Suspendida Preventivamente</option>
          </select>
        </div>
      </div>

      <!-- FEEDBACK -->
      <div id="rector-feedback" style="display:none; padding:10px 14px; margin-bottom:16px; font-family:var(--mono); font-size:12px; font-weight:600;"></div>

      <!-- FORM ACTIONS -->
      <div style="display:flex; gap:10px; justify-content:flex-end; padding-top:16px; border-top:1px solid var(--line);">
        <button id="rector-cancel-btn" type="button" class="btn btn-secondary" onclick="window.closeRectorModal && window.closeRectorModal()">Cancelar</button>
        <button id="rector-submit-btn" type="submit" class="btn btn-primary">Registrar Directivo</button>
      </div>
    </form>
  </div>
</div>

<script define:vars={{ schoolsJson, usersJson }}>
// ============================================================
// DATOS EN CLIENTE
// ============================================================
window.SCHOOLS = JSON.parse(schoolsJson || '[]');
window.USERS = JSON.parse(usersJson || '[]');
window._currentSchoolId = null;
window._selectedLogoFile = null;
window._selectedRectorAvatarFile = null;

// Helpers globales
function statusLabel(s) {
  const map = { active: 'Activa', trial: 'En Prueba', suspended: 'Suspendida', cancelled: 'Cancelada', pending: 'Pendiente' };
  return map[s] || s;
}
function statusColor(s) {
  const map = { active: 'var(--sage-dark)', trial: 'var(--orange-vibrant)', suspended: 'var(--danger)', cancelled: 'var(--ink-soft)', pending: 'var(--stone-accent)' };
  return map[s] || 'var(--ink)';
}
function auditLabel(a) {
  const map = { under_investigation: 'Bajo investigación', flagged: 'Marcado', none: 'Sin flags' };
  return map[a] || a;
}
function fmtDate(d) {
  return d ? new Date(d).toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' }) : '—';
}
function cleanInfoRow(label, value) {
  return `
    <div style="background:var(--cream); padding:9px 12px; border:1px solid var(--line);">
      <div style="font-family:var(--mono); font-size:9px; letter-spacing:0.08em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:2px;">${label}</div>
      <div style="font-size:13px; font-weight:700; color:var(--ink); word-break:break-word;">${value || '—'}</div>
    </div>
  `;
}
function statItem(num, label, value, color) {
  return `
    <div style="padding:14px 18px; border-right:1px solid var(--ink);">
      <div style="font-family:var(--mono); font-size:9.5px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">${num} · ${label}</div>
      <div style="font-family:var(--serif); font-size:24px; font-weight:700; color:${color || 'var(--ink)'}; margin-top:2px;">${value}</div>
    </div>
  `;
}

// ============================================================
// MODAL FICHA INSTITUCIONAL BRUTALISTA
// ============================================================
window.openModal = function(schoolId) {
  window._currentSchoolId = schoolId;
  const school = window.SCHOOLS.find(s => s.id === schoolId);
  if (!school) return;

  // Logo de la escuela en alta definición
  const logoCont = document.getElementById('modal-logo-container');
  const initials = school.name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
  if (school.logoUrl) {
    logoCont.innerHTML = `<img src="${school.logoUrl}" alt="${school.name}" style="max-width:100%; max-height:100%; object-fit:contain;"/>`;
  } else {
    const bg = school.brandColor || '#12110E';
    logoCont.innerHTML = `<div style="width:100%; height:100%; background:${bg}; color:#FFFFFF; font-family:var(--mono); font-size:22px; font-weight:800; display:flex; align-items:center; justify-content:center;">${initials}</div>`;
  }

  // Título y lema
  document.getElementById('modal-school-name').textContent = school.name;
  const sloganEl = document.getElementById('modal-school-slogan');
  sloganEl.textContent = school.slogan ? `"${school.slogan}"` : '';
  sloganEl.style.display = school.slogan ? 'block' : 'none';

  // Badges brutalistas
  document.getElementById('modal-badge-row').innerHTML = `
    <span style="background:${statusColor(school.status)}; color:#FFF; font-family:var(--mono); font-size:10px; font-weight:700; padding:3px 10px; letter-spacing:0.06em; text-transform:uppercase;">ESTADO: ${statusLabel(school.status)}</span>
    <span style="background:var(--ink); color:#FFF; font-family:var(--mono); font-size:10px; font-weight:700; padding:3px 10px; letter-spacing:0.06em; text-transform:uppercase;">PLAN: ${school.planName}</span>
    <span style="border:1px solid var(--ink); color:var(--ink); font-family:var(--mono); font-size:10px; font-weight:600; padding:3px 10px; text-transform:uppercase;">AUDITORÍA: ${auditLabel(school.auditStatus)}</span>
    <span style="border:1px solid var(--line); color:var(--ink-soft); font-family:var(--mono); font-size:10px; padding:3px 10px;">ID: ${school.id}</span>
  `;

  // Métricas
  document.getElementById('modal-stats-grid').innerHTML =
    statItem('01', 'Estudiantes', (school.studentCount || 0).toLocaleString(), 'var(--sage-dark)') +
    statItem('02', 'Docentes', (school.teacherCount || 0).toLocaleString(), 'var(--stone-accent)') +
    statItem('03', 'Clases Activas', (school.activeClassesCount || 0).toLocaleString(), 'var(--orange-vibrant)');

  // Columna 1
  document.getElementById('modal-identity-grid').innerHTML =
    cleanInfoRow('Dominio / Subdominio', school.domain) +
    cleanInfoRow('Correo Institucional', school.contactEmail) +
    cleanInfoRow('Ubicación & País', (school.location || school.country || 'No registrada') + (school.country ? ` · ${school.country}` : '')) +
    cleanInfoRow('Dirección Sede Principal', school.address || 'Sin dirección registrada') +
    cleanInfoRow('Teléfono / PBX', school.phone || 'Sin teléfono registrado') +
    cleanInfoRow('Zona Horaria', school.timezone || 'America/Bogota (UTC-5)') +
    cleanInfoRow('Fecha de Registro', fmtDate(school.createdAt));

  // Columna 2
  document.getElementById('modal-plan-grid').innerHTML =
    cleanInfoRow('Plan de Suscripción', school.planName) +
    cleanInfoRow('Estado Operativo', statusLabel(school.status)) +
    cleanInfoRow('Slug del Tenant', `${school.slug}.schoolos.com`) +
    cleanInfoRow('Color Institucional', school.brandColor || '#12110E') +
    cleanInfoRow('Auditoría Forense', auditLabel(school.auditStatus));

  // Renderizar Sección 03: Rectoría
  const rectorUser = window.USERS.find(u => u.schoolId === schoolId && u.role === 'school_admin');
  const rectorContent = document.getElementById('modal-rector-content');
  const manageRectorBtn = document.getElementById('modal-manage-rector-btn');

  if (rectorUser) {
    manageRectorBtn.textContent = 'Editar Rector';
    manageRectorBtn.onclick = () => window.openRectorModal(rectorUser.id, schoolId);

    const initialsRector = (rectorUser.name || 'Rector').split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
    rectorContent.innerHTML = `
      <div style="background:var(--cream); border:1.5px solid var(--ink); padding:14px 18px; display:flex; gap:16px; align-items:center; box-shadow:3px 3px 0 var(--ink);">
        <div style="width:60px; height:60px; border:1px solid var(--ink); background:#FFFFFF; display:flex; align-items:center; justify-content:center; flex-shrink:0; overflow:hidden;">
          ${rectorUser.avatarUrl ? `<img src="${rectorUser.avatarUrl}" alt="${rectorUser.name}" style="width:100%; height:100%; object-fit:cover;" />` : `<span style="font-family:var(--mono); font-size:18px; font-weight:800; color:var(--ink);">${initialsRector}</span>`}
        </div>
        <div style="flex:1;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <div style="font-size:15px; font-weight:700; color:var(--ink);">${rectorUser.name}</div>
            <span class="badge badge-${rectorUser.status || 'active'}">${statusLabel(rectorUser.status || 'active')}</span>
          </div>
          <div style="font-family:var(--mono); font-size:11.5px; color:var(--sage-dark); font-weight:700; margin-top:2px;">
            ${rectorUser.jobTitle || 'Rector General'} ${rectorUser.specialty ? `· ${rectorUser.specialty}` : ''}
          </div>
          <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-top:4px;">
            Correo: ${rectorUser.email} ${rectorUser.phone ? `· Tel: ${rectorUser.phone}` : ''} ${rectorUser.documentId ? `· Doc: ${rectorUser.documentType || 'CC'} ${rectorUser.documentId}` : ''}
          </div>
        </div>
      </div>
    `;
  } else if (school.rectorName || school.rectorEmail) {
    manageRectorBtn.textContent = '+ Vincular Cuenta';
    manageRectorBtn.onclick = () => window.openRectorModal(null, schoolId, { name: school.rectorName, email: school.rectorEmail });

    rectorContent.innerHTML = `
      <div style="background:var(--cream); border:1px solid var(--ink); padding:14px 18px; display:flex; justify-content:space-between; align-items:center;">
        <div>
