  if (editOverlay) {
    editOverlay.addEventListener('click', e => {
      if (e.target === e.currentTarget) window.closeEditModal();
    });
  }

  const rectorOverlay = document.getElementById('rector-modal-overlay');
  if (rectorOverlay) {
    rectorOverlay.addEventListener('click', e => {
      if (e.target === e.currentTarget) window.closeRectorModal();
    });
  }

  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (document.getElementById('rector-modal-overlay')?.style.display === 'flex') {
      window.closeRectorModal();
    } else if (document.getElementById('edit-modal-overlay')?.style.display === 'flex') {
      window.closeEditModal();
    } else {
      window.closeModal();
    }
  });

  const btnUploadLogo = document.getElementById('edit-btn-upload-logo');
  const logoFileInput = document.getElementById('edit-logo-file-input');
  const btnRemoveLogo = document.getElementById('edit-btn-remove-logo');
  const previewImg = document.getElementById('edit-logo-preview-img');
  const placeholder = document.getElementById('edit-logo-placeholder');
  const logoUrlHidden = document.getElementById('edit-logo-url');

  if (btnUploadLogo && logoFileInput) {
    btnUploadLogo.addEventListener('click', () => logoFileInput.click());

    logoFileInput.addEventListener('change', (e) => {
      const file = e.target.files?.[0];
      if (!file) return;

      if (file.size > 5 * 1024 * 1024) {
        alert('El escudo no puede exceder los 5MB.');
        return;
      }

      window._selectedLogoFile = file;
      const objectUrl = URL.createObjectURL(file);
      if (previewImg) {
        previewImg.src = objectUrl;
        previewImg.style.display = 'block';
      }
      if (placeholder) placeholder.style.display = 'none';
      if (btnRemoveLogo) btnRemoveLogo.style.display = 'inline-block';
    });
  }

  if (btnRemoveLogo) {
    btnRemoveLogo.addEventListener('click', () => {
      window._selectedLogoFile = null;
      if (logoFileInput) logoFileInput.value = '';
      if (logoUrlHidden) logoUrlHidden.value = '';
      if (previewImg) {
        previewImg.src = '';
        previewImg.style.display = 'none';
      }
      if (placeholder) placeholder.style.display = 'block';
      btnRemoveLogo.style.display = 'none';
    });
  }

  const btnUploadAvatar = document.getElementById('rector-btn-upload-avatar');
  const avatarFileInput = document.getElementById('rector-avatar-file-input');
  const btnRemoveAvatar = document.getElementById('rector-btn-remove-avatar');
  const avatarPreviewImg = document.getElementById('rector-avatar-preview-img');
  const avatarPlaceholder = document.getElementById('rector-avatar-placeholder');
  const avatarUrlHidden = document.getElementById('rector-avatar-url');

  if (btnUploadAvatar && avatarFileInput) {
    btnUploadAvatar.addEventListener('click', () => avatarFileInput.click());

    avatarFileInput.addEventListener('change', (e) => {
      const file = e.target.files?.[0];
      if (!file) return;

      if (file.size > 4 * 1024 * 1024) {
        alert('La fotografía no puede exceder 4MB.');
        return;
      }

      window._selectedRectorAvatarFile = file;
      const objectUrl = URL.createObjectURL(file);
      if (avatarPreviewImg) {
        avatarPreviewImg.src = objectUrl;
        avatarPreviewImg.style.display = 'block';
      }
      if (avatarPlaceholder) avatarPlaceholder.style.display = 'none';
      if (btnRemoveAvatar) btnRemoveAvatar.style.display = 'inline-block';
    });
  }

  if (btnRemoveAvatar) {
    btnRemoveAvatar.addEventListener('click', () => {
      window._selectedRectorAvatarFile = null;
      if (avatarFileInput) avatarFileInput.value = '';
      if (avatarUrlHidden) avatarUrlHidden.value = '';
      if (avatarPreviewImg) {
        avatarPreviewImg.src = '';
        avatarPreviewImg.style.display = 'none';
      }
      if (avatarPlaceholder) avatarPlaceholder.style.display = 'block';
      btnRemoveAvatar.style.display = 'none';
    });
  }

  const btnGenPass = document.getElementById('rector-btn-generate-pass');
  if (btnGenPass) {
    btnGenPass.addEventListener('click', () => {
      const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%^&*';
      let pass = 'Rector';
      for (let i = 0; i < 6; i++) pass += chars.charAt(Math.floor(Math.random() * chars.length));
      pass += '!2026';
      document.getElementById('rector-password').value = pass;
    });
  }

  const editForm = document.getElementById('edit-school-form');
  if (editForm) {
    editForm.addEventListener('submit', async e => {
      e.preventDefault();
      await window.saveSchoolEdits();
    });
  }

  const rectorForm = document.getElementById('rector-form');
  if (rectorForm) {
    rectorForm.addEventListener('submit', async e => {
      e.preventDefault();
      await window.saveRector();
    });
  }

  const searchInput  = document.getElementById('school-search');
  const statusFilter = document.getElementById('school-status-filter');
  const planFilter   = document.getElementById('school-plan-filter');

  function applyFilters() {
    const search = (searchInput?.value || '').toLowerCase().trim();
    const status = statusFilter?.value || '';
    const plan   = planFilter?.value || '';

    document.querySelectorAll('.school-row').forEach(row => {
      const school = window.SCHOOLS.find(s => s.id === row.dataset.id);
      if (!school) return;
      const ok =
        (!search || school.name.toLowerCase().includes(search) || school.domain.toLowerCase().includes(search) || (school.slug || '').toLowerCase().includes(search)) &&
        (!status || school.status === status) &&
        (!plan   || school.planName === plan);
      row.style.display = ok ? '' : 'none';
    });
  }

  if (searchInput) searchInput.addEventListener('input', applyFilters);
  if (statusFilter) statusFilter.addEventListener('change', applyFilters);
  if (planFilter) planFilter.addEventListener('change', applyFilters);
});
</script>
