window.openEditModal = function(schoolId) {
  const school = window.SCHOOLS.find(s => s.id === schoolId);
  if (!school) return;

  window._selectedLogoFile = null;

  document.getElementById('edit-school-id').value         = school.id;
  document.getElementById('edit-modal-title').textContent = school.name;
  document.getElementById('edit-name').value              = school.name || '';
  document.getElementById('edit-slug').value              = school.slug || '';
  document.getElementById('edit-slogan').value            = school.slogan || '';
  document.getElementById('edit-brand-color').value       = school.brandColor || '#12110E';
  document.getElementById('edit-brand-color-picker').value = /^#[0-9A-Fa-f]{6}$/.test(school.brandColor || '') ? school.brandColor : '#12110E';
  document.getElementById('edit-logo-url').value          = school.logoUrl || '';
  document.getElementById('edit-domain').value            = school.domain || '';
  document.getElementById('edit-contact-email').value     = school.contactEmail || '';
  document.getElementById('edit-location').value          = school.location || '';
  document.getElementById('edit-country').value           = school.country || '';
  document.getElementById('edit-address').value           = school.address || '';
  document.getElementById('edit-phone').value             = school.phone || '';
  document.getElementById('edit-plan').value              = school.planName || 'Starter';
  const stdCount = school.studentCount ?? 0;
  const planLimit = school.planName === 'Starter' ? '200' : school.planName === 'Enterprise' ? '5,000' : '1,500';
  const stdDisplay = document.getElementById('edit-student-count-display');
  if (stdDisplay) stdDisplay.textContent = `${stdCount} / ${planLimit}`;
  const tchDisplay = document.getElementById('edit-teacher-count-display');
  if (tchDisplay) tchDisplay.textContent = `${school.teacherCount ?? 0} docentes`;
  const clsDisplay = document.getElementById('edit-active-classes-display');
  if (clsDisplay) clsDisplay.textContent = `${school.activeClassesCount ?? 0} asignaturas`;

  const previewImg = document.getElementById('edit-logo-preview-img');
  const placeholder = document.getElementById('edit-logo-placeholder');
  const removeBtn = document.getElementById('edit-btn-remove-logo');
  const fileInput = document.getElementById('edit-logo-file-input');
  if (fileInput) fileInput.value = '';

  if (school.logoUrl) {
    previewImg.src = school.logoUrl;
    previewImg.style.display = 'block';
    placeholder.style.display = 'none';
    removeBtn.style.display = 'inline-block';
  } else {
    previewImg.src = '';
    previewImg.style.display = 'none';
    placeholder.style.display = 'block';
    removeBtn.style.display = 'none';
  }

  const tzSelect = document.getElementById('edit-timezone');
  const tzVal = school.timezone || 'America/Bogota (UTC-5)';
  Array.from(tzSelect.options).forEach(o => { o.selected = o.value === tzVal; });

  const fb = document.getElementById('edit-feedback');
  fb.style.display = 'none';
  fb.textContent = '';

  const submitBtn = document.getElementById('edit-submit-btn');
  submitBtn.disabled = false;
  submitBtn.textContent = 'Guardar Cambios';

  const overlay = document.getElementById('edit-modal-overlay');
  const panel   = document.getElementById('edit-modal-panel');
  overlay.style.display = 'flex';
  panel.getBoundingClientRect();
  panel.style.opacity   = '1';
  panel.style.transform = 'scale(1)';
  document.getElementById('edit-name').focus();
};

window.closeEditModal = function() {
  const overlay = document.getElementById('edit-modal-overlay');
  const panel   = document.getElementById('edit-modal-panel');
  if (!panel) return;
  panel.style.opacity   = '0';
  panel.style.transform = 'scale(0.97)';
  setTimeout(() => {
    if (overlay) overlay.style.display = 'none';
    document.body.style.overflow = '';
  }, 220);
};

function statusLabel(status) {
  switch (status) {
    case 'active': return 'Activa';
    case 'trial': return 'En Prueba';
    case 'suspended': return 'Suspendida';
    case 'cancelled': return 'Cancelada';
    default: return status || 'Activa';
  }
}

window.quickActivateRector = async function(rectorId, schoolId, event) {
  if (event) event.stopPropagation();
  if (!confirm('¿Deseas activar inmediatamente el acceso a esta cuenta directiva?')) return;

  try {
    const res = await window.fetchAuth('/api/admin/school', { method: 'POST',
      body: JSON.stringify({
        action: 'quick_activate_rector',
        rectorId,
        schoolId
      })
    });

    const data = await res.json();
    if (!data.ok) throw new Error(data.error || 'Error en servidor');

    const uIdx = window.USERS.findIndex(u => u.id === rectorId);
    if (uIdx !== -1) {
      window.USERS[uIdx].status = 'active';
    }

    alert('✓ Directivo activado exitosamente. La cuenta ahora tiene acceso activo.');
    window.openModal(schoolId);
  } catch (err) {
    console.error('Error activando directivo:', err);
    alert('No fue posible activar el directivo: ' + (err?.message || 'Error de conexión'));
  }
};

window.saveSchoolEdits = async function() {
  const submitBtn = document.getElementById('edit-submit-btn');
  const fb        = document.getElementById('edit-feedback');
  const schoolId  = document.getElementById('edit-school-id').value;

  submitBtn.disabled    = true;
  submitBtn.textContent = 'Guardando…';
  fb.style.display      = 'none';

  const slug = document.getElementById('edit-slug').value.trim() || 'school';

  try {
    let finalLogoUrl = document.getElementById('edit-logo-url').value.trim() || null;

    if (window._selectedLogoFile) {
      submitBtn.textContent = 'Subiendo imagen…';
      const file = window._selectedLogoFile;

      try {
        const fd = new FormData();
        fd.append('file', file);
        fd.append('type', 'logo');
        fd.append('slug', slug);
        const uploadRes = await window.fetchAuth('/api/admin/upload-asset', { method: 'POST', body: fd });
        const uploadData = await uploadRes.json();
        if (uploadData.ok) {
          finalLogoUrl = uploadData.url;
        }
      } catch (_) {}
    }

    const updates = {
      name:                 document.getElementById('edit-name').value.trim(),
      slug:                 slug,
      slogan:               document.getElementById('edit-slogan').value.trim(),
      brandColor:           document.getElementById('edit-brand-color').value.trim(),
      logoUrl:              finalLogoUrl || null,
      domain:               document.getElementById('edit-domain').value.trim(),
      contactEmail:         document.getElementById('edit-contact-email').value.trim(),
      location:             document.getElementById('edit-location').value.trim(),
      country:              document.getElementById('edit-country').value.trim(),
      address:              document.getElementById('edit-address').value.trim(),
      phone:                document.getElementById('edit-phone').value.trim(),
      timezone:             document.getElementById('edit-timezone').value,
      planName:             document.getElementById('edit-plan').value,
      status:               document.getElementById('edit-status').value,
    };

    submitBtn.textContent = 'Aplicando cambios…';

    const res = await window.fetchAuth('/api/admin/school', { method: 'POST',
      body: JSON.stringify({
        action: 'update_school',
        schoolId,
        updates
      })
    });

    const resData = await res.json();
    if (!resData.ok) throw new Error(resData.error || 'Error al guardar');

    const idx = window.SCHOOLS.findIndex(s => s.id === schoolId);
    if (idx !== -1) {
      window.SCHOOLS[idx] = { ...window.SCHOOLS[idx], ...updates, logoUrl: finalLogoUrl || undefined };
    }

    const nameCell = document.getElementById(`name-cell-${schoolId}`);
    if (nameCell) nameCell.textContent = updates.name;

    const domainCell = document.getElementById(`domain-cell-${schoolId}`);
    if (domainCell) domainCell.textContent = updates.domain;

    const planCell = document.getElementById(`plan-cell-${schoolId}`);
    if (planCell) planCell.innerHTML = `<span class="plan-tag">${updates.planName}</span>`;

    const statusCell = document.getElementById(`status-cell-${schoolId}`);
    if (statusCell) statusCell.innerHTML = `<span class="badge badge-${updates.status}">${statusLabel(updates.status)}</span>`;

    const logoCell = document.getElementById(`logo-cell-${schoolId}`);
    if (logoCell) {
      const initials = updates.name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
      if (finalLogoUrl) {
        logoCell.innerHTML = `<div style="width:34px; height:34px; border:1px solid var(--ink); background:#FFFFFF; padding:2px; display:flex; align-items:center; justify-content:center; flex-shrink:0;"><img src="${finalLogoUrl}" alt="${updates.name}" style="max-width:100%; max-height:100%; object-fit:contain;" /></div>`;
      } else {
        logoCell.innerHTML = `<div style="width:34px; height:34px; background:${updates.brandColor || 'var(--ink)'}; color:#FFFFFF; font-family:var(--mono); font-size:11px; font-weight:800; display:flex; align-items:center; justify-content:center; flex-shrink:0;">${initials}</div>`;
      }
    }

    fb.style.cssText = 'display:block; padding:10px 14px; background:#E6F4EA; border:1px solid var(--sage-dark); color:var(--sage-dark); font-family:var(--mono); font-size:12px; font-weight:600; margin-bottom:16px;';
    fb.textContent = '✓ Los cambios han sido guardados correctamente en Supabase.';
    submitBtn.textContent = '✓ Guardado';

    setTimeout(() => {
      window.closeEditModal();
      window.openModal(schoolId);
      submitBtn.disabled    = false;
      submitBtn.textContent = 'Guardar Cambios';
    }, 1000);

  } catch (err) {
    console.error('Error actualizando:', err);
    fb.style.cssText = 'display:block; padding:10px 14px; background:#FEE2E2; border:1px solid var(--danger); color:var(--danger); font-family:var(--mono); font-size:12px; font-weight:600; margin-bottom:16px;';
    fb.textContent = ' No fue posible guardar los cambios: ' + (err.message || 'Error de conexión');
    submitBtn.disabled    = false;
    submitBtn.textContent = 'Guardar Cambios';
  }
};

