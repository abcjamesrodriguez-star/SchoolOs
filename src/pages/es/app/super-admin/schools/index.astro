          </div>
          <div style="display:flex; flex-direction:column; gap:4px; grid-column:span 2;">
            <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink);">Dirección Sede Principal</label>
            <input id="edit-address" type="text" style="border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--sans); font-size:13px;" />
          </div>
          <div style="display:flex; flex-direction:column; gap:4px;">
            <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink);">Teléfono / PBX</label>
            <input id="edit-phone" type="text" style="border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--sans); font-size:13px;" />
          </div>
          <div style="display:flex; flex-direction:column; gap:4px;">
