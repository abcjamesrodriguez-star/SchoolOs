window.saveRector = async function() {
  const submitBtn = document.getElementById('rector-submit-btn');
  const fb        = document.getElementById('rector-feedback');
  const rectorId  = document.getElementById('rector-id').value;

  submitBtn.disabled    = true;
  submitBtn.textContent = 'Guardando…';
  fb.style.display      = 'none';

  const schoolId = document.getElementById('rector-school-id').value;
  const name     = document.getElementById('rector-name').value.trim();
  const email    = document.getElementById('rector-email').value.trim().toLowerCase();
  const password = document.getElementById('rector-password').value.trim();
  const docType  = document.getElementById('rector-doc-type').value;
  const docId    = document.getElementById('rector-doc-id').value.trim();
  const phone    = document.getElementById('rector-phone').value.trim();
  const jobTitle = document.getElementById('rector-job-title').value;
  const specialty= document.getElementById('rector-specialty').value.trim();
  const appDate  = document.getElementById('rector-appointment-date').value;
  const status   = document.getElementById('rector-status').value;

  try {
    const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
    const supabase = createClient(
      'https://tyzeirtdrvlufnkwpron.supabase.co',
      'sb_publishable_416BDuzMEaASLp4BLzqEAQ_jsUgB7Yl'
    );

    let avatarUrl = document.getElementById('rector-avatar-url').value.trim() || null;

    if (window._selectedRectorAvatarFile) {
      submitBtn.textContent = 'Subiendo imagen…';
      const file = window._selectedRectorAvatarFile;
      const fileExt = file.name.split('.').pop() || 'png';
      const filePath = `avatars/rector-${Date.now()}.${fileExt}`;

      const { error: upErr } = await supabase.storage
        .from('school-assets')
        .upload(filePath, file, {
          contentType: file.type || 'image/png',
          cacheControl: '3600',
          upsert: true
        });

      if (!upErr) {
        const { data: stData } = supabase.storage.from('school-assets').getPublicUrl(filePath);
        avatarUrl = stData.publicUrl;
      } else {
        avatarUrl = await new Promise((resolve) => {
          const reader = new FileReader();
          reader.onload = () => resolve(reader.result);
          reader.readAsDataURL(file);
        });
      }
    }

    submitBtn.textContent = 'Registrando directivo…';

    let targetUserId = rectorId;

    if (!targetUserId) {
      const { data: authData, error: authError } = await isolatedAuth.auth.signUp({
        email: email,
        password: password || 'Rector2026!*',
        options: {
          data: {
            name: name,
            role: 'school_admin',
            school_id: schoolId
          }
        }
      });

      if (authError) {
        const { data: existingUser } = await supabase
          .from('users')
          .select('id')
          .eq('email', email)
          .maybeSingle();

        if (existingUser) {
          targetUserId = existingUser.id;
        } else {
          throw authError;
        }
      } else if (authData.user) {
        targetUserId = authData.user.id;
      }
    }

    const profilePayload = {
      name: name,
      email: email,
      role: 'school_admin',
      school_id: schoolId,
      document_type: docType,
      document_id: docId || null,
      phone: phone || null,
      job_title: jobTitle,
      specialty: specialty || null,
      appointment_date: appDate || null,
      avatar_url: avatarUrl,
      status: status,
    };

    if (targetUserId) {
      const { error: upsertErr } = await supabase
        .from('users')
        .upsert({ id: targetUserId, ...profilePayload });

      if (upsertErr) {
        await supabase.from('users').update(profilePayload).eq('email', email);
      }
    }

    await supabase.from('schools').update({
      rector_name: name,
      rector_email: email,
    }).eq('id', schoolId);

    const uIdx = window.USERS.findIndex(u => (targetUserId && u.id === targetUserId) || u.email === email);
    if (uIdx !== -1) {
      window.USERS[uIdx] = {
        ...window.USERS[uIdx],
        ...profilePayload,
        schoolName: (window.SCHOOLS.find(s => s.id === schoolId) || {}).name || 'Colegio'
      };
    } else {
      window.USERS.push({
        id: targetUserId || crypto.randomUUID(),
        ...profilePayload,
        schoolName: (window.SCHOOLS.find(s => s.id === schoolId) || {}).name || 'Colegio',
        createdAt: new Date().toISOString()
      });
    }

    const sIdx = window.SCHOOLS.findIndex(s => s.id === schoolId);
    if (sIdx !== -1) {
      window.SCHOOLS[sIdx].rectorName = name;
      window.SCHOOLS[sIdx].rectorEmail = email;
    }

    fb.style.cssText = 'display:block; padding:10px 14px; background:#E6F4EA; border:1px solid var(--sage-dark); color:var(--sage-dark); font-family:var(--mono); font-size:12px; font-weight:600; margin-bottom:16px;';
    fb.textContent = '✓ Directivo registrado y vinculado correctamente.';
    submitBtn.textContent = '✓ Guardado';

    setTimeout(() => {
      window.closeRectorModal();
      if (typeof window.openModal === 'function' && window._currentSchoolId === schoolId) {
        window.openModal(schoolId);
      }
      submitBtn.disabled = false;
      submitBtn.textContent = 'Registrar Directivo';
    }, 900);

  } catch (err) {
    console.error('Error guardando rector:', err);
    fb.style.cssText = 'display:block; padding:10px 14px; background:#FEE2E2; border:1px solid var(--danger); color:var(--danger); font-family:var(--mono); font-size:12px; font-weight:600; margin-bottom:16px;';
    fb.textContent = '✗ No fue posible registrar el directivo. Intenta de nuevo.';
    submitBtn.disabled = false;
    submitBtn.textContent = 'Registrar Directivo';
  }
};

