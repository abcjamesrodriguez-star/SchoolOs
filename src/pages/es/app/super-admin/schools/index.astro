---
export const prerender = false;

// ============================================================
// SchoolOS — Listado de Escuelas (/es/app/super-admin/schools)
// ============================================================
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { schoolService } from '../../../../../services/schoolService';
import { userService } from '../../../../../services/userService';

const lang = 'es';
let schools: any[] = [];
let users: any[] = [];
try {
  schools = (await schoolService.getSchools()) || [];
} catch (e) {
  console.error('Error fetching schools from Supabase:', e);
  schools = [];
}

try {
  users = (await userService.getUsers()) || [];
} catch (e) {
  console.error('Error fetching users from Supabase:', e);
  users = [];
}

const totalCount = schools.length;
const activeCount = schools.filter((s) => s.status === 'active').length;
const trialCount = schools.filter((s) => s.status === 'trial').length;
const suspendedCount = schools.filter((s) => s.status === 'suspended').length;

function getAuditBadge(auditStatus: string) {
  if (auditStatus === 'under_investigation') return { class: 'badge-investigation', label: 'Bajo investigación' };
  if (auditStatus === 'flagged') return { class: 'badge-flagged', label: 'Marcado' };
  return { class: 'badge-none', label: 'Ninguno' };
}

function getStatusLabel(status: string) {
  switch (status) {
    case 'active': return 'Activa';
    case 'trial': return 'En Prueba';
    case 'suspended': return 'Suspendida';
    case 'cancelled': return 'Cancelada';
    default: return status;
  }
}

function formatSchoolDate(dateStr: string | null | undefined): string {
  if (!dateStr) return '—';
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr;
  return d.toLocaleDateString('es-CO', { year: 'numeric', month: 'short', day: 'numeric' });
}

// Serializar datos para el script cliente
const schoolsJson = JSON.stringify(schools);
const usersJson = JSON.stringify(users);
---

<AppLayout
  title="Escuelas"
  pageTitle="Directorio de Instituciones"
  activeSection="schools"
  lang={lang}
  activeRoute="/app/super-admin/schools"
  breadcrumbs={[{ label: 'Sistema' }, { label: 'Instituciones' }]}
>
  <!-- TOP SUMMARY RIBBON -->
  <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:16px; margin-bottom:24px;">
    <div style="background:var(--paper); border:1px solid var(--ink); padding:16px 20px; border-bottom:3px solid var(--sage-accent);">
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">Total Instituciones</div>
      <div id="stat-total-count" style="font-family:var(--serif); font-size:26px; font-weight:700; color:var(--ink); margin-top:4px;">{totalCount}</div>
      <div style="font-family:var(--mono); font-size:10.5px; color:var(--sage-dark); font-weight:600; margin-top:2px;">Registradas</div>
    </div>
    <div style="background:var(--paper); border:1px solid var(--ink); padding:16px 20px; border-bottom:3px solid var(--sage-dark);">
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">Escuelas Activas</div>
      <div id="stat-active-count" style="font-family:var(--serif); font-size:26px; font-weight:700; color:var(--ink); margin-top:4px;">{activeCount}</div>
      <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft); margin-top:2px;">{totalCount ? Math.round((activeCount / totalCount) * 100) : 100}% del total</div>
    </div>
    <div style="background:var(--paper); border:1px solid var(--ink); padding:16px 20px; border-bottom:3px solid var(--orange-vibrant);">
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">En Periodo Trial</div>
      <div id="stat-trial-count" style="font-family:var(--serif); font-size:26px; font-weight:700; color:var(--orange-vibrant); margin-top:4px;">{trialCount}</div>
      <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft); margin-top:2px;">prom. 9 días restantes</div>
    </div>
    <div style="background:var(--paper); border:1px solid var(--ink); padding:16px 20px; border-bottom:3px solid var(--danger);">
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">Suspendidas</div>
      <div id="stat-suspended-count" style="font-family:var(--serif); font-size:26px; font-weight:700; color:var(--danger); margin-top:4px;">{suspendedCount}</div>
      <div style="font-family:var(--mono); font-size:10.5px; color:var(--danger); margin-top:2px;">requieren revisión</div>
    </div>
  </div>

  <div class="panel">
    <div class="table-toolbar">
      <div class="filter-row" style="align-items:center;">
        <input
          id="school-search"
          type="text"
          placeholder="Filtrar por nombre o dominio..."
          style="border:1px solid var(--ink); background:var(--cream); padding:7px 12px; font-family:var(--sans); font-size:12.5px; width:240px; border-radius:2px;"
        />
        <select id="school-status-filter" class="filter-select" style="border:1px solid var(--ink);" aria-label="Filtrar por estado">
          <option value="">Todos los estados</option>
          <option value="active">Activa</option>
          <option value="trial">En Prueba</option>
          <option value="suspended">Suspendida</option>
          <option value="cancelled">Cancelada</option>
        </select>
        <select id="school-plan-filter" class="filter-select" style="border:1px solid var(--ink);" aria-label="Filtrar por plan">
          <option value="">Todos los planes</option>
          <option value="Starter">Starter</option>
          <option value="Professional">Professional</option>
          <option value="Enterprise">Enterprise</option>
        </select>
      </div>
      <div style="display:flex; gap:10px;">
        <button class="btn btn-secondary" onclick="window.openRectorModal && window.openRectorModal(null, window._currentSchoolId)">+ Registrar Rector</button>
        <a class="btn btn-primary" href={`/${lang}/app/super-admin/schools/new`}>+ Nueva Escuela</a>
      </div>
    </div>

    <div class="panel-body">
      <table class="data-table" id="schools-table">
        <thead>
          <tr>
            <th>Institución Escolar</th>
            <th>Plan de Suscripción</th>
            <th>Estado</th>
            <th>Auditoría</th>
            <th>Estudiantes</th>
            <th>Registro</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="schools-tbody">
          {schools.map((school) => {
            const audit = getAuditBadge(school.auditStatus);
            const initials = school.name.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
            return (
              <tr class="school-row" data-id={school.id} id={`row-${school.id}`}>
                <td class="cell-name">
                  <div style="display:flex; align-items:center; gap:10px;">
                    <div id={`logo-cell-${school.id}`}>
                      {school.logoUrl ? (
                        <div style="width:34px; height:34px; border:1px solid var(--ink); background:#FFFFFF; padding:2px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                          <img src={school.logoUrl} alt={school.name} style="max-width:100%; max-height:100%; object-fit:contain;" />
                        </div>
                      ) : (
                        <div style={`width:34px; height:34px; background:${school.brandColor || 'var(--ink)'}; color:#FFFFFF; font-family:var(--mono); font-size:11px; font-weight:800; display:flex; align-items:center; justify-content:center; flex-shrink:0;`}>
                          {initials}
                        </div>
                      )}
                    </div>
                    <div>
                      <div id={`name-cell-${school.id}`} style="font-size:14px; font-weight:700; color:var(--ink);">{school.name}</div>
                      <div id={`domain-cell-${school.id}`} style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">{school.domain}</div>
                    </div>
                  </div>
                </td>
                <td id={`plan-cell-${school.id}`}><span class="plan-tag">{school.planName}</span></td>
                <td id={`status-cell-${school.id}`}>
                  <span class={`badge badge-${school.status}`}>
                    {getStatusLabel(school.status)}
                  </span>
                </td>
                <td>
                  <span class={`badge ${audit.class}`}>{audit.label}</span>
                </td>
                <td style="font-family:var(--mono); font-size:12.5px;">
                  <span style="font-weight:700; color:var(--ink);">{school.studentCount.toLocaleString()}</span>
                  <span style="color:var(--ink-soft); font-size:11px;"> / {school.planName === 'Starter' ? '200' : school.planName === 'Enterprise' ? '5,000' : '1,500'}</span>
                </td>
                <td class="cell-muted">{formatSchoolDate(school.createdAt)}</td>
                <td class="cell-actions">
                  <button
                    class="btn btn-secondary btn-sm open-modal-btn"
                    data-school-id={school.id}
                    onclick={`window.openModal && window.openModal('${school.id}')`}
                    type="button"
                  >
                    Ver Ficha →
                  </button>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>

      {schools.length === 0 && (
        <div style="padding:48px; text-align:center; font-family:var(--mono); color:var(--ink-soft);">
          <div style="font-size:32px; margin-bottom:12px;"></div>
          <div style="font-weight:700; color:var(--ink); margin-bottom:6px;">No hay instituciones registradas</div>
          <div style="font-size:12px;">Crea la primera escuela desde el botón "Nueva Escuela".</div>
        </div>
      )}
    </div>
  </div>
</AppLayout>

<!-- ============================================================ -->
<!-- MODAL: FICHA INSTITUCIONAL (DISTRIBUCIÓN EQUILIBRADA)       -->
<!-- ============================================================ -->
<div
  id="school-modal-overlay"
  style="display:none; position:fixed; inset:0; background:rgba(18,17,14,0.75); z-index:1000; align-items:center; justify-content:center; padding:20px;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-school-name"
>
  <div
    id="school-modal-panel"
    style="
      background:var(--paper);
      border:2px solid var(--ink);
      width:min(900px, 95vw);
      max-height:90vh;
      display:flex;
      flex-direction:column;
      opacity:0;
      transform:scale(0.97);
      transition:opacity 0.2s ease, transform 0.2s ease;
      box-shadow:8px 8px 0 var(--ink);
      overflow:hidden;
    "
  >
    <!-- 1. CABECERA INSTITUCIONAL EQUILIBRADA -->
    <div style="border-bottom:2px solid var(--ink); padding:16px 24px; background:var(--cream); display:flex; align-items:center; justify-content:space-between; gap:16px; flex-shrink:0;">
      <div style="display:flex; align-items:center; gap:14px; min-width:0;">
        <div
          id="modal-logo-container"
          style="width:58px; height:58px; border:2px solid var(--ink); background:#FFFFFF; padding:4px; display:flex; align-items:center; justify-content:center; flex-shrink:0; box-shadow:2px 2px 0 var(--ink);"
        ></div>

        <div style="min-width:0;">
          <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:var(--ink-soft); font-weight:700;">
            FICHA INSTITUCIONAL
          </div>
          <h2 id="modal-school-name" style="font-family:var(--serif); font-size:21px; font-weight:700; color:var(--ink); margin:2px 0 2px; line-height:1.2;">—</h2>
          <div id="modal-school-slogan" style="font-style:italic; font-size:12.5px; color:var(--ink-soft);"></div>
        </div>
      </div>

      <div style="display:flex; align-items:center; gap:10px; flex-shrink:0;">
        <div id="modal-header-badges" style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;"></div>
        <button
          id="modal-close-btn"
          type="button"
          onclick="window.closeModal && window.closeModal()"
          style="
            width:34px; height:34px; border:2px solid var(--ink); background:var(--paper);
            cursor:pointer; font-size:16px; font-weight:700; display:flex; align-items:center; justify-content:center;
            color:var(--ink); flex-shrink:0; box-shadow:2px 2px 0 var(--ink);
          "
          aria-label="Cerrar ficha"
        >✕</button>
      </div>
    </div>

    <!-- 2. FRANJA HORIZONTAL DE 4 MÉTRICAS CLAVE -->
    <div id="modal-stats-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); border-bottom:2px solid var(--ink); background:var(--paper); flex-shrink:0;"></div>

    <!-- 3. CUERPO DEL EXPEDIENTE (DOSSIER INTEGRAL) -->
    <div style="padding:20px 24px; display:flex; flex-direction:column; gap:18px; background:var(--paper); flex:1; overflow-y:auto; min-height:0;">
      
      <!-- SECCIÓN A: RECTORÍA & DIRECCIÓN GENERAL -->
      <div style="border:1.5px solid var(--ink); background:var(--cream); padding:12px 16px; box-shadow:3px 3px 0 var(--ink);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; padding-bottom:4px; border-bottom:1px solid var(--line);">
          <span style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink); font-weight:800;">
            01 · Dirección Institucional & Representación
          </span>
          <button id="modal-manage-rector-btn" class="btn btn-secondary btn-sm" type="button" style="font-size:9.5px; padding:2px 8px; font-weight:700;">
            + Asignar / Cambiar
          </button>
        </div>
        <div id="modal-rector-content"></div>
      </div>

      <!-- SECCIÓN B: DATOS TÉCNICOS & SEDE (2 COLUMNAS CONTINUAS) -->
      <div>
        <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink); font-weight:800; margin-bottom:10px; padding-bottom:4px; border-bottom:1.5px solid var(--ink);">
          02 · Especificaciones del Tenant & Sede Principal
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; align-items:start;">
          <div id="modal-col-left" style="display:flex; flex-direction:column;"></div>
          <div id="modal-col-right" style="display:flex; flex-direction:column;"></div>
        </div>
      </div>

    </div>

    <!-- 4. FOOTER ACCIONES -->
    <div style="padding:12px 24px; display:flex; gap:10px; justify-content:space-between; align-items:center; border-top:2px solid var(--ink); background:var(--paper); flex-shrink:0;">
      <div style="display:flex; gap:8px; align-items:center;">
        <button id="modal-view-full-btn" class="btn btn-secondary btn-sm" type="button" onclick="if(window._currentSchoolId) window.location.href='/es/app/super-admin/schools/' + window._currentSchoolId;" style="font-weight:700;">
          Ver Ficha Completa →
        </button>
        <button type="button" class="btn btn-danger btn-sm" onclick="window.purgeSchool && window.purgeSchool(window._currentSchoolId)" title="Eliminar definitivamente toda la institución">
          🗑 Eliminar Escuela
        </button>
      </div>
      <div style="display:flex; gap:10px; align-items:center;">
        <button class="btn btn-secondary btn-sm" type="button" onclick="window.closeModal()">Cerrar</button>
        <button id="modal-suspend-btn" class="btn btn-danger btn-sm" type="button" onclick="window.suspendSchool && window.suspendSchool(window._currentSchoolId)">Suspender</button>
        <button id="modal-edit-btn" class="btn btn-primary btn-sm" type="button" onclick="if(window._currentSchoolId) window.openEditModal(window._currentSchoolId);">
           Editar Escuela
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================ -->
<!-- MODAL: EDICIÓN DE INSTITUCIÓN (DISTRIBUCIÓN NATURAL)        -->
<!-- ============================================================ -->
<div
  id="edit-modal-overlay"
  style="display:none; position:fixed; inset:0; background:rgba(18,17,14,0.75); z-index:1100; align-items:center; justify-content:center; padding:20px;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="edit-modal-title"
>
  <div
    id="edit-modal-panel"
    style="
      background:var(--paper);
      border:2px solid var(--ink);
      width:min(800px, 95vw);
      max-height:90vh;
      display:flex;
      flex-direction:column;
      opacity:0;
      transform:scale(0.97);
      transition:opacity 0.22s ease, transform 0.22s ease;
      box-shadow:8px 8px 0 var(--ink);
      overflow:hidden;
    "
  >
    <!-- EDIT HEADER -->
    <div style="border-bottom:2px solid var(--ink); padding:16px 24px; display:flex; align-items:center; justify-content:space-between; background:var(--cream); flex-shrink:0;">
      <div>
        <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:2px;">Configuración de Escuela</div>
        <h2 id="edit-modal-title" style="font-family:var(--serif); font-size:19px; font-weight:700; color:var(--ink); margin:0;">Editar Escuela</h2>
      </div>
      <button
        id="edit-modal-close-btn"
        type="button"
        onclick="window.closeEditModal && window.closeEditModal()"
        style="width:32px; height:32px; border:2px solid var(--ink); background:var(--paper); cursor:pointer; font-size:16px; font-weight:700; display:flex; align-items:center; justify-content:center; color:var(--ink); box-shadow:2px 2px 0 var(--ink);"
        aria-label="Cerrar editor"
      >✕</button>
    </div>

    <!-- FORM CON SCROLL -->
    <form id="edit-school-form" style="padding:22px 24px; display:flex; flex-direction:column; gap:16px; flex:1; overflow-y:auto; min-height:0; background:var(--paper);">
      <input type="hidden" id="edit-school-id" />

      <!-- BLOQUE 1: IDENTIDAD & ESCUDO INTEGRADO -->
      <div style="background:var(--cream); border:1.5px solid var(--ink); padding:16px; box-shadow:3px 3px 0 var(--ink);">
        <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink); font-weight:800; margin-bottom:12px; padding-bottom:4px; border-bottom:1px solid var(--line);">
          01 · Identidad & Escudo Oficial
        </div>

        <div style="display:grid; grid-template-columns:110px 1fr; gap:16px; align-items:start;">
          <!-- Escudo a la izquierda -->
          <div style="display:flex; flex-direction:column; align-items:center; gap:6px;">
            <div id="edit-logo-preview-box" style="width:90px; height:90px; border:2px solid var(--ink); background:#FFFFFF; display:flex; align-items:center; justify-content:center; overflow:hidden; box-shadow:2px 2px 0 var(--ink);">
              <img id="edit-logo-preview-img" src="" alt="Escudo" style="max-width:100%; max-height:100%; object-fit:contain; display:none;" />
              <div id="edit-logo-placeholder" style="font-family:var(--mono); font-size:9.5px; color:var(--ink-soft); font-weight:700; text-align:center;">ESCUDO</div>
            </div>
            <input type="file" id="edit-logo-file-input" accept="image/png,image/jpeg,image/webp,image/svg+xml" style="display:none;" />
            <input type="hidden" id="edit-logo-url" />
            <button type="button" id="edit-btn-upload-logo" class="btn btn-secondary btn-sm" style="font-size:9.5px; width:100%; padding:4px; font-weight:700;">
              Subir Escudo
            </button>
            <button type="button" id="edit-btn-remove-logo" style="background:none; border:none; color:var(--danger); font-size:9.5px; font-family:var(--mono); cursor:pointer; display:none;">
              ✕ Quitar
            </button>
          </div>

          <!-- Campos a la derecha -->
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
            <div style="display:flex; flex-direction:column; gap:4px; grid-column:span 2;">
              <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink);">Nombre Oficial *</label>
              <input id="edit-name" type="text" required style="border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--sans); font-size:13.5px;" />
            </div>
            <div style="display:flex; flex-direction:column; gap:4px;">
              <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink);">Slug / Subdominio</label>
              <input id="edit-slug" type="text" style="border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--mono); font-size:12.5px;" />
            </div>
            <div style="display:flex; flex-direction:column; gap:4px;">
              <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink);">Color Institucional</label>
              <div style="display:flex; gap:6px; align-items:center;">
                <input id="edit-brand-color-picker" type="color" style="width:36px; height:34px; border:1.5px solid var(--ink); cursor:pointer; padding:1px; background:#FFFFFF;" />
                <input id="edit-brand-color" type="text" placeholder="#12110E" style="border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--mono); font-size:12.5px; flex:1;" />
              </div>
            </div>
            <div style="display:flex; flex-direction:column; gap:4px; grid-column:span 2;">
              <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink);">Lema / Slogan</label>
              <input id="edit-slogan" type="text" placeholder="Frase institucional (opcional)" style="border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--sans); font-size:13px; font-style:italic;" />
            </div>
          </div>
        </div>
      </div>

      <!-- BLOQUE 2: CONTACTO & UBICACIÓN -->
      <div style="background:var(--cream); border:1.5px solid var(--ink); padding:16px; box-shadow:3px 3px 0 var(--ink);">
        <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink); font-weight:800; margin-bottom:12px; padding-bottom:4px; border-bottom:1px solid var(--line);">
          02 · Contacto & Ubicación de la Sede
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
          <div style="display:flex; flex-direction:column; gap:4px;">
            <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink);">Dominio Oficial</label>
            <input id="edit-domain" type="text" style="border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--mono); font-size:12px;" />
          </div>
          <div style="display:flex; flex-direction:column; gap:4px;">
            <label style="font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink);">Correo Oficial *</label>
            <input id="edit-contact-email" type="email" required style="border:1.5px solid var(--ink); background:var(--paper); padding:8px 10px; font-family:var(--sans); font-size:13px;" />
