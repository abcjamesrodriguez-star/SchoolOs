  <!-- SCRIPT DEL WIZARD (VITE BUNDLED) -->
  <script>
    const fetchAuth = (window as any).fetchAuth;

    let currentStep = 1;
    let selectedLogoFile = null;
    let selectedRectorAvatarFile = null;

    // Elementos UI
    const stepTitles = [
      'IDENTIDAD, BRANDING & LOGOTIPO',
      'UBICACIÓN, SEDES & CONTACTO',
      'PLAN DE SUSCRIPCIÓN & CAPACIDAD',
      'RECTORÍA & APROVISIONAMIENTO'
    ];

    const tabStep1 = document.getElementById('tabStep1');
    const tabStep2 = document.getElementById('tabStep2');
    const tabStep3 = document.getElementById('tabStep3');
    const tabStep4 = document.getElementById('tabStep4');
    const tabs = [tabStep1, tabStep2, tabStep3, tabStep4];

    const stepContent1 = document.getElementById('stepContent1');
    const stepContent2 = document.getElementById('stepContent2');
    const stepContent3 = document.getElementById('stepContent3');
    const stepContent4 = document.getElementById('stepContent4');
    const contents = [stepContent1, stepContent2, stepContent3, stepContent4];

    const currentStepBadge = document.getElementById('currentStepBadge');
    const stepHeaderTitle = document.getElementById('stepHeaderTitle');
    const btnPrevStep = document.getElementById('btnPrevStep');
    const btnNextStep = document.getElementById('btnNextStep');
    const btnSubmitWizard = document.getElementById('btnSubmitWizard');

    // Inputs para Auto-Slug y Resumen
    const inputName = document.getElementById('schoolName');
    const inputSlug = document.getElementById('schoolSlug');
    const inputCountry = document.getElementById('country');
    const inputContactEmail = document.getElementById('contactEmail');
    const inputRectorName = document.getElementById('rectorName');
    const inputRectorEmail = document.getElementById('rectorEmail');
    const inputRectorPhone = document.getElementById('rectorPhone');
    const selectRectorDocType = document.getElementById('rectorDocType');
    const inputRectorDocId = document.getElementById('rectorDocId');
    const selectRectorJobTitle = document.getElementById('rectorJobTitle');
    const selectRectorStatus = document.getElementById('rectorAccountStatus');
    const inputRectorPassword = document.getElementById('rectorPassword');
    const btnGenerateRectorPass = document.getElementById('btnGenerateRectorPass');
    const inputBrandColor = document.getElementById('brandColor');
    const inputBrandColorHex = document.getElementById('brandColorHex');

    // Auto-generar slug al escribir el nombre
    inputName?.addEventListener('input', () => {
      if (!inputSlug.dataset.manualEdited) {
        const slugified = inputName.value
          .toLowerCase()
          .trim()
          .replace(/[áàäâ]/g, 'a')
          .replace(/[éèëê]/g, 'e')
          .replace(/[íìïî]/g, 'i')
          .replace(/[óòöô]/g, 'o')
          .replace(/[úùüû]/g, 'u')
          .replace(/ñ/g, 'n')
          .replace(/[^a-z0-9]/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-|-$/g, '');
        inputSlug.value = slugified;
      }
    });

    inputSlug?.addEventListener('input', () => {
      inputSlug.dataset.manualEdited = 'true';
    });

    // Sincronizar Color Pickers
    inputBrandColor?.addEventListener('input', () => {
      if (inputBrandColorHex) inputBrandColorHex.value = inputBrandColor.value;
    });
    inputBrandColorHex?.addEventListener('input', () => {
      if (inputBrandColor) inputBrandColor.value = inputBrandColorHex.value;
    });

    // Generar Contraseña Segura para Rector
    btnGenerateRectorPass?.addEventListener('click', () => {
      const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@#$%';
      let pass = '';
      for (let i = 0; i < 12; i++) {
        pass += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      if (inputRectorPassword) inputRectorPassword.value = pass;
    });

    // Selección de Planes
    const planCards = document.querySelectorAll('.plan-select-card');
    planCards.forEach((card) => {
      card.addEventListener('click', () => {
        planCards.forEach((c) => {
          c.classList.remove('active');
          c.style.borderColor = 'var(--line-strong)';
          c.style.background = 'var(--paper)';
        });
        card.classList.add('active');
        card.style.borderColor = 'var(--orange-vibrant)';
        card.style.background = 'var(--cream)';
        const radio = card.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;
      });
    });

    // Manejo de Subida de Logo de Escuela & Previsualización
    const logoFileInput = document.getElementById('logoFileInput');
    const btnUploadLogo = document.getElementById('btnUploadLogo');
    const btnRemoveLogo = document.getElementById('btnRemoveLogo');
    const logoPreviewImg = document.getElementById('logoPreviewImg');
    const logoPlaceholder = document.getElementById('logoPlaceholder');

    btnUploadLogo?.addEventListener('click', (e) => {
      e.preventDefault();
      logoFileInput?.click();
    });

    logoFileInput?.addEventListener('change', () => {
      const file = logoFileInput.files?.[0];
      if (file) {
        if (file.size > 5 * 1024 * 1024) {
          if (window.showAlertModal) {
            window.showAlertModal({ title: 'Archivo muy grande', message: 'El logo no debe exceder los 5MB.', type: 'warning' });
          } else {
            alert('El logo no debe exceder los 5MB.');
          }
          return;
        }
        selectedLogoFile = file;
        const reader = new FileReader();
        reader.onload = (e) => {
          if (logoPreviewImg && logoPlaceholder) {
            logoPreviewImg.src = e.target?.result;
            logoPreviewImg.style.display = 'block';
            logoPlaceholder.style.display = 'none';
            if (btnRemoveLogo) btnRemoveLogo.style.display = 'inline-block';
          }
        };
        reader.readAsDataURL(file);
      }
    });

    btnRemoveLogo?.addEventListener('click', () => {
      selectedLogoFile = null;
      if (logoFileInput) logoFileInput.value = '';
      if (logoPreviewImg && logoPlaceholder) {
        logoPreviewImg.src = '';
        logoPreviewImg.style.display = 'none';
        logoPlaceholder.style.display = 'block';
        if (btnRemoveLogo) btnRemoveLogo.style.display = 'none';
      }
    });

    // Manejo de Subida de Foto del Rector & Previsualización
    const rectorAvatarFileInput = document.getElementById('rectorAvatarFileInput');
    const btnUploadRectorAvatar = document.getElementById('btnUploadRectorAvatar');
    const btnRemoveRectorAvatar = document.getElementById('btnRemoveRectorAvatar');
    const rectorAvatarPreviewImg = document.getElementById('rectorAvatarPreviewImg');
    const rectorAvatarPlaceholder = document.getElementById('rectorAvatarPlaceholder');

    btnUploadRectorAvatar?.addEventListener('click', (e) => {
      e.preventDefault();
      rectorAvatarFileInput?.click();
    });

    rectorAvatarFileInput?.addEventListener('change', () => {
      const file = rectorAvatarFileInput.files?.[0];
      if (file) {
        if (file.size > 5 * 1024 * 1024) {
          if (window.showAlertModal) {
            window.showAlertModal({ title: 'Archivo muy grande', message: 'La foto del rector no debe exceder los 5MB.', type: 'warning' });
          } else {
            alert('La foto del rector no debe exceder los 5MB.');
          }
          return;
        }
        selectedRectorAvatarFile = file;
        const reader = new FileReader();
        reader.onload = (e) => {
          if (rectorAvatarPreviewImg && rectorAvatarPlaceholder) {
            rectorAvatarPreviewImg.src = e.target?.result;
            rectorAvatarPreviewImg.style.display = 'block';
            rectorAvatarPlaceholder.style.display = 'none';
            if (btnRemoveRectorAvatar) btnRemoveRectorAvatar.style.display = 'inline-block';
          }
        };
        reader.readAsDataURL(file);
      }
    });

    btnRemoveRectorAvatar?.addEventListener('click', () => {
      selectedRectorAvatarFile = null;
      if (rectorAvatarFileInput) rectorAvatarFileInput.value = '';
      if (rectorAvatarPreviewImg && rectorAvatarPlaceholder) {
        rectorAvatarPreviewImg.src = '';
        rectorAvatarPreviewImg.style.display = 'none';
        rectorAvatarPlaceholder.style.display = 'block';
        if (btnRemoveRectorAvatar) btnRemoveRectorAvatar.style.display = 'none';
      }
    });

    // Cambiar de Paso
    function goToStep(step) {
      if (step < 1 || step > 4) return;
      currentStep = step;

      // Actualizar Tabs
      tabs.forEach((tab, i) => {
        if (i + 1 === currentStep) {
          tab?.classList.add('active');
          if (tab) {
            tab.style.borderLeftColor = 'var(--orange-vibrant)';
            tab.style.opacity = '1';
          }
        } else {
          tab?.classList.remove('active');
          if (tab) {
            tab.style.borderLeftColor = 'transparent';
            tab.style.opacity = i + 1 < currentStep ? '0.9' : '0.65';
          }
        }
      });

      // Actualizar Contenidos
      contents.forEach((content, i) => {
        if (content) content.style.display = i + 1 === currentStep ? 'block' : 'none';
      });

      // Actualizar Encabezado
      if (currentStepBadge) currentStepBadge.textContent = `PASO 0${currentStep} DE 04`;
      if (stepHeaderTitle) stepHeaderTitle.textContent = stepTitles[currentStep - 1];

      // Actualizar Botones
      if (btnPrevStep) btnPrevStep.style.display = currentStep > 1 ? 'inline-block' : 'none';
      if (btnNextStep) btnNextStep.style.display = currentStep < 4 ? 'inline-block' : 'none';
      if (btnSubmitWizard) btnSubmitWizard.style.display = currentStep === 4 ? 'inline-block' : 'none';

      // Actualizar Resumen en Paso 4
      if (currentStep === 4) {
        updateStep4Summary();
      }
    }

    function updateStep4Summary() {
      const sumName = document.getElementById('sumSchoolName');
      const sumSlug = document.getElementById('sumSlug');
      const sumLocation = document.getElementById('sumLocation');
      const sumPlan = document.getElementById('sumPlan');
      const sumRector = document.getElementById('sumRector');
      const sumRectorEmail = document.getElementById('sumRectorEmail');
      const sumRectorJob = document.getElementById('sumRectorJob');
      const sumRectorDoc = document.getElementById('sumRectorDoc');
      const selectedPlan = document.querySelector('input[name="planChoice"]:checked')?.value;

      if (sumName) sumName.textContent = inputName.value.trim() || '-';
      if (sumSlug) sumSlug.textContent = inputSlug.value.trim() ? `${inputSlug.value.trim()}.schoolos.com` : '-';
      if (sumLocation) sumLocation.textContent = inputCountry.value.trim() || '-';
      if (sumPlan) sumPlan.textContent = selectedPlan || 'Professional';
      if (sumRector) sumRector.textContent = inputRectorName.value.trim() || '-';
      if (sumRectorEmail) sumRectorEmail.textContent = inputRectorEmail.value.trim() || '-';
      if (sumRectorJob) sumRectorJob.textContent = selectRectorJobTitle?.value || 'Rector General';
      if (sumRectorDoc) sumRectorDoc.textContent = inputRectorDocId?.value.trim() ? `${selectRectorDocType?.value || 'CC'} ${inputRectorDocId.value.trim()}` : 'Sin registrar';
    }

    // Escuchar cambios en tiempo real para actualizar el resumen
    [inputName, inputSlug, inputCountry, inputRectorName, inputRectorEmail, inputRectorPhone, inputRectorDocId].forEach(el => {
      el?.addEventListener('input', updateStep4Summary);
    });
    [selectRectorJobTitle, selectRectorDocType, selectRectorStatus].forEach(el => {
      el?.addEventListener('change', updateStep4Summary);
    });
    document.querySelectorAll('input[name="planChoice"]').forEach(el => {
      el.addEventListener('change', updateStep4Summary);
    });

    btnNextStep?.addEventListener('click', async () => {
      // Validaciones por paso
      if (currentStep === 1) {
        if (!inputName.value.trim()) {
          if (window.showAlertModal) await window.showAlertModal({ title: 'Campo Requerido', message: 'Por favor ingresa el nombre oficial de la escuela.', type: 'warning' });
          else alert('Por favor ingresa el nombre oficial de la escuela.');
          inputName.focus();
          return;
        }
        if (!inputSlug.value.trim()) {
          if (window.showAlertModal) await window.showAlertModal({ title: 'Campo Requerido', message: 'Por favor ingresa un subdominio/slug válido.', type: 'warning' });
          else alert('Por favor ingresa un subdominio/slug válido.');
          inputSlug.focus();
          return;
        }
      } else if (currentStep === 2) {
        if (!inputCountry.value.trim()) {
          if (window.showAlertModal) await window.showAlertModal({ title: 'Campo Requerido', message: 'Por favor ingresa la ciudad y país.', type: 'warning' });
          else alert('Por favor ingresa la ciudad y país.');
          inputCountry.focus();
          return;
        }
        if (!inputContactEmail.value.trim() || !inputContactEmail.value.includes('@')) {
          if (window.showAlertModal) await window.showAlertModal({ title: 'Correo Inválido', message: 'Por favor ingresa un correo de contacto válido.', type: 'warning' });
          else alert('Por favor ingresa un correo de contacto válido.');
          inputContactEmail.focus();
          return;
        }
      }
      goToStep(currentStep + 1);
    });

    btnPrevStep?.addEventListener('click', () => goToStep(currentStep - 1));

    // Clicks directos en tabs
    tabs.forEach((tab, index) => {
      tab?.addEventListener('click', () => goToStep(index + 1));
    });

    // ============================================================
    // GESTIÓN DEL MODAL DE PROGRESO Y PROVISIÓN
    // ============================================================
    const provModalOverlay = document.getElementById('provisioning-modal-overlay');
    const provModalPanel = document.getElementById('provisioning-modal-panel');
    const provProgressBar = document.getElementById('prov-progress-bar');
    const provProgressPercent = document.getElementById('prov-progress-percent');
    const provLoadingView = document.getElementById('prov-loading-view');
    const provSuccessView = document.getElementById('prov-success-view');
    const provErrorView = document.getElementById('prov-error-view');
    const provErrorMessage = document.getElementById('prov-error-message');
    const provModalBadge = document.getElementById('prov-modal-badge');
    const provModalTitle = document.getElementById('prov-modal-title');
    const provHeaderIcon = document.getElementById('prov-header-icon');

    function openProvModal() {
      if (!provModalOverlay || !provModalPanel) return;
      provModalOverlay.style.display = 'flex';
      provLoadingView.style.display = 'block';
      provSuccessView.style.display = 'none';
      provErrorView.style.display = 'none';
      
      provModalBadge.textContent = 'DESPLIEGUE MULTI-TENANT EN PROGRESO';
      provModalBadge.style.color = 'var(--rust)';
      provModalTitle.textContent = 'Aprovisionando Institución...';
      provHeaderIcon.textContent = '⚙️';

      // Reset steps
      updateStepUI(1, 'active', 'Subiendo escudo institucional y fotografía...', '⏳');
      updateStepUI(2, 'waiting', 'Configurando escuela, subdominio y parámetros de sede...', '⏱');
      updateStepUI(3, 'waiting', 'Creando cuenta y perfil de directivo en estado Invitado...', '⏱');
      updateStepUI(4, 'waiting', 'Firmando ticket de 24h y despachando correo de activación...', '⏱');

      setProvProgress(15);

      requestAnimationFrame(() => {
        provModalOverlay.style.opacity = '1';
        provModalPanel.style.transform = 'scale(1)';
      });
    }

    function setProvProgress(pct) {
      if (provProgressBar) provProgressBar.style.width = pct + '%';
      if (provProgressPercent) provProgressPercent.textContent = pct + '%';
    }

    function updateStepUI(stepNum, state, desc, spin) {
      const item = document.getElementById(`step-item-${stepNum}`);
      const icon = document.getElementById(`step-icon-${stepNum}`);
      const descEl = document.getElementById(`step-desc-${stepNum}`);
      const spinEl = document.getElementById(`step-spin-${stepNum}`);

      if (desc && descEl) descEl.textContent = desc;
      if (spin && spinEl) spinEl.textContent = spin;

      if (state === 'active') {
        if (item) { item.style.opacity = '1'; item.style.borderColor = 'var(--orange-vibrant)'; item.style.background = 'var(--cream)'; }
        if (icon) { icon.textContent = String(stepNum); icon.style.background = 'var(--orange-vibrant)'; icon.style.color = '#FFFFFF'; }
        if (spinEl) spinEl.textContent = '⏳';
      } else if (state === 'done') {
        if (item) { item.style.opacity = '1'; item.style.borderColor = 'var(--sage-dark)'; item.style.background = '#E6F4EA'; }
        if (icon) { icon.textContent = '✓'; icon.style.background = 'var(--sage-dark)'; icon.style.color = '#FFFFFF'; }
        if (spinEl) spinEl.textContent = '✓';
      } else if (state === 'waiting') {
        if (item) { item.style.opacity = '0.55'; item.style.borderColor = 'var(--line)'; item.style.background = 'var(--paper)'; }
        if (icon) { icon.textContent = String(stepNum); icon.style.background = 'var(--cream)'; icon.style.color = 'var(--ink)'; }
        if (spinEl) spinEl.textContent = '⏱';
      }
    }

    function showProvSuccess(school, rectorData) {
      setProvProgress(100);
      setTimeout(() => {
        provLoadingView.style.display = 'none';
        provSuccessView.style.display = 'block';

        provModalBadge.textContent = 'APROVISIONAMIENTO COMPLETADO';
        provModalBadge.style.color = 'var(--sage-dark)';
        provModalTitle.textContent = '¡Despliegue Exitoso!';
        provHeaderIcon.textContent = '✓';

        document.getElementById('success-school-name').textContent = school.name || '-';
        document.getElementById('success-school-domain').textContent = school.domain || `${school.slug}.schoolos.com`;
        document.getElementById('success-rector-name').textContent = inputRectorName.value.trim() || '-';
        document.getElementById('success-rector-email').textContent = inputRectorEmail.value.trim() || '-';

        const jwtText = document.getElementById('success-jwt-text');
        if (rectorData?.emailSent) {
          jwtText.innerHTML = `Correo institucional despachado con éxito a <strong>${inputRectorEmail.value.trim()}</strong> con el enlace de confirmación JWT de 24 horas.`;
        } else {
          jwtText.innerHTML = `Directivo registrado en estado <strong>Invitación Pendiente</strong>. El enlace JWT de activación se encuentra listo para su uso.`;
        }

        if (rectorData?.confirmUrl) {
          const fallbackContainer = document.getElementById('success-fallback-link-container');
          const btnCopy = document.getElementById('btnCopySuccessLink');
          if (fallbackContainer) fallbackContainer.style.display = 'block';
          if (btnCopy) {
            btnCopy.onclick = async () => {
              try {
                await navigator.clipboard.writeText(rectorData.confirmUrl);
                btnCopy.textContent = '✓ Enlace de Activación Copiado';
                setTimeout(() => { btnCopy.textContent = '📋 Copiar Enlace Directo de Activación'; }, 3000);
              } catch {}
            };
          }
        }
      }, 500);
    }

    function showProvError(errMsg) {
      provLoadingView.style.display = 'none';
      provErrorView.style.display = 'block';

      provModalBadge.textContent = 'ERROR EN EL PROCESO';
      provModalBadge.style.color = 'var(--danger)';
      provModalTitle.textContent = 'Fallo en Aprovisionamiento';
      provHeaderIcon.textContent = '⚠️';

      if (provErrorMessage) provErrorMessage.textContent = errMsg || 'Ocurrió un error inesperado al aprovisionar la institución.';
    }

    document.getElementById('btnGoToSchools')?.addEventListener('click', () => {
      window.location.href = '/es/app/super-admin/schools';
    });

    document.getElementById('btnCloseErrorModal')?.addEventListener('click', () => {
      if (provModalOverlay) provModalOverlay.style.display = 'none';
      if (btnSubmitWizard) {
        btnSubmitWizard.disabled = false;
        btnSubmitWizard.textContent = 'Crear Institución en Supabase';
      }
    });

    // ENVÍO FINAL DEL WIZARD A SUPABASE CON MODAL DE PROGRESO INTERACTIVO
    document.getElementById('wizardSchoolForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!inputRectorName.value.trim()) {
        if (window.showAlertModal) await window.showAlertModal({ title: 'Campo Requerido', message: 'Por favor ingresa el nombre del rector.', type: 'warning' });
        else alert('Por favor ingresa el nombre del rector.');
        goToStep(4);
        inputRectorName.focus();
        return;
      }
      if (!inputRectorEmail.value.trim() || !inputRectorEmail.value.includes('@')) {
        if (window.showAlertModal) await window.showAlertModal({ title: 'Correo Requerido', message: 'Por favor ingresa el correo oficial del rector.', type: 'warning' });
        else alert('Por favor ingresa el correo del rector.');
        goToStep(4);
        inputRectorEmail.focus();
        return;
      }
      if (!inputRectorDocId?.value.trim() || !inputRectorPhone?.value.trim()) {
        if (window.showAlertModal) {
          await window.showAlertModal({
            title: 'Verificación de Identidad Requerida',
            message: 'Para la activación segura JWT es obligatorio ingresar el número de cédula/documento y el teléfono de contacto del directivo.',
            type: 'warning'
          });
        } else {
          alert('Para la activación segura JWT es obligatorio ingresar la cédula y teléfono del rector.');
        }
        goToStep(4);
        if (!inputRectorDocId?.value.trim()) inputRectorDocId.focus();
        else inputRectorPhone.focus();
        return;
      }

      // Abrir modal de progreso
      openProvModal();

      try {
        const slug = inputSlug.value.trim();
        let logoUrl = undefined;
        let rectorAvatarUrl = undefined;

        // FASE 1: SUBIR ARCHIVOS A STORAGE (via endpoint seguro)
        updateStepUI(1, 'active', 'Subiendo archivos institucionales a Supabase Storage...');
        setProvProgress(25);

        if (selectedLogoFile) {
          const fd = new FormData();
          fd.append('file', selectedLogoFile);
          fd.append('type', 'logo');
          fd.append('slug', slug);
          const uploadRes = await fetchAuth('/api/admin/upload-asset', { method: 'POST', body: fd });
          const uploadData = await uploadRes.json();
          if (uploadData.ok) {
            logoUrl = uploadData.url;
          } else {
            console.warn('Error subiendo logo:', uploadData.error);
          }
        }

        if (selectedRectorAvatarFile) {
          const fd = new FormData();
          fd.append('file', selectedRectorAvatarFile);
          fd.append('type', 'avatar');
          fd.append('slug', slug + '-rector');
          const uploadRes = await fetchAuth('/api/admin/upload-asset', { method: 'POST', body: fd });
          const uploadData = await uploadRes.json();
          if (uploadData.ok) {
            rectorAvatarUrl = uploadData.url;
          } else {
            console.warn('Error subiendo avatar del rector:', uploadData.error);
          }
        }

        updateStepUI(1, 'done', 'Archivos multimedia procesados correctamente.');

        // FASE 2: CREAR INSTITUCIÓN via API segura (service_role en servidor)
        updateStepUI(2, 'active', `Creando registro institucional "${inputName.value.trim()}"...`);
        setProvProgress(50);

        const selectedPlan = document.querySelector('input[name="planChoice"]:checked')?.value || 'Professional';
        const schoolStatus = document.getElementById('schoolStatus')?.value || 'active';

        const createRes = await fetchAuth('/api/admin/school', {
          method: 'POST',
          body: JSON.stringify({
            action: 'create_school',
            school: {
              name: inputName.value.trim(),
              slug: slug,
              domain: `${slug}.schoolos.com`,
              location: inputCountry.value.trim(),
              country: inputCountry.value.trim(),
              timezone: document.getElementById('timezone')?.value || 'America/Bogota (UTC-5)',
              planName: selectedPlan,
              contactEmail: inputContactEmail.value.trim(),
              status: schoolStatus,
              logoUrl: logoUrl,
              slogan: document.getElementById('slogan')?.value.trim() || undefined,
              address: document.getElementById('address')?.value.trim() || undefined,
              phone: document.getElementById('phone')?.value.trim() || undefined,
              brandColor: inputBrandColor?.value || document.getElementById('brandColorHex')?.value || '#12110E',
              rectorName: inputRectorName.value.trim(),
              rectorEmail: inputRectorEmail.value.trim(),
            },
          }),
        });

        const createData = await createRes.json();
        if (!createData.ok) {
          throw new Error(createData.error || 'No se pudo crear la institución.');
        }

        const newSchool = createData.school;
        if (!newSchool || !newSchool.id) {
          throw new Error('No se pudo obtener el ID de la escuela creada.');
        }

        updateStepUI(2, 'done', `Institución "${newSchool.name}" creada exitosamente.`);

        // FASE 3: APROVISIONAR RECTOR vía Edge Function (server-side)
        updateStepUI(3, 'active', `Aprovisionando credenciales para ${inputRectorName.value.trim()}...`);
        setProvProgress(75);

        // Invocar la Edge Function a través de la sesión del super admin
        let rectorData = { ok: true, emailSent: false };
        try {
          const rectorRes = await fetchAuth('/api/admin/rector', {
            method: 'POST',
            body: JSON.stringify({
              action: 'provision',
              schoolId: newSchool.id,
              name: inputRectorName.value.trim(),
              email: inputRectorEmail.value.trim(),
              phone: inputRectorPhone?.value.trim() || undefined,
              documentType: selectRectorDocType?.value || 'CC',
              documentId: inputRectorDocId?.value.trim() || undefined,
              jobTitle: selectRectorJobTitle?.value || 'Rector General',
              specialty: document.getElementById('rectorSpecialty')?.value.trim() || undefined,
              appointmentDate: document.getElementById('rectorAppointmentDate')?.value || undefined,
              status: 'invited',
              avatarUrl: rectorAvatarUrl,
            }),
          });
          const rectorJson = await rectorRes.json();
          if (!rectorJson.ok) {
            console.warn('Advertencia al aprovisionar rector:', rectorJson.error);
            rectorData.ok = false;
          } else {
            rectorData = { ...rectorData, ...rectorJson };
          }
        } catch (rectorErr) {
          console.warn('Error al llamar /api/admin/rector:', rectorErr);
          rectorData.ok = false;
        }

        updateStepUI(3, 'done', `Perfil directivo configurado en estado Invitado.`);

        // FASE 4: SEGURIDAD CRIPTOGRÁFICA & CORREO JWT
        updateStepUI(4, 'active', `Despachando correo institucional a ${inputRectorEmail.value.trim()}...`);
        setProvProgress(90);

        await new Promise(resolve => setTimeout(resolve, 400));
        updateStepUI(4, 'done', rectorData?.emailSent ? `Correo JWT enviado a ${inputRectorEmail.value.trim()}.` : `Ticket JWT de 24h generado.`);

        // MOSTRAR VISTA DE ÉXITO
        showProvSuccess(newSchool, rectorData);

      } catch (err) {
        console.error('Error durante el aprovisionamiento:', err);
        showProvError(err?.message || 'Error de conexión durante el aprovisionamiento.');
      }
    });
  </script>
</AppLayout>


