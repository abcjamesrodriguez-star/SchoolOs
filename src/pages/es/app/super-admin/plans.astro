---
// ============================================================
// SchoolOS — Planes de Suscripción (/es/app/super-admin/plans)
// ============================================================
import AppLayout from '../../../../layouts/AppLayout.astro';
import { schoolService } from '../../../../services/schoolService';

const lang = 'es';
let schools: any[] = [];
try {
  schools = (await schoolService.getSchools()) || [];
} catch (e) {
  console.error('Error fetching schools:', e);
  schools = [];
}

const totalSchools = schools.length || 1;
const starterCount = schools.filter((s) => (s.planName || '').toLowerCase().includes('starter')).length;
const proCount = schools.filter((s) => (s.planName || '').toLowerCase().includes('pro')).length;
const enterpriseCount = schools.filter((s) => (s.planName || '').toLowerCase().includes('enterprise')).length;

const plans = [
  {
    name: 'Starter',
    limit: 'Hasta 200 alumnos',
    price: '$199 USD/mes',
    schoolsCount: starterCount,
    status: 'Activo',
  },
  {
    name: 'Professional',
    limit: 'Hasta 1,500 alumnos',
    price: '$499 USD/mes',
    schoolsCount: proCount,
    status: 'Activo (Popular)',
  },
  {
    name: 'Enterprise',
    limit: 'Alumnos ilimitados',
    price: 'A Medida',
    schoolsCount: enterpriseCount,
    status: 'Activo',
  },
];
---

<AppLayout
  title="Planes"
  pageTitle="Planes y Suscripciones"
  activeSection="plans"
  lang={lang}
  activeRoute="/app/super-admin/plans"
  breadcrumbs={[{ label: 'Sistema' }, { label: 'Planes' }]}
>
  <!-- 3 VISUAL TIER CARDS -->
  <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:20px; margin-bottom:28px;">
    
    <!-- STARTER -->
    <div style="background:var(--paper); border:1px solid var(--ink); display:flex; flex-direction:column;">
      <div style="padding:20px 22px; border-bottom:1px solid var(--line);">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <span class="plan-tag">Starter</span>
          <span style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">{starterCount} ESCUELAS</span>
        </div>
        <div style="font-family:var(--serif); font-size:28px; font-weight:700; margin-top:8px;">$199 <span style="font-size:13px; font-family:var(--mono); font-weight:normal; color:var(--ink-soft);">USD / mes</span></div>
        <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-top:4px;">Hasta 200 estudiantes</div>
      </div>
      <div style="padding:14px 22px; background:var(--cream); flex:1; font-size:12.5px; color:var(--ink-soft);">
        <div style="margin-bottom:6px;">✓ Clases presenciales y digitales</div>
        <div style="margin-bottom:6px;">✓ Guías y calificaciones</div>
        <div>✓ Soporte estándar por ticket</div>
      </div>
      <div style="padding:10px 22px; background:var(--sage-accent); border-top:1px solid var(--ink); font-family:var(--mono); font-size:11px; font-weight:700; text-transform:uppercase;">
        Tier Básico Operacional
      </div>
    </div>

    <!-- PROFESSIONAL (FEATURED) -->
    <div style="background:var(--paper); border:1px solid var(--ink); display:flex; flex-direction:column; position:relative; box-shadow: 4px 4px 0 rgba(18, 17, 14, 0.15);">
      <div style="padding:20px 22px; border-bottom:1px solid var(--line);">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <span class="plan-tag" style="background:var(--ink); color:#FFFFFF; border-color:var(--ink); font-weight:700;">Professional</span>
          <span style="font-family:var(--mono); font-size:11px; color:var(--orange-vibrant); font-weight:700;">{proCount} ESCUELAS</span>
        </div>
        <div style="font-family:var(--serif); font-size:28px; font-weight:700; margin-top:8px;">$499 <span style="font-size:13px; font-family:var(--mono); font-weight:normal; color:var(--ink-soft);">USD / mes</span></div>
        <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-top:4px;">Hasta 1,500 estudiantes</div>
      </div>
      <div style="padding:14px 22px; background:var(--cream); flex:1; font-size:12.5px; color:var(--ink-soft);">
        <div style="margin-bottom:6px;">✓ Todo en Starter + Clases en vivo</div>
        <div style="margin-bottom:6px;">✓ Auditoría y reportes judiciales</div>
        <div>✓ Dominio personalizado propio</div>
      </div>
      <div style="padding:10px 22px; background:var(--orange-vibrant); color:#FFFFFF; border-top:1px solid var(--ink); font-family:var(--mono); font-size:11px; font-weight:700; text-transform:uppercase;">
        ★ Plan Recomendado
      </div>
    </div>

    <!-- ENTERPRISE -->
    <div style="background:var(--paper); border:1px solid var(--ink); display:flex; flex-direction:column;">
      <div style="padding:20px 22px; border-bottom:1px solid var(--line);">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <span class="plan-tag">Enterprise</span>
          <span style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">{enterpriseCount} ESCUELAS</span>
        </div>
        <div style="font-family:var(--serif); font-size:28px; font-weight:700; margin-top:8px;">A Medida <span style="font-size:13px; font-family:var(--mono); font-weight:normal; color:var(--ink-soft);">/ anual</span></div>
        <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-top:4px;">Estudiantes ilimitados</div>
      </div>
      <div style="padding:14px 22px; background:var(--cream); flex:1; font-size:12.5px; color:var(--ink-soft);">
        <div style="margin-bottom:6px;">✓ Servidores dedicados y SLA 99.99%</div>
        <div style="margin-bottom:6px;">✓ Integración SIS/ERP nacional</div>
        <div>✓ Gerente de cuenta dedicado 24/7</div>
      </div>
      <div style="padding:10px 22px; background:var(--stone-accent); border-top:1px solid var(--ink); font-family:var(--mono); font-size:11px; font-weight:700; text-transform:uppercase;">
        Gran Escala & Redes
      </div>
    </div>

  </div>

  <div class="panel">
    <div class="panel-header">
      <h2>DISTRIBUCIÓN Y ASIGNACIÓN DE SUSCRIPCIONES</h2>
    </div>
    <div class="panel-body">
      <table class="data-table">
        <thead>
          <tr>
            <th>Nivel de Plan</th>
            <th>Límite de Alumnos</th>
            <th>Tarifa Base</th>
            <th>Instituciones Activas</th>
            <th>Porcentaje del Total</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          {plans.map((p) => (
            <tr>
              <td class="cell-name"><span class="plan-tag" style="font-weight:700;">{p.name}</span></td>
              <td class="cell-muted" style="font-family:var(--mono);">{p.limit}</td>
              <td style="font-family:var(--mono); font-weight:700; font-size:13.5px;">{p.price}</td>
              <td style="font-family:var(--mono); font-weight:700;">{p.schoolsCount} escuelas</td>
              <td>
                <div style="display:flex; align-items:center; gap:8px; font-family:var(--mono); font-size:11.5px;">
                  <div style="width:80px; height:4px; background:var(--line); border-radius:2px; overflow:hidden;">
                    <div style={`width:${((p.schoolsCount / totalSchools) * 100).toFixed(0)}%; height:100%; background:var(--ink);`}></div>
                  </div>
                  <span>{((p.schoolsCount / totalSchools) * 100).toFixed(1)}%</span>
                </div>
              </td>
              <td><span class="badge badge-active">{p.status}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AppLayout>

