---
// ============================================================
// SchoolOS — Panel de Control Super Admin (/es/app/super-admin)
// ============================================================
import AppLayout from '../../../../layouts/AppLayout.astro';
import { getMockDashboardStats, getMockSchools, getMockAuditLogs } from '../../../../data/app/mock-data';

const lang = 'es';
const stats = getMockDashboardStats(lang);
const recentSchools = getMockSchools(lang).slice(0, 3);
const recentLogs = getMockAuditLogs(lang);

function getStatusLabel(status: string) {
  switch (status) {
    case 'active': return 'Activa';
    case 'trial': return 'En Prueba';
    case 'suspended': return 'Suspendida';
    case 'cancelled': return 'Cancelada';
    default: return status;
  }
}
---

<AppLayout
  title="Panel de Control"
  pageTitle="Panel de Control"
  activeSection="dashboard"
  lang={lang}
  activeRoute="/app/super-admin"
  breadcrumbs={[{ label: 'Sistema' }, { label: 'Panel de Control' }]}
>
  <div class="stat-grid">
    <div class="stat-card">
      <div class="stat-label">Escuelas Activas</div>
      <div class="stat-num">{stats.activeSchools}</div>
      <div class="stat-sub">{stats.activeSchoolsSub}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Estudiantes Totales</div>
      <div class="stat-num">{stats.totalStudents}</div>
      <div class="stat-sub">{stats.totalStudentsSub}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Escuelas en Prueba</div>
      <div class="stat-num accent">{stats.trialSchools}</div>
      <div class="stat-sub">{stats.trialSchoolsSub}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Vencidas / Suspendidas</div>
      <div class="stat-num accent">{stats.suspendedSchools}</div>
      <div class="stat-sub">{stats.suspendedSchoolsSub}</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-header">
      <h2>Escuelas creadas recientemente</h2>
      <a class="panel-link" href={`/${lang}/app/super-admin/schools`}>Ver todas →</a>
    </div>
    <div class="panel-body">
      <table class="data-table">
        <thead>
          <tr>
            <th>Institución / Escuela</th>
            <th>Plan de Suscripción</th>
            <th>Estado</th>
            <th>Estudiantes</th>
            <th>Fecha de Creación</th>
          </tr>
        </thead>
        <tbody>
          {recentSchools.map((s) => (
            <tr>
              <td class="cell-name">
                <a href={`/${lang}/app/super-admin/schools/${s.id}`}>{s.name}</a>
              </td>
              <td><span class="plan-tag">{s.planName}</span></td>
              <td><span class={`badge badge-${s.status}`}>{getStatusLabel(s.status)}</span></td>
              <td>{s.studentCount.toLocaleString()}</td>
              <td class="cell-muted">{s.createdAt}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="panel">
    <div class="panel-header">
      <h2>Actividad reciente del sistema</h2>
      <a class="panel-link" href={`/${lang}/app/super-admin/audit-log`}>Ver registro completo →</a>
    </div>
    <div class="panel-body">
      <table class="data-table">
        <thead>
          <tr>
            <th>Evento / Acción</th>
            <th>Entidad Objetivo</th>
            <th>Responsable (Actor)</th>
            <th>Tiempo</th>
          </tr>
        </thead>
        <tbody>
          {recentLogs.map((log) => (
            <tr>
              <td style="font-family:var(--mono); font-size:12.5px; font-weight:500;">{log.action}</td>
              <td class="cell-name">{log.targetName}</td>
              <td class="cell-muted">{log.actorEmail}</td>
              <td class="cell-muted">{log.timestamp}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AppLayout>
