---
// ============================================================
// SchoolOS — Acceso Judicial Centralizado (/es/app/super-admin/judicial-access)
// ============================================================
import AppLayout from '../../../../layouts/AppLayout.astro';
import { getMockJudicialGrants } from '../../../../data/app/mock-data';

const lang = 'es';
const grants = getMockJudicialGrants(lang);

function getGrantStatusLabel(status: string) {
  switch (status) {
    case 'active': return 'Activo';
    case 'pending_verification': return 'Pendiente de Verificación';
    case 'expired': return 'Expirado';
    case 'revoked': return 'Revocado';
    default: return status;
  }
}
---

<AppLayout
  title="Acceso Judicial"
  pageTitle="Cumplimiento & Órdenes Judiciales"
  activeSection="judicial-access"
  lang={lang}
  activeRoute="/app/super-admin/judicial-access"
  breadcrumbs={[{ label: 'Cumplimiento' }, { label: 'Acceso Judicial' }]}
>
  <!-- TOP SECURITY RIBBON -->
  <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:16px; margin-bottom:24px;">
    <div style="background:var(--paper); border:1px solid var(--ink); padding:16px 20px; border-bottom:3px solid var(--orange-vibrant);">
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">Órdenes Activas</div>
      <div style="font-family:var(--serif); font-size:26px; font-weight:700; color:var(--orange-vibrant); margin-top:4px;">1 En Vigor</div>
      <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft); margin-top:2px;">EXP-2026-0417 · Vence en 28d</div>
    </div>
    <div style="background:var(--paper); border:1px solid var(--ink); padding:16px 20px; border-bottom:3px solid #8A5A00;">
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">Pendientes de Verificación</div>
      <div style="font-family:var(--serif); font-size:26px; font-weight:700; color:#8A5A00; margin-top:4px;">1 Solicitud</div>
      <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft); margin-top:2px;">Requiere 2do Super Admin</div>
    </div>
    <div style="background:var(--paper); border:1px solid var(--ink); padding:16px 20px; border-bottom:3px solid var(--line-strong);">
      <div style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);">Histórico Archivado</div>
      <div style="font-family:var(--serif); font-size:26px; font-weight:700; color:var(--ink); margin-top:4px;">1 Expirada</div>
      <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft); margin-top:2px;">Auditoría inmutable</div>
    </div>
  </div>

  <div class="notice restricted" style="border:1px solid var(--danger); background:var(--danger-dim); color:#5C2015; border-radius:0;">
    <span class="notice-icon" style="font-size:18px;">⚖️</span>
    <div>
      <strong style="color:#3B120B;">Protocolo Estricto de Cumplimiento Judicial (Ley de Protección de Datos).</strong><br />
      Los registros individuales de estudiantes, comunicaciones y actividad académica están protegidos criptográficamente por diseño. El acceso únicamente se habilita mediante orden legal verificada bajo la <strong>regla de confirmación dual obligatoria de dos Super Administradores</strong>.
    </div>
  </div>

  <div class="panel">
    <div class="panel-header">
      <h2>REGISTRO CENTRAL DE EXPEDIENTES Y ÓRDENES JUDICIALES</h2>
      <button class="btn btn-secondary btn-sm" onclick="alert('Mock: Formulario de Registro de Orden Judicial abierto');">+ Radicar Nueva Orden</button>
    </div>
    <div class="panel-body">
      <table class="data-table">
        <thead>
          <tr>
            <th>Institución Escolar</th>
            <th>Nº Expediente / Caso</th>
            <th>Autoridad Judicial</th>
            <th>Alcance Autorizado</th>
            <th>Estado</th>
            <th>Radicado por</th>
            <th>Verificado por</th>
            <th>Vigencia</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {grants.map((g) => (
            <tr>
              <td class="cell-name">
                <a href={`/${lang}/app/super-admin/schools/${g.schoolId}`} style="font-weight:700;">{g.schoolName}</a>
              </td>
              <td style="font-family:var(--mono); font-weight:700; font-size:13px;">{g.caseReference}</td>
              <td class="cell-muted">{g.issuingAuthority}</td>
              <td class="cell-muted" style="color:var(--ink); font-weight:500;">{g.scope}</td>
              <td>
                <span class={`badge badge-${g.status}`}>
                  {getGrantStatusLabel(g.status)}
                </span>
              </td>
              <td class="cell-muted" style="font-family:var(--mono); font-size:11px;">{g.requestedBy}</td>
              <td class="cell-muted" style="font-family:var(--mono); font-size:11px;">{g.verifiedBy || '—'}</td>
              <td class="cell-muted" style="font-family:var(--mono); font-size:11.5px; font-weight:600; color:var(--ink);">{g.expiresAt}</td>
              <td class="cell-actions">
                <a class="btn btn-secondary btn-sm" href={`/${lang}/app/super-admin/schools/${g.schoolId}`}>
                  Ver Ficha →
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AppLayout>

