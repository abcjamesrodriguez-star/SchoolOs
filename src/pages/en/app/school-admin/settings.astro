---
// ============================================================
// SchoolOS — School Settings (/en/app/school-admin/settings)
// ============================================================
import AppLayout from '../../../../layouts/AppLayout.astro';
import { getAcademicStats } from '../../../../data/app/mock-academic';

const lang = 'en';
const stats = getAcademicStats(lang);
---

<AppLayout
  title="Settings"
  pageTitle="School Settings & Plan Allocation"
  activeSection="settings"
  role="school_admin"
  schoolName="Colegio Norte"
  lang={lang}
  activeRoute="/app/school-admin/settings"
  breadcrumbs={[{ label: 'Colegio Norte', href: `/${lang}/app/school-admin` }, { label: 'Settings' }]}
>
  <div style="display:grid; grid-template-columns: 1fr 1fr; gap:24px;">
    
    <!-- PANEL 1: INSTITUTIONAL INFO -->
    <div class="panel">
      <div class="panel-header">
        <h2>01 · INSTITUTION PROFILE & IDENTITY</h2>
      </div>
      <div class="panel-body padded">
        <form onsubmit="event.preventDefault(); alert('School profile updated successfully!');">
          <div class="form-grid">
            <div class="form-field full">
              <label>Official School Name</label>
              <input type="text" value="Colegio Norte" required />
            </div>

            <div class="form-field">
              <label>National Registry Code</label>
              <input type="text" value="111001849201" style="font-family:var(--mono);" />
            </div>

            <div class="form-field">
              <label>City & Country</label>
              <input type="text" value="Bogotá, Colombia" required />
            </div>

            <div class="form-field full">
              <label>Main Campus Address</label>
              <input type="text" value="Carrera 15 # 124-30, Bogotá D.C." />
            </div>

            <div class="form-field full">
              <label>Principal Contact Email</label>
              <input type="email" value="rectoria@colegionorte.edu.co" required style="font-family:var(--mono);" />
            </div>
          </div>

          <div style="margin-top:20px; text-align:right;">
            <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
          </div>
        </form>
      </div>
    </div>

    <!-- PANEL 2: PLAN AND CAPACITY -->
    <div class="panel">
      <div class="panel-header">
        <h2>02 · SUBSCRIPTION TIER & CAPACITY</h2>
      </div>
      <div class="panel-body padded">
        <div style="background:var(--cream); border:1px solid var(--ink); padding:16px; margin-bottom:18px;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
            <span class="plan-tag" style="background:var(--ink); color:#FFFFFF; border-color:var(--ink); font-weight:700;">Professional Plan</span>
            <span class="badge badge-active">ACTIVE & CURRENT</span>
          </div>
          <div style="font-family:var(--serif); font-size:22px; font-weight:700; margin:6px 0;">$499 USD / mo</div>
          <div style="font-size:12px; color:var(--ink-soft);">
            Automatic renewal on July 2, 2027.
          </div>
        </div>

        <div style="margin-bottom:18px;">
          <div style="display:flex; justify-content:space-between; font-family:var(--mono); font-size:11.5px; margin-bottom:6px;">
            <span>Enrollment Usage:</span>
            <strong>{stats.totalStudents} / {stats.maxStudentsPlan} students ({stats.planUsagePercent}%)</strong>
          </div>
          <div style="width:100%; height:6px; background:var(--line); overflow:hidden;">
            <div style={`width:${stats.planUsagePercent}%; height:100%; background:var(--rust);`}></div>
          </div>
          <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-top:4px;">
            {stats.maxStudentsPlan - stats.totalStudents} remaining slots available.
          </div>
        </div>

        <div style="border-top:1px dashed var(--line); padding-top:16px;">
          <button class="btn btn-secondary btn-sm" style="width:100%; text-align:center;" onclick="alert('Mock: Requesting capacity upgrade to Super Admin team');">
            Request Slot Expansion from SchoolOS Team →
          </button>
        </div>
      </div>
    </div>

    <!-- PANEL 3: DOMAIN AND CONNECTIVITY -->
    <div class="panel" style="grid-column: span 2;">
      <div class="panel-header">
        <h2>03 · DOMAIN & ACCESS PROTOCOLS</h2>
      </div>
      <div class="panel-body padded">
        <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:16px;">
          <div style="background:var(--cream); border:1px solid var(--line-strong); padding:14px 16px;">
            <div style="font-family:var(--mono); font-size:10px; text-transform:uppercase; color:var(--ink-soft);">Assigned Subdomain</div>
            <div style="font-family:var(--mono); font-size:13px; font-weight:700; color:var(--ink); margin-top:4px;">colegio-norte.schoolos.com</div>
            <div style="font-family:var(--mono); font-size:11px; color:var(--olive-dark); margin-top:2px;">✓ Wildcard SSL Active</div>
          </div>

          <div style="background:var(--cream); border:1px solid var(--line-strong); padding:14px 16px;">
            <div style="font-family:var(--mono); font-size:10px; text-transform:uppercase; color:var(--ink-soft);">Tenant Timezone</div>
            <div style="font-family:var(--serif); font-size:15px; font-weight:700; color:var(--ink); margin-top:4px;">America/Bogota (UTC-5)</div>
            <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-top:2px;">Synchronized with Colombia</div>
          </div>

          <div style="background:var(--cream); border:1px solid var(--line-strong); padding:14px 16px;">
            <div style="font-family:var(--mono); font-size:10px; text-transform:uppercase; color:var(--ink-soft);">System Audit Status</div>
            <div style="font-family:var(--serif); font-size:15px; font-weight:700; color:var(--danger); margin-top:4px;">Under Investigation</div>
            <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-top:2px;">Order EXP-2026-0417</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</AppLayout>
