  <div id="modalAddColumn" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(18,17,14,0.85); z-index:10000; justify-content:center; align-items:center; padding:16px;">
    <div style="background:var(--paper); border:2.5px solid var(--ink); border-radius:8px; max-width:480px; width:100%; box-shadow:10px 10px 0 rgba(18,17,14,0.4); overflow:hidden;">
      
      <div style="padding:14px 18px; background:var(--ink); color:#FFFFFF; display:flex; justify-content:space-between; align-items:center;">
        <div>
