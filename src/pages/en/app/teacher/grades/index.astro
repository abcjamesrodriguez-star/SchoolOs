                </button>
              </th>

              <!-- 4. Columna Definitiva (Sticky Derecha) -->
              <th class="th-sticky-definitiva" style="position:sticky; right:95px; top:0; width:105px; min-width:105px; max-width:105px; background:#E5EFE0; z-index:30; padding:8px 6px; text-align:center; font-family:var(--mono); font-size:10.5px; font-weight:900; color:#2E5E1E; border-bottom:2px solid var(--ink); border-left:2px solid var(--ink); border-right:1px solid #D8D2C2;">
                <div>FINAL GRADE</div>
                <div style="font-size:8.5px; font-weight:normal; color:#2E5E1E;">Scale 0–100 / 5.0</div>
              </th>

              <!-- 5. Columna Desempeño (Sticky Derecha) -->
              <th class="th-sticky-badge" style="position:sticky; right:0; top:0; width:95px; min-width:95px; max-width:95px; background:var(--cream); z-index:30; padding:8px 6px; text-align:center; font-family:var(--mono); font-size:10px; font-weight:800; color:var(--ink); border-bottom:2px solid var(--ink); box-shadow:-4px 0 6px -2px rgba(0,0,0,0.06);">
                Status
              </th>
            </tr>
          </thead>

          <tbody id="gradebookTableBody">
            {students10A.map((std, idx) => {
              const base = Math.round(std.averageScore * 10);
              const g1 = Math.min(100, Math.max(40, base + (idx % 3 === 0 ? 5 : -4)));
              const g2 = Math.min(100, Math.max(40, base + (idx % 2 === 0 ? 4 : -2)));
              const qz = Math.min(100, Math.max(40, base + (idx % 4 === 0 ? -6 : 3)));
              const ex = Math.min(100, Math.max(35, base + (idx % 5 === 0 ? -10 : 2)));
              const ac = Math.min(100, Math.max(60, base + (idx % 2 === 0 ? 8 : 4)));

              const def100 = (g1 * 0.15 + g2 * 0.20 + qz * 0.20 + ex * 0.30 + ac * 0.15);
              const def5 = (def100 / 20).toFixed(1);
              const isHonor = def100 >= 85;
              const isPass = def100 >= 60;
              const badgeCls = isHonor ? 'badge-active' : (isPass ? 'badge-warning' : 'badge-suspended');
              const level = isHonor ? 'HONOR' : (isPass ? 'PASS' : 'FAIL');
              const statusCategory = isHonor ? 'honor' : (isPass ? 'pass' : 'risk');

              return (
                <tr
                  class="gradebook-row"
                  id={`std-row-${idx}`}
                  data-row={idx}
                  data-name={std.name.toLowerCase()}
                  data-status={statusCategory}
                  style={`height:42px; border-bottom:1px solid #ECE7DE; ${idx % 2 === 0 ? 'background:#FFFFFF;' : 'background:#FAF8F5;'}`}
                >
                  <!-- 1. # Sticky -->
                  <td class="td-sticky-num" style={`position:sticky; left:0; width:44px; min-width:44px; text-align:center; font-family:var(--mono); font-size:11px; font-weight:800; color:var(--ink-soft); border-right:1px solid #ECE7DE; border-bottom:1px solid #ECE7DE; z-index:10; ${idx % 2 === 0 ? 'background:#FFFFFF;' : 'background:#FAF8F5;'}`}>
                    {idx + 1 < 10 ? `0${idx + 1}` : idx + 1}
                  </td>

                  <!-- 2. Estudiante Sticky con Avatar Compacto -->
                  <td class="td-sticky-student" style={`position:sticky; left:44px; width:230px; min-width:230px; max-width:230px; padding:4px 10px; border-right:2px solid var(--ink); border-bottom:1px solid #ECE7DE; z-index:10; box-shadow:4px 0 6px -2px rgba(0,0,0,0.06); ${idx % 2 === 0 ? 'background:#FFFFFF;' : 'background:#FAF8F5;'}`}>
                    <div style="display:flex; align-items:center; gap:8px;">
                      <img
                        src={std.avatarUrl || '/avatars/women/fila-1-columna-1.png'}
                        alt={std.name}
                        width="26"
                        height="26"
                        style="width:26px !important; height:26px !important; min-width:26px !important; max-width:26px !important; min-height:26px !important; max-height:26px !important; border-radius:50%; border:1px solid #D5CEBF; object-fit:cover; flex-shrink:0; display:block;"
                      />
                      <div style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        <div style="font-size:12px; font-weight:700; color:var(--ink); line-height:1.2; max-width:175px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title={std.name}>
                          {std.name}
                        </div>
                        <div style="font-family:var(--mono); font-size:9px; color:var(--ink-soft);">10°A · Regular</div>
                      </div>
                    </div>
                  </td>

                  <!-- 3. Actividades Estáticas -->
                  <td class="td-cell-grade" style="padding:4px 6px; text-align:center; border-bottom:1px solid #ECE7DE; border-right:1px solid #E2DDD5;">
                    <input
                      type="number" min="0" max="100"
                      id={`cell-g1-${idx}`}
                      value={g1}
                      data-col="g1"
                      data-row={idx}
                      onfocus="this.select();"
                      oninput={`handleGradeInput(${idx}, 'g1');`}
                      onkeydown={`navigateTableGrid(event, ${idx}, 'g1');`}
                      class={`grade-input-cell ${g1 < 60 ? 'grade-low' : (g1 >= 85 ? 'grade-high' : '')}`}
                      style="width:54px; height:28px; padding:2px 4px; border:1px solid #D5CEBF; border-radius:4px; font-family:var(--mono); font-size:12px; font-weight:800; color:var(--ink); text-align:center; outline:none;"
                    />
                  </td>

                  <td class="td-cell-grade" style="padding:4px 6px; text-align:center; border-bottom:1px solid #ECE7DE; border-right:1px solid #E2DDD5;">
                    <input
                      type="number" min="0" max="100"
                      id={`cell-g2-${idx}`}
                      value={g2}
                      data-col="g2"
                      data-row={idx}
                      onfocus="this.select();"
                      oninput={`handleGradeInput(${idx}, 'g2');`}
                      onkeydown={`navigateTableGrid(event, ${idx}, 'g2');`}
                      class={`grade-input-cell ${g2 < 60 ? 'grade-low' : (g2 >= 85 ? 'grade-high' : '')}`}
                      style="width:54px; height:28px; padding:2px 4px; border:1px solid #D5CEBF; border-radius:4px; font-family:var(--mono); font-size:12px; font-weight:800; color:var(--ink); text-align:center; outline:none;"
                    />
                  </td>

                  <td class="td-cell-grade" style="padding:4px 6px; text-align:center; border-bottom:1px solid #ECE7DE; border-right:1px solid #E2DDD5;">
                    <input
                      type="number" min="0" max="100"
                      id={`cell-qz-${idx}`}
                      value={qz}
                      data-col="qz"
                      data-row={idx}
                      onfocus="this.select();"
                      oninput={`handleGradeInput(${idx}, 'qz');`}
                      onkeydown={`navigateTableGrid(event, ${idx}, 'qz');`}
                      class={`grade-input-cell ${qz < 60 ? 'grade-low' : (qz >= 85 ? 'grade-high' : '')}`}
                      style="width:54px; height:28px; padding:2px 4px; border:1px solid #D5CEBF; border-radius:4px; font-family:var(--mono); font-size:12px; font-weight:800; color:var(--ink); text-align:center; outline:none;"
                    />
                  </td>

                  <td class="td-cell-grade td-exam-cell" style="padding:4px 6px; text-align:center; border-bottom:1px solid #ECE7DE; border-right:1.5px solid var(--rust); border-left:1.5px solid var(--rust); background:#FFFDF9;">
                    <input
                      type="number" min="0" max="100"
                      id={`cell-ex-${idx}`}
                      value={ex}
                      data-col="ex"
                      data-row={idx}
                      onfocus="this.select();"
                      oninput={`handleGradeInput(${idx}, 'ex');`}
                      onkeydown={`navigateTableGrid(event, ${idx}, 'ex');`}
                      class={`grade-input-cell ${ex < 60 ? 'grade-low' : (ex >= 85 ? 'grade-high' : '')}`}
                      style="width:54px; height:28px; padding:2px 4px; border:1px solid #D5CEBF; border-radius:4px; font-family:var(--mono); font-size:12px; font-weight:800; color:var(--ink); text-align:center; outline:none;"
                    />
                  </td>

                  <td class="td-cell-grade" style="padding:4px 6px; text-align:center; border-bottom:1px solid #ECE7DE; border-right:1px solid #E2DDD5;">
                    <input
                      type="number" min="0" max="100"
                      id={`cell-ac-${idx}`}
                      value={ac}
                      data-col="ac"
                      data-row={idx}
                      onfocus="this.select();"
                      oninput={`handleGradeInput(${idx}, 'ac');`}
                      onkeydown={`navigateTableGrid(event, ${idx}, 'ac');`}
                      class={`grade-input-cell ${ac < 60 ? 'grade-low' : (ac >= 85 ? 'grade-high' : '')}`}
                      style="width:54px; height:28px; padding:2px 4px; border:1px solid #D5CEBF; border-radius:4px; font-family:var(--mono); font-size:12px; font-weight:800; color:var(--ink); text-align:center; outline:none;"
                    />
                  </td>

                  <!-- Espacio botón + col -->
                  <td class="td-add-col-spacer" style="border-bottom:1px solid #ECE7DE; border-right:1px dashed var(--rust); background:#FFF8F5;"></td>

                  <!-- 4. Definitiva Sticky Derecha -->
                  <td class="td-sticky-definitiva" style="position:sticky; right:95px; background:#F4FAF1; z-index:10; text-align:center; border-bottom:1px solid #ECE7DE; border-left:2px solid var(--ink); border-right:1px solid #D8D2C2; padding:4px 4px;">
                    <div style="font-family:var(--mono); font-size:13px; font-weight:900; color:#2E5E1E; line-height:1.1;">
                      <span id={`def100-${idx}`}>{def100.toFixed(0)}</span>
                      <span style="font-size:9px; font-weight:normal; color:var(--ink-soft);">/100</span>
                    </div>
                    <div style="font-family:var(--mono); font-size:10.5px; font-weight:800; color:#2E5E1E; margin-top:1px;">
                      (<span id={`def5-${idx}`}>{def5}</span>/5.0)
                    </div>
                  </td>

                  <!-- 5. Desempeño Sticky Derecha -->
                  <td class="td-sticky-badge" style={`position:sticky; right:0; z-index:10; text-align:center; border-bottom:1px solid #ECE7DE; box-shadow:-4px 0 6px -2px rgba(0,0,0,0.06); padding:4px 4px; ${idx % 2 === 0 ? 'background:#FFFFFF;' : 'background:#FAF8F5;'}`}>
                    <span
                      id={`badge-${idx}`}
                      class={`badge ${badgeCls}`}
                      style="font-size:8px; font-weight:900; padding:2px 6px; text-transform:uppercase; border-radius:3px;"
                    >
                      {level}
                    </span>
                  </td>
                </tr>
              );
            })}
          </tbody>

          <!-- FILA FOOTER DE PROMEDIOS GRUPALES -->
          <tfoot>
            <tr style="background:var(--cream); height:38px; border-top:2px solid var(--ink);">
              <td style="position:sticky; left:0; background:var(--cream); font-family:var(--mono); font-size:11px; font-weight:900; text-align:center; color:var(--ink); border-right:1px solid #D8D2C2; z-index:15;">Σ</td>
              <td style="position:sticky; left:44px; background:var(--cream); font-family:var(--mono); font-size:10.5px; font-weight:800; color:var(--ink); padding:4px 10px; border-right:2px solid var(--ink); box-shadow:4px 0 6px -2px rgba(0,0,0,0.06); z-index:15;">
                ACTIVITY CLASS AVERAGE
              </td>
              <td style="background:var(--cream); text-align:center; font-family:var(--mono); font-size:11.5px; font-weight:800; color:var(--ink); border-right:1px solid #E2DDD5; padding:4px;" id="colAvg-g1">
                79.4
              </td>
              <td style="background:var(--cream); text-align:center; font-family:var(--mono); font-size:11.5px; font-weight:800; color:var(--ink); border-right:1px solid #E2DDD5; padding:4px;" id="colAvg-g2">
                80.1
              </td>
              <td style="background:var(--cream); text-align:center; font-family:var(--mono); font-size:11.5px; font-weight:800; color:var(--ink); border-right:1px solid #E2DDD5; padding:4px;" id="colAvg-qz">
                77.8
              </td>
              <td style="background:#FFF5EA; text-align:center; font-family:var(--mono); font-size:11.5px; font-weight:900; color:var(--rust); border-right:1.5px solid var(--rust); border-left:1.5px solid var(--rust); padding:4px;" id="colAvg-ex">
                71.2
              </td>
              <td style="background:var(--cream); text-align:center; font-family:var(--mono); font-size:11.5px; font-weight:800; color:var(--ink); border-right:1px solid #E2DDD5; padding:4px;" id="colAvg-ac">
                84.0
              </td>
              <td style="background:#FFF8F5; border-right:1px dashed var(--rust);"></td>
              <td style="position:sticky; right:95px; background:#D8E8D1; text-align:center; font-family:var(--mono); font-size:12.5px; font-weight:900; color:#2E5E1E; border-left:2px solid var(--ink); border-right:1px solid #D8D2C2; z-index:15; padding:4px;" id="colAvg-def">
                79.7
              </td>
              <td style="position:sticky; right:0; background:var(--cream); text-align:center; font-family:var(--mono); font-size:9.5px; font-weight:900; color:#2E5E1E; box-shadow:-4px 0 6px -2px rgba(0,0,0,0.06); z-index:15; padding:4px;">
                HIGH
              </td>
            </tr>
          </tfoot>
        </table>

      </div>

      <!-- ══════════════════════════════════════════════════════════════════════════ -->
      <!-- ── BARRA FLOTANTE INFERIOR PERMANENTE (STICKY BOTTOM DOCK) ── -->
      <!-- ══════════════════════════════════════════════════════════════════════════ -->
      <div
        id="gradebookFloatingToolbar"
        style="position:sticky; bottom:14px; z-index:800; background:rgba(255, 253, 251, 0.96); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); border:2px solid var(--ink); border-radius:8px; padding:8px 14px; box-shadow:0 8px 24px rgba(18,17,14,0.15), 4px 4px 0 var(--ink); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-top:10px;"
      >
        <!-- Búsqueda en Vivo + Filtros de Estado -->
        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
          
          <!-- Input de Búsqueda -->
          <div style="position:relative; width:180px;">
            <span style="position:absolute; left:8px; top:50%; transform:translateY(-50%); font-size:11px; color:var(--ink-soft);">🔍</span>
            <input
              type="text"
              id="studentSearchInput"
              placeholder="Search..."
              oninput="filterStudentsTable();"
              style="width:100%; padding:5px 8px 5px 24px; border:1.5px solid var(--ink); border-radius:4px; background:#FFFFFF; font-size:11px; font-weight:600; color:var(--ink); outline:none;"
            />
