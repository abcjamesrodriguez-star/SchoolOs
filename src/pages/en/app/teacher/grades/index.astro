            </button>
            <button
              type="button"
              id="filterBtn-pass"
              onclick="filterByStatus('pass');"
              class="grade-filter-pill"
              style="font-size:10px; padding:4px 8px;"
            >
              ✓ Passing (<span id="pillCountPass">28</span>)
            </button>
            <button
              type="button"
              id="filterBtn-honor"
              onclick="filterByStatus('honor');"
              class="grade-filter-pill"
              style="font-size:10px; padding:4px 8px;"
            >
              ⭐ Honors (<span id="pillCountHonor">13</span>)
            </button>
          </div>

        </div>

        <!-- Botones de Desplazamiento Horizontal (Columnas) & Vertical (Filas) & Acciones -->
        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
          
          <!-- ── CLUSTER DE DESPLAZAMIENTO HORIZONTAL (COLUMNAS) ── -->
          <div style="display:flex; align-items:center; background:#FFF3E8; border:1.5px solid var(--rust); border-radius:5px; padding:2px; gap:2px;">
            <button
              type="button"
              onclick="scrollTableHorizontal('left');"
              title="Scroll columns left"
              style="padding:4px 9px; font-family:var(--mono); font-size:11px; font-weight:900; border:none; background:transparent; color:var(--rust); cursor:pointer; border-radius:3px; display:flex; align-items:center; gap:3px;"
              onmouseenter="this.style.background='#FFFFFF';"
