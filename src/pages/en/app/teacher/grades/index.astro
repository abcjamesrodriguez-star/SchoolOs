              style="padding:4px 9px; font-family:var(--mono); font-size:11px; font-weight:900; border:none; background:transparent; color:var(--rust); cursor:pointer; border-radius:3px; display:flex; align-items:center; gap:3px;"
              onmouseenter="this.style.background='#FFFFFF';"
              onmouseleave="this.style.background='transparent';"
            >
