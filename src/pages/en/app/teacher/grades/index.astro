---
// ============================================================
// SchoolOS — Gradebook & Course Workbench (English)
// Rediseño UX Profesional:
// 1. Proceso en 2 fases: 1° Creación completa en DOM -> 2° Ubicación, desplazamiento y foco en siguiente frame
// 2. Barra Flotante Inferior Permanente (Sticky Bottom Dock) con Botones de Desplazamiento Horizontal (◀ Cols | Cols ▶) y Vertical (▲ Inicio | ▼ Final)
// 3. Tabla unificada con Encabezados y Columnas Sticky 2D (arriba, izquierda y derecha)
// 4. Barra de KPIs compacta en tiempo real (Promedio, Aprobados, En Riesgo, Ponderación)
// 5. Celdas de nota interactivas con feedback de color (<60 rojo, >=85 verde) y navegación fluida
// ============================================================
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { getTeacherCourses, getAllTeacherStudents } from '../../../../../data/app/mock-content';

const lang = 'en';
const isEs = lang === 'es';
const courses = getTeacherCourses();
const allStudents = getAllTeacherStudents();

// 30 estudiantes de 10°A
const students10A = allStudents.filter(s => s.courseId === 'crs-bio-10a');
---

<AppLayout
  title="Grades & Summary"
  pageTitle="Gradebook — Teacher Deck"
  activeSection="grades"
  role="teacher"
  schoolName="Colegio Norte"
  lang={lang}
  activeRoute="/app/teacher/grades"
  breadcrumbs={[
    { label: 'Colegio Norte' },
    { label: 'Teacher Portal', href: `/${lang}/app/teacher` },
    { label: 'Grades & Summary' },
  ]}
>

  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <!-- ── VISTA 1: CATÁLOGO DE CURSOS EN CARDS ── -->
  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <div id="viewCourseCatalog">
    
    <!-- Encabezado de Bienvenida -->
    <div style="background:var(--paper); border:2px solid var(--ink); border-radius:8px; padding:18px 24px; margin-bottom:22px; box-shadow:4px 4px 0 rgba(18,17,14,0.08); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
      <div>
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
          <span class="plan-tag" style="background:var(--rust); color:#FFFFFF; border-color:var(--rust); font-size:9.5px; font-weight:900; padding:2px 8px; border-radius:4px;">
            TERM 1 · 2026
          </span>
          <span style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft);">
            Week 6 of 18 · Scale 0–100% (0.0–5.0)
          </span>
        </div>
        <h1 style="font-family:var(--serif); font-size:24px; font-weight:700; color:var(--ink); margin:0;">
          My Classes — Assessment Gradebooks
        </h1>
        <div style="font-family:var(--mono); font-size:12px; color:var(--ink-soft); margin-top:3px;">
          Select a class to enter its focused interactive gradebook and manage student marks.
        </div>
      </div>

      <div style="display:flex; gap:12px;">
        <div style="background:var(--cream); border:1.5px solid var(--ink); border-radius:6px; padding:8px 16px; text-align:center;">
          <div style="font-family:var(--mono); font-size:9.5px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Total Classes</div>
          <div style="font-family:var(--mono); font-size:18px; font-weight:900; color:var(--ink);">{courses.length}</div>
        </div>
        <div style="background:var(--cream); border:1.5px solid var(--ink); border-radius:6px; padding:8px 16px; text-align:center;">
          <div style="font-family:var(--mono); font-size:9.5px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Global Average</div>
          <div style="font-family:var(--mono); font-size:18px; font-weight:900; color:#2E5E1E;">8.1</div>
        </div>
      </div>
    </div>

    <!-- GRID DE CARDS DE CURSOS -->
    <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap:18px; margin-bottom:30px;">
      {courses.map((course) => {
        const is10A = course.id === 'crs-bio-10a';
        const is10B = course.id === 'crs-bio-10b';
        const hasPending = is10A || is10B;
        const pendingCount = is10A ? 25 : (is10B ? 18 : 0);

        return (
          <div
            class="course-select-card"
            onclick={`selectCourseFromCard('${course.id}', '${course.name}', ${course.studentCount});`}
            style="background:#FFFDFB; border:2px solid var(--ink); border-radius:8px; box-shadow:4px 4px 0 rgba(18,17,14,0.08); cursor:pointer; display:flex; flex-direction:column; justify-content:space-between; transition:transform 0.15s ease, box-shadow 0.15s ease;"
          >
            <!-- Top info -->
            <div style="padding:18px 20px 14px 20px; border-bottom:1.5px solid var(--line);">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <span class="plan-tag" style={`font-size:9.5px; font-weight:900; padding:2px 7px; border-radius:3px; ${hasPending ? 'background:#FCEAE6; color:var(--rust); border-color:var(--rust);' : 'background:#E5EFE0; color:#2E5E1E; border-color:#5B8A4A;'}`}>
                  {hasPending ? `🔴 ${pendingCount} PENDING` : '🟢 ON TRACK'}
                </span>
                <span style="font-family:var(--mono); font-size:11px; font-weight:700; color:var(--ink-soft);">
                  {course.room}
                </span>
              </div>

              <h2 style="font-family:var(--serif); font-size:18px; font-weight:700; color:var(--ink); margin:0 0 6px 0; line-height:1.25;">
                {course.name}
              </h2>

              <div style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft);">
                {course.schedule} · <strong>{course.studentCount} Students</strong>
              </div>
            </div>

            <!-- Resumen de Actividades Evaluativas -->
            <div style="padding:14px 20px; background:var(--paper); border-bottom:1.5px solid var(--line); flex:1;">
              <div style="font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink-soft); margin-bottom:8px; display:flex; justify-content:space-between;">
                <span>Evaluation Plan (T1)</span>
                <span>4 / 5 Marked</span>
              </div>

              <div style="display:flex; flex-direction:column; gap:5px;">
                <div style="display:flex; justify-content:space-between; align-items:center; font-size:11px; padding:4px 8px; background:#FFFFFF; border:1px solid #E8E2D9; border-radius:4px;">
                  <span style="color:var(--ink); font-weight:600;">§1 Cell Biology (15%)</span>
                  <span style="font-family:var(--mono); font-size:10px; color:#2E5E1E; font-weight:800;">✓ Graded</span>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center; font-size:11px; padding:4px 8px; background:#FFFFFF; border:1px solid #E8E2D9; border-radius:4px;">
                  <span style="color:var(--ink); font-weight:600;">§2 Nucleus (20%)</span>
                  <span style="font-family:var(--mono); font-size:10px; color:#2E5E1E; font-weight:800;">✓ Graded</span>
                </div>
                <div style={`display:flex; justify-content:space-between; align-items:center; font-size:11px; padding:4px 8px; border-radius:4px; ${hasPending ? 'background:#FFF4F2; border:1px solid #F5C6BC;' : 'background:#FFFFFF; border:1px solid #E8E2D9;'}`}>
                  <span style="color:var(--ink); font-weight:700;">Mendel Exam (30%)</span>
                  <span style={`font-family:var(--mono); font-size:10px; font-weight:800; ${hasPending ? 'color:var(--rust);' : 'color:#2E5E1E;'}`}>
                    {hasPending ? `⏳ ${pendingCount} missing` : '✓ Graded'}
                  </span>
                </div>
              </div>
            </div>

            <!-- Footer de la Card -->
            <div style="padding:12px 20px; background:var(--cream); display:flex; justify-content:space-between; align-items:center;">
              <div>
                <div style="font-family:var(--mono); font-size:9.5px; color:var(--ink-soft); text-transform:uppercase;">Average</div>
                <div style="font-family:var(--mono); font-size:16px; font-weight:900; color:#2E5E1E;">
                  {course.averageScore.toFixed(1)} <span style="font-size:11px; font-weight:normal; color:var(--ink-soft);">/ 10</span>
                </div>
              </div>

              <span
                class="btn btn-primary btn-sm"
                style="font-size:11.5px; font-weight:800; padding:7px 16px; border-radius:4px;"
              >
                Open Gradebook →
              </span>
            </div>
          </div>
        );
      })}
    </div>

  </div>

  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <!-- ── VISTA 2: WORKBENCH DE CALIFICACIONES (PLANILLA Y BOLETÍN) ── -->
  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <div id="viewCourseWorkbench" style="display:none; position:relative;">
    
    <!-- BARRA SUPERIOR DEL CURSO -->
    <div style="background:var(--paper); border:2px solid var(--ink); border-radius:8px; padding:14px 20px; margin-bottom:14px; box-shadow:3px 3px 0 rgba(18,17,14,0.08); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
      
      <!-- Volver + Título del Curso -->
      <div style="display:flex; align-items:center; gap:12px;">
        <button
          type="button"
          onclick="returnToCourseCatalog();"
          class="btn btn-secondary btn-sm"
          style="font-size:11px; font-weight:800; padding:7px 14px; border-radius:5px; cursor:pointer;"
        >
          ← My Classes
        </button>

        <div>
          <div style="display:flex; align-items:center; gap:8px;">
            <span class="plan-tag" style="background:#E5EFE0; color:#2E5E1E; border-color:#5B8A4A; font-size:9.5px; font-weight:900; padding:1px 6px; border-radius:3px;">
              TERM 1
            </span>
            <span id="saveStatusIndicator" style="font-family:var(--mono); font-size:10.5px; color:#2E5E1E; font-weight:700; display:flex; align-items:center; gap:4px;">
              ● Synchronized
            </span>
          </div>
          <h2 id="wbCourseTitle" style="font-family:var(--serif); font-size:20px; font-weight:700; color:var(--ink); margin:2px 0 0 0;">
            Biología Celular y Genética · 10°A
          </h2>
        </div>
      </div>

      <!-- Pestañas y Guardado -->
      <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
        <div style="display:flex; background:var(--cream); border:1.5px solid var(--ink); border-radius:6px; padding:3px; gap:3px;">
          <button
            type="button"
            id="tabBtnPlanilla"
            onclick="switchMainTab('planilla');"
            style="padding:6px 16px; font-family:var(--mono); font-size:11px; font-weight:800; border:none; border-radius:4px; cursor:pointer; background:var(--ink); color:#FFFFFF; transition:all 0.15s ease;"
          >
            📊 Gradebook
          </button>

          <button
            type="button"
            id="tabBtnResumen"
            onclick="switchMainTab('resumen');"
            style="padding:6px 16px; font-family:var(--mono); font-size:11px; font-weight:800; border:none; border-radius:4px; cursor:pointer; background:transparent; color:var(--ink); transition:all 0.15s ease;"
          >
            📋 Summary & Reports
          </button>
        </div>

        <button
          type="button"
          onclick="savePlanillaGrades();"
          class="btn btn-primary btn-sm"
          style="font-size:11.5px; font-weight:900; padding:7px 18px; border-radius:5px; cursor:pointer;"
        >
          ✓ Save Gradebook
        </button>
      </div>

    </div>

    <!-- ── KPI SUMMARY BAR COMPACTO ── -->
    <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap:10px; margin-bottom:14px;">
      <div style="background:var(--paper); border:1.5px solid var(--ink); border-radius:6px; padding:10px 14px; box-shadow:2px 2px 0 rgba(18,17,14,0.06); display:flex; justify-content:space-between; align-items:center;">
        <div>
          <div style="font-family:var(--mono); font-size:9.5px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Class Average</div>
          <div style="font-family:var(--mono); font-size:18px; font-weight:900; color:var(--ink);">
            <span id="kpiAvgScore">79.7</span> <span style="font-size:11px; font-weight:700; color:var(--ink-soft);">/ 100</span>
          </div>
        </div>
        <span style="font-family:var(--mono); font-size:11px; font-weight:900; background:#E5EFE0; color:#2E5E1E; padding:3px 7px; border-radius:4px; border:1px solid #A8C99B;">
          4.0 / 5.0
        </span>
      </div>

      <div style="background:var(--paper); border:1.5px solid var(--ink); border-radius:6px; padding:10px 14px; box-shadow:2px 2px 0 rgba(18,17,14,0.06); display:flex; justify-content:space-between; align-items:center;">
        <div>
          <div style="font-family:var(--mono); font-size:9.5px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Passing</div>
          <div style="font-family:var(--mono); font-size:18px; font-weight:900; color:#2E5E1E;">
            <span id="kpiPassCount">28</span> <span style="font-size:11px; font-weight:700; color:var(--ink-soft);">/ 30</span>
          </div>
        </div>
        <span id="kpiPassPct" style="font-family:var(--mono); font-size:11px; font-weight:800; color:#2E5E1E;">
          93.3%
        </span>
      </div>

      <div style="background:var(--paper); border:1.5px solid var(--ink); border-radius:6px; padding:10px 14px; box-shadow:2px 2px 0 rgba(18,17,14,0.06); display:flex; justify-content:space-between; align-items:center;">
        <div>
          <div style="font-family:var(--mono); font-size:9.5px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">At Risk (< 60)</div>
          <div style="font-family:var(--mono); font-size:18px; font-weight:900; color:var(--rust);">
            <span id="kpiRiskCount">2</span> <span style="font-size:11px; font-weight:700; color:var(--ink-soft);">students</span>
          </div>
        </div>
        <button
          type="button"
          onclick="filterByStatus('risk');"
          style="font-family:var(--mono); font-size:9.5px; font-weight:800; background:#FFF0EE; color:var(--rust); border:1px solid #F5C6BC; padding:3px 6px; border-radius:3px; cursor:pointer;"
        >
          Filter ⚠️
        </button>
      </div>

      <div style="background:var(--paper); border:1.5px solid var(--ink); border-radius:6px; padding:10px 14px; box-shadow:2px 2px 0 rgba(18,17,14,0.06); display:flex; justify-content:space-between; align-items:center;">
        <div>
          <div style="font-family:var(--mono); font-size:9.5px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Total Weight</div>
          <div style="font-family:var(--mono); font-size:18px; font-weight:900; color:#2E5E1E;" id="kpiWeightTotal">
            100%
          </div>
        </div>
        <span id="kpiWeightStatus" style="font-family:var(--mono); font-size:10px; font-weight:900; background:#E5EFE0; color:#2E5E1E; padding:3px 7px; border-radius:4px; border:1px solid #A8C99B;">
          ✓ Balanced
        </span>
      </div>
    </div>

    <!-- ── PESTAÑA A: PLANILLA DE CALIFICACIONES ── -->
    <div id="tabContentPlanilla">

      <!-- ── TABLA SPREADSHEET UNIFICADA CON STICKY COLUMNS NATIVAS ── -->
      <div
        id="gradebookTableWrapper"
        class="gradebook-table-container modern-scrollbar"
        style="background:#FFFFFF; border:2px solid var(--ink); border-radius:8px; box-shadow:4px 4px 0 rgba(18,17,14,0.08); overflow-x:auto; margin-bottom:14px; scroll-behavior:smooth;"
      >
        
        <table class="gradebook-table" id="gradebookMainTable" style="width:100%; border-collapse:collapse; min-width:980px;">
          <thead>
            <tr style="background:var(--cream);">
              <!-- 1. Columna # (Sticky) -->
              <th class="th-sticky-num" style="position:sticky; left:0; top:0; width:44px; min-width:44px; max-width:44px; background:var(--cream); z-index:30; padding:10px 4px; font-family:var(--mono); font-size:10px; font-weight:800; color:var(--ink-soft); text-align:center; border-bottom:2px solid var(--ink); border-right:1px solid #D8D2C2;">
                #
              </th>

              <!-- 2. Columna Estudiante (Sticky) -->
              <th class="th-sticky-student" style="position:sticky; left:44px; top:0; width:230px; min-width:230px; max-width:230px; background:var(--cream); z-index:30; padding:10px 12px; font-family:var(--mono); font-size:11px; font-weight:800; text-transform:uppercase; color:var(--ink); text-align:left; border-bottom:2px solid var(--ink); border-right:2px solid var(--ink); box-shadow:4px 0 6px -2px rgba(0,0,0,0.06);">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                  <span>Student ({students10A.length})</span>
                  <span style="font-size:9px; color:var(--ink-soft); font-weight:normal;">A-Z</span>
                </div>
              </th>

              <!-- 3. Columnas de Actividades Estáticas -->
              <th class="th-activity-col" style="position:sticky; top:0; z-index:20; padding:8px 6px; text-align:center; border-bottom:2px solid var(--ink); border-right:1px solid #E2DDD5; background:var(--cream); min-width:100px;">
                <div class="act-th-title" style="font-family:var(--mono); font-size:11px; font-weight:800; color:var(--ink); line-height:1.2; margin-bottom:3px;">Guide § 1</div>
                <div class="act-th-sub" style="display:flex; align-items:center; justify-content:center; gap:4px;">
                  <span class="act-badge-type" style="font-family:var(--mono); font-size:8.5px; font-weight:700; color:var(--ink-soft); background:#FFFFFF; border:1px solid #D8D2C2; padding:1px 4px; border-radius:3px;">Lab</span>
                  <span class="act-badge-weight" style="font-family:var(--mono); font-size:9px; font-weight:900; color:var(--rust); background:#FFF0EE; padding:1px 5px; border-radius:3px;">15%</span>
                </div>
              </th>

              <th class="th-activity-col" style="position:sticky; top:0; z-index:20; padding:8px 6px; text-align:center; border-bottom:2px solid var(--ink); border-right:1px solid #E2DDD5; background:var(--cream); min-width:100px;">
                <div class="act-th-title" style="font-family:var(--mono); font-size:11px; font-weight:800; color:var(--ink); line-height:1.2; margin-bottom:3px;">Guide § 2</div>
                <div class="act-th-sub" style="display:flex; align-items:center; justify-content:center; gap:4px;">
                  <span class="act-badge-type" style="font-family:var(--mono); font-size:8.5px; font-weight:700; color:var(--ink-soft); background:#FFFFFF; border:1px solid #D8D2C2; padding:1px 4px; border-radius:3px;">Lab</span>
                  <span class="act-badge-weight" style="font-family:var(--mono); font-size:9px; font-weight:900; color:var(--rust); background:#FFF0EE; padding:1px 5px; border-radius:3px;">20%</span>
                </div>
              </th>

              <th class="th-activity-col" style="position:sticky; top:0; z-index:20; padding:8px 6px; text-align:center; border-bottom:2px solid var(--ink); border-right:1px solid #E2DDD5; background:var(--cream); min-width:100px;">
                <div class="act-th-title" style="font-family:var(--mono); font-size:11px; font-weight:800; color:var(--ink); line-height:1.2; margin-bottom:3px;">Quiz Lab</div>
                <div class="act-th-sub" style="display:flex; align-items:center; justify-content:center; gap:4px;">
                  <span class="act-badge-type" style="font-family:var(--mono); font-size:8.5px; font-weight:700; color:var(--ink-soft); background:#FFFFFF; border:1px solid #D8D2C2; padding:1px 4px; border-radius:3px;">Quiz</span>
                  <span class="act-badge-weight" style="font-family:var(--mono); font-size:9px; font-weight:900; color:var(--rust); background:#FFF0EE; padding:1px 5px; border-radius:3px;">20%</span>
                </div>
              </th>

              <th class="th-activity-col th-exam-highlight" style="position:sticky; top:0; z-index:20; padding:8px 6px; text-align:center; border-bottom:2px solid var(--ink); border-right:1.5px solid var(--rust); border-left:1.5px solid var(--rust); background:#FFFDF9; min-width:115px;">
                <div class="act-th-title" style="font-family:var(--mono); font-size:11px; font-weight:800; color:var(--rust); line-height:1.2; margin-bottom:3px;">Mendel Exam</div>
                <div class="act-th-sub" style="display:flex; align-items:center; justify-content:center; gap:4px;">
                  <span class="act-badge-type" style="font-family:var(--mono); font-size:8.5px; font-weight:700; color:var(--rust); background:#FCEAE6; border:1px solid var(--rust); padding:1px 4px; border-radius:3px;">Exam</span>
                  <span class="act-badge-weight" style="font-family:var(--mono); font-size:9px; font-weight:900; color:#FFFFFF; background:var(--rust); padding:1px 5px; border-radius:3px;">30% ★</span>
                </div>
              </th>

              <th class="th-activity-col" style="position:sticky; top:0; z-index:20; padding:8px 6px; text-align:center; border-bottom:2px solid var(--ink); border-right:1px solid #E2DDD5; background:var(--cream); min-width:100px;">
                <div class="act-th-title" style="font-family:var(--mono); font-size:11px; font-weight:800; color:var(--ink); line-height:1.2; margin-bottom:3px;">Attitude</div>
                <div class="act-th-sub" style="display:flex; align-items:center; justify-content:center; gap:4px;">
                  <span class="act-badge-type" style="font-family:var(--mono); font-size:8.5px; font-weight:700; color:var(--ink-soft); background:#FFFFFF; border:1px solid #D8D2C2; padding:1px 4px; border-radius:3px;">Behavior</span>
                  <span class="act-badge-weight" style="font-family:var(--mono); font-size:9px; font-weight:900; color:var(--rust); background:#FFF0EE; padding:1px 5px; border-radius:3px;">15%</span>
                </div>
              </th>

              <!-- Botón + Col Header -->
              <th class="th-add-col" style="position:sticky; top:0; z-index:20; width:46px; min-width:46px; padding:6px; border-bottom:2px solid var(--ink); border-right:1px dashed var(--rust); background:#FFF8F5; text-align:center;">
                <button
                  type="button"
                  onclick="openAddColumnModal();"
                  title="Add new assessment"
