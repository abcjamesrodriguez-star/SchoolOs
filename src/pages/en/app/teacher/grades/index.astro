            style="width:100%; padding:8px 10px; border:1.5px solid var(--ink); border-radius:5px; background:#FFFFFF; font-size:12.5px; font-weight:700; color:var(--ink); outline:none;"
          />
          <div id="colTitleCharCount" style="font-family:var(--mono); font-size:9.5px; color:var(--ink-soft); text-align:right; margin-top:2px;">11 restantes</div>
        </div>

        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
          <div>
            <label style="font-family:var(--mono); font-size:10.5px; font-weight:800; text-transform:uppercase; color:var(--ink-soft); display:block; margin-bottom:4px;">
              Weight (% of Term)
            </label>
            <input
              type="number"
              id="newColWeight"
              value="15"
              min="1"
              max="50"
              style="width:100%; padding:7px; border:1.5px solid var(--ink); border-radius:5px; background:#FFFFFF; font-family:var(--mono); font-size:13px; font-weight:800; color:var(--ink);"
            />
          </div>

          <div>
            <label style="font-family:var(--mono); font-size:10.5px; font-weight:800; text-transform:uppercase; color:var(--ink-soft); display:block; margin-bottom:4px;">Activity Type</label>
            <select id="newColType" style="width:100%; padding:7px; border:1.5px solid var(--ink); border-radius:5px; background:#FFFFFF; font-family:var(--mono); font-size:11px; font-weight:700;">
              <option value="Workshop">Workshop</option>
              <option value="Quiz">Quiz</option>
              <option value="Oral">Oral Defense</option>
              <option value="Essay">Essay</option>
              <option value="Exam">Midterm Exam</option>
            </select>
          </div>
        </div>

        <div style="background:var(--cream); border:1.5px solid #DDD6C8; border-radius:5px; padding:10px 12px; font-family:var(--mono); font-size:10.5px; color:var(--ink); line-height:1.4;">
          ✓ Created and attached completely to the table first.<br/>✓ Then positioned, centered and focused seamlessly.
        </div>

      </div>

      <div style="padding:12px 18px; background:var(--cream); border-top:1.5px solid #DDD6C8; display:flex; justify-content:space-between; align-items:center;">
        <button onclick="closeAddColumnModal();" class="btn btn-secondary btn-sm" style="border-radius:4px; cursor:pointer;">Cancel</button>
        <button onclick="createNewColumn();" class="btn btn-primary btn-sm" style="font-weight:900; font-size:12px; padding:8px 20px; border-radius:5px; cursor:pointer;">
          ✓ Add Column
        </button>
      </div>

    </div>
  </div>

  <!-- TOAST -->
  <div id="gradeToast" style="display:none; position:fixed; bottom:24px; right:24px; z-index:99999; background:var(--ink); color:#FFFFFF; padding:12px 20px; border:2px solid var(--rust); border-radius:6px; box-shadow:5px 5px 0 rgba(0,0,0,0.3); font-family:var(--mono); font-size:12px; font-weight:800; align-items:center; gap:10px;">
    <span id="toastIcon">✓</span>
    <span id="toastMsg">Changes saved successfully.</span>
  </div>

  <style is:global>
    .grade-input-cell:focus {
      border-color: var(--ink) !important;
      background: #FFFDF9 !important;
      box-shadow: 0 0 0 2px rgba(18, 17, 14, 0.25) !important;
    }

    .grade-low {
      color: var(--rust) !important;
      background: #FFF2F0 !important;
      border-color: #F5C6BC !important;
      font-weight: 900 !important;
    }

    .grade-high {
      color: #2E5E1E !important;
      background: #F4FAF1 !important;
      border-color: #C3DFC0 !important;
      font-weight: 900 !important;
    }

    .grade-filter-pill {
      font-family: var(--mono);
      font-size: 10px;
      font-weight: 800;
      padding: 4px 8px;
      border-radius: 4px;
      border: 1.5px solid var(--ink);
      background: #FFFFFF;
      color: var(--ink);
      cursor: pointer;
      transition: all 0.12s ease;
    }
    .grade-filter-pill:hover {
      background: var(--cream);
    }
    .grade-filter-pill.active {
      background: var(--ink);
      color: #FFFFFF;
    }

    .course-select-card:hover {
      transform: translateY(-2px);
      box-shadow: 6px 6px 0 rgba(18,17,14,0.14);
    }

    /* Custom Modern Scrollbar for the table */
    .modern-scrollbar::-webkit-scrollbar {
      height: 8px;
      width: 8px;
    }
    .modern-scrollbar::-webkit-scrollbar-track {
      background: #FAF8F5;
      border-top: 1px solid #ECE7DE;
    }
    .modern-scrollbar::-webkit-scrollbar-thumb {
      background: #C7BEB0;
      border-radius: 4px;
      border: 1px solid #AFA595;
    }
    .modern-scrollbar::-webkit-scrollbar-thumb:hover {
      background: var(--rust);
    }

    /* Highlight animation for newly created columns */
    @keyframes colHighlightFlash {
      0% { background-color: #FFE6D5; }
      50% { background-color: #FFD8BE; }
      100% { background-color: var(--cream); }
    }
    .new-col-highlight {
      animation: colHighlightFlash 1.6s ease;
    }
  </style>

  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <!-- ── JAVASCRIPT REACTIVO Y GESTOR DE CALIFICACIONES ── -->
  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <script is:inline>
    const TOTAL_STUDENTS = 30;
    let extraColumnsCount = 0;
    let dynamicColumns = [];
    let currentStatusFilter = 'all';
    let activeColumnsOrder = ['g1', 'g2', 'qz', 'ex', 'ac'];

    function showToast(msg, type = 'success') {
      const toast = document.getElementById('gradeToast');
      const toastMsg = document.getElementById('toastMsg');
      const toastIcon = document.getElementById('toastIcon');
      if (!toast) return;
      toastMsg.innerText = msg;
      toastIcon.innerText = type === 'success' ? '✓' : 'ℹ';
      toast.style.display = 'flex';
      setTimeout(() => { toast.style.display = 'none'; }, 3000);
    }

    function toggleToolsDropdown() {
      const menu = document.getElementById('toolsDropdownMenu');
      if (!menu) return;
      menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
    }

    document.addEventListener('click', function (e) {
      const menu = document.getElementById('toolsDropdownMenu');
      if (menu && menu.style.display === 'block') {
        if (!e.target.closest('#toolsDropdownMenu') && !e.target.closest('button[onclick*="toggleToolsDropdown"]')) {
          menu.style.display = 'none';
        }
      }
    });

    // ── DESPLAZAMIENTO HORIZONTAL SUAVE DE COLUMNAS ──
    function scrollTableHorizontal(direction) {
      const tableWrapper = document.getElementById('gradebookTableWrapper');
      if (!tableWrapper) return;
      const scrollStep = 240; // Desplazar aprox 2-3 columnas
      tableWrapper.scrollBy({
        left: direction === 'left' ? -scrollStep : scrollStep,
        behavior: 'smooth'
      });
    }

    function scrollToTableTop() {
      const el = document.getElementById('gradebookTableWrapper');
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    function scrollToTableBottom() {
      const el = document.getElementById('gradebookTableWrapper');
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'end' });
      } else {
        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
      }
    }

    function selectCourseFromCard(courseId, courseName, count) {
      document.getElementById('viewCourseCatalog').style.display = 'none';
      document.getElementById('viewCourseWorkbench').style.display = 'block';
      document.getElementById('wbCourseTitle').innerText = `${courseName} (${count} students)`;
      
      filterByStatus('all');
      const searchInp = document.getElementById('studentSearchInput');
      if (searchInp) searchInp.value = '';
      
      recalculateAllRows();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      showToast(`Active Workbench: ${courseName}`);
    }

    function returnToCourseCatalog() {
      document.getElementById('viewCourseWorkbench').style.display = 'none';
      document.getElementById('viewCourseCatalog').style.display = 'block';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function switchMainTab(tab) {
      const btnP = document.getElementById('tabBtnPlanilla');
      const btnR = document.getElementById('tabBtnResumen');
      const pnlP = document.getElementById('tabContentPlanilla');
      const pnlR = document.getElementById('tabContentResumen');

      if (tab === 'planilla') {
        btnP.style.background = 'var(--ink)';
        btnP.style.color = '#FFFFFF';
        btnR.style.background = 'transparent';
        btnR.style.color = 'var(--ink)';
        pnlP.style.display = 'block';
        pnlR.style.display = 'none';
      } else {
        btnR.style.background = 'var(--ink)';
        btnR.style.color = '#FFFFFF';
        btnP.style.background = 'transparent';
        btnP.style.color = 'var(--ink)';
        pnlP.style.display = 'none';
        pnlR.style.display = 'block';
      }
    }

    function filterStudentsTable() {
      const query = (document.getElementById('studentSearchInput')?.value || '').toLowerCase().trim();
      
      for (let i = 0; i < TOTAL_STUDENTS; i++) {
        const row = document.getElementById(`std-row-${i}`);
        if (!row) continue;

        const name = row.getAttribute('data-name') || '';
        const status = row.getAttribute('data-status') || '';

        const matchesSearch = !query || name.includes(query);
        const matchesStatus = currentStatusFilter === 'all' || status === currentStatusFilter;

        row.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
      }
    }

    function filterByStatus(status) {
      currentStatusFilter = status;
      ['all', 'risk', 'pass', 'honor'].forEach(s => {
        const btn = document.getElementById(`filterBtn-${s}`);
        if (btn) {
          if (s === status) btn.classList.add('active');
          else btn.classList.remove('active');
        }
      });
      filterStudentsTable();
    }

    function handleGradeInput(idx, colKey) {
      const inp = document.getElementById(`cell-${colKey}-${idx}`);
      if (inp) {
        let val = parseFloat(inp.value);
        if (isNaN(val)) val = 0;
        
        inp.classList.remove('grade-low', 'grade-high');
        if (val < 60) inp.classList.add('grade-low');
        else if (val >= 85) inp.classList.add('grade-high');
      }

      recalculateRow(idx);
      updateOverallMetrics();
      triggerAutoSaveFeedback();
    }

    function recalculateRow(idx) {
      const g1 = Math.max(0, Math.min(100, parseFloat(document.getElementById(`cell-g1-${idx}`)?.value) || 0));
      const g2 = Math.max(0, Math.min(100, parseFloat(document.getElementById(`cell-g2-${idx}`)?.value) || 0));
      const qz = Math.max(0, Math.min(100, parseFloat(document.getElementById(`cell-qz-${idx}`)?.value) || 0));
      const ex = Math.max(0, Math.min(100, parseFloat(document.getElementById(`cell-ex-${idx}`)?.value) || 0));
      const ac = Math.max(0, Math.min(100, parseFloat(document.getElementById(`cell-ac-${idx}`)?.value) || 0));

      let totalWeighted = (g1 * 15) + (g2 * 20) + (qz * 20) + (ex * 30) + (ac * 15);
      let totalWeightSum = 100;

      dynamicColumns.forEach(col => {
        const dynInp = document.getElementById(`cell-${col.key}-${idx}`);
        if (dynInp) {
          const val = Math.max(0, Math.min(100, parseFloat(dynInp.value) || 0));
          totalWeighted += (val * col.weight);
          totalWeightSum += col.weight;
        }
      });

      const final100 = totalWeightSum > 0 ? (totalWeighted / totalWeightSum) : 0;
      const final5 = (final100 / 20).toFixed(1);

      const def100El = document.getElementById(`def100-${idx}`);
      const def5El = document.getElementById(`def5-${idx}`);
      if (def100El) def100El.innerText = Math.round(final100);
      if (def5El) def5El.innerText = final5;

      const isHonor = final100 >= 85;
      const isPass = final100 >= 60;
      const level = isHonor ? 'HONOR' : (isPass ? 'PASS' : 'FAIL');
      const badgeCls = isHonor ? 'badge-active' : (isPass ? 'badge-warning' : 'badge-suspended');
      const statusCat = isHonor ? 'honor' : (isPass ? 'pass' : 'risk');

      const badge = document.getElementById(`badge-${idx}`);
      if (badge) {
        badge.className = `badge ${badgeCls}`;
        badge.innerText = level;
      }

      const row = document.getElementById(`std-row-${idx}`);
      if (row) {
        row.setAttribute('data-status', statusCat);
      }
    }

    function recalculateAllRows() {
      for (let i = 0; i < TOTAL_STUDENTS; i++) {
        recalculateRow(i);
      }
      updateOverallMetrics();
    }

    function updateOverallMetrics() {
      let sumDef = 0;
      let passCount = 0;
      let riskCount = 0;
      let honorCount = 0;

      const colSums = { g1: 0, g2: 0, qz: 0, ex: 0, ac: 0 };
      dynamicColumns.forEach(c => colSums[c.key] = 0);

      for (let i = 0; i < TOTAL_STUDENTS; i++) {
        const defVal = parseFloat(document.getElementById(`def100-${i}`)?.innerText) || 0;
        sumDef += defVal;
        if (defVal >= 85) honorCount++;
        if (defVal >= 60) passCount++;
        else riskCount++;

        ['g1', 'g2', 'qz', 'ex', 'ac'].forEach(k => {
          colSums[k] += parseFloat(document.getElementById(`cell-${k}-${i}`)?.value) || 0;
        });

        dynamicColumns.forEach(c => {
          colSums[c.key] += parseFloat(document.getElementById(`cell-${c.key}-${i}`)?.value) || 0;
        });
      }

      const avg = (sumDef / TOTAL_STUDENTS).toFixed(1);
      const avg5 = (sumDef / TOTAL_STUDENTS / 20).toFixed(1);
      const passPct = ((passCount / TOTAL_STUDENTS) * 100).toFixed(1);

      const kpiAvg = document.getElementById('kpiAvgScore');
      if (kpiAvg) kpiAvg.innerText = avg;

      const kpiPass = document.getElementById('kpiPassCount');
      if (kpiPass) kpiPass.innerText = passCount;

      const kpiPct = document.getElementById('kpiPassPct');
      if (kpiPct) kpiPct.innerText = `${passPct}%`;

      const kpiRisk = document.getElementById('kpiRiskCount');
      if (kpiRisk) kpiRisk.innerText = riskCount;

      const pillRisk = document.getElementById('pillCountRisk');
      if (pillRisk) pillRisk.innerText = riskCount;

      const pillPass = document.getElementById('pillCountPass');
      if (pillPass) pillPass.innerText = passCount;

      const pillHonor = document.getElementById('pillCountHonor');
      if (pillHonor) pillHonor.innerText = honorCount;

      ['g1', 'g2', 'qz', 'ex', 'ac'].forEach(k => {
        const el = document.getElementById(`colAvg-${k}`);
        if (el) el.innerText = (colSums[k] / TOTAL_STUDENTS).toFixed(1);
      });

      dynamicColumns.forEach(c => {
        const el = document.getElementById(`colAvg-${c.key}`);
        if (el) el.innerText = (colSums[c.key] / TOTAL_STUDENTS).toFixed(1);
      });

      const footerDef = document.getElementById('colAvg-def');
      if (footerDef) footerDef.innerText = avg;

      const resAvg = document.getElementById('resAvg');
      if (resAvg) resAvg.innerHTML = `${avg} <span style="font-size:14px; font-weight:normal; color:var(--ink-soft);">/ 100</span>`;
      const resPass = document.getElementById('resPass');
      if (resPass) resPass.innerText = `${passPct}%`;
      const resRisk = document.getElementById('resRisk');
      if (resRisk) resRisk.innerText = riskCount;
      const resHonor = document.getElementById('resHonor');
      if (resHonor) resHonor.innerText = honorCount;
    }

    let saveTimeout = null;
    function triggerAutoSaveFeedback() {
      const indicator = document.getElementById('saveStatusIndicator');
      if (indicator) {
        indicator.innerHTML = '● Saving...';
        indicator.style.color = 'var(--rust)';
      }
      clearTimeout(saveTimeout);
      saveTimeout = setTimeout(() => {
        if (indicator) {
          indicator.innerHTML = '● Synchronized';
          indicator.style.color = '#2E5E1E';
        }
      }, 800);
    }

    function navigateTableGrid(event, rowIdx, colKey) {
      const colIdx = activeColumnsOrder.indexOf(colKey);

      if (event.key === 'Enter' || event.key === 'ArrowDown') {
        event.preventDefault();
        for (let nextRow = rowIdx + 1; nextRow < TOTAL_STUDENTS; nextRow++) {
          const rowEl = document.getElementById(`std-row-${nextRow}`);
          if (rowEl && rowEl.style.display !== 'none') {
            const nextCell = document.getElementById(`cell-${colKey}-${nextRow}`);
            if (nextCell) {
              nextCell.focus();
              nextCell.select();
              nextCell.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
            }
            break;
          }
        }
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        for (let prevRow = rowIdx - 1; prevRow >= 0; prevRow--) {
          const rowEl = document.getElementById(`std-row-${prevRow}`);
          if (rowEl && rowEl.style.display !== 'none') {
            const prevCell = document.getElementById(`cell-${colKey}-${prevRow}`);
            if (prevCell) {
              prevCell.focus();
              prevCell.select();
              prevCell.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
            }
            break;
          }
        }
      } else if (event.key === 'ArrowRight' && colIdx < activeColumnsOrder.length - 1) {
        const nextCol = activeColumnsOrder[colIdx + 1];
        const nextCell = document.getElementById(`cell-${nextCol}-${rowIdx}`);
        if (nextCell) {
          nextCell.focus();
          nextCell.select();
          // asegurar que sea visible en scroll horizontal
          nextCell.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
        }
      } else if (event.key === 'ArrowLeft' && colIdx > 0) {
        const prevCol = activeColumnsOrder[colIdx - 1];
        const prevCell = document.getElementById(`cell-${prevCol}-${rowIdx}`);
        if (prevCell) {
          prevCell.focus();
          prevCell.select();
          // asegurar que sea visible en scroll horizontal
          prevCell.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
        }
      }
    }

    function openAddColumnModal() {
      document.getElementById('modalAddColumn').style.display = 'flex';
      const inputTitle = document.getElementById('newColTitle');
      if (inputTitle) {
        inputTitle.value = `Activity ${extraColumnsCount + 3}`;
        inputTitle.focus();
        inputTitle.select();
      }
    }

    function closeAddColumnModal() {
      document.getElementById('modalAddColumn').style.display = 'none';
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CREACIÓN EN 2 FASES: PRIMERO CREAR EN DOM -> LUEGO UBICAR Y DESPLAZAR
    // ══════════════════════════════════════════════════════════════════════════
    function createNewColumn() {
      const title = document.getElementById('newColTitle')?.value || `Activity ${extraColumnsCount + 1}`;
      const weight = parseFloat(document.getElementById('newColWeight')?.value) || 15;
      const type = document.getElementById('newColType')?.value || 'Workshop';
      
      // Cerrar modal primero
      closeAddColumnModal();

      extraColumnsCount++;
      const colKey = `dyn_${extraColumnsCount}`;
      dynamicColumns.push({ key: colKey, weight: weight, title: title, type: type });
      activeColumnsOrder.push(colKey);

      // ── FASE 1: CREAR E INSERTAR COMPLETAMENTE EN EL DOM ──
      const table = document.getElementById('gradebookMainTable');
      const headerRow = table.querySelector('thead tr');
      const addColTh = headerRow.querySelector('.th-add-col');

      // 1.1 Insertar TH en la cabecera
      const th = document.createElement('th');
      th.id = `th-${colKey}`;
      th.className = 'th-activity-col new-col-highlight';
      th.style.cssText = 'position:sticky; top:0; z-index:20; padding:8px 6px; text-align:center; border-bottom:2px solid var(--ink); border-right:1px solid #E2DDD5; background:var(--cream); min-width:100px; max-width:120px; width:120px;';
      th.innerHTML = `
        <div style="display:flex; justify-content:space-between; align-items:center; padding:0 2px; gap:2px;">
          <div style="font-family:var(--mono); font-size:11px; font-weight:800; color:var(--ink); line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:82px; flex:1;" title="${title}">${title}</div>
          <button onclick="removeDynamicColumn('${colKey}', event);" title="Delete column" style="background:none; border:none; color:var(--rust); cursor:pointer; font-weight:900; font-size:10px; padding:0 2px; flex-shrink:0;">✕</button>
        </div>
        <div style="display:flex; align-items:center; justify-content:center; gap:4px; margin-top:3px;">
          <span style="font-family:var(--mono); font-size:8.5px; font-weight:700; color:var(--ink-soft); background:#FFFFFF; border:1px solid #D8D2C2; padding:1px 4px; border-radius:3px;">${type}</span>
          <span style="font-family:var(--mono); font-size:9px; font-weight:900; color:var(--rust); background:#FFF0EE; padding:1px 5px; border-radius:3px;">${weight}%</span>
        </div>
      `;
      headerRow.insertBefore(th, addColTh);

      // 1.2 Insertar TD con input en cada una de las filas
      for (let i = 0; i < TOTAL_STUDENTS; i++) {
        const row = document.getElementById(`std-row-${i}`);
        const addSpacer = row.querySelector('.td-add-col-spacer');

        const td = document.createElement('td');
        td.id = `td-cell-${colKey}-${i}`;
        td.className = 'td-cell-grade';
        td.style.cssText = 'padding:4px 6px; text-align:center; border-bottom:1px solid #ECE7DE; border-right:1px solid #E2DDD5;';
        td.innerHTML = `
          <input
            type="number" min="0" max="100"
            id="cell-${colKey}-${i}"
            value="0"
            data-col="${colKey}"
            data-row="${i}"
            onfocus="this.select();"
            oninput="handleGradeInput(${i}, '${colKey}');"
            onkeydown="navigateTableGrid(event, ${i}, '${colKey}');"
            class="grade-input-cell grade-low"
            style="width:54px; height:28px; padding:2px 4px; border:1px solid #D5CEBF; border-radius:4px; font-family:var(--mono); font-size:12px; font-weight:800; color:var(--ink); text-align:center; outline:none;"
          />
        `;
        row.insertBefore(td, addSpacer);
      }

      // 1.3 Insertar TD en el Footer (Promedio de la nueva actividad)
      const footerRow = table.querySelector('tfoot tr');
      const footSpacer = footerRow.querySelector('.td-add-col-spacer');
      const tdFoot = document.createElement('td');
      tdFoot.id = `colAvg-${colKey}`;
      tdFoot.style.cssText = 'background:var(--cream); text-align:center; font-family:var(--mono); font-size:11.5px; font-weight:800; color:var(--ink); border-right:1px solid #E2DDD5; padding:4px;';
      tdFoot.innerText = '0.0';
      footerRow.insertBefore(tdFoot, footSpacer);

      // 1.4 Recalcular métricas generales
      updateTotalWeightBadge();
      recalculateAllRows();
      showToast(`✓ ${title} created and added to gradebook.`);

      // ── FASE 2: UBICAR, DESPLAZAR Y ENFOCAR TRAS LA CREACIÓN COMPLETA ──
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          const container = document.getElementById('gradebookTableWrapper');
          const newTh = document.getElementById(`th-${colKey}`);
          const firstInput = document.getElementById(`cell-${colKey}-0`);

          if (container && newTh) {
            // Desplazar el contenedor horizontal suavemente para revelar la nueva columna
            container.scrollTo({
              left: container.scrollWidth,
              behavior: 'smooth'
            });
          }

          if (firstInput) {
            setTimeout(() => {
              firstInput.focus();
              firstInput.select();
            }, 120);
          }
        });
      });
    }

    function removeDynamicColumn(colKey, event) {
      if (event) event.stopPropagation();
      if (!confirm('Delete this column and recalculate final grades?')) return;

      const th = document.getElementById(`th-${colKey}`);
      if (th) th.remove();

      for (let i = 0; i < TOTAL_STUDENTS; i++) {
        const td = document.getElementById(`td-cell-${colKey}-${i}`);
        if (td) td.remove();
      }

      const footTd = document.getElementById(`colAvg-${colKey}`);
      if (footTd) footTd.remove();

      dynamicColumns = dynamicColumns.filter(c => c.key !== colKey);
      activeColumnsOrder = activeColumnsOrder.filter(k => k !== colKey);

      updateTotalWeightBadge();
      recalculateAllRows();
      showToast('✓ Column removed.');
    }

    function updateTotalWeightBadge() {
      // Pesos de columnas estáticas son 100% en total (15+20+20+30+15)
      // Las dinámicas se agregan ENCIMA; esto es informativo para el docente
      let dynSum = 0;
      dynamicColumns.forEach(c => dynSum += c.weight);
      const kpiW = document.getElementById('kpiWeightTotal');
      const kpiStatus = document.getElementById('kpiWeightStatus');
      if (kpiW) {
        if (dynSum === 0) {
          kpiW.innerText = '100%';
        } else {
          kpiW.innerText = `+${dynSum}%`;
        }
      }
      if (kpiStatus) {
        if (dynSum === 0) {
          kpiStatus.innerText = '✓ Balanced';
          kpiStatus.style.background = '#E5EFE0';
          kpiStatus.style.color = '#2E5E1E';
          kpiStatus.style.border = '1px solid #A8C99B';
        } else {
          kpiStatus.innerText = `⚠ Re-weight cols`;
          kpiStatus.style.background = '#FFF8EE';
          kpiStatus.style.color = '#B35C00';
          kpiStatus.style.border = '1px solid #EFCA88';
        }
      }
    }

    function fillBlanksWith70() {
      for (let i = 0; i < TOTAL_STUDENTS; i++) {
        const ex = document.getElementById(`cell-ex-${i}`);
        if (ex && (!ex.value || ex.value === '0')) {
          ex.value = 70;
          ex.classList.remove('grade-low', 'grade-high');
        }
        dynamicColumns.forEach(c => {
          const inp = document.getElementById(`cell-${c.key}-${i}`);
          if (inp && (!inp.value || inp.value === '0')) {
            inp.value = 70;
            inp.classList.remove('grade-low', 'grade-high');
          }
        });
        recalculateRow(i);
      }
      updateOverallMetrics();
      showToast('✓ Blank marks set to 70.');
    }

    function applyGroupCurve() {
      for (let i = 0; i < TOTAL_STUDENTS; i++) {
        const ex = document.getElementById(`cell-ex-${i}`);
        if (ex) {
          const val = Math.min(100, (parseFloat(ex.value) || 0) + 5);
          ex.value = val;
          ex.classList.remove('grade-low', 'grade-high');
          if (val < 60) ex.classList.add('grade-low');
          else if (val >= 85) ex.classList.add('grade-high');
        }
        recalculateRow(i);
      }
      updateOverallMetrics();
      showToast('✓ Class curve of +5 points applied.');
    }

    function exportToCSV() {
      showToast('📥 Downloading CSV: Grades_10A_Term1.csv', 'success');
    }

    function savePlanillaGrades() {
      showToast('✅ 30 Student marks saved and synchronized with official reports.');
    }
  </script>

</AppLayout>
