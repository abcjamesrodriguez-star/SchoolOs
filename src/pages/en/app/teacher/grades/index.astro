          <div class="stat-sub">Average score below 60% (3.0)</div>
        </div>

        <div class="stat-card" style="border:2px solid var(--ink); border-radius:8px;">
          <div class="stat-label">Honor Roll</div>
          <div class="stat-num" id="resHonor" style="color:#2E5E1E;">13</div>
          <div class="stat-sub">Average score above 85% (4.25)</div>
        </div>
      </div>

      <div class="panel" style="border:2px solid var(--ink); border-radius:8px; box-shadow:5px 5px 0 rgba(18,17,14,0.08); margin-bottom:24px;">
        <div class="panel-header" style="background:var(--ink); color:#FFFFFF; display:flex; justify-content:space-between; align-items:center; border-top-left-radius:6px; border-top-right-radius:6px; padding:12px 18px;">
          <h2 style="font-size:12.5px; color:#FFFFFF; margin:0; letter-spacing:0.04em;">
            INDIVIDUAL STUDENT PERFORMANCE AND REPORT CARD REMARKS
          </h2>
          <button
            type="button"
            onclick="showToast('✓ Generating 30 official report cards (PDF)...', 'success');"
            class="btn btn-secondary btn-sm"
            style="background:#FFFFFF; color:var(--ink); font-size:10.5px; font-weight:800; border-radius:4px; cursor:pointer;"
          >
            Download 30 Report Cards (PDF)
          </button>
        </div>

        <div class="panel-body" style="padding:0; overflow-x:auto;">
          <table style="width:100%; border-collapse:collapse; min-width:760px;">
            <thead>
              <tr style="background:var(--cream); border-bottom:1.5px solid var(--ink);">
                <th style="padding:10px 14px; font-family:var(--mono); font-size:10.5px; font-weight:800; text-align:left; width:50px;">#</th>
                <th style="padding:10px 14px; font-family:var(--mono); font-size:10.5px; font-weight:800; text-align:left;">Student</th>
                <th style="padding:10px 12px; font-family:var(--mono); font-size:10.5px; font-weight:800; text-align:center; width:120px;">Final Mark</th>
                <th style="padding:10px 12px; font-family:var(--mono); font-size:10.5px; font-weight:800; text-align:center; width:110px;">Status</th>
                <th style="padding:10px 14px; font-family:var(--mono); font-size:10.5px; font-weight:800; text-align:left;">Qualitative Feedback</th>
              </tr>
            </thead>
            <tbody>
              {students10A.map((std, idx) => {
                const base = std.averageScore;
                const isHonor = base >= 8.5;
                const isPass = base >= 6.0;
                const badgeCls = isHonor ? 'badge-active' : (isPass ? 'badge-warning' : 'badge-suspended');
                const level = isHonor ? 'HONOR' : (isPass ? 'PASS' : 'FAIL');

                return (
                  <tr style={`border-bottom:1px solid #ECE7DE; ${idx % 2 === 0 ? 'background:#FFFFFF;' : 'background:#FAF8F5;'}`}>
                    <td style="padding:10px 14px; font-family:var(--mono); font-size:11px; font-weight:800; color:var(--ink-soft);">
                      {idx + 1 < 10 ? `0${idx + 1}` : idx + 1}.
                    </td>
                    <td style="padding:10px 14px;">
                      <div style="display:flex; align-items:center; gap:10px;">
                        <img
                          src={std.avatarUrl || '/avatars/women/fila-1-columna-1.png'}
                          alt={std.name}
                          width="28"
                          height="28"
                          style="width:28px !important; height:28px !important; min-width:28px !important; max-width:28px !important; min-height:28px !important; max-height:28px !important; border-radius:50%; border:1px solid #D5CEBF; object-fit:cover; display:block; flex-shrink:0;"
                        />
                        <div>
                          <strong style="color:var(--ink); font-size:13px;">{std.name}</strong>
                          <div style="font-family:var(--mono); font-size:10px; color:var(--ink-soft);">10°A · Regular</div>
                        </div>
                      </div>
                    </td>
                    <td style="padding:10px 12px; text-align:center; font-family:var(--mono); font-size:13px; font-weight:900; color:#2E5E1E;">
                      {Math.round(base * 10)}/100 <span style="font-size:11px; font-weight:normal; color:var(--ink-soft);">({(base/2).toFixed(1)})</span>
                    </td>
                    <td style="padding:10px 12px; text-align:center;">
                      <span class={`badge ${badgeCls}`} style="font-size:8.5px; font-weight:900; padding:2px 7px; border-radius:3px;">
                        {level}
                      </span>
                    </td>
                    <td style="padding:10px 14px;">
                      <input
                        type="text"
                        value={isHonor ? 'Demonstrates outstanding mastery of core biological principles.' : (isPass ? 'Satisfactorily achieves all term learning objectives.' : 'Requires recovery plan and guided tutoring at home.')}
                        style="width:100%; padding:5px 8px; border:1px solid #D5CEBF; border-radius:4px; background:transparent; font-size:11.5px; color:var(--ink); outline:none;"
                      />
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

    </div>

  </div>

