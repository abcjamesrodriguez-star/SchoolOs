      { id: 'std-11', name: 'Giraldo Ríos, Lucía',          avatarUrl: '/avatars/women/fila-2-columna-1.png' },
      { id: 'std-12', name: 'Gómez Mendoza, Daniela',       avatarUrl: '/avatars/women/fila-2-columna-2.png' },
      { id: 'std-13', name: 'Gutiérrez Caro, Santiago',     avatarUrl: '/avatars/men/fila-2-columna-3.png' },
      { id: 'std-14', name: 'Hernández Ospina, Camila',     avatarUrl: '/avatars/women/fila-2-columna-3.png' },
      { id: 'std-15', name: 'Jaramillo Sánchez, Nicolás',   avatarUrl: '/avatars/men/fila-2-columna-4.png' },
      { id: 'std-16', name: 'Londoño Jiménez, Valeria',     avatarUrl: '/avatars/women/fila-2-columna-4.png' },
      { id: 'std-17', name: 'Martínez Cruz, Alejandro',     avatarUrl: '/avatars/men/fila-3-columna-1.png' },
      { id: 'std-18', name: 'Mejía Ortiz, Gabriela',        avatarUrl: '/avatars/women/fila-3-columna-1.png' },
      { id: 'std-19', name: 'Morales Duque, Esteban',       avatarUrl: '/avatars/men/fila-3-columna-2.png' },
      { id: 'std-20', name: 'Muñoz Salazar, Natalia',       avatarUrl: '/avatars/women/fila-3-columna-2.png' },
      { id: 'std-21', name: 'Osorio Parra, Sebastián',      avatarUrl: '/avatars/men/fila-3-columna-3.png' },
      { id: 'std-22', name: 'Palacio Pineda, Laura',        avatarUrl: '/avatars/women/fila-3-columna-3.png' },
      { id: 'std-23', name: 'Quintero Gil, Martín',         avatarUrl: '/avatars/men/fila-3-columna-4.png' },
      { id: 'std-24', name: 'Ramírez Correa, Salomé',       avatarUrl: '/avatars/women/fila-3-columna-4.png' },
      { id: 'std-25', name: 'Restrepo Vega, David',         avatarUrl: '/avatars/men/fila-4-columna-1.png' },
      { id: 'std-26', name: 'Rincón Torres, Paula',         avatarUrl: '/avatars/women/fila-4-columna-1.png' },
      { id: 'std-27', name: 'Salazar Montoya, Jerónimo',    avatarUrl: '/avatars/men/fila-4-columna-2.png' },
      { id: 'std-28', name: 'Tobón Flórez, Andrea',         avatarUrl: '/avatars/women/fila-4-columna-2.png' },
      { id: 'std-29', name: 'Uribe Benítez, Simón',         avatarUrl: '/avatars/men/fila-4-columna-3.png' },
      { id: 'std-30', name: 'Zapata Moreno, Manuela',       avatarUrl: '/avatars/women/fila-4-columna-3.png' }
    ];

    let currentIdxEn = 0;
    const swipeHistoryEn = [];

    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('btnTriggerSwipeEn')?.addEventListener('click', startSwipeAttendanceEn);
      document.getElementById('btnCloseSwipeEn')?.addEventListener('click', () => {
        document.getElementById('swipeModalEn').style.display = 'none';
      });

      document.getElementById('btnSwipeRightEn')?.addEventListener('click', doSwipeRightEn);
      document.getElementById('btnSwipeLeftEn')?.addEventListener('click', doSwipeLeftEn);
      document.getElementById('btnSwipeUndoEn')?.addEventListener('click', doSwipeUndoEn);

      document.getElementById('btnSubAbsentEn')?.addEventListener('click', () => saveAbsenceEn('absent'));
      document.getElementById('btnSubLateEn')?.addEventListener('click', () => saveAbsenceEn('late'));
      document.getElementById('btnSubCancelEn')?.addEventListener('click', () => {
        document.getElementById('absenceReasonSubPanelEn').style.display = 'none';
      });

      document.getElementById('btnFinishSwipeEn')?.addEventListener('click', finishSwipeAttendanceEn);
    });

    function startSwipeAttendanceEn() {
      currentIdxEn = 0;
      swipeHistoryEn.length = 0;
      document.getElementById('swipeCompletedScreenEn').style.display = 'none';
      document.getElementById('currentStudentCardEn').style.display = 'block';
      document.getElementById('swipeActionButtonsEn').style.display = 'flex';
      document.getElementById('absenceReasonSubPanelEn').style.display = 'none';
      document.getElementById('swipeModalEn').style.display = 'flex';
      renderSwipeCardEn();
      refreshSwipeHUDEn();
    }

    function renderSwipeCardEn() {
      if (currentIdxEn >= STUDENTS_DATA_EN.length) {
        showFinalSwipeScreenEn();
        return;
      }

      const std = STUDENTS_DATA_EN[currentIdxEn];
      document.getElementById('cardStudentNumEn').innerText = (currentIdxEn + 1 < 10 ? '0' : '') + (currentIdxEn + 1);
      document.getElementById('cardStudentNameEn').innerText = std.name;
      
      const img = document.getElementById('cardStudentImgEn');
      if (img) {
        img.src = std.avatarUrl;
        img.alt = std.name;
      }

      const card = document.getElementById('currentStudentCardEn');
      card.style.transform = 'translate(0px, 0px) rotate(0deg)';
      card.style.opacity = '1';
      card.style.borderColor = 'var(--ink)';

      document.getElementById('swipeOverlayEn').style.display = 'none';

      const btnUndo = document.getElementById('btnSwipeUndoEn');
      if (btnUndo) {
        btnUndo.disabled = (currentIdxEn === 0);
        btnUndo.style.opacity = (currentIdxEn === 0 ? '0.5' : '1');
      }
    }

    function doSwipeRightEn() {
      if (currentIdxEn >= STUDENTS_DATA_EN.length) return;

      const card = document.getElementById('currentStudentCardEn');
      const overlay = document.getElementById('swipeOverlayEn');

      overlay.innerText = 'PRESENT';
      overlay.style.color = '#2E5E1E';
      overlay.style.borderColor = '#5B8A4A';
      overlay.style.background = '#E5EFE0';
      overlay.style.display = 'block';

      card.style.transform = 'translate(180px, -15px) rotate(10deg)';
      card.style.opacity = '0';

      const std = STUDENTS_DATA_EN[currentIdxEn];
      swipeHistoryEn.push({ id: std.id, name: std.name, avatarUrl: std.avatarUrl, status: 'present' });

      setTimeout(() => {
        currentIdxEn++;
        renderSwipeCardEn();
        refreshSwipeHUDEn();
      }, 160);
    }

    function doSwipeLeftEn() {
      if (currentIdxEn >= STUDENTS_DATA_EN.length) return;

      const std = STUDENTS_DATA_EN[currentIdxEn];
      document.getElementById('subPanelStudentNameEn').innerText = std.name;
      document.getElementById('absenceReasonSubPanelEn').style.display = 'flex';
    }

    function saveAbsenceEn(status) {
      document.getElementById('absenceReasonSubPanelEn').style.display = 'none';
      const std = STUDENTS_DATA_EN[currentIdxEn];
      swipeHistoryEn.push({ id: std.id, name: std.name, avatarUrl: std.avatarUrl, status: status });

      const card = document.getElementById('currentStudentCardEn');
      const overlay = document.getElementById('swipeOverlayEn');

      overlay.innerText = status === 'absent' ? 'ABSENT' : 'TARDY';
      overlay.style.color = status === 'absent' ? 'var(--rust)' : '#785700';
      overlay.style.borderColor = status === 'absent' ? 'var(--rust)' : '#C49000';
      overlay.style.background = status === 'absent' ? '#FCEAE6' : '#FFF4E0';
      overlay.style.display = 'block';

      card.style.transform = 'translate(-180px, -15px) rotate(-10deg)';
      card.style.opacity = '0';

      setTimeout(() => {
        currentIdxEn++;
        renderSwipeCardEn();
        refreshSwipeHUDEn();
      }, 160);
    }

    function doSwipeUndoEn() {
      if (currentIdxEn > 0) {
        currentIdxEn--;
        swipeHistoryEn.pop();
        renderSwipeCardEn();
        refreshSwipeHUDEn();
      }
    }

    function refreshSwipeHUDEn() {
      const total = STUDENTS_DATA_EN.length;
      const prog = Math.min(currentIdxEn, total);
      document.getElementById('swipeProgressTextEn').innerText = `${prog} / ${total}`;
      document.getElementById('swipeProgressBarEn').style.width = `${(prog / total) * 100}%`;

      let p = 0, a = 0, l = 0;
      swipeHistoryEn.forEach(r => {
        if (r.status === 'present') p++;
        else if (r.status === 'absent') a++;
        else if (r.status === 'late') l++;
      });

      document.getElementById('swipeCntPEn').innerText = p;
      document.getElementById('swipeCntAEn').innerText = a;
      document.getElementById('swipeCntLEn').innerText = l;
    }

    function showFinalSwipeScreenEn() {
      document.getElementById('currentStudentCardEn').style.display = 'none';
      document.getElementById('swipeActionButtonsEn').style.display = 'none';
      document.getElementById('swipeCompletedScreenEn').style.display = 'flex';

      updateFinalCountersEn();
      renderFinalRosterRowsEn();
    }

    function renderFinalRosterRowsEn() {
      const container = document.getElementById('swipeFullRosterSummaryEn');
      container.innerHTML = '';

      swipeHistoryEn.forEach((item, idx) => {
        const row = document.createElement('div');
        row.id = `final-row-en-${idx}`;
        row.style.display = 'flex';
        row.style.justifyContent = 'space-between';
        row.style.alignItems = 'center';
        row.style.padding = '8px 12px';
        row.style.border = '1.5px solid var(--line-strong)';
        row.style.transition = 'background 0.15s ease';

        applyRowStyleEn(row, item.status);

        row.innerHTML = `
          <div style="display:flex; align-items:center; gap:10px;">
            <span style="font-family:var(--mono); font-size:10.5px; font-weight:800; color:var(--ink-soft); min-width:20px;">${idx + 1 < 10 ? '0' : ''}${idx + 1}.</span>
            <img src="${item.avatarUrl}" alt="${item.name}" style="width:28px; height:28px; border-radius:50%; border:1px solid var(--ink); object-fit:cover;" />
            <span style="font-size:12.5px; font-weight:700; color:var(--ink);">${item.name}</span>
          </div>
          <div>
            <select
              id="final-sel-en-${idx}"
              onchange="changeFinalStudentStatusEn(${idx}, this.value);"
              style="font-family:var(--mono); font-size:11px; font-weight:800; padding:4px 10px; border:1.5px solid; cursor:pointer; outline:none; border-radius:2px;"
            >
              <option value="present" ${item.status === 'present' ? 'selected' : ''}>PRESENT</option>
              <option value="absent" ${item.status === 'absent' ? 'selected' : ''}>ABSENT</option>
              <option value="late" ${item.status === 'late' ? 'selected' : ''}>TARDY</option>
            </select>
          </div>
        `;

        container.appendChild(row);
        applySelectStyleEn(row.querySelector('select'), item.status);
      });
    }

    window.changeFinalStudentStatusEn = function(idx, newStatus) {
      if (swipeHistoryEn[idx]) {
        swipeHistoryEn[idx].status = newStatus;
        const row = document.getElementById(`final-row-en-${idx}`);
        if (row) {
          applyRowStyleEn(row, newStatus);
          const sel = document.getElementById(`final-sel-en-${idx}`);
          if (sel) applySelectStyleEn(sel, newStatus);
        }
        updateFinalCountersEn();
      }
    };

    function applyRowStyleEn(rowElement, status) {
      if (status === 'present') {
        rowElement.style.background = 'var(--cream)';
      } else if (status === 'absent') {
        rowElement.style.background = '#FFF0EE';
      } else if (status === 'late') {
        rowElement.style.background = '#FFFDF0';
      }
    }

    function applySelectStyleEn(selectElement, status) {
      if (!selectElement) return;
      if (status === 'present') {
        selectElement.style.background = '#E5EFE0';
        selectElement.style.color = '#2E5E1E';
        selectElement.style.borderColor = '#5B8A4A';
      } else if (status === 'absent') {
        selectElement.style.background = '#FCEAE6';
        selectElement.style.color = 'var(--rust)';
        selectElement.style.borderColor = 'var(--rust)';
      } else if (status === 'late') {
        selectElement.style.background = '#FFF4E0';
        selectElement.style.color = '#785700';
        selectElement.style.borderColor = '#C49000';
      }
    }

    function updateFinalCountersEn() {
      let p = 0, a = 0, l = 0;
      swipeHistoryEn.forEach(r => {
        if (r.status === 'present') p++;
        else if (r.status === 'absent') a++;
        else if (r.status === 'late') l++;
      });

      document.getElementById('finalPEn').innerText = p;
      document.getElementById('finalAEn').innerText = a;
      document.getElementById('finalLEn').innerText = l;
    }

    function finishSwipeAttendanceEn() {
      let p = 0, a = 0, l = 0;
      swipeHistoryEn.forEach(r => {
        if (r.status === 'present') p++;
        else if (r.status === 'absent') a++;
        else if (r.status === 'late') l++;
      });

      alert(`Attendance saved:\n• ${p} Present\n• ${a} Absent\n• ${l} Tardies\n\nSubmitted.`);
      document.getElementById('swipeModalEn').style.display = 'none';

      const mainBtn = document.getElementById('btnTriggerSwipeEn');
      if (mainBtn) {
        mainBtn.innerHTML = `Attendance Complete (${p}/30) ✓`;
        mainBtn.style.background = '#5B8A4A';
        mainBtn.style.borderColor = '#5B8A4A';
      }
    }

    window.addEventListener('keydown', (e) => {
      const modal = document.getElementById('swipeModalEn');
      if (modal && modal.style.display === 'flex') {
        const sub = document.getElementById('absenceReasonSubPanelEn');
        if (sub && sub.style.display === 'flex') {
          if (e.key === '1' || e.key === 'a') saveAbsenceEn('absent');
          else if (e.key === '2' || e.key === 'l') saveAbsenceEn('late');
          else if (e.key === 'Escape') sub.style.display = 'none';
          return;
        }

        const compScreen = document.getElementById('swipeCompletedScreenEn');
        if (compScreen && compScreen.style.display === 'flex') {
          if (e.key === 'Enter') finishSwipeAttendanceEn();
          return;
        }

        if (e.key === 'ArrowRight' || e.key === ' ') {
          e.preventDefault();
          doSwipeRightEn();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          doSwipeLeftEn();
        } else if (e.key === 'Backspace' || e.key === 'z') {
          e.preventDefault();
          doSwipeUndoEn();
        } else if (e.key === 'Escape') {
          modal.style.display = 'none';
        }
      }
    });
  </script>

</AppLayout>
