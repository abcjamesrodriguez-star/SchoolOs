---
// ============================================================
// SchoolOS — Guide Creation Wizard (Teacher - English)
// Phase 3 | Distraction-free layout + React Island
// ============================================================
import { getTeacherCourses, getTeacherCourseById } from '../../../../../../../data/app/mock-content';
import GuideWizard from '../../../../../../../components/app/teacher/GuideWizard';
import type { Lang } from '../../../../../../../i18n';
import '../../../../../../../styles/app.css';

const lang: Lang = 'en';
const { id } = Astro.params;
const course = getTeacherCourseById(id!);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Guide — {course?.name} — SchoolOS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,450;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        try {
          var auth = localStorage.getItem('schoolos-auth');
          if (!auth) window.location.replace('/login?redirect=' + encodeURIComponent(window.location.pathname));
        } catch (_) {}
      })();
    </script>
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--cream, #F4EFE6); font-family: 'Inter', sans-serif; }
      .wizard-shell { min-height: 100vh; display: flex; flex-direction: column; }
      .wizard-topbar {
        background: var(--paper, #FCFAF7);
        border-bottom: 2px solid var(--ink, #12110E);
        padding: 12px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      .wizard-brand { font-family: 'Fraunces', serif; font-size: 18px; font-weight: 700; color: var(--ink, #12110E); text-decoration: none; }
      .wizard-brand span { color: var(--rust, #C3532C); }
      .wizard-course-tag { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--ink-soft, #524E44); }
      .wizard-exit { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--rust, #C3532C); font-weight: 700; text-decoration: none; }
      .wizard-exit:hover { text-decoration: underline; }
      .wizard-body { flex: 1; padding: 20px 24px; max-width: 1540px; margin: 0 auto; width: 100%; }
      @media print {
        @page {
          size: A4 portrait;
          margin: 0mm; /* Suprime automáticamente la URL, fecha, título y 1 of 3 del navegador */
        }

        html, body, .wizard-shell, .wizard-body {
          background: #ffffff !important;
          padding: 0 !important;
          margin: 0 !important;
          min-height: auto !important;
          height: auto !important;
          width: 100% !important;
          overflow: visible !important;
        }

        /* Ocultar elementos de interfaz explícitamente con display:none */
        .no-print,
        .wizard-topbar,
        .wizard-editor-col,
        nav,
        header,
        footer,
        button,
        input,
        textarea,
        select,
        .toast,
        [role="alert"],
        [role="dialog"] {
          display: none !important;
          visibility: hidden !important;
        }

        /* Expandir contenedor y columna del documento al 100% */
        .wizard-split-grid {
          display: block !important;
          width: 100% !important;
          margin: 0 !important;
          padding: 0 !important;
        }

        .wizard-pdf-col {
          position: static !important;
          max-height: none !important;
          height: auto !important;
          overflow: visible !important;
          width: 100% !important;
          max-width: 100% !important;
          margin: 0 !important;
          padding: 0 !important;
          display: block !important;
        }

        #printableGuidePdf {
          box-sizing: border-box !important;
          display: block !important;
          width: 100% !important;
          max-width: 100% !important;
          padding-left: 15mm !important;
          padding-right: 15mm !important;
          padding-top: 0 !important;
          padding-bottom: 0 !important;
          margin: 0 auto !important;
          border: none !important;
          box-shadow: none !important;
          background: #ffffff !important;
          min-height: auto !important;
          height: auto !important;
          overflow: visible !important;
        }

        /* Repetición del encabezado y pie de página en cada hoja */
        table {
          width: 100% !important;
          border-collapse: collapse !important;
        }

        thead {
          display: table-header-group !important;
        }

        tfoot {
          display: table-footer-group !important;
        }

        /* Margen superior e inferior repetitivo para cada página */
        .pdf-thead-cell {
          padding-top: 15mm !important;
          padding-bottom: 12px !important;
        }

        .pdf-tfoot-cell {
          padding-top: 12px !important;
          padding-bottom: 15mm !important;
        }

        /* Protección estricta contra cortes y solapamientos de bloques y preguntas entre páginas */
        .pdf-item,
        .pdf-block,
        .pdf-question-card,
        .pdf-header,
        .pdf-footer {
          break-inside: avoid !important;
          page-break-inside: avoid !important;
          display: block !important;
        }

        /* Forzado estricto de hoja nueva independiente para la Hoja de Respuestas ICFES */
        .pdf-icfes-sheet-page {
          page-break-before: always !important;
          break-before: page !important;
          display: block !important;
          clear: both !important;
          width: 100% !important;
          margin-top: 0 !important;
          padding-top: 0 !important;
          border-top: none !important;
        }

        /* Marca de agua institucional al 20% repetida en cada página */
        .pdf-watermark {
          position: fixed !important;
          top: 50% !important;
          left: 50% !important;
          transform: translate(-50%, -50%) !important;
          width: 320px !important;
          height: 320px !important;
          opacity: 0.18 !important;
          z-index: 0 !important;
          pointer-events: none !important;
          display: flex !important;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }

        #printableGuidePdf * {
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="wizard-shell">
      <!-- Minimalist Wizard Topbar -->
      <div class="wizard-topbar">
        <div style="display:flex; align-items:center; gap:16px;">
          <a href={`/${lang}/app/teacher`} class="wizard-brand">School<span>OS</span></a>
          <div style="width:1px; height:20px; background:var(--line, #E8E2D9);"></div>
          <div class="wizard-course-tag">
            New Guide in: <strong style="color:var(--ink);">{course?.name ?? 'Course'}</strong>
          </div>
        </div>
        <a href={`/${lang}/app/teacher/courses/${id}`} class="wizard-exit">
          ✕ Cancel & Exit
        </a>
      </div>

      <!-- React Island -->
      <div class="wizard-body">
        <GuideWizard
          client:load
          courseId={id!}
          courseName={course?.name ?? 'My Course'}
          lang={lang}
          returnUrl={`/${lang}/app/teacher/courses/${id}`}
        />
      </div>
    </div>
  </body>
</html>
