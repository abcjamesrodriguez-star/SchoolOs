---
// ============================================================
// SchoolOS — My Assigned Courses (Teacher - English)
// Phase 3 | Clean workspace view for teacher courses
// ============================================================
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { getTeacherCourses, getGuidesByCourse, getStudentsByCourse } from '../../../../../data/app/mock-content';

const lang = 'en';
const courses = getTeacherCourses();
---

<AppLayout
  title="My Courses"
  pageTitle="My Assigned Courses"
  activeSection="courses"
  role="teacher"
  schoolName="Colegio Norte"
  lang={lang}
  activeRoute="/app/teacher/courses"
  breadcrumbs={[{ label: 'Colegio Norte' }, { label: 'Teacher Panel', href: `/${lang}/app/teacher` }, { label: 'My Courses' }]}
>

  <!-- ── 1. HEADER BANNER ── -->
  <div style="background:var(--paper); border:2px solid var(--ink); border-radius:8px; padding:18px 24px; margin-bottom:24px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; box-shadow:4px 4px 0 rgba(18,17,14,0.08);">
    <div>
      <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
        <span class="plan-tag" style="background:var(--rust); color:#FFFFFF; border-color:var(--rust); font-size:9.5px; font-weight:900; padding:2px 8px; border-radius:3px;">
          TERM 1 · 2026
        </span>
        <span style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft);">
          Week 6 of 18 · Academic Year 2026
        </span>
      </div>
      <h1 style="font-family:var(--serif); font-size:24px; font-weight:700; color:var(--ink); margin:0;">
        My Assigned Courses
      </h1>
      <div style="font-family:var(--mono); font-size:12px; color:var(--ink-soft); margin-top:4px;">
        Access each group's course workspace to manage instructional guides, inspect the student roster, and review grades.
      </div>
    </div>

    <div style="display:flex; gap:12px;">
      <div style="background:var(--cream); border:1.5px solid var(--ink); border-radius:6px; padding:8px 16px; text-align:center;">
        <div style="font-family:var(--mono); font-size:9.5px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Active Courses</div>
        <div style="font-family:var(--mono); font-size:18px; font-weight:900; color:var(--ink);">{courses.length}</div>
      </div>
      <div style="background:var(--cream); border:1.5px solid var(--ink); border-radius:6px; padding:8px 16px; text-align:center;">
        <div style="font-family:var(--mono); font-size:9.5px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Total Students</div>
        <div style="font-family:var(--mono); font-size:18px; font-weight:900; color:var(--ink);">{courses.reduce((acc, c) => acc + c.studentCount, 0)}</div>
      </div>
    </div>
  </div>

  <!-- ── 2. COURSE GRID ── -->
  <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap:20px; margin-bottom:28px;">
    {courses.map((course) => {
      const guides = getGuidesByCourse(course.id);
      const publishedGuides = guides.filter(g => g.status === 'published');
      const students = getStudentsByCourse(course.id);
      const riskCount = students.filter(s => s.status === 'risk').length;

      return (
        <div
          class="panel"
          style="border:2px solid var(--ink); border-radius:8px; box-shadow:5px 5px 0 rgba(18,17,14,0.08); display:flex; flex-direction:column; justify-content:space-between; background:var(--paper); transition:transform 0.15s ease, box-shadow 0.15s ease;"
        >
          <!-- Card Header -->
          <div style="padding:18px 20px 14px; border-bottom:1.5px solid var(--line);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
              <span
                class={publishedGuides.length > 0 ? 'badge badge-active' : 'badge badge-warning'}
                style="font-size:9.5px; font-weight:800; padding:2px 8px; border-radius:3px;"
              >
                {publishedGuides.length > 0 ? 'ACTIVE' : 'NO GUIDES'}
              </span>
              <span style="font-family:var(--mono); font-size:11px; font-weight:700; color:var(--ink-soft);">
                📍 {course.room}
              </span>
            </div>

            <h3 style="font-family:var(--serif); font-size:18px; font-weight:700; color:var(--ink); margin:0 0 6px 0; line-height:1.25;">
              {course.name}
            </h3>

            <div style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft); display:flex; align-items:center; gap:6px;">
              <span>🕒 {course.schedule}</span>
            </div>
          </div>

          <!-- Essential Course Metrics -->
          <div style="padding:14px 20px; border-bottom:1.5px solid var(--line); background:var(--cream); display:grid; grid-template-columns: repeat(3, 1fr); gap:10px; text-align:center;">
            <div>
              <div style="font-family:var(--mono); font-size:9.5px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Students</div>
              <div style="font-family:var(--mono); font-size:17px; font-weight:900; color:var(--ink); margin-top:2px;">
                {course.studentCount}
              </div>
            </div>

            <div>
              <div style="font-family:var(--mono); font-size:9.5px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Guides</div>
              <div style="font-family:var(--mono); font-size:17px; font-weight:900; color:var(--ink); margin-top:2px;">
                {publishedGuides.length} <span style="font-size:10px; font-weight:normal; color:var(--ink-soft);">/ {guides.length}</span>
              </div>
            </div>

            <div>
              <div style="font-family:var(--mono); font-size:9.5px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Average</div>
              <div style="font-family:var(--mono); font-size:17px; font-weight:900; color:var(--rust); margin-top:2px;">
                {course.averageScore.toFixed(1)}
              </div>
            </div>
          </div>

          <!-- Footer with quick alerts and action -->
          <div style="padding:14px 20px; display:flex; justify-content:space-between; align-items:center; background:#FFFDFB;">
            <div>
              {riskCount > 0 ? (
                <span style="font-family:var(--mono); font-size:10.5px; font-weight:800; color:var(--rust); display:flex; align-items:center; gap:4px;">
                  ⚠️ {riskCount} at risk
                </span>
              ) : (
                <span style="font-family:var(--mono); font-size:10.5px; font-weight:800; color:#2E5E1E; display:flex; align-items:center; gap:4px;">
                  ✓ On track
                </span>
              )}
            </div>

            <a
              href={`/${lang}/app/teacher/courses/${course.id}`}
              class="btn btn-primary btn-sm"
              style="font-size:12px; font-weight:800; padding:8px 16px; border-radius:4px; text-decoration:none;"
            >
              Enter Course →
            </a>
          </div>
        </div>
      );
    })}
  </div>

</AppLayout>
