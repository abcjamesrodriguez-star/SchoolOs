---
// ============================================================
// SchoolOS — Course Detail (Teacher - English)
// Phase 3 | Course Workspace with Ergonomic Tabs
// ============================================================
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { getTeacherCourses, getTeacherCourseById, getGuidesByCourse, getStudentsByCourse } from '../../../../../data/app/mock-content';

export async function getStaticPaths() {
  const courses = getTeacherCourses();
  return courses.map((c) => ({ params: { id: c.id } }));
}

const lang = 'en';
const { id } = Astro.params;
const course = getTeacherCourseById(id!);
const guides = getGuidesByCourse(id!);
const students = getStudentsByCourse(id!);
const honorStudents = students.filter(s => s.status === 'honor');
const riskStudents = students.filter(s => s.status === 'risk');
---

{course ? (
  <AppLayout
    title={course.name}
    pageTitle={course.name}
    activeSection="courses"
    role="teacher"
    schoolName="Colegio Norte"
    lang={lang}
    activeRoute={`/app/teacher/courses/${id}`}
    breadcrumbs={[
      { label: 'Colegio Norte' },
      { label: 'Teacher Panel', href: `/${lang}/app/teacher` },
      { label: 'My Courses', href: `/${lang}/app/teacher/courses` },
      { label: course.name },
    ]}
  >

    <!-- ── 1. COURSE WORKSPACE HEADER ── -->
    <div style="background:var(--paper); border:2px solid var(--ink); border-radius:8px; padding:18px 24px; margin-bottom:20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; box-shadow:4px 4px 0 rgba(18,17,14,0.08);">
      <div>
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
          <span class="plan-tag" style="background:var(--rust); color:#FFFFFF; border-color:var(--rust); font-size:9.5px; font-weight:900; padding:2px 8px; border-radius:3px;">
            {course.level}
          </span>
          <span style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft);">
            📍 {course.room} · 🕒 {course.schedule}
          </span>
        </div>

        <h1 style="font-family:var(--serif); font-size:24px; font-weight:700; color:var(--ink); margin:0;">
          {course.name}
        </h1>

        <div style="font-family:var(--mono); font-size:12px; color:var(--ink-soft); margin-top:4px;">
          <strong>{students.length} enrolled students</strong> · Group grade average: <strong style="color:var(--rust); font-size:13px;">{course.averageScore.toFixed(1)} / 10</strong>
        </div>
      </div>

      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <a href={`/${lang}/app/teacher/courses/${id}/guides/new`} class="btn btn-primary btn-sm" style="font-size:12px; font-weight:800; padding:8px 16px; border-radius:4px; text-decoration:none;">
          + New Guide
        </a>
        <a href={`/${lang}/app/teacher/grades`} class="btn btn-secondary btn-sm" style="font-size:12px; font-weight:700; padding:8px 14px; border-radius:4px; border-color:var(--ink); text-decoration:none;">
          Gradebook →
        </a>
      </div>
    </div>

    <!-- ── 2. TABS BAR ── -->
    <div style="display:flex; border-bottom:2px solid var(--ink); margin-bottom:20px; gap:4px; flex-wrap:wrap;">
      <button
        type="button"
        id="tabBtnGuides"
        onclick="switchCourseTab('guides');"
        class="course-tab-btn active"
        style="padding:10px 20px; font-family:var(--mono); font-size:12px; font-weight:800; border:2px solid var(--ink); border-bottom:none; border-radius:6px 6px 0 0; background:var(--ink); color:#FFFFFF; cursor:pointer; transition:all 0.15s ease;"
      >
        📚 Guides & Content ({guides.length})
      </button>

      <button
        type="button"
        id="tabBtnStudents"
        onclick="switchCourseTab('students');"
        class="course-tab-btn"
        style="padding:10px 20px; font-family:var(--mono); font-size:12px; font-weight:800; border:2px solid var(--ink); border-bottom:none; border-radius:6px 6px 0 0; background:var(--cream); color:var(--ink); cursor:pointer; transition:all 0.15s ease;"
      >
        👥 Class Roster ({students.length})
      </button>

      <button
        type="button"
        id="tabBtnGrades"
        onclick="switchCourseTab('grades');"
        class="course-tab-btn"
        style="padding:10px 20px; font-family:var(--mono); font-size:12px; font-weight:800; border:2px solid var(--ink); border-bottom:none; border-radius:6px 6px 0 0; background:var(--cream); color:var(--ink); cursor:pointer; transition:all 0.15s ease;"
      >
        📊 Evaluations & Grades
      </button>
    </div>

    <!-- ── TAB 1: GUIDES ── -->
    <div id="courseTabContent-guides" class="course-tab-panel">
      
      <div class="panel" style="border:2px solid var(--ink); border-radius:8px; box-shadow:5px 5px 0 rgba(18,17,14,0.08); background:var(--paper); overflow:hidden;">
        <div class="panel-header" style="background:var(--cream); border-bottom:1.5px solid var(--ink); padding:12px 20px; display:flex; justify-content:space-between; align-items:center;">
          <h2 style="font-size:13px; font-weight:800; margin:0; letter-spacing:0.04em;">
            INSTRUCTIONAL GUIDES ASSIGNED TO THIS CLASS ({guides.length})
          </h2>
          <a href={`/${lang}/app/teacher/courses/${id}/guides/new`} class="btn btn-primary btn-sm" style="font-size:11px; font-weight:800; border-radius:3px;">
            + Create Guide
          </a>
        </div>

        {guides.length > 0 ? (
          <div class="panel-body" style="padding:0;">
            {guides.map((guide) => (
              <div style="padding:20px 24px; border-bottom:1.5px solid var(--line); transition:background 0.15s ease;">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px; flex-wrap:wrap; gap:8px;">
                  <div style="display:flex; gap:8px; align-items:center;">
                    <span class={guide.status === 'published' ? 'badge badge-active' : guide.status === 'draft' ? 'badge badge-warning' : 'badge badge-suspended'} style="font-size:9.5px; font-weight:800; padding:2px 8px; border-radius:3px;">
                      {guide.status === 'published' ? 'PUBLISHED' : guide.status === 'draft' ? 'DRAFT' : 'ARCHIVED'}
                    </span>
                    <span style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">
                      {guide.blocks.length} interactive blocks · ~{guide.estimatedMinutes} min reading
                    </span>
                  </div>
                  <span style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">
                    Created: {new Date(guide.createdAt).toLocaleDateString('en-US', { day:'2-digit', month:'short', year:'numeric' })}
                  </span>
                </div>

                <h3 style="font-family:var(--serif); font-size:18px; font-weight:700; color:var(--ink); margin:0 0 6px 0;">
                  {guide.title}
                </h3>
                <p style="font-size:13px; color:var(--ink-soft); margin:0 0 16px 0; line-height:1.5; max-width:820px;">
                  {guide.description}
                </p>

                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; border-top:1px dashed var(--line); padding-top:12px;">
                  <div style="display:flex; gap:10px; flex-wrap:wrap;">
                    <a href={`/${lang}/app/teacher/guides/${guide.id}`} class="btn btn-secondary btn-sm" style="font-size:11.5px; font-weight:700; border-radius:4px; text-decoration:none;">
                      View / Project Guide →
                    </a>
                    {guide.status === 'published' && guide.evaluationsCount > 0 && (
                      <a href={`/${lang}/app/teacher/evaluations/eval-1/results`} class="btn btn-secondary btn-sm" style="font-size:11px; font-weight:700; border-radius:4px; text-decoration:none;">
                        View Student Results →
                      </a>
                    )}
                    {guide.status === 'draft' && (
                      <button class="btn btn-primary btn-sm" onclick="alert('Guide published successfully to this course.');" style="font-size:11px; font-weight:800; border-radius:4px;">
                        Publish Guide to Class
                      </button>
                    )}
                  </div>

                  {guide.status === 'published' && (
                    <div style="font-family:var(--mono); font-size:11px; color:#2E5E1E; font-weight:700; background:#E5EFE0; padding:3px 10px; border-radius:4px; border:1px solid #A8C99B;">
                      ✓ 24/30 submissions registered
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="panel-body padded" style="text-align:center; padding:50px 20px;">
            <div style="font-family:var(--serif); font-size:20px; font-weight:700; color:var(--ink); margin-bottom:8px;">
              No guides published yet
            </div>
            <p style="font-size:13px; color:var(--ink-soft); margin-bottom:20px; max-width:440px; margin-left:auto; margin-right:auto;">
              Create the first instructional guide for this class using the interactive block builder.
            </p>
            <a href={`/${lang}/app/teacher/courses/${id}/guides/new`} class="btn btn-primary" style="font-size:12px; font-weight:800;">
              + Create First Guide
            </a>
          </div>
        )}
      </div>

    </div>

    <!-- ── TAB 2: STUDENTS ── -->
    <div id="courseTabContent-students" class="course-tab-panel" style="display:none;">
      
      <!-- Filter Bar -->
      <div style="background:var(--paper); border:2px solid var(--ink); border-radius:8px; padding:14px 18px; margin-bottom:16px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
          <input
            type="text"
            id="studentCourseSearch"
            placeholder="Search by name..."
            oninput="filterCourseStudents();"
            style="padding:7px 12px; border:1.5px solid var(--ink); border-radius:4px; background:#FFFFFF; font-family:var(--mono); font-size:11.5px; color:var(--ink); outline:none; width:220px;"
          />
          
          <div style="display:flex; gap:4px;">
            <button
              type="button"
              id="filterPillAll"
              onclick="setStudentFilter('all');"
              class="student-filter-pill active"
              style="padding:5px 10px; font-family:var(--mono); font-size:10.5px; font-weight:800; border:1px solid var(--ink); border-radius:3px; background:var(--ink); color:#FFFFFF; cursor:pointer;"
            >
              All ({students.length})
            </button>
            <button
              type="button"
              id="filterPillHonor"
              onclick="setStudentFilter('honor');"
              class="student-filter-pill"
              style="padding:5px 10px; font-family:var(--mono); font-size:10.5px; font-weight:800; border:1px solid var(--ink); border-radius:3px; background:var(--cream); color:var(--ink); cursor:pointer;"
            >
              ⭐ Honor ({honorStudents.length})
            </button>
            <button
              type="button"
              id="filterPillRisk"
              onclick="setStudentFilter('risk');"
              class="student-filter-pill"
              style="padding:5px 10px; font-family:var(--mono); font-size:10.5px; font-weight:800; border:1px solid var(--rust); border-radius:3px; background:#FFF0EE; color:var(--rust); cursor:pointer;"
            >
              ⚠️ At Risk ({riskStudents.length})
            </button>
          </div>
        </div>

        <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft);">
          Showing <strong id="visibleStudentCount" style="color:var(--ink);">{students.length}</strong> of {students.length} students
        </div>
      </div>

      <!-- Students Table -->
      <div class="panel" style="border:2px solid var(--ink); border-radius:8px; box-shadow:5px 5px 0 rgba(18,17,14,0.08); background:#FFFFFF; overflow:hidden;">
        <div style="overflow-x:auto;">
          <table style="width:100%; border-collapse:collapse; font-size:12.5px;">
            <thead>
              <tr style="border-bottom:2px solid var(--ink); background:var(--cream);">
                <th style="text-align:center; width:44px; padding:10px 6px; font-family:var(--mono); font-size:10px; font-weight:800; color:var(--ink-soft); border-right:1px solid var(--line);">#</th>
                <th style="text-align:left; padding:10px 16px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink); border-right:1px solid var(--line);">Student</th>
                <th style="text-align:left; padding:10px 16px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink); border-right:1px solid var(--line);">Subject Average</th>
                <th style="text-align:center; padding:10px 12px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink); border-right:1px solid var(--line);">Pending</th>
                <th style="text-align:center; padding:10px 12px; font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink);">Performance</th>
              </tr>
            </thead>
            <tbody id="courseStudentsTableBody">
              {students.map((std, idx) => {
                const barWidth = Math.round(std.averageScore * 10);
                return (
                  <tr
                    class="course-student-row"
                    data-name={std.name.toLowerCase()}
                    data-status={std.status}
                    style={`border-bottom:1px solid var(--line); ${idx % 2 === 0 ? 'background:#FFFFFF;' : 'background:#FAF8F5;'}`}
                  >
                    <td style="text-align:center; font-family:var(--mono); font-size:11px; font-weight:800; color:var(--ink-soft); padding:8px 6px; border-right:1px solid var(--line);">
                      {idx + 1 < 10 ? `0${idx + 1}` : idx + 1}
                    </td>

                    <td style="padding:10px 16px; border-right:1px solid var(--line);">
                      <div style="display:flex; align-items:center; gap:10px;">
                        <img
                          src={std.avatarUrl || '/avatars/women/fila-1-columna-1.png'}
                          alt={std.name}
                          style="width:30px; height:30px; border-radius:50%; border:1.5px solid var(--ink); object-fit:cover; flex-shrink:0;"
                        />
                        <div>
                          <div style="font-weight:700; color:var(--ink); font-size:13px;">{std.name}</div>
                          <div style="font-family:var(--mono); font-size:9.5px; color:var(--ink-soft);">Group {std.groupCode} · Enrolled</div>
                        </div>
                      </div>
                    </td>

                    <td style="padding:10px 16px; border-right:1px solid var(--line);">
                      <div style="display:flex; align-items:center; gap:8px;">
                        <span style={`font-family:var(--mono); font-size:14px; font-weight:900; min-width:32px; color:${std.averageScore >= 8.5 ? '#2E5E1E' : std.averageScore >= 6.0 ? 'var(--ink)' : 'var(--rust)'};`}>
                          {std.averageScore.toFixed(1)}
                        </span>
                        <div style="flex:1; height:6px; background:var(--cream); border:1px solid var(--ink); border-radius:2px; max-width:110px; overflow:hidden;">
                          <div style={`width:${barWidth}%; height:100%; background:${std.averageScore >= 8.5 ? '#5B8A4A' : std.averageScore >= 6.0 ? '#8B7355' : 'var(--rust)'};`}></div>
                        </div>
                        <span style="font-family:var(--mono); font-size:9.5px; color:var(--ink-soft);">/ 10</span>
                      </div>
                    </td>

                    <td style="padding:10px 12px; text-align:center; border-right:1px solid var(--line);">
                      {std.pendingCount === 0 ? (
                        <span style="font-family:var(--mono); font-size:11px; color:#2E5E1E; font-weight:700;">✓ Up to date</span>
                      ) : (
                        <span style="font-family:var(--mono); font-size:11px; font-weight:800; color:var(--rust); background:#FFF0EE; padding:2px 7px; border-radius:3px; border:1px solid #F5C6BC;">
                          ⏳ {std.pendingCount} pending
                        </span>
                      )}
                    </td>

                    <td style="padding:10px 12px; text-align:center;">
                      <span
                        class={std.status === 'honor' ? 'badge badge-active' : std.status === 'risk' ? 'badge badge-suspended' : 'badge'}
                        style={`font-size:9px; font-weight:900; padding:2px 8px; border-radius:3px; ${std.status === 'normal' ? 'background:var(--cream); border:1px solid var(--ink); color:var(--ink);' : ''}`}
                      >
                        {std.status === 'honor' ? '⭐ SUPERIOR' : std.status === 'risk' ? '⚠️ AT RISK' : 'PASSING'}
                      </span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- ── TAB 3: EVALUATIONS & GRADES ── -->
    <div id="courseTabContent-grades" class="course-tab-panel" style="display:none;">
      
      <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:14px; margin-bottom:20px;">
        <div style="background:var(--paper); border:2px solid var(--ink); border-radius:8px; padding:14px 18px; box-shadow:3px 3px 0 rgba(18,17,14,0.06);">
          <div style="font-family:var(--mono); font-size:10px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Class Average (T1)</div>
          <div style="font-family:var(--mono); font-size:26px; font-weight:900; color:var(--rust); margin-top:2px;">
            {course.averageScore.toFixed(1)} <span style="font-size:13px; font-weight:normal; color:var(--ink-soft);">/ 10</span>
          </div>
        </div>

        <div style="background:var(--paper); border:2px solid var(--ink); border-radius:8px; padding:14px 18px; box-shadow:3px 3px 0 rgba(18,17,14,0.06);">
          <div style="font-family:var(--mono); font-size:10px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Passing Rate</div>
          <div style="font-family:var(--mono); font-size:26px; font-weight:900; color:#2E5E1E; margin-top:2px;">
            {(((students.length - riskStudents.length) / (students.length || 1)) * 100).toFixed(0)}%
          </div>
        </div>

        <div style="background:var(--paper); border:2px solid var(--ink); border-radius:8px; padding:14px 18px; box-shadow:3px 3px 0 rgba(18,17,14,0.06);">
          <div style="font-family:var(--mono); font-size:10px; font-weight:800; color:var(--ink-soft); text-transform:uppercase;">Students At Risk</div>
          <div style="font-family:var(--mono); font-size:26px; font-weight:900; color:var(--rust); margin-top:2px;">
            {riskStudents.length} <span style="font-size:13px; font-weight:normal; color:var(--ink-soft);">students</span>
          </div>
        </div>
      </div>

      <div class="panel" style="border:2px solid var(--ink); border-radius:8px; box-shadow:5px 5px 0 rgba(18,17,14,0.08); background:var(--paper); margin-bottom:20px; overflow:hidden;">
        <div class="panel-header" style="background:var(--cream); border-bottom:1.5px solid var(--ink); padding:12px 20px; display:flex; justify-content:space-between; align-items:center;">
          <h2 style="font-size:13px; font-weight:800; margin:0;">
            EVALUATION PLAN — TERM 1 (100% WEIGHT)
          </h2>
          <span style="font-family:var(--mono); font-size:11px; font-weight:700; color:#2E5E1E; background:#E5EFE0; padding:2px 8px; border-radius:3px;">
            ✓ 4 / 5 Grades Logged
          </span>
        </div>

        <div class="panel-body" style="padding:0;">
          <div style="padding:14px 20px; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <div>
              <div style="display:flex; align-items:center; gap:8px;">
                <strong style="color:var(--ink); font-size:13.5px;">Assignment: Eukaryotic Cell</strong>
                <span class="plan-tag" style="font-size:9px; font-weight:900;">15%</span>
              </div>
              <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-top:2px;">Guide § 1 · Class Average: 7.9</div>
            </div>
            <span class="badge badge-active" style="font-size:9.5px;">✓ GRADED</span>
          </div>

          <div style="padding:14px 20px; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <div>
              <div style="display:flex; align-items:center; gap:8px;">
                <strong style="color:var(--ink); font-size:13.5px;">Assignment: Cell Nucleus & DNA</strong>
                <span class="plan-tag" style="font-size:9px; font-weight:900;">20%</span>
              </div>
              <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-top:2px;">Guide § 2 · Class Average: 8.0</div>
            </div>
            <span class="badge badge-active" style="font-size:9.5px;">✓ GRADED</span>
          </div>

          <div style="padding:14px 20px; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; background:#FFF8F5;">
            <div>
              <div style="display:flex; align-items:center; gap:8px;">
                <strong style="color:var(--rust); font-size:13.5px;">In-Person Exam: Mendel's Laws</strong>
                <span class="plan-tag" style="font-size:9px; font-weight:900; background:var(--rust); color:#FFFFFF; border-color:var(--rust);">30% ★</span>
              </div>
              <div style="font-family:var(--mono); font-size:11px; color:var(--rust); font-weight:700; margin-top:2px;">Paper exam · 25 students pending grading</div>
            </div>
            <a href={`/${lang}/app/teacher/evaluations/eval-2/grade`} class="btn btn-primary btn-sm" style="font-size:11px; font-weight:800; border-radius:4px;">
              Input Exam Grades →
            </a>
          </div>

          <div style="padding:14px 20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <div>
              <div style="display:flex; align-items:center; gap:8px;">
                <strong style="color:var(--ink); font-size:13.5px;">Lab Attendance & Conduct</strong>
                <span class="plan-tag" style="font-size:9px; font-weight:900;">15%</span>
              </div>
              <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); margin-top:2px;">Classroom conduct and microscope care · Average: 8.4</div>
            </div>
            <span class="badge badge-active" style="font-size:9.5px;">✓ ON TRACK</span>
          </div>
        </div>
      </div>

      <div style="background:var(--cream); border:2px solid var(--ink); border-radius:8px; padding:18px 22px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px;">
        <div>
          <h3 style="font-family:var(--serif); font-size:16px; font-weight:700; color:var(--ink); margin:0 0 2px 0;">
            Need to edit grades in the spreadsheet gradebook?
          </h3>
          <div style="font-family:var(--mono); font-size:11.5px; color:var(--ink-soft);">
            Access the full interactive gradebook with sticky navigation and instant calculation.
          </div>
        </div>

        <a href={`/${lang}/app/teacher/grades`} class="btn btn-primary" style="font-size:12.5px; font-weight:800; padding:10px 22px; border-radius:5px; text-decoration:none;">
          Open Full Gradebook →
        </a>
      </div>

    </div>

    <!-- SCRIPT -->
    <script is:inline>
      let currentFilterStatus = 'all';

      function switchCourseTab(tabName) {
        document.querySelectorAll('.course-tab-panel').forEach(panel => {
          panel.style.display = 'none';
        });

        document.querySelectorAll('.course-tab-btn').forEach(btn => {
          btn.style.background = 'var(--cream)';
          btn.style.color = 'var(--ink)';
        });

        const activePanel = document.getElementById(`courseTabContent-${tabName}`);
        if (activePanel) activePanel.style.display = 'block';

        const activeBtn = document.getElementById(`tabBtn${tabName.charAt(0).toUpperCase() + tabName.slice(1)}`);
        if (activeBtn) {
          activeBtn.style.background = 'var(--ink)';
          activeBtn.style.color = '#FFFFFF';
        }
      }

      function setStudentFilter(status) {
        currentFilterStatus = status;

        document.querySelectorAll('.student-filter-pill').forEach(pill => {
          pill.style.background = 'var(--cream)';
          pill.style.color = 'var(--ink)';
          pill.style.borderColor = 'var(--ink)';
        });

        const activePill = document.getElementById(`filterPill${status.charAt(0).toUpperCase() + status.slice(1)}`);
        if (activePill) {
          if (status === 'risk') {
            activePill.style.background = 'var(--rust)';
            activePill.style.color = '#FFFFFF';
            activePill.style.borderColor = 'var(--rust)';
          } else {
            activePill.style.background = 'var(--ink)';
            activePill.style.color = '#FFFFFF';
          }
        }

        filterCourseStudents();
      }

      function filterCourseStudents() {
        const query = (document.getElementById('studentCourseSearch')?.value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('.course-student-row');
        let visibleCount = 0;

        rows.forEach(row => {
          const name = row.getAttribute('data-name') || '';
          const status = row.getAttribute('data-status') || '';

          const matchName = name.includes(query);
          const matchStatus = (currentFilterStatus === 'all') || (status === currentFilterStatus);

          if (matchName && matchStatus) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        const countEl = document.getElementById('visibleStudentCount');
        if (countEl) countEl.innerText = visibleCount;
      }
    </script>

  </AppLayout>
) : (
  <AppLayout title="Course Not Found" pageTitle="Error" activeSection="courses" role="teacher" schoolName="Colegio Norte" lang={lang} activeRoute="/app/teacher/courses" breadcrumbs={[{ label: 'Colegio Norte' }, { label: 'Courses' }]}>
    <div style="padding:40px; text-align:center;">
      <h2>Course Not Found</h2>
      <a href={`/${lang}/app/teacher/courses`} class="btn btn-primary">Return to My Courses</a>
    </div>
  </AppLayout>
)}
