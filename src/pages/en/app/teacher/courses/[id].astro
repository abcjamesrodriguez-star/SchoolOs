---
// ============================================================
// SchoolOS — Course Detail (Teacher - English)
// Phase 3 | Dynamic route [id]
// ============================================================
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { getTeacherCourses, getTeacherCourseById, getGuidesByCourse } from '../../../../../data/app/mock-content';

export async function getStaticPaths() {
  const courses = getTeacherCourses();
  return courses.map((c) => ({ params: { id: c.id } }));
}

const lang = 'en';
const { id } = Astro.params;
const course = getTeacherCourseById(id!);
const guides = getGuidesByCourse(id!);

const MOCK_STUDENTS: Record<string, string[]> = {
  'crs-bio-10a': ['Valentina Torres', 'Mateo García', 'Sofía López', 'Juan Restrepo', 'Isabella Martínez', 'Samuel Morales', 'Camila Ruiz', 'Andrés Castro'],
  'crs-bio-10b': ['Laura Peña', 'Diego Vargas', 'Natalia Gómez', 'Carlos Ríos', 'Andrea Suárez', 'Nicolás Fuentes'],
  'crs-eco-11a': ['Felipe Sánchez', 'Mariana Herrera', 'Tomás Jiménez', 'Lucía Mendoza', 'Esteban Caro', 'Daniela Ospina'],
};
const students = MOCK_STUDENTS[id!] ?? [];
---

{course ? (
  <AppLayout
    title={course.name}
    pageTitle={course.name}
    activeSection="courses"
    role="teacher"
    schoolName="Colegio Norte"
    lang={lang}
    activeRoute={`/app/teacher/courses/${id}`}
    breadcrumbs={[
      { label: 'Colegio Norte' },
      { label: 'Teacher Panel', href: `/${lang}/app/teacher` },
      { label: 'My Courses', href: `/${lang}/app/teacher/courses` },
      { label: course.name },
    ]}
  >

    <!-- ── COURSE HEADER ── -->
    <div style="background:var(--paper); border:2px solid var(--ink); padding:16px 20px; margin-bottom:20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; box-shadow:4px 4px 0 rgba(18,17,14,0.08);">
      <div>
        <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); text-transform:uppercase; margin-bottom:4px;">{course.level} · {course.room}</div>
        <h1 style="font-family:var(--serif); font-size:22px; font-weight:700; color:var(--ink); margin:0 0 4px 0;">{course.name}</h1>
        <div style="font-family:var(--mono); font-size:12px; color:var(--ink-soft);">
          {course.schedule} · <strong>{course.studentCount} students</strong> · Class Average: <strong style="color:var(--rust);">{course.averageScore.toFixed(1)}</strong>
        </div>
      </div>
      <a href={`/${lang}/app/teacher/courses/${id}/guides/new`} class="btn btn-primary" style="font-size:12px; font-weight:700;">
        + New Guide
      </a>
    </div>

    <!-- ── BODY: 2/3 GUIDES + 1/3 STATS & ROSTER ── -->
    <div style="display:grid; grid-template-columns: 2fr 1fr; gap:24px;">

      <!-- LEFT COLUMN: COURSE GUIDES -->
      <div>
        <div class="panel" style="border:2px solid var(--ink); box-shadow:6px 6px 0 rgba(18,17,14,0.08);">
          <div class="panel-header" style="background:var(--cream); display:flex; justify-content:space-between; align-items:center;">
            <h2 style="font-size:13px; margin:0;">COURSE GUIDES ({guides.length})</h2>
            <a href={`/${lang}/app/teacher/courses/${id}/guides/new`} class="btn btn-primary btn-sm" style="font-size:11px; font-weight:700;">+ New Guide</a>
          </div>

          {guides.length > 0 ? (
            <div class="panel-body" style="padding:0;">
              {guides.map((guide) => (
                <div style="padding:18px 20px; border-bottom:1.5px solid var(--line);">
                  <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px; flex-wrap:wrap; gap:8px;">
                    <div style="display:flex; gap:8px; align-items:center;">
                      <span class={guide.status === 'published' ? 'badge badge-active' : guide.status === 'draft' ? 'badge badge-warning' : 'badge badge-suspended'} style="font-size:9.5px; font-weight:800;">
                        {guide.status === 'published' ? 'PUBLISHED' : guide.status === 'draft' ? 'DRAFT' : 'ARCHIVED'}
                      </span>
                      <span style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft);">{guide.blocks.length} blocks · {guide.estimatedMinutes} min read</span>
                    </div>
                    <span style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft);">{new Date(guide.createdAt).toLocaleDateString('en-US', { day:'2-digit', month:'short', year:'numeric' })}</span>
                  </div>
                  <h3 style="font-family:var(--serif); font-size:17px; font-weight:700; color:var(--ink); margin:0 0 4px 0;">{guide.title}</h3>
                  <p style="font-size:12.5px; color:var(--ink-soft); margin:0 0 12px 0; line-height:1.5;">{guide.description}</p>
                  <div style="display:flex; gap:10px; flex-wrap:wrap;">
                    <a href={`/${lang}/app/teacher/guides/${guide.id}`} class="btn btn-secondary btn-sm" style="font-size:11.5px; font-weight:700;">View Guide →</a>
                    {guide.status === 'published' && guide.evaluationsCount > 0 && (
                      <a href={`/${lang}/app/teacher/evaluations/eval-1/results`} class="btn btn-secondary btn-sm" style="font-size:11px;">View Results →</a>
                    )}
                    {guide.status === 'draft' && (
                      <button class="btn btn-primary btn-sm" onclick="alert('Guide published to course roster. Students can now view the material.')" style="font-size:11px; font-weight:700;">Publish Guide</button>
                    )}
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="panel-body padded" style="text-align:center; padding:40px 20px;">
              <div style="font-family:var(--serif); font-size:18px; color:var(--ink-soft); margin-bottom:12px;">No guides created yet</div>
              <p style="font-size:12.5px; color:var(--ink-soft); margin-bottom:16px;">Create your first lesson guide for this class using the block wizard.</p>
              <a href={`/${lang}/app/teacher/courses/${id}/guides/new`} class="btn btn-primary" style="font-size:12px;">+ Create First Guide</a>
            </div>
          )}
        </div>
      </div>

      <!-- RIGHT COLUMN: STATS & STUDENTS -->
      <div style="display:flex; flex-direction:column; gap:16px;">

        <!-- Course Statistics -->
        <div class="panel" style="border:1.5px solid var(--ink); padding:16px;">
          <div style="font-family:var(--mono); font-size:10.5px; font-weight:800; text-transform:uppercase; color:var(--ink); margin-bottom:12px; border-bottom:1.5px solid var(--ink); padding-bottom:6px;">
            COURSE STATISTICS
          </div>
          <div style="display:flex; flex-direction:column; gap:10px; font-size:12px;">
            <div style="display:flex; justify-content:space-between;">
              <span style="color:var(--ink-soft);">Enrolled Students</span>
              <strong style="font-family:var(--mono);">{course.studentCount}</strong>
            </div>
            <div style="display:flex; justify-content:space-between;">
              <span style="color:var(--ink-soft);">Published Guides</span>
              <strong style="font-family:var(--mono);">{guides.filter(g => g.status === 'published').length}</strong>
            </div>
            <div style="display:flex; justify-content:space-between;">
              <span style="color:var(--ink-soft);">Class Average</span>
              <strong style="font-family:var(--mono); color:var(--rust);">{course.averageScore.toFixed(1)} / 10</strong>
            </div>
            <div style="display:flex; justify-content:space-between;">
              <span style="color:var(--ink-soft);">Schedule</span>
              <strong style="font-family:var(--mono); font-size:10.5px;">{course.schedule}</strong>
            </div>
            <div style="display:flex; justify-content:space-between;">
              <span style="color:var(--ink-soft);">Room</span>
              <strong style="font-family:var(--mono);">{course.room}</strong>
            </div>
          </div>
        </div>

        <!-- Student Roster -->
        <div class="panel" style="border:1.5px solid var(--ink); padding:16px;">
          <div style="font-family:var(--mono); font-size:10.5px; font-weight:800; text-transform:uppercase; color:var(--ink); margin-bottom:10px; border-bottom:1.5px solid var(--ink); padding-bottom:6px;">
            STUDENT ROSTER (Read-Only)
          </div>
          <div style="display:flex; flex-direction:column; gap:6px;">
            {students.map((name) => (
              <div style="display:flex; align-items:center; gap:8px; padding:5px 0; border-bottom:1px solid var(--line);">
                <div style="width:24px; height:24px; background:var(--cream); border:1.5px solid var(--ink); border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:var(--mono); font-size:9px; font-weight:800; flex-shrink:0;">
                  {name.split(' ').map((n: string) => n[0]).slice(0,2).join('')}
                </div>
                <span style="font-size:12px; color:var(--ink);">{name}</span>
              </div>
            ))}
            {course.studentCount > students.length && (
              <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft); padding-top:6px; text-align:center;">
                + {course.studentCount - students.length} more students
              </div>
            )}
          </div>
        </div>

      </div>
    </div>

  </AppLayout>
) : (
  <AppLayout title="Course Not Found" pageTitle="Error" activeSection="courses" role="teacher" schoolName="Colegio Norte" lang={lang} activeRoute="/app/teacher/courses" breadcrumbs={[{ label: 'Colegio Norte' }, { label: 'Courses' }]}>
    <div style="padding:40px; text-align:center;">
      <h2>Course not found</h2>
      <a href={`/${lang}/app/teacher/courses`} class="btn btn-primary">Return to My Courses</a>
    </div>
  </AppLayout>
)}
