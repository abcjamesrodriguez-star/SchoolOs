---
// ============================================================
// SchoolOS — Super Admin Dashboard (/en/app/super-admin)
// ============================================================
import AppLayout from '../../../../layouts/AppLayout.astro';
import { schoolService } from '../../../../services/schoolService';
import { auditService } from '../../../../services/auditService';

const lang = 'en';
let schools: any[] = [];
let recentLogs: any[] = [];

try {
  schools = (await schoolService.getSchools()) || [];
} catch (e) {
  console.error('Error loading schools from Supabase:', e);
  schools = [];
}

try {
  recentLogs = (await auditService.getRecentLogs(4)) || [];
} catch (e) {
  console.error('Error loading logs from Supabase:', e);
  recentLogs = [];
}

const recentSchools = schools.slice(0, 4);

function getStatusLabel(status: string) {
  switch (status) {
    case 'active': return 'Active';
    case 'trial': return 'Trial';
    case 'suspended': return 'Suspended';
    case 'cancelled': return 'Cancelled';
    default: return status;
  }
}
---

<AppLayout
  title="Dashboard"
  pageTitle="System Governance"
  activeSection="dashboard"
  lang={lang}
  activeRoute="/app/super-admin"
  breadcrumbs={[{ label: 'System' }, { label: 'Governance Overview' }]}
>
  <div class="dashboard-grid">
    <!-- LEFT / MAIN CANVAS -->
    <div class="main-canvas">
      
      <!-- 3 MODULAR METRIC CARDS (01, 02, 03) -->
      <div class="module-card-grid">
        <!-- CARD 01: ACTIVE SCHOOLS (Sage Accent) -->
        <div class="module-card">
          <div class="module-card-header">
            <span class="module-num-badge">01</span>
            <span class="module-pill-tag" style="color:var(--sage-dark); font-weight:700;">IN PRODUCTION</span>
          </div>
          <div class="module-card-body">
            <h3 class="module-card-title">ACTIVE SCHOOLS</h3>
            <div class="module-card-sub">INSTITUTIONS & COLLEGES</div>
            
            <div class="module-card-visual-slot">
              <svg width="100%" height="48" viewBox="0 0 200 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="10" y="10" width="30" height="38" fill="#BACBB0" opacity="0.6"/>
                <rect x="50" y="4" width="30" height="44" fill="#BACBB0" opacity="0.8"/>
                <rect x="90" y="14" width="30" height="34" fill="#BACBB0" opacity="0.5"/>
                <rect x="130" y="0" width="30" height="48" fill="#BACBB0"/>
                <line x1="0" y1="47.5" x2="200" y2="47.5" stroke="#12110E" stroke-width="1.5"/>
              </svg>
            </div>

            <div class="module-card-stat">
              <div class="module-card-progress-row">
                <span style="font-family:var(--serif); font-size:24px; font-weight:700;">{stats.activeSchools}</span>
                <span style="color:var(--sage-dark);">{stats.activeSchoolsSub}</span>
              </div>
              <div class="module-progress-track">
                <div class="module-progress-fill" style="width: 78%; background: var(--sage-dark);"></div>
              </div>
            </div>
          </div>
          <a class="module-card-footer footer-sage" href={`/${lang}/app/super-admin/schools`}>
            <span>Manage Schools</span>
            <span class="arrow-symbol">→</span>
          </a>
        </div>

        <!-- CARD 02: TOTAL STUDENTS (Warm Stone Accent + Graph Grid Texture) -->
        <div class="module-card graph-grid-bg">
          <div class="module-card-header">
            <span class="module-num-badge">02</span>
            <span class="module-pill-tag">STUDENT ENROLLMENT</span>
          </div>
          <div class="module-card-body">
            <h3 class="module-card-title">STUDENTS</h3>
            <div class="module-card-sub">ACTIVE LEARNERS</div>

            <div class="module-card-visual-slot">
              <svg width="100%" height="48" viewBox="0 0 200 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 35 C 30 10, 60 40, 90 20 C 120 5, 150 30, 200 12" stroke="#12110E" stroke-width="1.5" fill="none"/>
                <path d="M0 42 C 40 25, 80 45, 120 28 C 160 15, 180 35, 200 22" stroke="#B9B29C" stroke-width="1" stroke-dasharray="3 3" fill="none"/>
                <circle cx="90" cy="20" r="3" fill="#12110E"/>
                <circle cx="200" cy="12" r="3" fill="#12110E"/>
              </svg>
            </div>

            <div class="module-card-stat">
              <div class="module-card-progress-row">
                <span style="font-family:var(--serif); font-size:24px; font-weight:700;">{stats.totalStudents}</span>
                <span>{stats.totalStudentsSub}</span>
              </div>
              <div class="module-progress-track">
                <div class="module-progress-fill" style="width: 86%;"></div>
              </div>
            </div>
          </div>
          <a class="module-card-footer footer-stone" href={`/${lang}/app/super-admin/users`}>
            <span>View Directory</span>
            <span class="arrow-symbol">→</span>
          </a>
        </div>

        <!-- CARD 03: CAPACITY & PLANS (Vibrant Orange Accent) -->
        <div class="module-card">
          <div class="module-card-header">
            <span class="module-num-badge">03</span>
            <span class="module-pill-tag" style="color:var(--orange-vibrant); font-weight:700;">TIERS & SLA</span>
          </div>
          <div class="module-card-body">
            <h3 class="module-card-title">PLANS & TRIALS</h3>
            <div class="module-card-sub">COVERAGE & LICENSING</div>

            <div class="module-card-visual-slot">
              <svg width="100%" height="48" viewBox="0 0 200 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <line x1="10" y1="24" x2="190" y2="24" stroke="#D8D2C2" stroke-width="2"/>
                <line x1="10" y1="24" x2="160" y2="24" stroke="#F25C2B" stroke-width="3"/>
                <circle cx="160" cy="24" r="6" fill="#F25C2B"/>
                <circle cx="160" cy="24" r="2" fill="#FFFFFF"/>
                <text x="10" y="14" font-family="'IBM Plex Mono', monospace" font-size="9" fill="#12110E" font-weight="700">11 IN TRIAL</text>
                <text x="140" y="42" font-family="'IBM Plex Mono', monospace" font-size="9" fill="#F25C2B" font-weight="700">91% CAPACITY</text>
              </svg>
            </div>

            <div class="module-card-stat">
              <div class="module-card-progress-row">
                <span style="font-family:var(--serif); font-size:24px; font-weight:700; color:var(--orange-vibrant);">{stats.trialSchools} in Trial</span>
                <span style="color:var(--danger); font-weight:700;">{stats.suspendedSchools} Susp.</span>
              </div>
              <div class="module-progress-track">
                <div class="module-progress-fill" style="width: 91%; background: var(--orange-vibrant);"></div>
              </div>
            </div>
          </div>
          <a class="module-card-footer footer-orange" href={`/${lang}/app/super-admin/plans`}>
            <span>Supervise Plans</span>
            <span class="arrow-symbol">→</span>
          </a>
        </div>
      </div>

      <!-- STRIP 04: MISSION CONTROL / CRITICAL FOCUS -->
      <div class="mission-strip">
        <div class="mission-num-box">
          04
        </div>
        <div class="mission-body">
          <div class="mission-tag">PRIORITY COMPLIANCE & LEGAL AUDIT</div>
          <div class="mission-title">EXP-2026-0417 · COLEGIO NORTE</div>
          <div class="mission-meta">
            Prosecutor Office #14 Bogotá · Access to Student Records & Transcripts · <strong>Expires in 28 days</strong>
          </div>
        </div>
        <a class="mission-action-btn" href={`/${lang}/app/super-admin/judicial-access`} title="Review Legal Case">
          →
        </a>
      </div>

      <!-- RECENT SCHOOLS TABLE -->
      <div class="panel">
        <div class="panel-header">
          <h2>RECENTLY ONBOARDED INSTITUTIONS</h2>
          <a class="panel-link" href={`/${lang}/app/super-admin/schools`}>View all schools →</a>
        </div>
        <div class="panel-body">
          <table class="data-table">
            <thead>
              <tr>
                <th>Institution / School</th>
                <th>Subscription Plan</th>
                <th>Status</th>
                <th>Students</th>
                <th>Created Date</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {recentSchools.map((s) => (
                <tr>
                  <td class="cell-name">
                    <a href={`/${lang}/app/super-admin/schools/${s.id}`}>{s.name}</a>
                    <div style="font-family:var(--mono); font-size:11px; color:var(--ink-soft); font-weight:normal;">{s.location}</div>
                  </td>
                  <td><span class="plan-tag">{s.planName}</span></td>
                  <td><span class={`badge badge-${s.status}`}>{getStatusLabel(s.status)}</span></td>
                  <td style="font-family:var(--mono); font-weight:600;">{s.studentCount.toLocaleString()}</td>
                  <td class="cell-muted">{s.createdAt}</td>
                  <td class="cell-actions">
                    <a class="btn btn-secondary btn-sm" href={`/${lang}/app/super-admin/schools/${s.id}`}>
                      Details →
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- SYSTEM AUDIT LOG TABLE -->
      <div class="panel">
        <div class="panel-header">
          <h2>REAL-TIME SYSTEM AUDIT STREAM</h2>
          <a class="panel-link" href={`/${lang}/app/super-admin/audit-log`}>View full log →</a>
        </div>
        <div class="panel-body">
          <table class="data-table">
            <thead>
              <tr>
                <th>Event / Action</th>
                <th>Target Entity</th>
                <th>Actor</th>
                <th>Time</th>
              </tr>
            </thead>
            <tbody>
              {recentLogs.map((log) => (
                <tr>
                  <td style="font-family:var(--mono); font-size:12px; font-weight:600; color:var(--ink);">
                    <span style="display:inline-block; width:6px; height:6px; border-radius:50%; background:var(--orange-vibrant); margin-right:8px;"></span>
                    {log.action}
                  </td>
                  <td class="cell-name">{log.targetName}</td>
                  <td class="cell-muted">{log.actorEmail}</td>
                  <td class="cell-muted" style="color:var(--ink); font-weight:500;">{log.timestamp}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- RIGHT / INTELLIGENCE RAIL -->
    <aside class="intel-rail">
      
      <!-- SUPER ADMIN PROFILE WIDGET -->
      <div class="intel-card">
        <div class="intel-card-header">
          <span class="intel-card-title">ROOT OPERATOR</span>
          <span class="intel-badge-orange">LEVEL 0</span>
        </div>
        <div class="admin-profile-widget">
          <div class="admin-avatar-lg">
            MP
          </div>
          <div class="admin-profile-details">
            <span class="admin-name">MARIA P.</span>
            <span class="admin-quote">"Active governance. Infrastructure running at full capacity. ↗"</span>
          </div>
        </div>
      </div>

      <!-- SYSTEM HEALTH & RADIAL SLA GAUGE -->
      <div class="intel-card">
        <div class="intel-card-header">
          <span class="intel-card-title">INFRASTRUCTURE HEALTH</span>
        </div>
        <div class="sla-gauge-wrapper">
          <div class="sla-gauge-visual">
            <svg width="130" height="130" viewBox="0 0 120 120">
              <circle
                cx="60"
                cy="60"
                r="48"
                fill="none"
                stroke="#E5DACB"
                stroke-width="9"
              />
              <circle
                cx="60"
                cy="60"
                r="48"
                fill="none"
                stroke="#12110E"
                stroke-width="9"
                stroke-dasharray="301.6"
                stroke-dashoffset="20"
                stroke-linecap="square"
                transform="rotate(-90 60 60)"
              />
              <circle cx="60" cy="12" r="3.5" fill="#F25C2B"/>
            </svg>
            <div class="sla-center-text">
              <div class="sla-center-val">99.8%</div>
              <div class="sla-center-label">GLOBAL SLA</div>
            </div>
          </div>

          <div class="sla-metric-list">
            <div class="sla-metric-row">
              <span class="sla-metric-label">Cluster Compute</span>
              <span class="sla-metric-val">100.0%</span>
            </div>
            <div class="sla-metric-row">
              <span class="sla-metric-label">Tenant Databases</span>
              <span class="sla-metric-val">99.9%</span>
            </div>
            <div class="sla-metric-row">
              <span class="sla-metric-label">Cryptographic Audit</span>
              <span class="sla-metric-val" style="color:var(--orange-vibrant);">VERIFIED</span>
            </div>
            <div class="sla-metric-row">
              <span class="sla-metric-label">Average Latency</span>
              <span class="sla-metric-val">24 ms</span>
            </div>
          </div>
        </div>
      </div>

      <!-- PRIORITY AGENDA -->
      <div class="intel-card">
        <div class="intel-card-header">
          <span class="intel-card-title">THIS WEEK</span>
          <span style="font-family:var(--mono); font-size:12px; color:var(--ink-soft);">•••</span>
        </div>
        <div class="intel-agenda-list">
          <a class="intel-agenda-item" href={`/${lang}/app/super-admin/judicial-access`}>
            <div class="intel-agenda-left">
              <span class="intel-agenda-icon"></span>
              <div>
                <div class="intel-agenda-title">Review Judicial Case</div>
                <div class="intel-agenda-sub">Expires in 2 days</div>
              </div>
            </div>
            <span class="intel-agenda-arrow">→</span>
          </a>

          <a class="intel-agenda-item" href={`/${lang}/app/super-admin/schools`}>
            <div class="intel-agenda-left">
              <span class="intel-agenda-icon"></span>
              <div>
                <div class="intel-agenda-title">Trial Liceo Andino</div>
                <div class="intel-agenda-sub">Due in 4 days</div>
              </div>
            </div>
            <span class="intel-agenda-arrow">→</span>
          </a>

          <a class="intel-agenda-item" href={`/${lang}/app/super-admin/settings`}>
            <div class="intel-agenda-left">
              <span class="intel-agenda-icon"></span>
              <div>
                <div class="intel-agenda-title">API Key Rotation</div>
                <div class="intel-agenda-sub">Scheduled in 6 days</div>
              </div>
            </div>
            <span class="intel-agenda-arrow">→</span>
          </a>
        </div>
      </div>

      <!-- EDITORIAL PHILOSOPHY QUOTE BOX IN WARM STONE -->
      <div class="quote-card-stone">
        <div class="quote-mark">“</div>
        <p class="quote-text">
          Education is not preparation for life; education is life itself. Governance guarantees that every classroom runs without compromise.
        </p>
        <div class="quote-author">— John Dewey · SchoolOS Governance</div>
      </div>

      <!-- FOCUS MODE / MISSION CONTROL TRIGGER STRIP -->
      <div class="focus-mode-dock" onclick="alert('Mission Control Monitoring Active');">
        <div class="focus-mode-left">
          <div class="focus-target-icon"></div>
          <div>
            <div class="focus-mode-title">CONSOLE MODE</div>
            <div class="focus-mode-sub">Continuous live monitoring</div>
          </div>
        </div>
        <div style="font-family:var(--mono); font-size:11px; font-weight:700;">
          START →
        </div>
      </div>

    </aside>
  </div>
</AppLayout>

