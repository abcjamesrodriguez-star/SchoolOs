---
// ============================================================
// SchoolOS — Subscription Plans (/en/app/super-admin/plans)
// ============================================================
import AppLayout from '../../../../layouts/AppLayout.astro';
import { getMockPlans } from '../../../../data/app/mock-data';

const lang = 'en';
const plans = getMockPlans(lang);
---

<AppLayout
  title="Plans"
  pageTitle="Subscription Plans"
  activeSection="plans"
  lang={lang}
  activeRoute="/app/super-admin/plans"
  breadcrumbs={[{ label: 'System' }, { label: 'Plans' }]}
>
  <div class="panel">
    <div class="panel-header">
      <h2>Commercial Plans Configuration</h2>
    </div>
    <div class="panel-body">
      <table class="data-table">
        <thead>
          <tr>
            <th>Plan Tier</th>
            <th>Student Limit</th>
            <th>Base Price</th>
            <th>Active Schools</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {plans.map((p) => (
            <tr>
              <td class="cell-name"><span class="plan-tag">{p.name}</span></td>
              <td class="cell-muted">{p.limit}</td>
              <td style="font-family:var(--mono);">{p.price}</td>
              <td>{p.schoolsCount}</td>
              <td><span class="badge badge-active">{p.status}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AppLayout>
