---
// ============================================================
// SchoolOS — Student Panel: Guide Viewer (English)
// Phase 4 | Dynamic route: /en/app/student/guides/[id]
// ============================================================
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { getGuideForStudent, getGuideProgressById, getPendingEvaluations } from '../../../../../data/app/mock-student';
import { getEvaluationsByGuide } from '../../../../../data/app/mock-content';

const { id } = Astro.params;
const lang = 'en';
const guide = getGuideForStudent(id);
const progress = getGuideProgressById(id);
const evaluations = guide ? getEvaluationsByGuide(guide.id) : [];
const pendingEvals = getPendingEvaluations().filter((p) => p.guideId === id);

if (!guide) {
  return Astro.redirect(`/${lang}/app/student`);
}

const blockTypeLabel: Record<string, string> = {
  heading: 'Section Heading',
  paragraph: 'Paragraph',
  image: 'Image',
  callout: 'Key Insight',
};
---

<AppLayout
  title={guide.title}
  pageTitle={guide.title}
  activeSection="courses"
  role="student"
  schoolName="Colegio Norte"
  lang={lang}
  activeRoute={`/app/student/guides/${id}`}
  breadcrumbs={[
    { label: 'Colegio Norte' },
    { label: 'Student Panel', href: `/${lang}/app/student` },
    { label: 'My Courses', href: `/${lang}/app/student/courses` },
    { label: guide.title },
  ]}
>

  <div style="display:grid; grid-template-columns: 1fr 260px; gap:24px; align-items:start;">

    <!-- MAIN GUIDE BODY -->
    <div>
      <!-- Meta-header of the guide -->
      <div style="background:var(--paper); border:2px solid var(--ink); border-radius:8px; padding:18px 22px; margin-bottom:24px; box-shadow:4px 4px 0 rgba(18,17,14,0.07);">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:12px;">
          <div>
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
              <span class="badge badge-active" style="font-size:9px;">PUBLISHED</span>
              <span style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft);">{guide.courseName}</span>
            </div>
            <h1 style="font-family:var(--serif); font-size:22px; font-weight:900; margin:0 0 6px 0; line-height:1.3;">{guide.title}</h1>
            <p style="font-size:13.5px; color:var(--ink-soft); margin:0; line-height:1.6;">{guide.description}</p>
          </div>
          <div style="text-align:right; flex-shrink:0;">
            <div style="font-family:var(--mono); font-size:9.5px; color:var(--ink-soft); font-weight:700;">EST. TIME</div>
            <div style="font-family:var(--serif); font-size:24px; font-weight:900; color:var(--ink);">{guide.estimatedMinutes}</div>
            <div style="font-family:var(--mono); font-size:9.5px; color:var(--ink-soft);">minutes</div>
          </div>
        </div>
        <div style="margin-top:12px; padding-top:12px; border-top:1px solid var(--line); display:flex; align-items:center; gap:8px;">
          <img
            src="/avatars/women/fila-1-columna-1.png"
            alt={guide.teacherName}
            style="width:24px; height:24px; border-radius:50%; border:1px solid var(--line); object-fit:cover;"
          />
          <span style="font-size:12px; color:var(--ink-soft);">By <strong style="color:var(--ink);">{guide.teacherName}</strong> · Updated on {new Date(guide.updatedAt).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
          {progress?.status === 'read' && (
            <span style="font-family:var(--mono); font-size:9.5px; font-weight:800; padding:2px 7px; border-radius:3px; background:#E8F5E9; color:#4A7C59; margin-left:auto;">✓ READ</span>
          )}
        </div>
      </div>

      <!-- CONTENT BLOCKS -->
      <div style="display:flex; flex-direction:column; gap:0;">
        {guide.blocks.map((block, idx) => (
          <div id={block.id} style="scroll-margin-top:80px;">
            {block.type === 'heading' && (
              <div style="padding:20px 0 8px 0; margin-top:8px;">
                <div style="font-family:var(--mono); font-size:9.5px; color:var(--rust); font-weight:700; margin-bottom:4px; text-transform:uppercase;">
                  § {idx + 1} · {blockTypeLabel[block.type]}
                </div>
                <h2 style="font-family:var(--serif); font-size:20px; font-weight:800; color:var(--ink); margin:0; border-bottom:2px solid var(--ink); padding-bottom:8px;">
                  {block.title || block.content}
                </h2>
              </div>
            )}
            {block.type === 'paragraph' && (
              <div style="background:var(--paper); border:1.5px solid var(--line); border-radius:8px; padding:18px 20px; margin:8px 0;">
                <div style="font-family:var(--mono); font-size:9px; color:var(--ink-soft); font-weight:700; margin-bottom:6px; text-transform:uppercase;">
                  Block {block.id}
                </div>
                <p style="font-size:14.5px; line-height:1.8; color:var(--ink); margin:0;">{block.content}</p>
              </div>
            )}
            {block.type === 'callout' && (
              <div style="background:#FFFCF4; border:2px solid var(--rust); border-left:5px solid var(--rust); border-radius:8px; padding:16px 20px; margin:10px 0;">
                <div style="font-family:var(--mono); font-size:10px; color:var(--rust); font-weight:800; margin-bottom:6px; text-transform:uppercase; display:flex; align-items:center; gap:6px;">
                  <span></span> {block.title || 'Key Insight'}
                </div>
                <p style="font-size:14px; line-height:1.7; color:var(--ink); margin:0; font-weight:500;">{block.content}</p>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- LINKED ASSESSMENTS -->
      {evaluations.length > 0 && (
        <div style="margin-top:32px; background:var(--paper); border:2px solid var(--ink); border-radius:8px; overflow:hidden; box-shadow:4px 4px 0 rgba(18,17,14,0.07);">
          <div style="background:var(--ink); padding:12px 20px;">
            <h3 style="font-family:var(--mono); font-size:11px; font-weight:800; color:#FFFFFF; margin:0; text-transform:uppercase; letter-spacing:0.06em;">
              ASSESSMENTS LINKED TO THIS GUIDE
            </h3>
          </div>
          {evaluations.map((ev) => {
            const isPending = pendingEvals.some((p) => p.evaluationId === ev.id);
            return (
              <div style="padding:16px 20px; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
                <div>
                  <span class={`badge ${ev.mode === 'virtual' ? 'badge-active' : 'badge-warning'}`} style="font-size:9px; margin-bottom:4px;">
                    {ev.mode === 'virtual' ? 'ONLINE' : 'IN PERSON'}
                  </span>
                  <div style="font-weight:700; font-size:14px; color:var(--ink);">{ev.title}</div>
                  <div style="font-family:var(--mono); font-size:10.5px; color:var(--ink-soft);">
                    {ev.timeLimitMinutes ? ` ${ev.timeLimitMinutes} min · ` : ''}{ev.questions.length} questions · Attempts: {ev.maxAttempts}
                  </div>
                </div>
                {isPending && (
                  <a
                    href={`/${lang}/app/student/evaluations/${ev.id}/take`}
                    class="btn btn-primary btn-sm"
                    style="font-size:11.5px; font-weight:800; background:var(--rust); border-color:var(--rust);"
                  >
                    Start Assessment →
                  </a>
                )}
              </div>
            );
          })}
        </div>
      )}

    </div>

    <!-- STICKY SIDEBAR NAVIGATION -->
    <div style="position:sticky; top:24px; display:flex; flex-direction:column; gap:16px;">

      <!-- Section Index -->
      <div style="background:var(--paper); border:2px solid var(--ink); border-radius:8px; overflow:hidden; box-shadow:4px 4px 0 rgba(18,17,14,0.07);">
        <div style="background:var(--cream); border-bottom:1.5px solid var(--ink); padding:10px 14px;">
          <div style="font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink);">Table of Contents</div>
        </div>
        <div style="padding:8px 0;">
          {guide.blocks.filter((b) => b.type === 'heading').map((block, idx) => (
            <a
              href={`#${block.id}`}
              style="display:block; padding:8px 14px; font-size:12.5px; color:var(--ink); text-decoration:none; border-left:3px solid transparent; transition:all 0.2s;"
              onmouseover="this.style.borderLeftColor='var(--rust)'; this.style.background='var(--cream)';"
              onmouseout="this.style.borderLeftColor='transparent'; this.style.background='transparent';"
            >
              <span style="font-family:var(--mono); font-size:9.5px; color:var(--rust); font-weight:700;">§ {idx + 1} </span>
              {block.title || block.content}
            </a>
          ))}
        </div>
      </div>

      <!-- Action Panel -->
      <div style="background:var(--paper); border:2px solid var(--ink); border-radius:8px; padding:14px; box-shadow:4px 4px 0 rgba(18,17,14,0.07);">
        <div style="font-family:var(--mono); font-size:10px; font-weight:800; text-transform:uppercase; color:var(--ink); margin-bottom:10px;">Actions</div>
        <div style="display:flex; flex-direction:column; gap:8px;">
          <button
            style="width:100%; padding:10px 12px; background:var(--cream); border:1.5px solid var(--ink); border-radius:5px; font-size:12px; font-weight:700; cursor:pointer; text-align:left; display:flex; justify-content:space-between; align-items:center;"
            onclick="window.print()"
          >
            <span> Download PDF</span>
            <span style="font-size:10px; color:var(--ink-soft);">→</span>
          </button>
          {pendingEvals.length > 0 && (
            <a
              href={`/${lang}/app/student/evaluations/${pendingEvals[0].evaluationId}/take`}
              style="width:100%; padding:10px 12px; background:var(--rust); border:1.5px solid var(--rust); border-radius:5px; font-size:12px; font-weight:800; cursor:pointer; text-align:left; display:flex; justify-content:space-between; align-items:center; color:#FFFFFF; text-decoration:none;"
            >
              <span> Take Assessment</span>
              <span>→</span>
            </a>
          )}
          <a
            href={`/${lang}/app/student/courses`}
            style="width:100%; padding:8px 12px; background:transparent; border:1.5px solid var(--line); border-radius:5px; font-size:11.5px; font-weight:700; cursor:pointer; text-align:center; color:var(--ink-soft); text-decoration:none;"
          >
            ← My Courses
          </a>
        </div>
      </div>

      <!-- Study Tip -->
      <div style="background:var(--cream); border:1.5px solid var(--line); border-radius:8px; padding:12px 14px; font-size:11.5px; color:var(--ink-soft); line-height:1.5;">
        <strong style="color:var(--ink); display:block; margin-bottom:4px;"> Study Tip</strong>
        Read each section carefully. Highlighted concepts may appear on the upcoming evaluation.
      </div>

    </div>

  </div>

</AppLayout>
