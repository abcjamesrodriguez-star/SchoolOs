---
import Nav from '../components/chrome/Nav.astro';
import Footer from '../components/chrome/Footer.astro';
import type { Lang } from '../i18n';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  activeRoute: string;
  lang: Lang;
}
const {
  title,
  description = 'SchoolOS — A digital platform for schools. Classes, guides, evaluations and communication — connected in one platform.',
  activeRoute,
  lang,
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- hreflang for SEO -->
    <link rel="alternate" hreflang="en" href={`/en${activeRoute === '/' ? '' : activeRoute}`} />
    <link rel="alternate" hreflang="es" href={`/es${activeRoute === '/' ? '' : activeRoute}`} />
    <link rel="alternate" hreflang="x-default" href={`/es${activeRoute === '/' ? '' : activeRoute}`} />

    <!-- Preconnect for Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,450;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon placeholder -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Nav activeRoute={activeRoute} lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
