---
import Sidebar from '../components/app/Sidebar.astro';
import Topbar from '../components/app/Topbar.astro';
import type { Lang } from '../i18n';
import '../styles/app.css';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  pageTitle: string;
  breadcrumbs: BreadcrumbItem[];
  activeSection: 'dashboard' | 'schools' | 'users' | 'plans' | 'judicial-access' | 'audit-log' | 'settings';
  lang?: Lang;
  activeRoute?: string;
}

const {
  title,
  pageTitle,
  breadcrumbs,
  activeSection,
  lang = 'es',
  activeRoute = '/app/super-admin',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Super Admin — SchoolOS</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,450;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Auth check script -->
    <script is:inline>
      (function () {
        try {
          var auth = localStorage.getItem('schoolos-auth');
          if (!auth) {
            window.location.replace('/login?redirect=' + encodeURIComponent(window.location.pathname));
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <div class="app-shell">
      <Sidebar activeSection={activeSection} lang={lang} />
      <main class="app-main">
        <Topbar
          title={pageTitle}
          breadcrumbs={breadcrumbs}
          lang={lang}
          activeRoute={activeRoute}
        />
        <div class="app-content">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
