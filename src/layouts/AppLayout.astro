---
import Sidebar from '../components/app/Sidebar.astro';
import Topbar from '../components/app/Topbar.astro';
import type { Lang } from '../i18n';
import '../styles/app.css';

export type AppRole = 'super_admin' | 'school_admin' | 'teacher' | 'student';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  pageTitle: string;
  breadcrumbs: BreadcrumbItem[];
  activeSection: string;
  role?: AppRole;
  schoolName?: string;
  lang?: Lang;
  activeRoute?: string;
}

const {
  title,
  pageTitle,
  breadcrumbs,
  activeSection,
  role = 'super_admin',
  schoolName = 'Institución',
  lang = 'es',
  activeRoute = '/app/super-admin',
} = Astro.props;

const roleLabels = {
  super_admin: lang === 'es' ? 'Super Admin' : 'Super Admin',
  school_admin: lang === 'es' ? 'Rectoría / School Admin' : 'School Admin',
  teacher: lang === 'es' ? 'Docente' : 'Teacher',
  student: lang === 'es' ? 'Estudiante' : 'Student',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — {roleLabels[role]} — SchoolOS</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,450;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fast local redirect only. Real Supabase session validation happens before showing the app. -->
    <script is:inline define:vars={{ role }}>
      (function () {
        try {
          var userRaw = localStorage.getItem('schoolos-user');
          if (!userRaw) return;
          var user = JSON.parse(userRaw);
          if (role && user.role !== role) {
            if (user.role === 'super_admin') window.location.replace('/es/app/super-admin');
            else if (user.role === 'school_admin') window.location.replace('/es/app/school-admin');
            else if (user.role === 'teacher') window.location.replace('/es/app/teacher');
            else if (user.role === 'student') window.location.replace('/es/app/student');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="auth-pending" data-expected-role={role}>
    <div class="auth-loading-screen" aria-hidden="true">
      <div class="auth-loading-card">
        <div class="auth-loading-spinner"></div>
        <div class="auth-loading-text">{lang === 'es' ? 'Cargando...' : 'Loading...'}</div>
      </div>
    </div>
    <div class="app-shell">
      <Sidebar activeSection={activeSection} role={role} schoolName={schoolName} lang={lang} />
      <main class="app-main">
        <Topbar
          title={pageTitle}
          breadcrumbs={breadcrumbs}
          role={role}
          schoolName={schoolName}
          lang={lang}
          activeRoute={activeRoute}
        />
        <div class="app-content">
          <slot />
        </div>
      </main>
    </div>
    <script>
      import { authService } from '../services/authService';
      import { schoolService } from '../services/schoolService';

      const schoolOSApp = ((window as any).SchoolOSApp = (window as any).SchoolOSApp || {});
      schoolOSApp.pageLoads = schoolOSApp.pageLoads || [];
      schoolOSApp.registerPageLoad = (promise) => {
        if (promise) schoolOSApp.pageLoads.push(Promise.resolve(promise));
        return promise;
      };

      function redirectForRole(role) {
        if (role === 'super_admin') return '/es/app/super-admin';
        if (role === 'school_admin') return '/es/app/school-admin';
        if (role === 'teacher') return '/es/app/teacher';
        if (role === 'student') return '/es/app/student';
        return '/login';
      }

      async function validateRealSession() {
        try {
          const user = await authService.getCurrentUser();
          if (!user) {
            window.location.replace('/login?redirect=' + encodeURIComponent(window.location.pathname));
            return null;
          }

          if (user.status === 'suspended') {
            await authService.signOut();
            window.location.replace('/login?account=suspended');
            return null;
          }

          const expectedRole = document.body.dataset.expectedRole;
          if (expectedRole && user.role !== expectedRole) {
            window.location.replace(redirectForRole(user.role));
            return null;
          }

          localStorage.setItem('schoolos-user', JSON.stringify(user));
          localStorage.setItem('schoolos-auth', 'true');
          return user;
        } catch (error) {
          console.warn('No se pudo validar la sesión real:', error);
          window.location.replace('/login?redirect=' + encodeURIComponent(window.location.pathname));
          return null;
        }
      }

      async function hydrateTenantContext(user) {
        try {
          if (!user || user.role !== 'school_admin' || !user.schoolId) return;

          const school = await schoolService.getSchoolById(user.schoolId);
          if (!school) return;

          user.schoolName = school.name;
          user.schoolStatus = school.status;
          localStorage.setItem('schoolos-user', JSON.stringify(user));

          document.querySelectorAll('[data-tenant-name]').forEach((el) => {
            const text = el.textContent === el.textContent?.toUpperCase()
              ? school.name.toUpperCase()
              : school.name;
            el.textContent = text;
          });

          if (school.status === 'suspended') {
            window.location.replace('/login?tenant=suspended');
          }
        } catch (error) {
          console.warn('No se pudo hidratar el tenant de Rectoría:', error);
        }
      }

      async function waitForPageData() {
        await new Promise((resolve) => window.setTimeout(resolve, 0));
        const pageLoads = [...schoolOSApp.pageLoads];
        if (!pageLoads.length) return;
        await Promise.allSettled(pageLoads);
      }

      (async function bootApp() {
        const user = await validateRealSession();
        if (!user) return;
        await hydrateTenantContext(user);
        await waitForPageData();
        document.body.classList.remove('auth-pending');
        document.body.classList.add('auth-ready');
      })();
    </script>
  </body>
</html>
