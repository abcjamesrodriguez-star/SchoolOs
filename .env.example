# Copia este archivo a .env y pega los valores del dashboard.
# Nunca subas .env a git. Nunca pongas SUPABASE_SECRET_KEY en el navegador.

# --- Públicos (el front de Astro SÍ puede leer PUBLIC_*) ---
PUBLIC_SUPABASE_URL=https://TU-REF.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Privados (solo servidor Node.js SSR / API REST) ---
SUPABASE_URL=https://TU-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://TU-REF.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://postgres.TU-REF:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Configuración del Servidor y JWT ---
SITE_URL=http://localhost:4321
# Genera uno local con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_CONFIRM_SECRET=pon_un_secreto_largo_aleatorio_32_chars

# --- Servicio de Correos SMTP (Nodemailer en Node.js SSR) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-password-de-aplicacion
SMTP_FROM_NAME=SchoolOS
SMTP_FROM_EMAIL=tu-correo@gmail.com

# --- Cloudflare R2 (PDFs). Déjalo vacío hasta la fase de storage ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
