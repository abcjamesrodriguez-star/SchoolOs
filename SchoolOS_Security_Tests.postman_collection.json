{
  "info": {
    "name": "SchoolOS — Pruebas de Seguridad y Endpoints",
    "_postman_id": "schoolos-security-audit-2026",
    "description": "Colección completa para verificar la seguridad, autenticación (401), autorización de roles (403) y funcionalidad de los endpoints de SchoolOS contra el backend real.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:4321" },
    { "key": "supabase_url", "value": "https://tyzeirtdrvlufnkwpron.supabase.co" },
    { "key": "anon_key", "value": "sb_publishable_416BDuzMEaASLp4BLzqEAQ_jsUgB7Yl" },
    { "key": "school_slug", "value": "cafelitos" },
    { "key": "school_id", "value": "REEMPLAZAR_CON_UUID_ESCUELA" },
    { "key": "user_id", "value": "REEMPLAZAR_CON_UUID_USUARIO" },
    { "key": "auth_token", "value": "REEMPLAZAR_CON_JWT_OBTENIDO_EN_LOGIN" }
  ],
  "item": [
    {
      "name": "0. Autenticación — Obtener JWT",
      "item": [
        {
          "name": "0.1 Login Super Admin (Obtener Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('auth_token', jsonData.access_token);",
                  "    console.log('auth_token guardado exitosamente');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anon_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kumikasato45@gmail.com\",\n  \"password\": \"TU_PASSWORD_AQUI\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/auth/v1/token?grant_type=password",
              "host": ["{{supabase_url}}"],
              "path": ["auth", "v1", "token"],
              "query": [{ "key": "grant_type", "value": "password" }]
            },
            "description": "Autentica directamente contra Supabase Auth y guarda automáticamente el access_token en la variable {{auth_token}}."
          }
        }
      ]
    },
    {
      "name": "1. Endpoints de Instituciones (/api/admin/school)",
      "item": [
        {
          "name": "1.1 Crear Nueva Escuela (Backend Seguro)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"create_school\",\n  \"school\": {\n    \"name\": \"Academia San Marcos\",\n    \"slug\": \"san-marcos\",\n    \"domain\": \"sanmarcos.edu.co\",\n    \"location\": \"Medellín, Colombia\",\n    \"planName\": \"Professional\",\n    \"contactEmail\": \"contacto@sanmarcos.edu.co\"\n  }\n}"
            },
            "url": { "raw": "{{base_url}}/api/admin/school", "host": ["{{base_url}}"], "path": ["api", "admin", "school"] },
            "description": "Crea una escuela de forma segura desde el backend con rol super_admin."
          }
        },
        {
          "name": "1.2 Actualizar Datos Institución",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"update_school\",\n  \"schoolId\": \"{{school_id}}\",\n  \"updates\": {\n    \"name\": \"Institución Educativa Actualizada\",\n    \"planName\": \"Professional\",\n    \"status\": \"active\"\n  }\n}"
            },
            "url": { "raw": "{{base_url}}/api/admin/school", "host": ["{{base_url}}"], "path": ["api", "admin", "school"] }
          }
        },
        {
          "name": "1.3 Suspender / Reactivar Escuela",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"suspend_or_reactivate\",\n  \"schoolId\": \"{{school_id}}\",\n  \"updates\": {\n    \"status\": \"suspended\"\n  }\n}"
            },
            "url": { "raw": "{{base_url}}/api/admin/school", "host": ["{{base_url}}"], "path": ["api", "admin", "school"] }
          }
        },
        {
          "name": "1.4 Purgar Escuela (Solo Super Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"purge_school\",\n  \"schoolId\": \"{{school_slug}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/admin/school", "host": ["{{base_url}}"], "path": ["api", "admin", "school"] },
            "description": "⚠️ PELIGROSO: Purgar escuela. Sin token debe dar 401 Unauthorized."
          }
        }
      ]
    },
