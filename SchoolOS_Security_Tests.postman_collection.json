    {
      "name": "7. Motor de Evaluación Server-Side (/api/evaluations/submit)",
      "item": [
        {
          "name": "7.1 Entregar Evaluación (Calificación en Servidor)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assessmentId\": \"eval-sample-01\",\n  \"guideId\": \"guide-mat-10\",\n  \"totalTimeSpentSeconds\": 120,\n  \"answers\": [\n    {\n      \"questionId\": \"q-1\",\n      \"selectedOptionIndex\": 0,\n      \"timeSpentSeconds\": 45\n    },\n    {\n      \"questionId\": \"q-2\",\n      \"selectedOptionIndex\": 1,\n      \"timeSpentSeconds\": 75\n    }\n  ],\n  \"assessmentData\": {\n    \"passingScore\": 70,\n    \"guideTitle\": \"Evaluación de Matemáticas\",\n    \"questions\": [\n      {\n        \"id\": \"q-1\",\n        \"prompt\": \"¿Cuál es la raíz cuadrada de 64?\",\n        \"options\": [\"8\", \"6\", \"4\", \"12\"],\n        \"correctAnswerIndex\": 0,\n        \"explanation\": \"8 * 8 = 64\"\n      },\n      {\n        \"id\": \"q-2\",\n        \"prompt\": \"¿Cuánto es 5! (factorial de 5)?\",\n        \"options\": [\"60\", \"120\", \"24\", \"100\"],\n        \"correctAnswerIndex\": 1,\n        \"explanation\": \"5*4*3*2*1 = 120\"\n      }\n    ]\n  }\n}"
            },
            "url": { "raw": "{{base_url}}/api/evaluations/submit", "host": ["{{base_url}}"], "path": ["api", "evaluations", "submit"] },
            "description": "Calcula la nota de forma 100% segura en el servidor."
          }
        }
      ]
    },
